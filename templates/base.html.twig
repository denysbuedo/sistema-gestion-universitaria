<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Sistema de Gestión Universitaria{% endblock %}</title>

    <!-- Google Font: Montserrat -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="{{ asset('assets/fontawesome-free/css/all.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/select2.min.css') }}">
    <!-- Theme style -->
    <link rel="stylesheet" href="{{ asset('assets/dist/css/adminlte.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/icheck-bootstrap.min.css') }}">

    <!-- DataTables -->
    <link rel="stylesheet" href="{{ asset('assets/datatables-bs4/css/dataTables.bootstrap4.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/datatables-responsive/css/responsive.bootstrap4.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/datatables-buttons/css/buttons.bootstrap4.min.css') }}">

    <link rel="stylesheet" href="{{ asset('assets/css/HoldOn.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/fullCalendar/main.css') }}">

    <link rel="stylesheet" href="{{ asset('assets/toastr/toastr.min.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/SimpleLineMES/simple-line-icons-es.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/bootstrap-switch.css') }}">

    <style>
        :root {
            --primary-blue: #0E375F;
            --secondary-blue: #134679;
            --panel-blue: #e6eff8;   /* azul muy claro para el panel derecho */
            --light-gray: #f3f4f6;
            --light-hover: #e2e8f0;
            --link-active-bg: #dde7f5;
            --text-dark: #1f2933;
        }

        body {
            background: #f5f7fb;
            margin: 0;
            font-family: 'Montserrat', sans-serif;
        }

        .btn-primary {
            color: #fff;
            background-color: #134679;
            border-color: #134679;
            box-shadow: none;
        }

        .select2 {
            width: 100% !important;
        }

        label span.invalid-feedback {
            display: none !important;
        }

        label.required:after {
            content: "*";
            color: red;
        }

        label {
            margin-bottom: 2px !important;
        }

        [class*=sidebar-dark-] {
            background-color: #f7f7f7;
        }

        .sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link.active,
        .sidebar-light-primary .nav-sidebar > .nav-item > .nav-link.active {
            background-color: #682423;
            color: #fff;
        }

        .sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link,
        .sidebar-light-primary .nav-sidebar > .nav-item > .nav-link {
            background-color: #91969f;
            color: #fff;
        }

        [class*=sidebar-dark-] .nav-sidebar > .nav-item.menu-open > .nav-link,
        [class*=sidebar-dark-] .nav-sidebar > .nav-item:hover > .nav-link,
        [class*=sidebar-dark-] .nav-sidebar > .nav-item > .nav-link:focus {
            background-color: rgb(104 36 35 / 62%);
            color: #fff;
        }

        [class*=sidebar-dark] .brand-link,
        [class*=sidebar-dark] .user-panel {
            border-bottom: 1px solid #73767847;
        }

        .main-header {
            border-bottom: none;
        }

        .content-wrapper {
            background-color: #ffffff;
        }

        .control-sidebar {
            position: absolute;
        }

        .aside-header {
            background-color: var(--primary-blue);
        }

        .aside-header > i {
            color: white;
            position: absolute;
            right: 16px;
            top: 12px;
        }

        .control-sidebar, .control-sidebar::before {
            width: 280px !important;
        }

        /* ==== PANEL DERECHO (MENÚ) ==== */
        .control-sidebar {
            background-color: var(--panel-blue);   /* azul claro */
            color: var(--text-dark);
        }

        .control-sidebar .nav.nav-pills.nav-sidebar {
            background-color: transparent;
        }

        .control-sidebar .nav.nav-pills .nav-link {
            background-color: transparent;
            color: var(--text-dark);
            border-radius: 6px;
            display: flex;
            align-items: center;
            padding-left: 10px;
            padding-right: 10px;
            font-size: 0.9rem;
            font-weight: 500;
        }

        .control-sidebar .nav.nav-pills .nav-link i {
            color: var(--text-dark);
            margin-right: 8px;
            font-size: 1rem;
        }

        .control-sidebar .nav.nav-pills .nav-link:hover {
            background-color: var(--light-hover);
        }

        .control-sidebar .nav.nav-pills .nav-link.active {
            background-color: var(--link-active-bg);
            color: var(--text-dark);
            box-shadow: inset 3px 0 0 var(--primary-blue);
        }

        .control-sidebar .nav.nav-pills .nav-link.active i {
            color: var(--primary-blue);
        }

        /* ==== NAVBAR SUPERIOR ==== */
        .main-header.navbar {
            background-color: var(--primary-blue);
            color: #ffffff;
            box-shadow: 0 2px 4px rgba(0,0,0,.08);
        }

        .main-header.navbar .navbar-nav .nav-link,
        .main-header.navbar .navbar-nav .nav-link i {
            color: #ffffff !important;
        }

        .main-header.navbar .navbar-nav .nav-link:hover {
            color: #e9ecef !important;
        }

        .sgu-navbar-title {
            color: #ffffff !important;
            font-weight: 600;
            font-size: 1.05rem;
            margin-left: 0.75rem;
        }

        .main-header.navbar .navbar-text {
            color: #ffffff !important;
        }

        /* Ocultar menú lateral izquierdo y ajustar márgenes */
        .menuAmburguesa {
            display: none !important;
        }

        .main-sidebar {
            display: none !important;
        }

        .main-header,
        .layout-fixed .main-header {
            margin-left: 0 !important;
        }

        .content-wrapper,
        .main-footer {
            margin-left: 0 !important;
        }

        /* ==== FOOTER ÚNICO SGU ==== */
        .main-footer {
            background: var(--primary-blue);
            padding: 10px 15px;
            color: #ffffff;
            border-top: none;
            text-align: center;
            font-size: 0.8rem;
            line-height: 1.3;
        }

        .main-footer .sgu-footer-system {
            font-weight: 600;
            color: #ffffff;
        }

        .main-footer .sgu-footer-copy {
            font-size: 0.8rem;
            color: #e2e6f0;
        }

        /* --- resto de estilos que ya usabas --- */

        .item-icon-card {
            margin: 5px;
            background-color: #e7e2e7d4;
            border-radius: 5px;
            width: 43px;
            height: 43px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #682423;
            margin-left: 0;
        }

        .card-stadistics {
            border-radius: 20px;
            padding: 12px;
            display: flex;
            align-items: center;
            background: radial-gradient(50px circle at 5% -11%, #e9e5e92e 50%, transparent 51%),
            radial-gradient(71px circle at 90% 95%, #dce3100a 50%, transparent 51%),
            radial-gradient(37px circle at 67% 11%, #1024e303 50%, transparent 51%);
            background-color: #f9f8f9;
        }

        .item-icon-card > i {
            font-size: 19px;
        }

        .progress-bar {
            display: flex;
            flex-direction: column;
            justify-content: center;
            overflow: hidden;
            color: #fff;
            text-align: center;
            white-space: nowrap;
            background-color: #3b893d;
            transition: width .6s ease;
        }

        .box-type-green {
            background-color: #edfbeb;
            border-left: 4px solid #58b553;
        }

        .box-type-green .progress-bar {
            background-color: #58b553;
        }

        .box-type-green .box-type-text {
            color: #58b553;
        }

        .box-type-red {
            background-color: #fff2f7;
            border-left: 4px solid #e46d62;
        }

        .box-type-red .progress-bar {
            background-color: #e46d62;
        }

        .box-type-red .box-type-text {
            color: #e46d62;
        }

        .box-type-orange {
            background-color: #fbfbe8;
            border-left: 4px solid #eb9e40;
        }

        .box-type-orange .progress-bar {
            background-color: #eb9e40;
        }

        .box-type-orange .box-type-text {
            color: #eb9e40;
        }

        .box-type-ne {
            background-color: #f1f1f1;
            border-left: 4px solid #868686;
        }

        .box-type-ne .progress-bar {
            background-color: #868686;
        }

        .box-type-ne .box-type-text {
            color: #868686;
        }

        .box-type-text {
            font-weight: 600;
        }

        .nav-pills .nav-link.active,
        .nav-pills .show > .nav-link {
            background-color: #682423;
        }

        .dark-mode .small-box {
            color: black;
        }

        .btn-primary {
            background-color: #682423;
            border-color: white;
        }

        .btn-primary:not(:disabled):not(.disabled).active,
        .btn-primary:not(:disabled):not(.disabled):active,
        .show > .btn-primary.dropdown-toggle {
            color: #fff;
            background-color: #682423cf;
            border-color: white;
        }

        .btn-primary.disabled, .btn-primary:disabled {
            color: #fff;
            background-color: #844d4c;
            border-color: #844d4c;
        }

        .btn-primary:hover {
            background-color: #682423;
            border-color: #682423;
        }

        .layout-navbar-fixed .wrapper .sidebar-dark-primary .brand-link:not([class*=navbar]) {
            background-color: #f7f7f7;
        }

        .todo-list > li {
            border-radius: 2px;
            background-color: #1346790d;
            border-left: 4px solid #e9ecef;
            color: #495057;
            margin-bottom: 7px;
            padding: 10px;
        }

        .login-page, .register-page {
            background-color: #dee2e6;
        }

        .login-box, .register-box {
            margin-top: 5px;
        }

        .alto-completo {
            height: 100vh;
        }

        .table.dataTable tbody tr.selected {
            background-color: #13467952 !important;
        }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #1346790d;
        }

        .smallPading td {
            padding: 4px;
        }

        .smallPading td .btn {
            padding: 0.2rem 0.2rem;
            font-size: .800rem;
            border-radius: 0.2rem;
        }

        .smallPading th {
            padding: 4px;
        }

        .custom-control-label::before { }

        .bg-primary {
            background-color: #134679 !important;
        }

        .bg-warning {
            background-color: #ffc107 !important;
        }

        .custom {
            padding-right: 5px;
            padding-left: 5px;
        }

        .content-selected {
            background-color: #f1f2f2;
            padding-right: 10px;
            padding-left: 10px;
        }

        .margin2 {
            margin-bottom: 3px;
        }

        .text-black {
            color: black;
        }

        .callout-success {
            border-radius: 2px;
            background-color: #d4edda;
            border-left: 4px solid #c3e6cb;
            color: #155724;
            margin-bottom: 7px;
            padding: 10px;
        }

        .callout-info {
            border-radius: 2px;
            background-color: #cce5ff;
            border-left: 4px solid #b8daff;
            color: #004085;
            margin-bottom: 7px;
            padding: 10px;
        }

        .callout-danger {
            border-radius: 2px;
            background-color: #f8d7da;
            border-left: 4px solid #f5c6cb;
            color: #721c24;
            margin-bottom: 7px;
            padding: 10px;
        }

        .callout-warning {
            border-radius: 2px;
            background-color: #fff3cd;
            border-left: 4px solid #ffeeba;
            color: #856404;
            margin-bottom: 7px;
            padding: 10px;
        }

        .callout-secondary {
            border-radius: 2px;
            background-color: #e2e3e5;
            border-left: 4px solid #d6d8db;
            color: #383d41;
            margin-bottom: 7px;
            padding: 10px;
        }

        .callout-gray {
            border-radius: 2px;
            background-color: #d6d8db;
            border-left: 4px solid #c6c7c8;
            color: #383d41;
            margin-bottom: 7px;
            padding: 10px;
        }

        .callout-border {
            border-radius: 2px;
            background-color: #1346790d;
            border-left: 4px solid #e9ecef;
            color: #495057;
            margin-bottom: 7px;
            padding: 10px;
        }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="hold-transition sidebar-mini layout-fixed layout-navbar-fixed">
<div class="wrapper">

    <!-- Navbar -->
    <nav class="main-header navbar navbar-expand navbar-dark">
        <!-- Left navbar links -->
