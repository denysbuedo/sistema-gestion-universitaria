            <li class="nav-item menuAmburguesa">
                <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
            </li>
        </ul>

        <!-- Título SGU alineado a la izquierda -->
        <span class="navbar-text sgu-navbar-title">
            Sistema de Gestión Universitaria
        </span>

        <!-- Right navbar links -->
        <ul class="navbar-nav ml-auto">
            <li class="nav-item dropdown">
                <a class="nav-link nbtn" data-toggle="dropdown" href="#">
                    <i class="far fa-bell"></i>
                    <span class="badge badge-warning navbar-badge cantidadNotificacionesBadge">0</span>
                </a>
                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right" id="notificacionesContainer"></div>
            </li>
            <li class="nav-item">
                <a class="nav-link sid" data-widget="control-sidebar" data-slide="true" href="#" role="button">
                    <i class="fas fa-ellipsis-v"></i>
                </a>
            </li>
        </ul>
    </nav>
    <!-- /.navbar -->

    {% block sidebar %}
