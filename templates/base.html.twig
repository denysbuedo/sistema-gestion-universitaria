        </div>
        <ul class="nav nav-pills nav-sidebar flex-column p-2" data-widget="treeview" role="menu"
            data-accordion="false">
            <li class="nav-item">
                <a href="{{ path('app_admin_home') }}" class="nav-link">
                    <i class="nav-icon fas fa-cog"></i>
                    <p>Sistema</p>
                </a>
            </li>

            {% if hasRoles('ROLE_HOME_PERSONAL') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_personal_portada') }}">
                        <i class="fas fa-user" title="Personal"></i>
                        <p>Personal</p>
                    </a>
                </li>
            {% endif %}
            {% if hasRoles('ROLE_HOME_INSTIT') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_institucion_portada') }}">
                        <i class="fa fa-university" title="Instituciones"></i>
                        <p>Instituciones</p>
                    </a>
                </li>
            {% endif %}
            {% if hasRoles('ROLE_HOME_ADMIN') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_administracion_portada') }}">
                        <i class="fas fa-cog" title="Administración"></i>
                        <p>Administración</p>
                    </a>
                </li>
            {% endif %}
            {% if hasRoles('ROLE_HOME_TRAZAS') %}
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_traza_portada') }}">
                        <i class="fa fa-clone" title="Trazas"></i>
                        <p>Trazas</p>
                    </a>
                </li>
            {% endif %}

            <li class="nav-item">
                <a href="{{ path('app_logout') }}" class="nav-link">
                    <i class="nav-icon fas fa-sign-out-alt"></i>
                    <p>Salir</p>
                </a>
