        //     secondText: "Segundos",
        //     dateFormat: 'dd/mm/yy',
        //     closeText:'Hecho',
        //     firstDay: 1,
        //     isRTL: false,
        //     showMonthAfterYear: false,
        //     yearSuffix: ''
        // };
        // $.datepicker.setDefaults($.datepicker.regional['es']);
        // $(function () {
        //     $("#fecha").datepicker();
        // });


        $('select:not(.no-select2)').select2()

        $(function () {
            $('[data-toggle="tooltip"]').tooltip()
        })

        var hasMultipleHeaderRows = $('.dataTable thead tr').length > 1;
        var hasMultipleHeaderRows = $('.dataTable thead tr').length > 1;
        var table = $(".dataTable").DataTable({
            "dom": '<"row"<"col-sm-6 text-left"f ><"col-sm-6 text-right"l>>rt<"row"<"col-sm-12"p>>',
            "pagingType": "full_numbers",
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
            "responsive": true,
            "lengthChange": true,
            "autoWidth": false,
            "scrollX": true,
            "ordering": !hasMultipleHeaderRows,
            buttons: [
                {
                    extend: 'excelHtml5',
                    text: '<i class="fa fa-file-excel"></i> Exportar a Excel',
                    className: 'btn btn-success',
                    filename: function () {
                        var now = new Date();
                        return `reporte_${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}_${String(now.getHours()).padStart(2, '0')}-${String(now.getMinutes()).padStart(2, '0')}-${String(now.getSeconds()).padStart(2, '0')}`;
                    },
                    title: '',
                    exportOptions: {
                        columns: function (idx, data, node) {
                            return $(node).text().trim() !== 'Opciones';
                        },
                        search: 'applied',
                        order: 'applied'
                    },
                    customize: function (xlsx) {
                        var sheet = xlsx.xl.worksheets['sheet1.xml'];
                        var sheetData = $('sheetData', sheet);

                        // Obtener los encabezados y excluir 'Opciones'
                        var colHeaders = [];
                        var excludeIndexes = [];

                        $('.dataTable thead tr:eq(0) th').each(function (index) {
                            var text = $(this).text().trim();
                            if (text !== 'Opciones') {
                                colHeaders.push({text: text, index: index});
                            } else {
                                excludeIndexes.push(index); // columnas a excluir
                            }
                        });

                        // Crear una nueva fila de encabezado
                        var newRow = '<row>';
                        for (var i = 0; i < colHeaders.length; i++) {
                            newRow += '<c t="inlineStr" s="2"><is><t>' + colHeaders[i].text + '</t></is></c>';
                        }
                        newRow += '</row>';

                        // Insertar encabezado nuevo
                        sheetData.prepend(newRow);

                        // Eliminar las celdas de la columna "Opciones" en cada fila (basado en index)
                        $('row', sheet).each(function () {
                            excludeIndexes.forEach(function (colIdx) {
                                $('c', this).eq(colIdx).remove();
                            });
                        });

                        // Agregar negrita
                        var styles = xlsx.xl['styles.xml'];
                        $('fonts', styles).append('<font><b/><sz val="12"/></font>');
                        $('cellXfs', styles).append('<xf fontId="2" applyFont="1"/>');
                    }
                }
            ]
            ,
            language: {
                "sProcessing": "Procesando...",
                "sLengthMenu": "Mostrar _MENU_ registros",
                "sZeroRecords": "No se encontraron resultados",
                "sEmptyTable": "No existen resultados",
                "sInfo": "Registros del _START_ al _END_ de  _TOTAL_ ",
                "sInfoEmpty": "Registros del 0 al 0 de  0 ",
                "sInfoFiltered": "(filtrado de un total de _MAX_ registros)",
                "sSearch": "Buscar:",
                "sLoadingRecords": "Cargando...",
                "oPaginate": {
                    "sFirst": "Primero",
                    "sLast": "Último",
                    "sNext": "Siguiente",
                    "sPrevious": "Anterior"
                }
            }
        });

// Usa el botón de la vista en lugar del que genera DataTables
        $('#exportExcel').on('click', function () {
            table.button('.buttons-excel').trigger();
        });
        // Filtros individuales por columna
        $('.dataTable thead tr:eq(1) th').each(function (i) {
            $('input', this).on('keyup change', function () {
                if (table.column(i).search() !== this.value) {
                    table.column(i).search(this.value).draw();
                }
            });
        });

        // Controla el ordenamiento solo cuando no hay filtros aplicados
        table.on('draw', function () {
            var hasFilter = false;

            table.columns().every(function () {
                if (this.search()) {
                    hasFilter = true;
                }
            });

            if (hasFilter) {
                table.order([]);
            }
        });

        $('#DataTables_Table_0_filter').css('text-align', 'left');
        $('#DataTables_Table_0_filter').children().children().css('width', 500);

        $('div.dataTables_wrapper div.dataTables_filter').css('text-align', 'left');
        $('input[type="search"]').css('width', 500);

        $('.btn-cancel').click(function () {

            let url = $(this).data('url')
