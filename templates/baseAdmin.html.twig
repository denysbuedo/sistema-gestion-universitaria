        body.pregrado-workspace .program-summary { min-width: 0; padding: 20px; border-bottom: 1px solid #dce4ea; background: #f8fafb; overflow: hidden; }
        body.pregrado-workspace .program-summary .pd-grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        body.pregrado-workspace .program-summary .pd-item { min-width: 0; }
        body.pregrado-workspace .program-summary .pd-value { overflow-wrap: anywhere; font-weight: 500; }
        body.pregrado-workspace .program-form-section { margin: 8px 0 20px; padding: 18px; border: 1px solid #dce4ea; background: #f8fafb; }
        body.pregrado-workspace .program-form-section h4 { margin: 0 0 16px; color: #425563; font-size: 14px; font-weight: 500; }
        body.pregrado-workspace .program-action-header { gap: 14px; }
        body.pregrado-workspace .program-action-header .card-title { min-width: 0; }
        body.pregrado-workspace .program-header-actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
        body.pregrado-workspace .program-back-link { display: inline-flex; min-height: 38px; align-items: center; gap: 7px; padding: 8px 13px; border: 1px solid #b8c5cf; border-radius: 4px; background: #fff; color: #425563; font-size: 13px; font-weight: 500; text-decoration: none; white-space: nowrap; }
        body.pregrado-workspace .program-back-link:hover { border-color: #8fa1af; background: #f4f7f9; color: #102f4f; text-decoration: none; }
        body.pregrado-workspace .badge { border-radius: 3px !important; box-shadow: none !important; font-weight: 500 !important; }
        body.pregrado-workspace .badge-info,
        body.pregrado-workspace .badge-primary { border: 1px solid #c9d7e1; background: #eaf1f6 !important; color: #284b66 !important; }
        body.pregrado-workspace .badge-light { border-color: #d7e0e6 !important; background: #f5f7f9 !important; color: #4c5f6e !important; }
        body.pregrado-workspace .pregrado-status { display: inline-flex; align-items: center; gap: 6px; padding: 4px 9px; border: 1px solid #d3dde4; border-radius: 3px; background: #f5f7f9; color: #536776; font-size: 12px; font-weight: 500; white-space: nowrap; }
        body.pregrado-workspace .pregrado-status i { font-size: 7px; }
        body.pregrado-workspace .pregrado-status.is-active { border-color: #bed4cc; background: #edf5f2; color: #315f55; }
        body.pregrado-workspace .pregrado-status.is-inactive { border-color: #dfc9cc; background: #f8f0f1; color: #75434a; }
        body.pregrado-workspace .pregrado-status.is-archived { border-color: #d5d9dd; background: #f1f3f5; color: #59636c; }
        body.pregrado-workspace .dropdown-item i.text-primary,
        body.pregrado-workspace .dropdown-item i.text-warning,
        body.pregrado-workspace .dropdown-item i.text-success { color: #496b86 !important; }
        body.pregrado-workspace .modal-content { border: 1px solid #dce4ea; border-radius: 4px; box-shadow: none; }

        @media (max-width: 767px) {
            body.pregrado-workspace .content > .container-fluid { padding: 12px; }
            body.pregrado-workspace .card-header { align-items: flex-start !important; gap: 12px; }
            body.pregrado-workspace .card-body { padding: 14px !important; overflow-x: auto; }
            body.pregrado-workspace .fs-actions { flex-wrap: wrap; }
            body.pregrado-workspace .program-summary .pd-grid-3 { grid-template-columns: 1fr; }
            body.pregrado-workspace .program-action-header { flex-direction: column; align-items: stretch !important; }
            body.pregrado-workspace .program-header-actions { width: 100%; margin-left: 0; flex-wrap: wrap; }
        }

