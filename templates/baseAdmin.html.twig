                        className: 'btn-primary'
                    },
                    cancel: {
                        label: '<i class="fa fa-times"></i> Cancelar',
                        className: 'btn-danger'
                    }
                },
                callback: function (result) {
                    if (result) {
                        window.location.href = url
                    }
                }
            });
        })
        $(document).on('click', '.elementRemoveTexarea', function () {
            let url = $(this).data('url');
            let urlRedirect = $(this).data('url_redirect');
            let title = $(this).data('title');
            console.log(urlRedirect);
            bootbox.confirm({
                message: `<p>¿Está seguro que desea realizar la acción?</p>
                  <div class="form-group">
                      <label for="additionalFile">${title ? title : ''}:</label>
                      <input type="file" class="form-control" id="additionalFile" name="additionalFile">
                  </div>`,
                buttons: {
                    confirm: {
                        label: '<i class="fa fa-check"></i> Confirmar',
                        className: 'btn-primary'
                    },
                    cancel: {
                        label: '<i class="fa fa-times"></i> Cancelar',
                        className: 'btn-danger'
                    }
                },
                callback: function (result) {
                    if (result) {
                        let fileInput = $('#additionalFile')[0];
                        let file = fileInput.files[0]; // Obtener el archivo seleccionado

                        if (!file) {
                            bootbox.alert("Seleccionar un archivo es obligatorio.");
                            return false;
                        }

                        // Debido a las limitaciones de GET, no podemos enviar el archivo de esta manera.
                        // Lo que sigue es un ejemplo de cómo enviar el archivo por POST utilizando FormData.

                        let formData = new FormData();
                        formData.append('additionalFile', file);

                        $.ajax({
                            type: 'POST', // Cambiado a POST ya que GET no es adecuado para archivos
                            url: url,
                            data: formData,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                console.log(urlRedirect);
                                window.location.href = urlRedirect; // Redirigir si es necesario
                            },
                            error: function (error) {
                                console.log('Error:', error);
                            }
                        });
                    }
                }
            });
        });

        // Abrir modal y configurar URLs dinámicas
        $(document).on('click', '.elementSignature', function () {
            let url = $(this).data('url');
            let downloadUrl = $(this).data('download');

            $('#downloadDocument').attr('href', downloadUrl);
            $('#signatureFile').val(''); // limpiar input

            $('#signatureModal').modal('show');

            $('#confirmSignature').off('click').on('click', function () {
                let fileInput = $('#signatureFile')[0].files[0];
                if (!fileInput) {
                    toastr.error("Debe adjuntar un documento antes de confirmar.");
                    return;
                }

                let $btn = $(this);
                $btn.prop('disabled', true).html('<i class="fa fa-spinner fa-spin"></i> Enviando...');

                let formData = new FormData();
                formData.append("file", fileInput);

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function () {
                        $('#signatureModal').modal('hide');
                        toastr.success("Documento firmado correctamente.");
                        location.reload();
                    },
                    error: function () {
                        toastr.error("Error al enviar el documento.");
                        $btn.prop('disabled', false).html('<i class="fa fa-check"></i> Confirmar');
                    }
                });
            });

            $('#cancelSignature').click(function (e){
                $('#signatureModal').modal('hide');
            })
        });




