<script>

    // Los menús de acciones de las tablas se sacan temporalmente de su celda para
    // evitar que DataTables los recorte. Conservamos su propietario para poder
    // devolverlos al cerrar y usamos coordenadas del viewport por ser position:fixed.
    $(document).on('shown.bs.dropdown.sguTableActions', 'table .dropdown', function () {
        var $dropdown = $(this);
        var $button = $dropdown.find('[data-toggle="dropdown"]').first();
        var $menu = $('body > .dropdown-menu.show').last();

        if (!$menu.length || !$button.length) {
            return;
        }

        var rect = $button[0].getBoundingClientRect();
        $dropdown.data('sgu-detached-menu', $menu);
        $menu.data('sgu-dropdown-owner', $dropdown).css({
            position: 'fixed',
            top: rect.bottom + 2,
            left: 'auto',
            right: Math.max(8, window.innerWidth - rect.right),
            display: 'block',
            zIndex: 9999
        });
    });

    $(document).on('hide.bs.dropdown.sguTableActions', 'table .dropdown', function () {
        var $dropdown = $(this);
        var $menu = $dropdown.data('sgu-detached-menu');

        if ($menu && $menu.length) {
            $menu.appendTo($dropdown).css({
                position: '',
                top: '',
                left: '',
                right: '',
                display: '',
                zIndex: ''
            }).removeData('sgu-dropdown-owner');
            $dropdown.removeData('sgu-detached-menu');
        }
    });

    function closeOpenTableActionMenus() {
        $('table .dropdown.show').each(function () {
            $(this).find('[data-toggle="dropdown"]').first().dropdown('hide');
        });
    }

    // Un menú separado de la tabla no debe permanecer abierto cuando su fila se
    // desplaza. Capturamos también el scroll de contenedores internos de DataTables.
    window.addEventListener('scroll', closeOpenTableActionMenus, { passive: true });
    document.addEventListener('scroll', function (event) {
        if (event.target !== document) {
            closeOpenTableActionMenus();
        }
    }, true);
    $(window).on('resize.sguTableActions', closeOpenTableActionMenus);

    $(document).ready(function () {
