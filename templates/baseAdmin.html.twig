            }
        });

    })

    // Acordeón del menú: este manejador se ejecuta antes que AdminLTE para evitar dobles toggles.
    document.addEventListener('click', function (event) {
        var link = event.target.closest('[data-widget="treeview"] .nav-link');
        if (!link) return;

        var parent = link.closest('.nav-item');
        var treeview = parent ? parent.querySelector(':scope > .nav-treeview') : null;
        if (!treeview) return;

        event.preventDefault();
        event.stopImmediatePropagation();

        var root = link.closest('[data-widget="treeview"]');
        var wasOpen = parent.classList.contains('menu-open');

        root.querySelectorAll('.nav-item.menu-open').forEach(function (item) {
            if (item === parent) return;
            item.classList.remove('menu-open', 'menu-is-opening');
            var submenu = item.querySelector(':scope > .nav-treeview');
            var trigger = item.querySelector(':scope > .nav-link');
            if (submenu) submenu.style.display = 'none';
            if (trigger) trigger.setAttribute('aria-expanded', 'false');
        });

        parent.classList.toggle('menu-open', !wasOpen);
        parent.classList.remove('menu-is-opening');
        treeview.style.display = wasOpen ? 'none' : 'block';
        link.setAttribute('aria-expanded', wasOpen ? 'false' : 'true');
    }, true);

    // Obtener todas las filas de la tabla
    const rows = document.querySelectorAll('.table tbody tr');

    // Iterar sobre las filas y agregar un evento de clic
    rows.forEach(row => {
        row.addEventListener('click', function () {
            // Remover la clase 'selected' de todas las filas
            rows.forEach(r => r.classList.remove('selected'));

            // Añadir la clase 'selected' a la fila clickeada
            this.classList.add('selected');
        });
    });
</script>

