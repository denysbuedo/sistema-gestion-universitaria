        .ms-status {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #4a5568;
            background: linear-gradient(to right, rgba(0, 0, 0, 0.05), transparent);
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-left: 3.5px solid #cbd5e0;
            font-size: 11px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 4px;
            min-width: 125px;
            justify-content: flex-start;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }

        .ms-status::before {
            font-family: "Font Awesome 5 Free";
            font-weight: 900;
            font-size: 13px;
            flex-shrink: 0;
            opacity: 0.85;
        }

        .ms-status:hover {
            transform: translateX(4px);
            background: linear-gradient(to right, rgba(0, 0, 0, 0.08), transparent);
            box-shadow: 4px 4px 15px rgba(0,0,0,0.05);
        }

        .ms-status.-active {
            color: #047857;
            background: linear-gradient(to right, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.02));
            border-color: rgba(16, 185, 129, 0.2);
            border-left-color: #10b981;
        }
        .ms-status.-active::before { content: "\f058"; }

        .control-sidebar {
            /*bottom: calc(3.5rem + 1px);*/
            position: absolute;
            /*top: calc(3.5rem + 1px);*/
            bottom: 0;
            top: 0;
            z-index: 1035;
            background-color: #102f4f;
        }

        .control-sidebar, .control-sidebar::before {
            width: 280px !important;
        }

        .ms-status.-warning {
            color: #b45309;
            background: linear-gradient(to right, rgba(245, 158, 11, 0.15), rgba(245, 158, 11, 0.02));
            border-color: rgba(245, 158, 11, 0.2);
            border-left-color: #f59e0b;
        }
        .ms-status.-warning::before { content: "\f06a"; }

        .ms-status.-info {
            color: #1d4ed8;
            background: linear-gradient(to right, rgba(59, 130, 246, 0.15), rgba(59, 130, 246, 0.02));
            border-color: rgba(59, 130, 246, 0.2);
            border-left-color: #3b82f6;
        }
        .ms-status.-info::before { content: "\f05a"; }

        /* Estilo para Deshabilitado / Peligro (Default) */
        .ms-status:not(.-active):not(.-warning):not(.-info) {
            color: #b91c1c;
            background: linear-gradient(to right, rgba(239, 68, 68, 0.15), rgba(239, 68, 68, 0.02));
            border-color: rgba(239, 68, 68, 0.2);
            border-left-color: #ef4444;
        }
        .ms-status:not(.-active):not(.-warning):not(.-info)::before { content: "\f057"; }

