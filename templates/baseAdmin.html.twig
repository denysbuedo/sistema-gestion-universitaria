        /* ── Modal de confirmación (bootbox) ── */
        .bootbox .modal-content {
            border: none;
            border-radius: 14px;
            box-shadow: 0 20px 60px rgba(0,0,0,.18);
            overflow: hidden;
        }
        .bootbox .modal-header {
            border: none;
            padding: 0;
            margin: 0;
            min-height: 0;
            background: transparent;
        }
        .bootbox .modal-header .modal-title { display: none; }
        
        /* El botón de cerrar puede estar en el header o en el body dependiendo de si bootbox recibe un title */
        .bootbox .close {
            position: absolute !important;
            top: 16px !important;
            right: 20px !important;
            z-index: 100 !important;
            color: #4a5568 !important;
            text-shadow: none !important;
            opacity: 0.45 !important;
            font-size: 1.5rem !important;
            margin: 0 !important;
            padding: 0 !important;
            line-height: 1 !important;
            float: none !important;
        }
        .bootbox .close:hover { opacity: 0.85 !important; }
        .bootbox .modal-body {
            padding: 44px 28px 20px;
            text-align: center;
        }
        .bootbox .modal-body::before {
            content: '\f059';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            display: block;
            font-size: 2.4rem;
            color: #134679;
            margin-bottom: 14px;
            opacity: .85;
        }
        .bootbox .bootbox-body {
            font-size: .95rem;
            color: #2d3748;
            font-weight: 500;
            line-height: 1.5;
        }
        .bootbox .modal-footer {
            border-top: 1px solid #f0f4f8;
            padding: 14px 20px 18px;
            display: flex;
            justify-content: center;
            gap: 10px;
            background: #f8fafc;
            border-radius: 0 0 14px 14px;
        }
        .bootbox .modal-footer .btn {
            border-radius: 8px;
            padding: 8px 26px;
            font-weight: 600;
            font-size: .875rem;
            min-width: 110px;
            border: none;
            transition: opacity .15s, box-shadow .15s;
        }
        .bootbox .modal-footer .btn-primary {
            background: #134679;
            color: #fff;
            box-shadow: 0 3px 10px rgba(19,70,121,.25);
        }
        .bootbox .modal-footer .btn-primary:hover { opacity: .9; }
        .bootbox .modal-footer .btn-danger {
            background: #fff;
            color: #4a5568;
            border: 1.5px solid #e2e8f0 !important;
            box-shadow: none;
        }
        .bootbox .modal-footer .btn-danger:hover { background: #f7fafc; }

