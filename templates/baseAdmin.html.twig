        }

        /*[class*=sidebar-dark-] .nav-treeview > .nav-item > .nav-link.active, [class*=sidebar-dark-] .nav-treeview > .nav-item > .nav-link.active:focus, [class*=sidebar-dark-] .nav-treeview > .nav-item > .nav-link.active:hover {*/
        /*    background-color: #144e86e0;*/
        /*    color: #ffffff;*/
        /*}*/

        .navbar-light .navbar-nav .active > .nav-link, .navbar-light .navbar-nav .nav-link.active, .navbar-light .navbar-nav .nav-link.show, .navbar-light .navbar-nav .show > .nav-link {
            color: rgb(255 255 255);
            background-color: #0e375f;
            border-radius: 0.25rem;
        }

        [class*=sidebar-dark] .brand-link {
            border-bottom: 1px solid #134679;
        }

        /* Eliminado duplicado de user-panel aquí para usar el diseño minimalista de abajo */

        .layout-navbar-fixed .wrapper .sidebar-dark-primary .brand-link:not([class*=navbar]) {
            background-color: #0e375f;
        }

        .table-custom-header {
            background-color: #134679;
            color: white;
        }

        .table thead th {
            vertical-align: bottom;
            border-bottom: 0;
        }

        .table-bordered td, .table-bordered th {
            border: 1px solid #13467912;
        }

        .btn-primary {
            color: #fff;
            background-color: #134679;
            border-color: #134679;
            box-shadow: none;
        }

        .ms-status {
            position: relative;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #4a5568;
            background: linear-gradient(to right, rgba(0, 0, 0, 0.05), transparent);
            border: 1px solid rgba(0, 0, 0, 0.08);
            border-left: 3.5px solid #cbd5e0;
            font-size: 11px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 4px;
            min-width: 125px;
            justify-content: flex-start;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 1px 2px rgba(0,0,0,0.02);
        }

        .ms-status::before {
            font-family: "Font Awesome 5 Free";
            font-weight: 900;
            font-size: 13px;
            flex-shrink: 0;
            opacity: 0.85;
        }

        .ms-status:hover {
            transform: translateX(4px);
            background: linear-gradient(to right, rgba(0, 0, 0, 0.08), transparent);
            box-shadow: 4px 4px 15px rgba(0,0,0,0.05);
        }

        .ms-status.-active {
            color: #047857;
            background: linear-gradient(to right, rgba(16, 185, 129, 0.15), rgba(16, 185, 129, 0.02));
            border-color: rgba(16, 185, 129, 0.2);
            border-left-color: #10b981;
        }
        .ms-status.-active::before { content: "\f058"; }

        .control-sidebar {
            /*bottom: calc(3.5rem + 1px);*/
            position: absolute;
            /*top: calc(3.5rem + 1px);*/
            bottom: 0;
            top: 0;
            z-index: 1035;
            background-color: #eceaf8;
        }

        .control-sidebar, .control-sidebar::before {
            width: 280px !important;
        }

        .ms-status.-warning {
            color: #b45309;
            background: linear-gradient(to right, rgba(245, 158, 11, 0.15), rgba(245, 158, 11, 0.02));
            border-color: rgba(245, 158, 11, 0.2);
            border-left-color: #f59e0b;
        }
        .ms-status.-warning::before { content: "\f06a"; }

        .ms-status.-info {
            color: #1d4ed8;
            background: linear-gradient(to right, rgba(59, 130, 246, 0.15), rgba(59, 130, 246, 0.02));
            border-color: rgba(59, 130, 246, 0.2);
            border-left-color: #3b82f6;
        }
        .ms-status.-info::before { content: "\f05a"; }

        /* Estilo para Deshabilitado / Peligro (Default) */
        .ms-status:not(.-active):not(.-warning):not(.-info) {
            color: #b91c1c;
            background: linear-gradient(to right, rgba(239, 68, 68, 0.15), rgba(239, 68, 68, 0.02));
            border-color: rgba(239, 68, 68, 0.2);
            border-left-color: #ef4444;
        }
        .ms-status:not(.-active):not(.-warning):not(.-info)::before { content: "\f057"; }

        .select2 {
            width: 100% !important;
        }

        .todo-list > li {
            border-radius: 2px;
            background-color: #1346790d;
            border-left: 4px solid #e9ecef;
            color: #495057;
            margin-bottom: 7px;
            padding: 10px;
        }

        /* ── Modal de confirmación (bootbox) ── */
        .bootbox .modal-content {
            border: none;
            border-radius: 14px;
            box-shadow: 0 20px 60px rgba(0,0,0,.18);
            overflow: hidden;
        }
        .bootbox .modal-header {
            border: none;
            padding: 0;
            margin: 0;
            min-height: 0;
            background: transparent;
        }
        .bootbox .modal-header .modal-title { display: none; }
        
        /* El botón de cerrar puede estar en el header o en el body dependiendo de si bootbox recibe un title */
        .bootbox .close {
            position: absolute !important;
            top: 16px !important;
            right: 20px !important;
            z-index: 100 !important;
            color: #4a5568 !important;
            text-shadow: none !important;
            opacity: 0.45 !important;
            font-size: 1.5rem !important;
            margin: 0 !important;
            padding: 0 !important;
            line-height: 1 !important;
            float: none !important;
        }
        .bootbox .close:hover { opacity: 0.85 !important; }
        .bootbox .modal-body {
            padding: 44px 28px 20px;
            text-align: center;
        }
        .bootbox .modal-body::before {
            content: '\f059';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            display: block;
            font-size: 2.4rem;
            color: #134679;
            margin-bottom: 14px;
            opacity: .85;
        }
        .bootbox .bootbox-body {
            font-size: .95rem;
            color: #2d3748;
            font-weight: 500;
            line-height: 1.5;
        }
        .bootbox .modal-footer {
            border-top: 1px solid #f0f4f8;
            padding: 14px 20px 18px;
            display: flex;
            justify-content: center;
            gap: 10px;
            background: #f8fafc;
            border-radius: 0 0 14px 14px;
        }
        .bootbox .modal-footer .btn {
            border-radius: 8px;
            padding: 8px 26px;
            font-weight: 600;
            font-size: .875rem;
            min-width: 110px;
            border: none;
            transition: opacity .15s, box-shadow .15s;
        }
        .bootbox .modal-footer .btn-primary {
            background: #134679;
            color: #fff;
            box-shadow: 0 3px 10px rgba(19,70,121,.25);
        }
        .bootbox .modal-footer .btn-primary:hover { opacity: .9; }
        .bootbox .modal-footer .btn-danger {
            background: #fff;
            color: #4a5568;
            border: 1.5px solid #e2e8f0 !important;
            box-shadow: none;
        }
        .bootbox .modal-footer .btn-danger:hover { background: #f7fafc; }

        .aside-header {
            background-color: #0E375F;
        }

        .aside-header > img {
            width: 20%;
            margin-bottom: 3%;
        }

        .aside-header > i {
            color: white;
            position: absolute;
            right: 16px;
            top: 12px;
        }

        .responsive-input {
            width: 100%; /* Asegura que el input ocupe el 100% del espacio disponible */
            padding: 8px; /* Ajusta el padding para una mejor usabilidad en dispositivos móviles */
            box-sizing: border-box; /* Incluye el padding y el borde en el cálculo del ancho */
            font-size: 14px; /* Ajusta el tamaño de la fuente */
            border: 1px solid #ccc; /* Estilo del borde */
            border-radius: 4px; /* Bordes redondeados */
        }

        .responsive-col {
            width: 15%; /* Ancho fijo en pantallas grandes */
            text-align: center; /* Alineación centrada del texto */
        }

        @media (max-width: 768px) {
            .responsive-col {
                width: 100%; /* En pantallas pequeñas, ocupa todo el ancho */
            }
        }

        /* Consolidación de diseño en bloque único abajo */

        /* ============================================================
           PANEL DE USUARIO — Diseño Horizontal Minimalista
           Puro, profesional, limpio, alineado a la izquierda.
           ============================================================ */
        [class*=sidebar-dark] .user-panel {
            padding: 20px 16px;
            margin: 0 !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;
            display: flex !important;
            align-items: center;
            background-color: transparent;
        }

        .up-avatar-wrapper {
            position: relative;
            flex-shrink: 0;
        }

        .up-avatar {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            object-fit: cover;
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
            /* Borde ultra sutil para separar el avatar oscuro del fondo oscuro */
            border: 1px solid rgba(255,255,255,0.15); 
            display: block;
        }

        .up-status {
            position: absolute;
            bottom: 1px;
            right: 0px;
            width: 11px;
            height: 11px;
            background-color: #10b981; /* Verde esmeralda elegante */
            border: 2px solid var(--m-sidebar); /* Mismo color del fondo del sidebar */
            border-radius: 50%;
        }

        .up-info {
            margin-left: 14px;
            overflow: hidden;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .up-name {
            color: #ffffff;
            font-size: 0.92rem;
            font-weight: 600;
            margin: 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.2;
            letter-spacing: 0.2px;
        }

        .up-email {
            color: rgba(255, 255, 255, 0.55);
            font-size: 0.76rem;
            font-weight: 400;
            margin: 3px 0 0 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.2;
        }

        /* Navegación institucional */
        .main-sidebar.sidebar-dark-primary { background: #102f4f; box-shadow: none !important; }
        .main-sidebar .brand-link,
        .layout-navbar-fixed .wrapper .sidebar-dark-primary .brand-link:not([class*=navbar]) {
            display: flex; height: 64px; align-items: center; gap: 11px; padding: 0 18px;
            border-bottom: 1px solid rgba(255,255,255,.12); background: #102f4f; color: #fff;
        }
        .sgu-brand-mark {
            display: inline-flex; width: 32px; height: 32px; flex: 0 0 32px; align-items: center;
            justify-content: center; border: 1px solid rgba(255,255,255,.3); font-size: 13px;
        }
        .sgu-brand-name { display: block; font-size: 15px; font-weight: 500; line-height: 1.1; letter-spacing: .04em; }
        .sgu-brand-system { display: block; margin-top: 3px; color: rgba(255,255,255,.58); font-size: 10px; font-weight: 400; letter-spacing: .06em; text-transform: uppercase; }
        .main-sidebar .sidebar { padding: 0 0 18px; }
        [class*=sidebar-dark] .user-panel { padding: 16px 18px; }
        .up-avatar { width: 40px; height: 40px; box-shadow: none; }
        .up-status { background: #fff; border-color: #102f4f; }
        .up-name { font-size: .86rem; font-weight: 500; }
        .main-sidebar .nav-sidebar { padding: 10px 0; }
        .main-sidebar .nav-sidebar > .nav-item > .nav-link {
            width: auto; min-height: 44px; margin: 2px 10px; padding: 11px 12px; border-radius: 3px;
            color: rgba(255,255,255,.78); font-size: 14px; font-weight: 400;
        }
        .main-sidebar .nav-sidebar > .nav-item > .nav-link:hover,
        .main-sidebar .nav-sidebar > .nav-item.menu-open > .nav-link,
        .sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link.active {
            background: rgba(255,255,255,.09); color: #fff; box-shadow: none;
        }
        .main-sidebar .nav-sidebar .nav-icon { width: 22px; margin-right: 8px; color: rgba(255,255,255,.65); font-size: 14px; }
        [class*=sidebar-dark] .nav-legacy.nav-sidebar > .nav-item .nav-treeview,
        [class*=sidebar-dark] .nav-legacy.nav-sidebar > .nav-item > .nav-treeview { background: transparent; }
        .main-sidebar .nav-treeview > .nav-item > .nav-link {
            width: auto; margin: 1px 10px; padding: 9px 12px 9px 43px; border-radius: 3px;
            color: rgba(255,255,255,.62); font-size: 13px; font-weight: 400;
        }
        .main-sidebar .nav-treeview > .nav-item > .nav-link:hover,
        .main-sidebar .nav-treeview > .nav-item > .nav-link.active { background: rgba(255,255,255,.07); color: #fff; }

            </style>

