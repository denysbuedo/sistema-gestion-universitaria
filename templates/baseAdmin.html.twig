    <!-- Theme style -->
    <style>
        .table td, .table th {
            text-align: left; /* Alinea el texto a la izquierda */
            vertical-align: middle; /* Centra verticalmente */
        }

        .table tbody tr:hover {
            background-color: #d3d3d3; /* Cambia el color de fondo al pasar el mouse */
        }

        .table tbody tr.selected {
            background-color: #e0e0e0; /* Gris claro, puedes cambiarlo a cualquier color */
        }

        .table td {
            padding-top: 1%
        }

        label span.invalid-feedback {
            display: none !important;
        }

        label.required:after {
            content: "*";
            color: red;
        }

        label {
            margin-bottom: 2px !important;
        }

        [class*=sidebar-dark-] {
            background-color: #0e375f;
        }

        .sidebar-dark-primary .nav-sidebar > .nav-item > .nav-link.active, .sidebar-light-primary .nav-sidebar > .nav-item > .nav-link.active {

            background-color: rgb(20 76 130 / 74%);
            color: #fff;
        }

        [class*=sidebar-dark] .nav-legacy.nav-sidebar > .nav-item .nav-treeview, [class*=sidebar-dark] .nav-legacy.nav-sidebar > .nav-item > .nav-treeview {
            background-color: rgb(26 65 103);
        }

        .nav-link {
