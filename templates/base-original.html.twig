<script>


    $(document).ready(function () {
        $(".dataTable").DataTable({
            "responsive": true, "lengthChange": false, "autoWidth": false
        });

        $('select').select2()

        $(function () {
            $('[data-toggle="tooltip"]').tooltip()
        })


        $('.content-wrapper,.main-sidebar').on('click', function () {
            if ($('.control-sidebar').css('display') == 'block') {
                $('.sid').click();
            }

        })

        $(".nav-link-menu").toArray().forEach(e => {
            let href = $(e).attr('href')
            if ('{{ app.request.pathinfo }}'.includes(href)) {
                $($(e)).addClass('active')
                if ($($(e).parent().parent()).hasClass('nav-treeview')) {
                    $($(e).parent().parent().parent()).addClass('menu-open')
                    $($(e).parent().parent().parent().children()).addClass('active')
                }
            }
        })

        function loadNotifications() {

            //Load Notificaciones
            $.ajax({
                type: "POST",
                cache: false,
                url: "{{ path('app_notificaciones_usuario') }}",
                dataType: "html",
                success: function (res) {

                    $('#notificacionesContainer').html(res)
                    $('.cantidadNotificacionesBadge').text($('.cantidadContainer').text())

                },
                error: function (err) {

                    toastr.error(err);
                }
            });
        }

        loadNotifications();

        setInterval(function () {
            loadNotifications()
        }, 60000)

        $(document).on('click', '.notificationRemove', function (e) {
            e.preventDefault()

            setTimeout(function () {
                $('.nbtn').click()

            }, 1)

            $.ajax({
                type: "GET",
                cache: false,
                url: $(this).data('url'),
                dataType: "html",
                success: function (res) {
                    // $('.nd').addClass('show')
                    loadNotifications()
                    $(".tooltip").tooltip("hide");

                },
                error: function (err) {

                    toastr.error(err);
                }
            });
        })


        $('li.dropdown button').on('click', function (event) {
            $(this).parent().toggleClass('open');
        });


    })

    $(document).on('click', '.elementRemove', function () {

        let url = $(this).data('url')
        bootbox.confirm({
            message: "¿Está seguro que desea realizar la acción?",
            buttons: {
                confirm: {
                    label: '<i class="fa fa-check"></i> Confirmar',
                    className: 'btn-primary'
                },
                cancel: {
                    label: '<i class="fa fa-times"></i> Cancelar',
                    className: 'btn-danger'
                }
            },
            callback: function (result) {
                if (result) {
                    window.location.href = url;
                }
            }
        });
    })

    $(document).on('click', '.filter-dash-buttom', function () {

        $('#filterDashboard').modal('show')
    })


    $('#planUserBase').change(function () {
        let url = "{{ path('app_change_filter_plan_user', {'id':'id_r'}) }}";
        url = url.replace('id_r', $(this).val());

        HoldOn.open({
            theme: "sk-bounce",
            message: 'Por favor espere...',
            textColor: "white"
        });

        $.ajax({
            type: "POST",
            cache: false,
            url: url,
            dataType: "json",

            success: function (res) {

                window.location.href = '{{ path('app_dash_board') }}'

            },
            error: function (err) {

                toastr.error(err);
                HoldOn.close()
            }
        });
    })

    $(document).on('hidden.bs.modal', function (event) {
        if ($('.modal:visible').length) {
            $('body').addClass('modal-open');
        }
    });

    let details = navigator.userAgent;

    /* Creating a regular expression
    containing some mobile devices keywords
    to search it in details string*/
    let regexp = /android|iphone|kindle|ipad/i;

    /* Using test() method to search regexp in details
    it returns boolean value*/
    let isMobileDevice = regexp.test(details);

    if (isMobileDevice) {

        if (getOrientation() === 'Landscape') {

            $('.movile').addClass('d-none')
        } else {
            $('.movile').removeClass('d-none')
        }

    }

    window.addEventListener("orientationchange", () => {

        if (getOrientation() === 'Landscape') {
            $('.movile').removeClass('d-none')
        } else {
            $('.movile').addClass('d-none')
        }
    });

    function getOrientation() {
        if (window.matchMedia("(orientation: portrait)").matches) {
            var current_mode = 'Portrait';
        } else if (window.matchMedia("(orientation: landscape)").matches) {
            var current_mode = 'Landscape';
        } else {
            var current_mode = window.innerWidth < window.innerHeight ? "Portrait" : "Landscape";
        }
        return current_mode
    };


</script>
