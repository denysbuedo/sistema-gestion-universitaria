{% extends 'baseAdmin.html.twig' %}

{% block title %}Obsequios{% endblock %}

{% block body %}
<style>
    .card-luxury {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border-top: 4px solid #134679;
        margin-bottom: 1.5rem;
    }
    .card-luxury .card-header {
        background-color: #fff;
        border-bottom: 1px solid #f1f5f9;
        padding: 15px 24px;
    }
    .card-luxury .card-title { color: #1a2e44; font-weight: 700; font-size: 1rem; margin: 0; }
    .label-icon { color: #134679; margin-right: 6px; opacity: 0.8; }

    /* ── Compact Buttons ── */
    .btn-lux-sm {
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.75rem;
        transition: all 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
    }
    .btn-lux-primary { background: #134679; color: #fff !important; }
    .btn-lux-primary:hover { background: #0f3560; }
    
    .table-custom-header {
        background-color: #f8fafc !important;
        color: #475569 !important;
        font-size: 0.8rem;
        letter-spacing: 0.02em;
        font-weight: 700;
    }
    .table td { vertical-align: middle; font-size: 0.85rem; }
</style>

    {% include 'pages/modalDetail.html.twig' %}

    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title text-bold m-0"><i class="fas fa-gift label-icon"></i>Listado de obsequios</h3>
            <a title="Nuevo" class="btn-lux-sm btn-lux-primary ml-auto" href="{{ path('app_obsequio_registrar') }}">
                <i class="fas fa-plus"></i> Nuevo
            </a>
        </div>
        
        <div class="card-body px-4">
            <div class="table-responsive">
                <table class="table table-hover table-striped dataTable mb-0">
                    <thead class="table-custom-header">
                    <tr>
                        <th class="px-4">No.</th>
                        <th>Nombre</th>
                        <th>Marca</th>
                        <th>Modelo</th>
                        <th>Color</th>
                        <th>Talla</th>
                        <th>Presentación</th>
                        <th>Tipo</th>
                        <th>Género</th>
                        <th class="text-center">Estado</th>
                        <th class="text-center px-4">Opciones</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for item in registros %}
                        <tr>
                            <td class="px-4" width="1%">{{ loop.index }}</td>
                            <td class="font-weight-bold">{{ item.nombre | default('-') }}</td>
                            <td>{{ item.marca | default('-') }}</td>
                            <td>{{ item.modelo | default('-') }}</td>
                            <td>{{ item.color | default('-') }}</td>
                            <td>{{ item.talla | default('-') }}</td>
                            <td>{{ item.presentacion | default('-') }}</td>
                            <td>{{ item.tipo | default('-') }}</td>
                            <td>{{ item.genero | default('-') }}</td>
                            <td width="15%" class="text-center">
                                {% if '1' == item.activo %}
                                    <span style="display:inline-block;padding:3px 10px;border-radius:20px;font-size:0.72rem;font-weight:700;background:#dcfce7;color:#15803d;letter-spacing:.3px;"><i class="fas fa-circle" style="font-size:0.45rem;vertical-align:middle;margin-right:4px;"></i>Habilitado</span>
                                {% else %}
                                    <span style="display:inline-block;padding:3px 10px;border-radius:20px;font-size:0.72rem;font-weight:700;background:#fee2e2;color:#b91c1c;letter-spacing:.3px;"><i class="fas fa-circle" style="font-size:0.45rem;vertical-align:middle;margin-right:4px;"></i>Deshabilitado</span>
                                {% endif %}
                            </td>
                            <td class="text-center px-4">
                                <div class="dropdown d-flex justify-content-center">
                                    <button class="btn btn-sm btn-light rounded-circle shadow-sm border-0 p-0 d-flex align-items-center justify-content-center"
                                            style="width:32px;height:32px;background:#f1f5f9;color:#64748b;font-size:1rem;line-height:1;"
                                            type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        &#8942;
                                    </button>
                                    <div class="dropdown-menu dropdown-menu-right shadow-sm" style="border-radius:10px;border:none;min-width:180px;padding:6px 0;font-size:0.85rem;">
                                        <button class="dropdown-item modalDetailAction" style="padding:8px 16px;"
                                                data-url="{{ path('app_obsequio_detail', {'id': item.id}) }}"
                                                data-title="Detalles del obsequio">
                                            <i class="fa fa-eye fa-fw mr-2 text-primary"></i> Ver detalles
                                        </button>
                                        <a class="dropdown-item" style="padding:8px 16px;" href="{{ path('app_obsequio_modificar', {'id': item.id}) }}">
                                            <i class="fa fa-edit fa-fw mr-2 text-warning"></i> Modificar
                                        </a>
                                        <div class="dropdown-divider my-1"></div>
                                        <button class="dropdown-item elementRemove text-danger" style="padding:8px 16px;"
                                                data-url="{{ path('app_obsequio_eliminar', {'id': item.id}) }}">
                                            <i class="fa fa-trash fa-fw mr-2"></i> Eliminar
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function () {
            $(document).on('show.bs.dropdown', 'table .dropdown', function () {
                var $btn  = $(this).find('button[data-toggle="dropdown"]');
                var $menu = $(this).find('.dropdown-menu');
                var offset = $btn.offset();
                $menu.appendTo('body').css({
                    position: 'fixed',
                    top:   offset.top + $btn.outerHeight() + 2,
                    left:  'auto',
                    right: $(window).width() - offset.left - $btn.outerWidth(),
                    display: 'block',
                    zIndex: 9999
                });
            });
            $(document).on('hide.bs.dropdown', 'table .dropdown', function () {
                var $menu = $(this).find('.dropdown-menu');
                if ($menu.parent().is('body')) {
                    $menu.appendTo($(this)).css({ position: '', top: '', left: '', right: '', zIndex: '' });
                }
            });
        });
    </script>
{% endblock %}