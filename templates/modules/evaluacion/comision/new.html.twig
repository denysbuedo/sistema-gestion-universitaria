{% extends 'baseAdmin.html.twig' %}

{% block title %}Adicionar comisión evaluadora{% endblock %}

{% block body %}

<style>
        .card-luxury { border-radius:12px; border:none; box-shadow:0 4px 20px rgba(0,0,0,0.08); border-top:4px solid #134679; margin-bottom:1.5rem; }
        .card-luxury .card-header { background-color:#fff; border-bottom:1px solid #f1f5f9; padding:15px 24px; }
        .card-luxury .card-title { color:#1a2e44; font-weight:700; font-size:1rem; margin:0; float:none !important; }
        .label-icon { color:#134679; margin-right:6px; opacity:0.8; }
        .fs-label { font-size:0.82rem; font-weight:600; color:#4b5563; margin-bottom:6px; display:block; }
        .btn-fs-submit { background:#134679; color:#fff !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; cursor:pointer; }
        .btn-fs-submit:hover { background:#0f3560; transform:translateY(-1px); box-shadow:0 4px 12px rgba(19,70,121,0.2); }
        .btn-fs-cancel { background:#f1f5f9; color:#475569 !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; text-decoration:none; cursor:pointer; }
        .btn-fs-cancel:hover { background:#e2e8f0; color:#1e293b !important; transform:translateY(-1px); }
        .btn-lux-sm { padding:6px 14px; border-radius:6px; font-weight:700; font-size:0.75rem; border:none; display:inline-flex; align-items:center; gap:5px; text-transform:uppercase; transition:all 0.2s; text-decoration:none; color:#fff; cursor:pointer; }
        .btn-lux-primary { background:#134679; color:#fff; }
        .btn-lux-primary:hover { background:#0f3560; color:#fff; transform:translateY(-1px); }
        .btn-lux-success { background:#15803d; color:#fff; }
        .btn-lux-success:hover { background:#166534; color:#fff; transform:translateY(-1px); }
        .btn-action-sm { width:28px; height:28px; padding:0; display:inline-flex; justify-content:center; align-items:center; border-radius:6px; font-size:0.75rem; border:none; transition:all 0.2s; color:#fff; margin:0 2px; text-decoration:none; cursor:pointer; }
        .btn-action-primary { background:#3b82f6; }
        .btn-action-primary:hover { background:#2563eb; transform:translateY(-1px); }
        .btn-action-warning { background:#eab308; color:#1e293b !important; }
        .btn-action-warning:hover { background:#ca8a04; transform:translateY(-1px); }
        .btn-action-danger { background:#ef4444; }
        .btn-action-danger:hover { background:#dc2626; transform:translateY(-1px); }
        .badge-pill-on { background:#dcfce7; color:#15803d; font-size:0.75rem; font-weight:700; padding:3px 10px; border-radius:20px; display:inline-block; }
        .badge-pill-off { background:#fee2e2; color:#b91c1c; font-size:0.75rem; font-weight:700; padding:3px 10px; border-radius:20px; display:inline-block; }
        .config-table th { background:#f1f5f9; color:#4a5568; font-size:0.82rem; font-weight:700; border-color:#e2e8f0; padding:8px 10px; }
        .config-table td { font-size:0.85rem; color:#1a2e44; border-color:#e2e8f0; padding:7px 10px; vertical-align:middle; }
</style>

    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title text-bold text-gray">Adicionar comisión evaluadora</h3>
        </div>
        <!-- /.card-header -->
        {{ form_start(form) }}
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.nombre) }}
                    {{ form_widget(form.nombre) }}
                    {{ form_errors(form.nombre) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.activo) }}
                    {{ form_widget(form.activo) }}
                    {{ form_errors(form.activo) }}
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 form-group">
                    {{ form_label(form.descripcion) }}
                    {{ form_widget(form.descripcion) }}
                    {{ form_errors(form.descripcion) }}
                </div>
            </div>
        </div>

        <h6 style="padding-left: 1%" class="mb-0"><b><p style="font-size: 20px; font-weight: bold; margin-top: 5px;">
                    Miembros</p>
            </b></h6>
        <hr style="margin-bottom: 5px;padding-left: 1%">
        <div class="card-body">
            <table class="table table-bordered table-striped dataTable">
                <thead class="table-custom-header">
                <tr>
                    <th>No.</th>
                    <th></th>
                    <th>Foto</th>
                    <th>Nombre y apellidos</th>
                    <th>Rol</th>
                    <th>Universidad</th>
                    <th>Correo</th>
                </tr>
                </thead>
                <tbody>
                {% for item in personas %}
                    <tr id="tr_{{ item.id }}">
                        <td width="1%" style="width: 2%">{{ loop.index }}</td>
                        <td width="1%" style="width: 4%"><input type="checkbox" name="asignados_{{ item.id }}"
                                                                id="asignados_{{ item.id }}"
                                                                value="{{ item.id }}"></td>
                        <td style="width: 3%"><a
                                    href="{% if item.foto != null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ item.foto }} {% else %} /assets/images/usuario.png {% endif %}"
                                    target="_blank">
                                <img src="{% if item.foto != null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ item.foto }}{% else %} /assets/images/usuario.png {% endif %}"
                                     class="img-circle" alt="{{ item.primerNombre }}"
                                     style="width: 40px;height: 40px; object-fit: cover">
                            </a></td>
                        <td>{{ item.primerNombre ~ ' ' ~ item.segundoNombre ~' '~ item.primerApellido ~ ' ' ~ item.segundoApellido }}</td>
                        <td>
                            <select id="asignados_{{ item.id }}_rol"
                                    name="asignados_{{ item.id }}_rol">
                                <option value="">Seleccione</option>
                                {% for resp in rolComision %}
                                    <option value="{{ resp.id }}">{{ resp.nombre }} </option>
                                {% endfor %}

                            </select>
                        </td>
                        <td>{{ item.universidad.nombre | default('') }}</td>
                        <td>{{ item.email | default('') }}</td>
                    </tr>
                {% endfor %}
                </tbody>

            </table>
        </div>
        <div class="card-footer" style="display: flex; justify-content: flex-end; align-items: center;">
            <button class="btn btn-primary" id="btn-asociar">Asociar</button>
        </div>
        <div class="card-body">
            <table id="tbl-asociados" class="table table-bordered table-striped dataTable">
                <thead class="table-custom-header">
                <tr>
                    <th>No.</th>
                    <th>Foto</th>
                    <th>Nombre y apellidos</th>
                    <th>Rol</th>
                    <th>Universidad</th>
                    <th>Correo</th>
                    <th class="text-center">Opciones</th>
                </tr>
                </thead>
                <tbody>
                {% for item in asignadas %}
                    <tr>
                        <td width="1%" style="width: 2%">{{ loop.index }}</td>
                        <td width="5%" style="width: 3%"><a
                                    href="{% if item.foto != null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ item.foto }} {% else %} /assets/images/usuario.png {% endif %}"
                                    target="_blank">
                                <img src="{% if item.foto != null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ item.foto }}{% else %} /assets/images/usuario.png {% endif %}"
                                     class="img-circle" alt="{{ item.primerNombre }}"
                                     style="width: 40px;height: 40px; object-fit: cover">
                            </a></td>
                        <td>{{ item.primerNombre ~ ' ' ~ item.segundoNombre ~' '~ item.primerApellido ~ ' ' ~ item.segundoApellido }}</td>
                        <td>{{ item.rolComision | default('') }}</td>
                        <td>{{ item.universidad.nombre | default('') }}</td>
                        <td>{{ item.email | default('') }}</td>
                        <td style="width: 3%" class="text-center">
                            <a title="Eliminar" class="btn-action-sm btn-action-danger elementRemove"
                               data-url="{{ path('app_comision_evaluadora_eliminar_persona_asignada_registrar', {'id': item.id}) }}"
                               data-title=""
                               data-content="¿Está seguro que desea realizar la acción?" type="button"><i
                                        class="fa fa-trash"></i></a>
                        </td>


                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        <input type="hidden" id="idSolicitud" name="idSolicitud" value="{{ idSolicitud }}">

        <div class="card-footer" style="display: flex; justify-content: flex-end; align-items: center;">
            <a class="btn-fs-cancel btn-cancel"
               data-url="{% if idSolicitud is null %}  {{ path('app_comision_evaluadora_index') }}  {% else %}  {{ path('app_plan_anual_evaluacion_index') }} {% endif %}"
               data-title=""
               data-content="¿Está seguro que desea realizar la acción?" type="button">Cancelar</a>
            <button id="btn_aceptar" class="btn-fs-submit"><i class="fas fa-check mr-2"></i>Aceptar</button>
        </div>
        {{ form_end(form) }}
    </div>

{% endblock %}

{% block javascripts %}
    <script>
        $('#evaluacion_nombre').val(localStorage.getItem('nombre'));
        $('#evaluacion_descripcion').val(localStorage.getItem('descripcion'));
        $('#evaluacion_activo').val(localStorage.getItem('activo'));
        var idSolicitud = $('#idSolicitud').val();

        $('#btn_aceptar').click(function (e) {
            console.log(idSolicitud);
            e.preventDefault();
            if (idSolicitud != null) {
                $('form[name="comision"]').attr('action', 'registrar?id=' + idSolicitud);
                $('form[name="comision"]').submit();
            } else {
                $('form[name="comision"]').attr('action', 'registrar');
                $('form[name="comision"]').submit();
            }
        });
        $('#btn-asociar').click(function (e) {
            e.preventDefault();
            console.log(idSolicitud);
            localStorage.setItem('nombre', $('#evaluacion_nombre').val());
            localStorage.setItem('descripcion', $('#evaluacion_descripcion').val());
            localStorage.setItem('activo', $('#evaluacion_activo').val());
            var flag = true;
            if ($('input[id*=asignados_]').length > 0) {
                var arrayId = [];
                $('input[id*=asignados_]').each(function (item, element) {
                    if (element.checked) {
                        var obj = new Object();
                        obj.id_persona = element.value;
                        var rol = $('#' + element.id + '_rol').val();
                        if (rol != "") {
                            obj.id_rol = rol;
                            obj.nombre_rol = $('#' + element.id + '_rol option:selected').text();
                            arrayId.push(obj);

                        } else {
                            flag = false;
                            toastr.warning("El rol es obligatorio por cada miembro de la evaluacion.");
                            return;
                        }
                    }
                });


                if (arrayId.length > 0 && flag) {
                    HoldOn.open({
                        theme: "sk-cube-grid",
                        message: 'Por favor espere...',
                        textColor: "white"
                    });
                    $.post("{{ path('app_comision_evaluadora_asociar_persona_registrar') }}",
                        {
                            arrayId: arrayId
                        },
                        function (data) {
                            HoldOn.close()
                            if (idSolicitud != null) {
                                $(window).attr('location', "{{ path('app_comision_evaluadora_registrar', {'id': idSolicitud}) }}")
                            } else {
                                $(window).attr('location', "{{ path('app_comision_evaluadora_registrar') }}")
                            }

                        });
                } else {
                    HoldOn.close()
                    if (flag) {
                        toastr.warning("Debe de seleccionar al menos un miembro.");
                    }

                }
            }
        });
    </script>
{% endblock %}