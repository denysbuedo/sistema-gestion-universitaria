{% extends 'baseAdmin.html.twig' %}

{% block title %}Asignar categoría de acreditación{% endblock %}

{% block body %}

<style>
        .card-luxury { border-radius:12px; border:none; box-shadow:0 4px 20px rgba(0,0,0,0.08); border-top:4px solid #134679; margin-bottom:1.5rem; }
        .card-luxury .card-header { background-color:#fff; border-bottom:1px solid #f1f5f9; padding:15px 24px; }
        .card-luxury .card-title { color:#1a2e44; font-weight:700; font-size:1rem; margin:0; float:none !important; }
        .label-icon { color:#134679; margin-right:6px; opacity:0.8; }
        .fs-label { font-size:0.82rem; font-weight:600; color:#4b5563; margin-bottom:6px; display:block; }
        .btn-fs-submit { background:#134679; color:#fff !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; cursor:pointer; }
        .btn-fs-submit:hover { background:#0f3560; transform:translateY(-1px); box-shadow:0 4px 12px rgba(19,70,121,0.2); }
        .btn-fs-cancel { background:#f1f5f9; color:#475569 !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; text-decoration:none; cursor:pointer; }
        .btn-fs-cancel:hover { background:#e2e8f0; color:#1e293b !important; transform:translateY(-1px); }
        .btn-lux-sm { padding:6px 14px; border-radius:6px; font-weight:700; font-size:0.75rem; border:none; display:inline-flex; align-items:center; gap:5px; text-transform:uppercase; transition:all 0.2s; text-decoration:none; color:#fff; cursor:pointer; }
        .btn-lux-primary { background:#134679; color:#fff; }
        .btn-lux-primary:hover { background:#0f3560; color:#fff; transform:translateY(-1px); }
        .btn-lux-success { background:#15803d; color:#fff; }
        .btn-lux-success:hover { background:#166534; color:#fff; transform:translateY(-1px); }
        .btn-action-sm { width:28px; height:28px; padding:0; display:inline-flex; justify-content:center; align-items:center; border-radius:6px; font-size:0.75rem; border:none; transition:all 0.2s; color:#fff; margin:0 2px; text-decoration:none; cursor:pointer; }
        .btn-action-primary { background:#3b82f6; }
        .btn-action-primary:hover { background:#2563eb; transform:translateY(-1px); }
        .btn-action-warning { background:#eab308; color:#1e293b !important; }
        .btn-action-warning:hover { background:#ca8a04; transform:translateY(-1px); }
        .btn-action-danger { background:#ef4444; }
        .btn-action-danger:hover { background:#dc2626; transform:translateY(-1px); }
        .badge-pill-on { background:#dcfce7; color:#15803d; font-size:0.75rem; font-weight:700; padding:3px 10px; border-radius:20px; display:inline-block; }
        .badge-pill-off { background:#fee2e2; color:#b91c1c; font-size:0.75rem; font-weight:700; padding:3px 10px; border-radius:20px; display:inline-block; }
        .config-table th { background:#f1f5f9; color:#4a5568; font-size:0.82rem; font-weight:700; border-color:#e2e8f0; padding:8px 10px; }
        .config-table td { font-size:0.85rem; color:#1a2e44; border-color:#e2e8f0; padding:7px 10px; vertical-align:middle; }
</style>

    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title text-bold text-gray">Asignar categoría de acreditación</h3>
        </div>
        {{ include('modules/postgrado/solicitud_programa/info_comun.html.twig', { 'solicitudPrograma': solicitudPrograma }) }}
        <!-- /.card-header -->
        {{ form_start(form) }}
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.categoriaAcreditacion) }}
                    {{ form_widget(form.categoriaAcreditacion) }}
                    {{ form_errors(form.categoriaAcreditacion) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.fechaEmision) }}
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        {{ form_widget(form.fechaEmision ) }}
                        {{ form_errors(form.fechaEmision) }}
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.numeroPleno) }}
                    {{ form_widget(form.numeroPleno) }}
                    {{ form_errors(form.numeroPleno) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.numeroAcuerdoPleno) }}
                    {{ form_widget(form.numeroAcuerdoPleno) }}
                    {{ form_errors(form.numeroAcuerdoPleno) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.annosVigenciaCategoriaAcreditacion) }}
                    {{ form_widget(form.annosVigenciaCategoriaAcreditacion) }}
                    {{ form_errors(form.annosVigenciaCategoriaAcreditacion) }}
                </div>
            </div>

        </div>
        <div class="card-footer" style="display: flex; justify-content: flex-end; align-items: center;">
            <a class="btn-fs-cancel btn-cancel"
               data-url="{{ path('app_evaluacion_categoria_acreditacion_ies_index') }}"
               data-title=""
               data-content="¿Está seguro que desea realizar la acción?" type="button">Cancelar</a>
            <button id="btn_submit" class="btn-fs-submit"><i class="fas fa-check mr-2"></i>Aceptar</button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    <script>

        var fecha = "{% if new.fechaEmision is empty %}  {{ new.fechaEmision | default('') }} {% else %}  {{ new.fechaEmision|date('d/m/Y') }} {% endif %}".replace(' ', '');
        $('#categoria_acreditacion_posgrado_fechaEmision').val(fecha.replace(' ', ''));

        $('#categoria_acreditacion_posgrado_categoriaAcreditacion').val({{ solicitudPrograma.categoriaAcreditacion.id }});

        $('#categoria_acreditacion_posgrado_fechaEmision').datetimepicker({
            format: 'DD/MM/YYYY'
        });
        $('#categoria_acreditacion_posgrado_annosVigenciaCategoriaAcreditacion').on('keydown keypress', function (e) {
            if (e.key.length === 1) {
                if ($(this).val().length < 2 /*&& !isNaN(parseFloat(e.key))*/) {
                    $(this).val($(this).val() + e.key);
                }
                return false;
            }
        });

        $('#categoria_acreditacion_posgrado_categoriaAcreditacion').on('change', function () {
            if ($(this).val() == 4) {
                $('#categoria_acreditacion_posgrado_fechaEmision').val(null);
                $('#categoria_acreditacion_posgrado_fechaEmision').removeAttr('required');
                $('#categoria_acreditacion_posgrado_numeroPleno').removeAttr('required');
                $('#categoria_acreditacion_posgrado_numeroAcuerdoPleno').removeAttr('required');
                $('#categoria_acreditacion_posgrado_annosVigenciaCategoriaAcreditacion').removeAttr('required');
            } else {
                // Obtener la fecha actual
                var today = new Date();

                // Obtener el día, mes y año
                var day = today.getDate();
                var month = today.getMonth() + 1; // Enero es 0
                var year = today.getFullYear();

                // Asegurarse de que el día y el mes tengan dos dígitos
                if (day < 10) {
                    day = '0' + day;
                }
                if (month < 10) {
                    month = '0' + month;
                }

                // Formatear la fecha como dd/mm/yyyy
                var formattedDate = day + '/' + month + '/' + year;

                // Mostrar la fecha en un elemento HTML (por ejemplo, un div con id="fecha")


                $('#categoria_acreditacion_posgrado_fechaEmision').val(formattedDate);
                $('#categoria_acreditacion_posgrado_fechaEmision').attr('required', 'required');
                $('#categoria_acreditacion_posgrado_numeroPleno').attr('required', 'required');
                $('#categoria_acreditacion_posgrado_numeroAcuerdoPleno').attr('required', 'required');
                $('#categoria_acreditacion_posgrado_annosVigenciaCategoriaAcreditacion').attr('required', 'required');
            }
        });
    </script>
{% endblock %}
