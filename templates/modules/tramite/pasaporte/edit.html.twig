{% extends 'baseAdmin.html.twig' %}

{% block title %}Modificar pasaporte{% endblock %}

{% block body %}
<style>
    .fs-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #134679;
        border-left: 4px solid #134679;
        padding-left: 12px;
        margin-bottom: 20px;
        line-height: 1.3;
    }
    .fs-title small {
        display: block;
        font-size: .78rem;
        font-weight: 400;
        color: #6c757d;
        margin-top: 2px;
    }

    .fs-persona {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        border-left: 4px solid #134679;
        padding: 14px 20px;
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 22px;
    }
    .fs-persona-avatar {
        width: 64px; height: 64px;
        border-radius: 8px;
        object-fit: cover;
        flex-shrink: 0;
        box-shadow: 0 2px 8px rgba(0,0,0,.12);
    }
    .fs-persona-name {
        font-weight: 700;
        color: #1a2e44;
        font-size: .95rem;
        margin: 0 0 5px;
    }
    .fs-persona-meta {
        font-size: .8rem;
        color: #718096;
        display: flex;
        flex-wrap: wrap;
        gap: 4px 14px;
    }
    .fs-persona-meta span i { margin-right: 4px; color: #134679; }

    .fs-section {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        margin-bottom: 18px;
    }
    .fs-section-title {
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .6px;
        color: #134679;
        padding: 11px 18px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        border-radius: 10px 10px 0 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .fs-section-title i { opacity: .7; }
    .fs-section-body { padding: 18px 18px 4px; }

    .fs-label {
        font-size: .78rem;
        font-weight: 600;
        color: #4a5568;
        margin-bottom: 5px;
        display: block;
    }
    .fs-label .req { color: #e53e3e; }

    .fs-section-body .form-control,
    .fs-section-body .custom-select {
        border-radius: 7px;
        border: 1.5px solid #cbd5e0;
        font-size: .875rem;
        transition: border-color .15s, box-shadow .15s;
    }
    .fs-section-body .form-control:focus,
    .fs-section-body .custom-select:focus {
        border-color: #134679;
        box-shadow: 0 0 0 3px rgba(19,70,121,.1);
    }
    .fs-section-body .input-group .form-control { border-radius: 0 7px 7px 0; }
    .fs-section-body .input-group-text {
        border-radius: 7px 0 0 7px;
        border: 1.5px solid #cbd5e0;
        border-right: none;
        background: #f8fafc;
        color: #718096;
    }

    .fs-img-zone {
        border: 1.5px dashed #cbd5e0;
        border-radius: 8px;
        background: #f8fafc;
        cursor: pointer;
        transition: border-color .2s, background .2s;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 140px;
        position: relative;
    }
    .fs-img-zone:hover { border-color: #134679; background: #eef3fa; }
    .fs-img-zone.has-img { border-color: #38a169; background: #f0fff4; border-style: solid; }
    .fs-img-zone .fs-img-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 20px;
        text-align: center;
        pointer-events: none;
    }
    .fs-img-zone .fs-img-placeholder i { font-size: 1.6rem; color: #a0aec0; }
    .fs-img-zone.has-img .fs-img-placeholder i { color: #38a169; }
    .fs-img-zone .fs-img-placeholder span { font-size: .8rem; color: #718096; font-weight: 500; }
    .fs-img-zone .fs-img-placeholder small { font-size: .72rem; color: #a0aec0; }
    .fs-img-preview {
        width: 100%; height: 140px;
        object-fit: cover;
        display: none;
        border-radius: 6px;
    }
    .fs-img-zone.has-img .fs-img-preview { display: block; }
    .fs-img-zone.has-img .fs-img-placeholder { display: none; }

    .fs-toggle-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 0 6px;
    }
    .fs-toggle-wrap label {
        font-size: .875rem;
        color: #4a5568;
        font-weight: 500;
        margin: 0;
        cursor: pointer;
    }

    .fs-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding-top: 4px;
        padding-bottom: 8px;
    }
    .btn-fs-cancel {
        background: transparent;
        border: 1.5px solid #cbd5e0;
        color: #718096;
        border-radius: 7px;
        padding: 7px 20px;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: all .15s;
        text-decoration: none;
        display: inline-block;
    }
    .btn-fs-cancel:hover { border-color: #a0aec0; color: #4a5568; background: #f7fafc; text-decoration: none; }
    .btn-fs-submit {
        background: #134679;
        border: none;
        color: #fff;
        border-radius: 7px;
        padding: 7px 24px;
        font-weight: 700;
        font-size: .85rem;
        cursor: pointer;
        transition: background .15s;
    }
    .btn-fs-submit:hover { background: #0e3460; color: #fff; }
</style>

<div class="fs-title">
    Modificar pasaporte
    <small>Actualice los datos del pasaporte y guarde los cambios</small>
</div>

{# Persona #}
<div class="fs-persona">
    <img class="fs-persona-avatar"
         src="{% if pasaporte.persona.foto is not null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ pasaporte.persona.foto }}{% else %}/assets/images/usuario.png{% endif %}"
         alt="{{ pasaporte.persona.primerNombre }}">
    <div>
        <p class="fs-persona-name">{{ pasaporte.persona.primerNombre }} {{ pasaporte.persona.segundoNombre }} {{ pasaporte.persona.primerApellido }} {{ pasaporte.persona.segundoApellido }}</p>
        <div class="fs-persona-meta">
            <span><i class="fas fa-id-card"></i>{{ pasaporte.persona.carnetIdentidad }}</span>
            {% if pasaporte.persona.responsabilidad is not null %}<span><i class="fas fa-briefcase"></i>{{ pasaporte.persona.responsabilidad.nombre }}</span>{% endif %}
            {% if pasaporte.persona.estructura is not null %}<span><i class="fas fa-building"></i>{{ pasaporte.persona.estructura.nombre }}</span>{% endif %}
        </div>
    </div>
</div>

{{ form_start(form) }}

{# Sección 1 — Datos del pasaporte #}
<div class="fs-section">
    <div class="fs-section-title"><i class="fas fa-passport"></i> Datos del pasaporte</div>
    <div class="fs-section-body">
        <div class="row">
            <div class="col-12 col-md-6 col-lg-3 form-group">
                <label class="fs-label">Tipo de pasaporte <span class="req">*</span></label>
                {{ form_widget(form.tipoPasaporte) }}
                {{ form_errors(form.tipoPasaporte) }}
            </div>
            <div class="col-12 col-md-6 col-lg-3 form-group">
                <label class="fs-label">Número de pasaporte <span class="req">*</span></label>
                {{ form_widget(form.numeroPasaporte, {'attr': {'placeholder': 'Ej: A1234567'}}) }}
                {{ form_errors(form.numeroPasaporte) }}
            </div>
            <div class="col-12 col-md-6 col-lg-3 form-group">
                <label class="fs-label">Fecha de emisión <span class="req">*</span></label>
                <div class="input-group">
                    <div class="input-group-prepend"><span class="input-group-text"><i class="far fa-calendar-alt"></i></span></div>
                    {{ form_widget(form.fechaEmisionPasaporte, {'attr': {'placeholder': 'DD/MM/AAAA', 'autocomplete': 'off'}}) }}
                </div>
                {{ form_errors(form.fechaEmisionPasaporte) }}
            </div>
            <div class="col-12 col-md-6 col-lg-3 form-group">
                <label class="fs-label">Fecha de caducidad <span class="req">*</span></label>
                <div class="input-group">
                    <div class="input-group-prepend"><span class="input-group-text"><i class="far fa-calendar-alt"></i></span></div>
                    {{ form_widget(form.fechaCaducidadPasaporte, {'attr': {'placeholder': 'DD/MM/AAAA', 'autocomplete': 'off'}}) }}
                </div>
                {{ form_errors(form.fechaCaducidadPasaporte) }}
            </div>
            <div class="col-12 form-group">
                <div class="fs-toggle-wrap">
                    {{ form_widget(form.activo) }}
                    <label for="{{ form.activo.vars.id }}">Pasaporte activo</label>
                </div>
                {{ form_errors(form.activo) }}
            </div>
        </div>
    </div>
</div>

{# Sección 2 — Imágenes #}
<div class="fs-section">
    <div class="fs-section-title"><i class="fas fa-images"></i> Imágenes del pasaporte</div>
    <div class="fs-section-body">
        <div class="row">
            <div class="col-12 col-md-6 form-group">
                <label class="fs-label">Cara frontal</label>
                <div class="fs-img-zone {% if pasaporte.cara1 is not null %}has-img{% endif %}" id="zone-cara1">
                    <img class="fs-img-preview" id="preview-cara1"
                         src="{% if pasaporte.cara1 is not null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/tramites/pasaporte/{{ pasaporte.cara1 }}{% else %}{% endif %}"
                         alt="Vista previa">
                    <div class="fs-img-placeholder">
                        <i class="fas fa-image"></i>
                        <span>{% if pasaporte.cara1 is not null %}Haga clic para cambiar{% else %}Haga clic para seleccionar{% endif %}</span>
                        <small>JPG, PNG, GIF</small>
                    </div>
                </div>
                <div style="display:none">{{ form_widget(form.cara1) }}</div>
                {{ form_errors(form.cara1) }}
            </div>
            <div class="col-12 col-md-6 form-group">
                <label class="fs-label">Cara posterior</label>
                <div class="fs-img-zone {% if pasaporte.cara2 is not null %}has-img{% endif %}" id="zone-cara2">
                    <img class="fs-img-preview" id="preview-cara2"
                         src="{% if pasaporte.cara2 is not null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/tramites/pasaporte/{{ pasaporte.cara2 }}{% else %}{% endif %}"
                         alt="Vista previa">
                    <div class="fs-img-placeholder">
                        <i class="fas fa-image"></i>
                        <span>{% if pasaporte.cara2 is not null %}Haga clic para cambiar{% else %}Haga clic para seleccionar{% endif %}</span>
                        <small>JPG, PNG, GIF</small>
                    </div>
                </div>
                <div style="display:none">{{ form_widget(form.cara2) }}</div>
                {{ form_errors(form.cara2) }}
            </div>
        </div>
    </div>
</div>

{# Acciones #}
<div class="fs-actions">
    <a class="btn-fs-cancel btn-cancel"
       data-url="{{ path('app_pasaporte_index') }}"
       data-title=""
       data-content="¿Está seguro que desea cancelar?"
       href="#">
        <i class="fas fa-times mr-1"></i> Cancelar
    </a>
    <button id="btn_aceptar" type="submit" class="btn-fs-submit">
        <i class="fas fa-save mr-1"></i> Guardar cambios
    </button>
</div>

{{ form_end(form) }}
{% endblock %}

{% block javascripts %}
<script>
    /* ── Zonas de imagen ── */
    function setupImgZone(zoneId, inputId, previewId) {
        var $zone    = $('#' + zoneId);
        var $input   = $('#' + inputId);
        var $preview = $('#' + previewId);

        $zone.on('click', function () { $input.trigger('click'); });

        $input.on('change', function () {
            var file = this.files[0];
            if (!file) return;
            var ext = file.name.split('.').pop().toLowerCase();
            if (!['jpg','jpeg','png','gif'].includes(ext)) {
                toastr.warning('Solo se permiten imágenes JPG, PNG o GIF.');
                return;
            }
            var reader = new FileReader();
            reader.onload = function (e) {
                $preview.attr('src', e.target.result);
                $zone.addClass('has-img');
            };
            reader.readAsDataURL(file);
        });
    }

    setupImgZone('zone-cara1', '{{ form.cara1.vars.id }}', 'preview-cara1');
    setupImgZone('zone-cara2', '{{ form.cara2.vars.id }}', 'preview-cara2');

    /* ── Datepickers ── */
    $(document).ready(function () {
        var emision = "{{ pasaporte.fechaEmisionPasaporte is not null ? pasaporte.fechaEmisionPasaporte|date('d/m/Y') : '' }}";
        var caducidad = "{{ pasaporte.fechaCaducidadPasaporte is not null ? pasaporte.fechaCaducidadPasaporte|date('d/m/Y') : '' }}";

        $('#pasaporte_fechaEmisionPasaporte').val(emision.trim());
        $('#pasaporte_fechaCaducidadPasaporte').val(caducidad.trim());

        $('#pasaporte_fechaEmisionPasaporte').datetimepicker({
            format: 'DD/MM/YYYY',
            maxDate: moment()
        });
        $('#pasaporte_fechaCaducidadPasaporte').datetimepicker({
            format: 'DD/MM/YYYY',
            useCurrent: false
        });
        $('#pasaporte_fechaEmisionPasaporte').on('dp.change', function (e) {
            $('#pasaporte_fechaCaducidadPasaporte').data('DateTimePicker')
                .minDate(e.date ? moment(e.date).add(1, 'days') : false);
        });
    });

    /* ── Submit ── */
    $('#btn_aceptar').on('click', function (e) {
        e.preventDefault();
        var $btn = $(this);
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
        HoldOn.open({ theme: 'sk-cube-grid', message: 'Por favor espere...', textColor: 'white' });
        $('form[name="pasaporte"]').submit();
    });
</script>
{% endblock %}
