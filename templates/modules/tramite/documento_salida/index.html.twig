{% extends 'baseAdmin.html.twig' %}

{% block title %}Trámites{% endblock %}

{% block body %}
<style>
    .card-luxury {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border-top: 4px solid #134679;
        margin-bottom: 1.5rem;
    }
    .card-luxury .card-header {
        background-color: #fff;
        border-bottom: 1px solid #f1f5f9;
        padding: 15px 24px;
    }
    .card-luxury .card-title { color: #1a2e44; font-weight: 700; font-size: 1rem; margin: 0; float: none !important; }
    .label-icon { color: #134679; margin-right: 6px; opacity: 0.8; }

    .config-table th {
        background: #f1f5f9;
        color: #4a5568;
        font-size: 0.82rem;
        font-weight: 700;
        border-color: #e2e8f0;
        padding: 8px 10px;
    }
    .config-table td {
        font-size: 0.85rem;
        color: #1a2e44;
        border-color: #e2e8f0;
        padding: 7px 10px;
        vertical-align: middle;
    }
    .config-table tbody tr:hover { background: #f8fafc; }

    .btn-lux-sm {
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.75rem;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s;
    }
    .btn-lux-primary { background: #134679; color: #fff !important; }
    .btn-lux-primary:hover { background: #0f3560; }

    /* Accordion Customization */
    .search-accordion { margin-bottom: 1rem; }
    .search-accordion .card { border: none; box-shadow: none; background: transparent; }
    .search-accordion .card-header { 
        background: #f8fafc !important; 
        border: 1px solid #e2e8f0 !important;
        border-radius: 8px !important; 
        padding: 12px 20px;
        transition: all 0.3s;
    }
    .search-accordion .card-header:hover { background: #f1f5f9 !important; }
    .search-accordion .card-title a { 
        color: #134679 !important; 
        font-size: 0.85rem; 
        font-weight: 700; 
        display: flex; 
        align-items: center; 
        justify-content: space-between;
        text-decoration: none !important;
    }
    .filter-container {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-top: none;
        border-radius: 0 0 8px 8px;
        padding: 20px;
        margin-top: -2px;
    }
    .filter-label {
        font-size: 0.75rem;
        font-weight: 700;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        display: block;
    }

    /* Proteger headers de modales personalizados del override de bootbox */
    #docSalidaHistoryModal .modal-header,
    #modalAprobarTramites .modal-header,
    #modalFechaSalidaRegreso .modal-header {
        position: relative !important;
        top: auto !important;
        right: auto !important;
        width: 100% !important;
        padding: 18px 24px !important;
        display: flex !important;
        align-items: center !important;
    }
    #docSalidaHistoryModal .modal-header .close,
    #modalAprobarTramites .modal-header .close,
    #modalFechaSalidaRegreso .modal-header .close {
        color: white !important;
        opacity: .85 !important;
        font-size: 1.6rem !important;
        position: static !important;
        top: auto !important;
        right: auto !important;
        transform: none !important;
        margin-left: auto !important;
    }
</style>

    {% include 'pages/modalDetail.html.twig' %}

    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title text-bold m-0"><i class="fas fa-file-contract label-icon"></i>Listado de trámites</h3>
        </div>
        
        <div class="px-4 pt-3">
            <div class="search-accordion" id="accordion">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title w-100">
                            <a class="d-block w-100 collapsed" data-toggle="collapse" href="#collapseOne" aria-expanded="false">
                                <span><i class="fas fa-filter mr-2"></i>Filtrar resultados {{ text_fil }}</span>
                                <i class="fas fa-chevron-down"></i>
                            </a>
                        </h4>
                    </div>
                    <div id="collapseOne" class="collapse" data-parent="#accordion">
                        <div class="filter-container">
                            <div class="row">
                                <div class="col-md-4">
                                    <label class="filter-label" for="estadoFicha">Estado del trámite</label>
                                    <select id="estadoFicha" name="estadoFicha" class="form-control select2" style="width: 100%;">
                                        <option value="">Todos los estados</option>
                                        {% for item2 in estados %}
                                            <option {% if item2.id == fil_estado %} selected {% endif %} value="{{ item2.id }}">{{ item2.nombre }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="filter-label" for="clasificacionDoc">Clasificación</label>
                                    <select id="clasificacionDoc" name="clasificacionDoc" class="form-control" style="width: 100%;">
                                        <option value="">Todas las clasificaciones</option>
                                        <option {% if fil_clasificacion == 'Interno' %}selected{% endif %} value="Interno">Interno</option>
                                        <option {% if fil_clasificacion == 'Externa' %}selected{% endif %} value="Externa">Externa</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body px-4">
            <table class="table config-table table-bordered table-striped dataTable">
                <thead>
                <tr>
                    <th>No.</th>
                    <th>Nombre y apellidos</th>
                    <th>Inst. cubana</th>
                    <th>Clasificación</th>
                    <th>País</th>
                    <th>Fecha salida</th>
                    <th>Estancia</th>
                    <th>Estado</th>
                    <th class="text-center" style="width: 60px;">Opciones</th>
                </tr>
                </thead>
                <tbody>
                {% for item in registros %}
                    <tr>
                        <td width="1%">{{ loop.index }}</td>
                        <td>{{ item.persona.primerNombre ~ ' ' ~ item.persona.segundoNombre ~' '~ item.persona.primerApellido ~ ' ' ~ item.persona.segundoApellido }}</td>
                        <td>{{ item.institucionCubana.siglas | default('') }}</td>
                        <td>
                            {% set clas = item.fichaSalida is not null ? item.fichaSalida.clasificacion | default('') : '' %}
                            {% if clas == 'Interno' %}
                                <span class="badge badge-info"><i class="fas fa-building mr-1"></i>Interno</span>
                            {% elseif clas == 'Externa' %}
                                <span class="badge badge-warning"><i class="fas fa-globe-americas mr-1"></i>Externa</span>
                            {% else %}
                                {{ clas }}
                            {% endif %}
                        </td>
                        <td>{{ item.pais.nombre | default('') }}</td>
                        <td width="10%">{{ item.fechaSalidaReal | date('d/m/Y') }}</td>
                        <td>{{ item.tiempoEstancia | default('') }}</td>
                        <td>
                            {% set eNom = item.estadoDocumentoSalida.nombre | default('') %}
                            {% set eId  = item.estadoDocumentoSalida.id | default(0) %}
                            {% if eId == 4 %}
                                <span class="badge" style="background:#e0f2fe;color:#0369a1;font-size:0.75rem;padding:4px 8px;border-radius:12px;font-weight:600;">{{ eNom }}</span>
                            {% elseif eId == 7 %}
                                <span class="badge" style="background:#fef9c3;color:#854d0e;font-size:0.75rem;padding:4px 8px;border-radius:12px;font-weight:600;">{{ eNom }}</span>
                            {% elseif eId == 8 %}
                                <span class="badge" style="background:#ede9fe;color:#5b21b6;font-size:0.75rem;padding:4px 8px;border-radius:12px;font-weight:600;">{{ eNom }}</span>
                            {% elseif eId == 5 %}
                                <span class="badge" style="background:#dcfce7;color:#166534;font-size:0.75rem;padding:4px 8px;border-radius:12px;font-weight:600;">{{ eNom }}</span>
                            {% elseif eId == 9 %}
                                <span class="badge" style="background:#dbeafe;color:#1e40af;font-size:0.75rem;padding:4px 8px;border-radius:12px;font-weight:600;">{{ eNom }}</span>
                            {% elseif eId == 11 %}
                                <span class="badge" style="background:#fff7ed;color:#c2410c;font-size:0.75rem;padding:4px 8px;border-radius:12px;font-weight:600;">{{ eNom }}</span>
                            {% elseif eId == 10 or eId == 6 %}
                                <span class="badge" style="background:#f1f5f9;color:#475569;font-size:0.75rem;padding:4px 8px;border-radius:12px;font-weight:600;">{{ eNom }}</span>
                            {% else %}
                                <span class="badge" style="background:#f1f5f9;color:#475569;font-size:0.75rem;padding:4px 8px;border-radius:12px;font-weight:600;">{{ eNom }}</span>
                            {% endif %}
                        </td>
                        <td class="text-center" style="white-space: nowrap; width: 60px;">
                            {% set persona_str = (item.persona.primerNombre ~ ' ' ~ item.persona.segundoNombre ~ ' ' ~ item.persona.primerApellido ~ ' ' ~ item.persona.segundoApellido) | trim %}
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle-no-caret"
                                        id="ds-actions-{{ item.id }}"
                                        data-toggle="dropdown"
                                        aria-haspopup="true"
                                        aria-expanded="false"
                                        title="Opciones"
                                        style="border-radius: 50%; width: 34px; height: 34px; padding: 0; line-height: 34px; font-size: 1rem;">
                                    <i class="fas fa-ellipsis-v"></i>
                                </button>
                                <div class="dropdown-menu dropdown-menu-right shadow-sm" aria-labelledby="ds-actions-{{ item.id }}" style="min-width: 230px; border-radius: 0.5rem; padding: 8px 0;">

                                    <h6 class="dropdown-header text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #adb5bd; letter-spacing: 0.5px;">Trámite</h6>

                                    {% if item.estadoDocumentoSalida.id | default('') in [7] %}
                                        <button class="dropdown-item btn-asignar-tramite"
                                                data-doc-id="{{ item.id }}"
                                                data-url="{{ path('app_documento_salida_asignar_tramite', {'id': item.id}) }}"
                                                data-fetch-url="{{ path('app_documento_salida_datos_asignar_tramite', {'id': item.id}) }}"
                                                data-persona="{{ persona_str }}"
                                                data-grado="{{ item.persona.gradoAcademico.nombre | default('') }}"
                                                data-institucion="{{ item.institucionCubana.siglas | default('') }}"
                                                data-pais="{{ item.pais.nombre | default('') }}"
                                                data-fecha="{{ item.fechaSalidaReal | date('d/m/Y') }}"
                                                data-estancia="{{ item.tiempoEstancia | default('') }}"
                                                data-estado="{{ item.estadoDocumentoSalida.nombre | default('') }}">
                                            <i class="fa fa-address-book fa-fw mr-2 text-primary"></i> Asignar trámites
                                        </button>
                                        <button class="dropdown-item btn-aprobar-tramite"
                                                data-doc-id="{{ item.id }}"
                                                data-fetch-url="{{ path('app_documento_salida_datos_aprobar_tramites', {'id': item.id}) }}"
                                                data-persona="{{ persona_str }}"
                                                data-grado="{{ item.persona.gradoAcademico.nombre | default('') }}"
                                                data-institucion="{{ item.institucionCubana.siglas | default('') }}"
                                                data-pais="{{ item.pais.nombre | default('') }}"
                                                data-fecha="{{ item.fechaSalidaReal | date('d/m/Y') }}"
                                                data-estancia="{{ item.tiempoEstancia | default('') }}"
                                                data-estado="{{ item.estadoDocumentoSalida.nombre | default('') }}">
                                            <i class="fa fa-check-circle fa-fw mr-2 text-success"></i> Aprobar trámites
                                        </button>
                                    {% endif %}

                                    {% if item.estadoDocumentoSalida.id | default('') in [8] %}
                                        <button class="dropdown-item btn-fecha-salida-regreso"
                                                data-doc-id="{{ item.id }}"
                                                data-url="{{ path('app_documento_salida_asignar_fecha_salida_regreso', {'id': item.id}) }}"
                                                data-persona="{{ persona_str }}"
                                                data-grado="{{ item.persona.gradoAcademico.nombre | default('') }}"
                                                data-institucion="{{ item.institucionCubana.siglas | default('') }}"
                                                data-pais="{{ item.pais.nombre | default('') }}"
                                                data-fecha-salida="{{ item.fechaSalidaReal is not null ? item.fechaSalidaReal | date('d/m/Y') : '' }}"
                                                data-fecha-regreso="{{ item.fechaRegresoReal is not null ? item.fechaRegresoReal | date('d/m/Y') : '' }}"
                                                data-fecha-entrega="{{ item.fechaEntregaPasaporte is not null ? item.fechaEntregaPasaporte | date('d/m/Y') : '' }}"
                                                data-estancia="{{ item.tiempoEstancia | default('') }}"
                                                data-estado="{{ item.estadoDocumentoSalida.nombre | default('') }}">
                                            <i class="fa fa-plane-departure fa-fw mr-2 text-primary"></i> Definir fechas de salida
                                        </button>
                                    {% endif %}

                                    {% if item.estadoDocumentoSalida.id | default('') in [5] %}
                                        <button class="dropdown-item elementRemove"
                                                data-url="{{ path('app_documento_salida_viajando', {'id': item.id}) }}">
                                            <i class="fa fa-plane fa-fw mr-2 text-primary"></i> Definir como viajando
                                        </button>
                                        <button class="dropdown-item btn-fecha-salida-regreso"
                                                data-doc-id="{{ item.id }}"
                                                data-url="{{ path('app_documento_salida_asignar_fecha_salida_regreso', {'id': item.id}) }}"
                                                data-persona="{{ persona_str }}"
                                                data-grado="{{ item.persona.gradoAcademico.nombre | default('') }}"
                                                data-institucion="{{ item.institucionCubana.siglas | default('') }}"
                                                data-pais="{{ item.pais.nombre | default('') }}"
                                                data-fecha-salida="{{ item.fechaSalidaReal is not null ? item.fechaSalidaReal | date('d/m/Y') : '' }}"
                                                data-fecha-regreso="{{ item.fechaRegresoReal is not null ? item.fechaRegresoReal | date('d/m/Y') : '' }}"
                                                data-fecha-entrega="{{ item.fechaEntregaPasaporte is not null ? item.fechaEntregaPasaporte | date('d/m/Y') : '' }}"
                                                data-estancia="{{ item.tiempoEstancia | default('') }}"
                                                data-estado="{{ item.estadoDocumentoSalida.nombre | default('') }}">
                                            <i class="fa fa-calendar-plus fa-fw mr-2 text-warning"></i> Redefinir fechas
                                        </button>
                                    {% endif %}

                                    {% if item.estadoDocumentoSalida.id | default('') in [9] %}
                                        <button class="dropdown-item btn-finalizar-salida"
                                                data-doc-id="{{ item.id }}"
                                                data-url="{{ path('app_documento_salida_finalizar_salida', {'id': item.id}) }}">
                                            <i class="fa fa-plane-arrival fa-fw mr-2 text-success"></i> Finalizar salida
                                        </button>
                                    {% endif %}

                                    {% if item.estadoDocumentoSalida.id | default('') in [11] %}
                                        <button class="dropdown-item btn-adjuntar-informe"
                                                data-doc-id="{{ item.id }}"
                                                data-url="{{ path('app_documento_salida_adjuntar_informe', {'id': item.id}) }}">
                                            <i class="fa fa-file-alt fa-fw mr-2 text-warning"></i> Adjuntar informe ejecutivo
                                        </button>
                                    {% endif %}

                                    <div class="dropdown-divider"></div>
                                    <h6 class="dropdown-header text-uppercase" style="font-size: 0.65rem; font-weight: 700; color: #adb5bd; letter-spacing: 0.5px;">Documentos</h6>
                                    <button class="dropdown-item btn-view-doc-history"
                                            data-id="{{ item.id }}"
                                            data-url="{{ path('app_documento_salida_historial_documentos', {'id': item.id}) }}">
                                        <i class="fa fa-folder-open fa-fw mr-2 text-info"></i> Historial de documentos
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modals preserved -->
    <div class="modal fade" id="docSalidaHistoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="border-radius: 12px; border: none; box-shadow: 0 10px 30px rgba(0,0,0,.2);">
                <div class="modal-header d-flex align-items-center justify-content-between"
                     style="background: #134679; color: white; border-top-left-radius: 12px; border-top-right-radius: 12px; padding: 18px 24px;">
                    <h5 class="modal-title font-weight-bold mb-0"><i class="fas fa-folder-open mr-2"></i> Historial de Documentos</h5>
                    <button type="button" class="close mb-0" data-dismiss="modal" aria-label="Close"
                            style="color: white; opacity: .85; font-size: 1.6rem; line-height: 1; padding: 0; background: none; border: none; cursor: pointer; margin-left: auto;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body p-4">
                    <!-- Tarjeta de persona -->
                    <div style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-radius: 12px; padding: 18px; margin-bottom: 20px; border: 1px solid #e2e8f0;">
                        <div class="d-flex align-items-center">
                            <div id="hist2Avatar" style="width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, #134679, #1a5898); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 16px; flex-shrink: 0; box-shadow: 0 3px 10px rgba(19,70,121,.3); letter-spacing: 1px;">--</div>
                            <div style="margin-left: 14px; flex: 1; min-width: 0;">
                                <div id="hist2PersonaName" style="font-weight: 700; font-size: 0.92rem; color: #1a2e44; line-height: 1.3;">—</div>
                                <div id="hist2Grado" style="font-size: 0.78rem; color: #64748b; margin-top: 2px;"></div>
                                <div id="hist2Institucion" style="font-size: 0.78rem; color: #64748b;"></div>
                            </div>
                            <span id="hist2Estado" style="background: #dbeafe; color: #134679; font-size: 0.7rem; font-weight: 700; padding: 4px 10px; border-radius: 20px; text-transform: uppercase; letter-spacing: 0.4px; align-self: flex-start; white-space: nowrap; margin-left: 10px;">—</span>
                        </div>
                        <div class="d-flex" style="margin-top: 14px; padding-top: 12px; border-top: 1px solid #e2e8f0; gap: 24px; flex-wrap: wrap;">
                            <div>
                                <div style="font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 3px;">País</div>
                                <div id="hist2Pais" style="font-size: 0.82rem; font-weight: 600; color: #1a2e44;">—</div>
                            </div>
                            <div>
                                <div style="font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 3px;">Fecha Salida</div>
                                <div id="hist2Fecha" style="font-size: 0.82rem; font-weight: 600; color: #1a2e44;">—</div>
                            </div>
                            <div>
                                <div style="font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 3px;">Estancia</div>
                                <div id="hist2Estancia" style="font-size: 0.82rem; font-weight: 600; color: #1a2e44;">—</div>
                            </div>
                            <div>
                                <div style="font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 3px;">Consulta Embajada</div>
                                <div id="hist2Embajada" style="font-size: 0.82rem; font-weight: 600; color: #1a2e44;">—</div>
                            </div>
                            <div>
                                <div style="font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 3px;">Entrega Pasaporte</div>
                                <div id="hist2FechaEntrega" style="font-size: 0.82rem; font-weight: 600; color: #1a2e44;">—</div>
                            </div>
                            <div>
                                <div style="font-size: 0.65rem; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 3px;">Recogida Pasaporte</div>
                                <div id="hist2FechaRecogida" style="font-size: 0.82rem; font-weight: 600; color: #1a2e44;">—</div>
                            </div>
                        </div>
                    </div>
                    <div style="background:#f1f5f9;border-radius:10px;padding:4px;display:inline-flex;gap:2px;margin-bottom:16px;">
                        <a class="doc-tab-pill active" id="tab-doc-salida-tab" href="#tab-doc-salida"
                           style="display:inline-flex;align-items:center;padding:7px 18px;border-radius:7px;font-size:0.82rem;font-weight:700;cursor:pointer;text-decoration:none;transition:all .2s;background:#134679;color:#fff;box-shadow:0 2px 6px rgba(19,70,121,.25);">
                            <i class="fas fa-file-contract mr-2"></i> Documento de Salida
                        </a>
                        <a class="doc-tab-pill" id="tab-ficha-salida-tab" href="#tab-ficha-salida"
                           style="display:inline-flex;align-items:center;padding:7px 18px;border-radius:7px;font-size:0.82rem;font-weight:700;cursor:pointer;text-decoration:none;transition:all .2s;background:transparent;color:#64748b;">
                            <i class="fas fa-file-invoice mr-2"></i> Ficha de Salida
                        </a>
                    </div>
                    <div class="tab-content" id="docHistoryTabsContent">
                        <div class="tab-pane fade show active" id="tab-doc-salida" role="tabpanel">
                            <div style="border-radius: 10px; overflow: hidden; border: 1px solid #e2e8f0;">
                                <div id="loaderDocSalida" class="text-center py-5 d-none">
                                    <div class="spinner-border" role="status" style="color: #134679; width: 2.5rem; height: 2.5rem;"></div>
                                </div>
                                <table class="table mb-0" style="font-size: 0.85rem;">
                                    <thead>
                                        <tr style="background: #f1f5f9;">
                                            <th style="color: #64748b; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; padding: 10px 16px; border-bottom: 1px solid #e2e8f0; border-top: none;">Documento específico</th>
                                            <th style="color: #64748b; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; padding: 10px 16px; border-bottom: 1px solid #e2e8f0; border-top: none;">Fecha</th>
                                            <th style="color: #64748b; font-weight: 700; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.5px; padding: 10px 16px; border-bottom: 1px solid #e2e8f0; border-top: none;">Usuario</th>
