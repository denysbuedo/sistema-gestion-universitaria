                    <button type="submit" id="btnSubmitFecha" class="btn btn-primary px-4 shadow-sm" style="border-radius: 8px; font-weight: 600; background: #134679; border-color: #134679;">
                        <i class="fas fa-check-circle mr-1"></i> GUARDAR FECHAS
                    </button>
                </div>
                {{ form_end(formFecha) }}
            </div>
        </div>
    </div>

{% endblock %}

{% block javascripts %}
    <script>
        window.docDataMap = {
            {% for item in registros %}
            "{{ item.id }}": {
                persona: "{{ (item.persona.primerNombre ~ ' ' ~ (item.persona.segundoNombre ?? '') ~ ' ' ~ item.persona.primerApellido ~ ' ' ~ (item.persona.segundoApellido ?? '')) | trim | e('js') }}",
                grado: "{{ (item.persona.gradoAcademico is not null ? item.persona.gradoAcademico.nombre : '') | e('js') }}",
                institucion: "{{ (item.institucionCubana is not null ? item.institucionCubana.siglas : '') | e('js') }}",
                pais: "{{ (item.pais is not null ? item.pais.nombre : '') | e('js') }}",
                fecha: "{{ item.fechaSalidaReal | date('d/m/Y') }}",
                estancia: "{{ item.tiempoEstancia | default('') | e('js') }}",
                estado: "{{ (item.estadoDocumentoSalida is not null ? item.estadoDocumentoSalida.nombre : '') | e('js') }}",
                consultaEmbajada: {{ item.fichaSalida is not null and item.fichaSalida.consultaEmbajada is not null ? (item.fichaSalida.consultaEmbajada ? 'true' : 'false') : 'null' }},
                fechaEntregaPasaporte: "{{ item.fechaEntregaPasaporte is not null ? item.fechaEntregaPasaporte | date('d/m/Y') : '' }}",
                fechaRecogidaPasaporte: "{{ item.fechaRecogidaPasaporte is not null ? item.fechaRecogidaPasaporte | date('d/m/Y') : '' }}"
            }{% if not loop.last %},{% endif %}
            {% endfor %}
        };

        // Fix dropdown recortado por overflow:hidden del wrapper DataTables
        $(document).on('show.bs.dropdown', 'table .dropdown', function () {
            var $toggle = $(this).find('[data-toggle="dropdown"]');
            var $menu   = $(this).find('.dropdown-menu');
            var offset  = $toggle.offset();
            var toggleH = $toggle.outerHeight();
            var menuW   = $menu.outerWidth() || 230;
            var left    = offset.left + $toggle.outerWidth() - menuW;
            $menu.appendTo('body').css({
                position: 'fixed',
                top:  offset.top + toggleH,
                left: Math.max(0, left),
                zIndex: 9999
            });
        }).on('hide.bs.dropdown', '.dropdown', function () {
            var $menu = $(this).find('.dropdown-menu');
            $menu.appendTo($(this)).css({ position: '', top: '', left: '', zIndex: '' });
        });

        function recargarDocs() {
            HoldOn.open({ theme: "sk-cube-grid", message: 'Por favor espere...', textColor: "white" });
            $.post("{{ path('app_documento_salida_index') }}", {
                estado: $('#estadoFicha').val(),
                clasificacion: $('#clasificacionDoc').val()
            }, function () {
                $(window).attr('location', window.location);
                HoldOn.close();
            });
        }
        $('#estadoFicha').change(recargarDocs);
        $('#clasificacionDoc').change(recargarDocs);

        // Tabs pill en modal historial — manejo manual de cambio de panel
        $(document).on('click', '.doc-tab-pill', function(e) {
            e.preventDefault();
            var target = $(this).attr('href');
            // Actualizar estilos
            $('.doc-tab-pill').css({'background':'transparent','color':'#64748b','box-shadow':'none'});
            $(this).css({'background':'#134679','color':'#fff','box-shadow':'0 2px 6px rgba(19,70,121,.25)'});
            // Mostrar panel correcto
            $('.tab-pane').removeClass('show active');
            $(target).addClass('show active');
        });

        $(document).on('click', '.btn-view-doc-history', function (e) {
            e.stopPropagation();
            var $btn = $(this);
            var id   = $btn.attr('data-id');
            var url  = $btn.attr('data-url') || '';
            
            // Buscar datos en el mapa
            var d = window.docDataMap[id] || {};
            var persona  = (d.persona    || '').trim() || '—';
            var grado    = d.grado       || '';
            var inst     = d.institucion || '';
            var pais     = d.pais        || '—';
            var fecha    = d.fecha       || '—';
            var estancia = d.estancia    || '—';
            var estado   = d.estado      || '—';

            var parts    = persona.split(/\s+/).filter(Boolean);
            var initials = (parts[0] ? parts[0][0] : '') + (parts.length > 1 ? parts[parts.length - 1][0] : '');

            // Poblar tarjeta de persona
            $('#hist2Avatar').text(initials.toUpperCase() || '?');
            $('#hist2PersonaName').text(persona);
            $('#hist2Grado').text(grado);
            $('#hist2Institucion').text(inst);
            $('#hist2Estado').text(estado);
            $('#hist2Pais').text(pais);
            $('#hist2Fecha').text(fecha);
            $('#hist2Estancia').text(estancia);
            $('#hist2Embajada').text(d.consultaEmbajada === true ? 'Sí' : (d.consultaEmbajada === false ? 'No' : '—'));
            $('#hist2FechaEntrega').text(d.fechaEntregaPasaporte || '—');
            $('#hist2FechaRecogida').text(d.fechaRecogidaPasaporte || '—');

            let bodyDoc = $('#bodyDocSalida');
            let bodyFicha = $('#bodyFichaSalida');
            let loader = $('#loaderDocSalida');
            bodyDoc.empty();
            bodyFicha.empty();
            loader.removeClass('d-none');
            $('#docSalidaHistoryModal').modal('show');
            $('#tab-doc-salida-tab').tab('show');
            // Resetear estilos de pills al abrir
            $('#tab-doc-salida-tab').css({'background':'#134679','color':'#fff','box-shadow':'0 2px 6px rgba(19,70,121,.25)'});
            $('#tab-ficha-salida-tab').css({'background':'transparent','color':'#64748b','box-shadow':'none'});
            $.get(url, function (data) {
                loader.addClass('d-none');
                
                function renderEmptyState(message) {
                    return `
                        <tr>
                            <td colspan="4" style="text-align: center; padding: 40px 20px;">
                                <div style="width: 56px; height: 56px; border-radius: 50%; background: #f1f5f9; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 12px;">
                                    <i class="fas fa-folder-open" style="font-size: 1.4rem; color: #94a3b8;"></i>
                                </div>
                                <p style="color: #64748b; font-size: 0.88rem; font-weight: 600; margin: 0;">${message}</p>
                            </td>
                        </tr>
                    `;
                }

                if (data.documento.length === 0) {
                    bodyDoc.append(renderEmptyState('Sin documentos específicos registrados para este trámite.'));
                } else {
                    data.documento.forEach(doc => { bodyDoc.append(renderDocRow(doc)); });
                }
                if (data.ficha.length === 0) {
                    bodyFicha.append(renderEmptyState('Sin documentos de ficha asociados.'));
                } else {
                    data.ficha.forEach(doc => { bodyFicha.append(renderDocRow(doc)); });
                }
            }).fail(function(){
                loader.addClass('d-none');
                toastr.error("Error al cargar el historial documental.");
            });
        });

        function renderDocRow(doc) {
            var ext = (doc.nombre || '').split('.').pop().toLowerCase();
            var iconClass = ext === 'pdf' ? 'fa-file-pdf' : (ext === 'doc' || ext === 'docx' ? 'fa-file-word' : (ext === 'jpg' || ext === 'png' ? 'fa-file-image' : 'fa-file-alt'));
            var iconColor = ext === 'pdf' ? '#e53e3e' : (ext === 'doc' || ext === 'docx' ? '#2b6cb0' : (ext === 'jpg' || ext === 'png' ? '#d69e2e' : '#718096'));
            return `
                <tr style="border-bottom: 1px solid #f1f5f9; transition: background 0.1s;" onmouseover="this.style.background='#f8fafc'" onmouseout="this.style.background=''">
                    <td style="padding: 12px 16px; vertical-align: middle;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="width: 38px; height: 38px; border-radius: 8px; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <i class="fas ${iconClass}" style="font-size: 1.1rem; color: ${iconColor};"></i>
                            </div>
                            <span style="font-weight: 600; color: #1a2e44; font-size: 0.85rem;">${doc.nombre}</span>
                        </div>
                    </td>
                    <td style="padding: 12px 16px; vertical-align: middle; color: #4a5568; font-size: 0.83rem; white-space: nowrap;">
                        <i class="far fa-clock mr-1" style="color: #94a3b8;"></i>${doc.fecha}
                    </td>
                    <td style="padding: 12px 16px; vertical-align: middle;">
                        <span style="background: #e8edf5; color: #134679; font-size: 0.72rem; font-weight: 700; padding: 3px 10px; border-radius: 20px; display: inline-block;">
                            <i class="fas fa-user mr-1"></i>${doc.usuario}
                        </span>
                    </td>
                    <td style="padding: 12px 16px; vertical-align: middle; text-align: center;">
                        <a href="${doc.url}" target="_blank"
                           title="Ver / Descargar"
                           style="display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 8px; background: #134679; color: #fff; transition: background 0.15s; text-decoration: none;"
                           onmouseover="this.style.background='#0e3460'" onmouseout="this.style.background='#134679'">
                            <i class="fas fa-download" style="font-size: 0.8rem;"></i>
                        </a>
                    </td>
                </tr>
            `;
        }

        $(document).on('click', '.btn-finalizar-salida', function() {
            let url = $(this).data('url');
            $('#formFinalizarSalida').attr('action', url);
            $('#finalFechaEntregaPasaporte').val('');
            $('#modalFinalizarSalida').modal('show');
        });

        $('#modalFinalizarSalida').on('shown.bs.modal', function() {
            var $el = $('#finalFechaEntregaPasaporte');
            if ($el.data('DateTimePicker')) $el.data('DateTimePicker').destroy();
            $el.datetimepicker({ format: 'DD/MM/YYYY', locale: 'es', useCurrent: false });
        });

        $('#formFinalizarSalida').on('submit', function(e) {
            if (!$('#finalFechaEntregaPasaporte').val()) {
                e.preventDefault();
                toastr.warning('La fecha de entrega del pasaporte es obligatoria.');
                return;
            }
            $('#btnSubmitFinalizar').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
            HoldOn.open({ theme: "sk-cube-grid", message: 'Procesando...', textColor: "white" });
        });

        $(document).on('click', '.btn-adjuntar-informe', function() {
            let url = $(this).data('url');
            $('#formInformeEjecutivo').attr('action', url);
            $('#informeEjecutivoFile').val('');
            $('#informeEjecutivoFile').next('.custom-file-label').html('Seleccionar documento PDF...');
            $('#modalInformeEjecutivo').modal('show');
        });

        $('#informeEjecutivoFile').on('change', function() {
            let fileName = $(this).val().split('\\').pop();
            $(this).next('.custom-file-label').addClass("selected").html(fileName);
        });

        $('#formInformeEjecutivo').on('submit', function() {
            if (!$('#informeEjecutivoFile').val()) {
                toastr.warning('Debe seleccionar el informe ejecutivo en PDF.');
                return false;
            }
            $('#btnSubmitInforme').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
            HoldOn.open({ theme: "sk-cube-grid", message: 'Subiendo informe y finalizando trámite...', textColor: "white" });
        });

        // Lógica Asignar Trámite
        $(document).on('click', '.btn-asignar-tramite', function() {
            let url      = $(this).data('url');
            let fetchUrl = $(this).data('fetch-url');
            let persona  = ($(this).data('persona') || '').trim();
            let grado    = $(this).data('grado')       || '';
            let inst     = $(this).data('institucion') || '';
            let pais     = $(this).data('pais')        || '';
            let fecha    = $(this).data('fecha')       || '';
            let estancia = $(this).data('estancia')    || '';
            let estado   = $(this).data('estado')      || '';
            let docId   = $(this).data('doc-id');
            let docData = window.docDataMap[docId] || {};

            let modal  = $('#modalAsignarTramite');
            let select = modal.find('select');

            // Iniciales del avatar
            var parts    = persona.split(/\s+/).filter(Boolean);
            var initials = (parts[0] ? parts[0][0] : '') + (parts.length > 1 ? parts[parts.length - 1][0] : '');
            $('#asigAvatar').text(initials.toUpperCase() || '?');

            // Pre-poblar con datos del botón
            $('#asigPersonaName').text(persona || '—');
            $('#asigGrado').text(grado);
            $('#asigInstitucion').text(inst);
            $('#asigPais').text(pais || '—');
            $('#asigFecha').text(fecha || '—');
            $('#asigEstancia').text(estancia || '—');
            $('#asigEstado').text(estado || '—');
            $('#asigEmbajada').text(docData.consultaEmbajada === true ? 'Sí' : (docData.consultaEmbajada === false ? 'No' : '—'));
            $('#asigFechaEntrega').text(docData.fechaEntregaPasaporte || '—');
            $('#asigFechaRecogida').text(docData.fechaRecogidaPasaporte || '—');

            select.val(null).trigger('change');
            modal.find('form').attr('action', url);
            modal.modal('show');

            $.get(fetchUrl, function(data) {
                // Si la persona ya tiene pasaporte habilitado, deshabilitar la opción de confección
                var idConfeccion = data.idTramiteConfeccion;
                var $opt = select.find('option[value="' + idConfeccion + '"]');
                if (data.tienePasaporteHabilitado) {
                    $opt.prop('disabled', true).attr('title', 'Esta persona ya tiene un pasaporte habilitado');
                    // Quitar de la selección actual si estuviera marcado
                    var vals = (data.tramites || []).filter(function(v) { return v != idConfeccion; });
                    select.val(vals).trigger('change');
                    // Mostrar aviso en el modal
                    if (!$('#aviso-pasaporte-habilitado').length) {
                        select.closest('.form-group').before(
                            '<div id="aviso-pasaporte-habilitado" class="alert alert-warning py-2 px-3 mb-3" style="font-size:0.82rem;border-radius:8px;">' +
                            '<i class="fas fa-exclamation-triangle mr-1"></i> Esta persona ya tiene un <strong>pasaporte habilitado</strong>. El trámite de confección de pasaporte no está disponible.' +
                            '</div>'
                        );
                    }
                } else {
                    $opt.prop('disabled', false).removeAttr('title');
                    $('#aviso-pasaporte-habilitado').remove();
                    select.val(data.tramites).trigger('change');
                }
            }).fail(function() {
                toastr.error("Error al cargar los trámites asignados.");
            });
        });

        $('#formAsignarTramite').on('submit', function() {
            $(this).find('button[type="submit"]').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
            HoldOn.open({ theme: "sk-cube-grid", message: 'Guardando asignaciones...', textColor: "white" });
        });

        $('#modalAsignarTramite').on('hidden.bs.modal', function() {
            $('#aviso-pasaporte-habilitado').remove();
            $(this).find('select option').prop('disabled', false).removeAttr('title');
        });

        // Lógica Aprobar Trámites
        $(document).on('click', '.btn-aprobar-tramite', function() {
            let fetchUrl = $(this).data('fetch-url');
            let persona  = ($(this).data('persona') || '').trim();
            let grado    = $(this).data('grado')       || '';
            let inst     = $(this).data('institucion') || '';
            let pais     = $(this).data('pais')        || '';
            let fecha    = $(this).data('fecha')       || '';
            let estancia = $(this).data('estancia')    || '';
            let estado   = $(this).data('estado')      || '';
            let docId   = $(this).data('doc-id');
            let docData = window.docDataMap[docId] || {};

            let body   = $('#bodyAprobar');
            let loader = $('#loaderAprobar');

            // Iniciales del avatar
            var parts    = persona.split(/\s+/).filter(Boolean);
            var initials = (parts[0] ? parts[0][0] : '') + (parts.length > 1 ? parts[parts.length - 1][0] : '');
            $('#aprobAvatar').text(initials.toUpperCase() || '?');

            // Pre-poblar con datos del botón
            $('#aprobPersonaName').text(persona || '—');
            $('#aprobGrado').text(grado);
            $('#aprobInstitucion').text(inst);
            $('#aprobPais').text(pais || '—');
            $('#aprobFecha').text(fecha || '—');
            $('#aprobEstancia').text(estancia || '—');
            $('#aprobEstadoActual').text(estado || '—');
            $('#aprobEmbajada').text(docData.consultaEmbajada === true ? 'Sí' : (docData.consultaEmbajada === false ? 'No' : '—'));
            $('#aprobFechaEntrega').text(docData.fechaEntregaPasaporte || '—');
            $('#aprobFechaRecogida').text(docData.fechaRecogidaPasaporte || '—');

            body.empty();
            loader.removeClass('d-none');
            $('#modalAprobarTramites').modal('show');

            $.get(fetchUrl, function(data) {
                loader.addClass('d-none');
                if (data.estado) $('#aprobEstadoActual').text(data.estado);
                
                if (data.tramites.length === 0) {
                    body.html(`
                        <div class="text-center py-4" style="color:#94a3b8;">
                            <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                            <span style="font-size:0.85rem;">No hay trámites asignados.</span>
                        </div>`);
                } else {
                    let totalListo = data.tramites.filter(t => t.listo).length;
                    let total = data.tramites.length;
                    let pct = total > 0 ? Math.round(totalListo / total * 100) : 0;

                    let header = `
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span style="font-size:0.72rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.7px;">
                                ${total} trámite${total !== 1 ? 's' : ''}
                            </span>
                            <span id="aprobCounter" style="font-size:0.78rem;font-weight:700;color:#134679;">
                                ${totalListo}/${total} completados
                            </span>
                        </div>
                        <div id="aprobProgressBar" style="height:4px;background:#e2e8f0;border-radius:4px;margin-bottom:16px;overflow:hidden;">
                            <div id="aprobProgressFill" style="height:100%;width:${pct}%;background:linear-gradient(90deg,#134679,#2563eb);border-radius:4px;transition:width .35s ease;"></div>
                        </div>
                    `;
                    body.html(header);

                    data.tramites.forEach((item, idx) => {
                        let isListo    = !!item.listo;
                        let bloqueado  = !!item.bloqueado;
                        let bgCard     = isListo ? 'linear-gradient(135deg,#f0fdf4,#dcfce7)' : (bloqueado ? 'linear-gradient(135deg,#fffbeb,#fef3c7)' : '#fff');
                        let borderCard = isListo ? '#86efac' : (bloqueado ? '#fcd34d' : '#e2e8f0');
                        let bgNum      = isListo ? '#16a34a' : (bloqueado ? '#d97706' : '#cbd5e1');
                        let colorName  = isListo ? '#15803d' : (bloqueado ? '#92400e' : '#1a2e44');
                        let bgTrack    = isListo ? '#16a34a' : '#cbd5e1';
                        let thumbX     = isListo ? '24px' : '0px';
                        let statusHtml = isListo
                            ? '<i class="fas fa-check-circle mr-1"></i>Completado'
                            : (bloqueado
                                ? '<i class="fas fa-lock mr-1"></i>Bloqueado — pasaporte en Pendiente'
                                : '<i class="fas fa-clock mr-1"></i>Pendiente');
                        let statusColor = isListo ? '#16a34a' : (bloqueado ? '#d97706' : '#94a3b8');
                        let toggleCursor = bloqueado ? 'not-allowed' : 'pointer';
                        let card = $(`
                            <div class="tramite-card d-flex align-items-center justify-content-between"
                                 data-id="${item.id}"
                                 data-bloqueado="${bloqueado ? '1' : '0'}"
                                 style="background:${bgCard};
                                        border:1.5px solid ${borderCard};
                                        border-radius:10px;padding:14px 18px;margin-bottom:10px;
                                        transition:all .25s ease;cursor:default;">
                                <div class="d-flex align-items-center" style="min-width:0;flex:1;">
                                    <div class="tramite-num" style="width:26px;height:26px;border-radius:50%;
                                                background:${bgNum};color:white;
                                                display:flex;align-items:center;justify-content:center;
                                                font-size:0.7rem;font-weight:700;flex-shrink:0;
                                                transition:background .25s ease;">${idx + 1}</div>
                                    <div style="margin-left:12px;min-width:0;">
                                        <div class="tramite-nombre" style="font-size:0.88rem;font-weight:600;
                                                     color:${colorName};
                                                     transition:color .25s ease;">${item.nombre}</div>
                                        <div class="tramite-status" style="font-size:0.72rem;font-weight:600;
                                                     color:${statusColor};margin-top:2px;
                                                     transition:color .25s ease;">
                                            ${statusHtml}
                                        </div>
                                    </div>
                                </div>
                                <label class="tramite-toggle mb-0 ml-3" style="flex-shrink:0;" title="${bloqueado ? 'El pasaporte de esta persona está Pendiente de confección' : ''}">
                                    <input type="checkbox" class="switch-aprobar" ${isListo ? 'checked' : ''} style="display:none;">
                                    <span class="toggle-track" style="display:inline-flex;align-items:center;width:52px;height:28px;
                                               border-radius:14px;background:${bgTrack};
                                               padding:3px;cursor:${toggleCursor};transition:background .25s ease;position:relative;
                                               ${bloqueado ? 'opacity:0.5;' : ''}">
                                        <span class="toggle-thumb" style="width:22px;height:22px;border-radius:50%;background:white;
                                                     box-shadow:0 1px 4px rgba(0,0,0,.2);
                                                     transform:translateX(${thumbX});
                                                     transition:transform .25s ease;display:block;"></span>
                                    </span>
                                </label>
                            </div>
                        `);
                        body.append(card);
                    });

                    body.on('click', '.tramite-toggle', function(e) {
                        e.preventDefault();
                        let $card  = $(this).closest('.tramite-card');
                        if ($card.data('bloqueado') == '1') {
                            toastr.warning('El pasaporte de esta persona está <b>Pendiente</b> de confección. No se puede marcar este trámite como completado hasta que el pasaporte esté habilitado.', '', { timeOut: 5000, escapeHtml: false });
                            return;
                        }
                        let $cb    = $card.find('.switch-aprobar');
                        let id     = $card.data('id');
                        let newVal = $cb.is(':checked') ? 0 : 1;
                        let $track = $card.find('.toggle-track');
                        let $thumb = $card.find('.toggle-thumb');
                        let $num   = $card.find('.tramite-num');
                        let $name  = $card.find('.tramite-nombre');
                        let $stat  = $card.find('.tramite-status');

                        // Optimistic UI
                        $cb.prop('checked', !!newVal);
                        if (newVal) {
                            $card.css({'background':'linear-gradient(135deg,#f0fdf4,#dcfce7)','border-color':'#86efac'});
                            $track.css('background','#16a34a');
                            $thumb.css('transform','translateX(24px)');
                            $num.css('background','#16a34a');
                            $name.css('color','#15803d');
                            $stat.html('<i class="fas fa-check-circle mr-1"></i>Completado').css('color','#16a34a');
                        } else {
                            $card.css({'background':'#fff','border-color':'#e2e8f0'});
                            $track.css('background','#cbd5e1');
                            $thumb.css('transform','translateX(0px)');
                            $num.css('background','#cbd5e1');
                            $name.css('color','#1a2e44');
                            $stat.html('<i class="fas fa-clock mr-1"></i>Pendiente').css('color','#94a3b8');
                        }

                        // Actualizar contador y barra
                        let listos = body.find('.switch-aprobar:checked').length;
                        let tot    = body.find('.switch-aprobar').length;
                        let p      = tot > 0 ? Math.round(listos / tot * 100) : 0;
                        $('#aprobCounter').text(listos + '/' + tot + ' completados');
                        $('#aprobProgressFill').css('width', p + '%');

                        function revertirCard() {
                            $cb.prop('checked', !newVal);
                            if (!newVal) {
                                $card.css({'background':'linear-gradient(135deg,#f0fdf4,#dcfce7)','border-color':'#86efac'});
                                $track.css('background','#16a34a');
                                $thumb.css('transform','translateX(24px)');
                                $num.css('background','#16a34a');
                                $name.css('color','#15803d');
                                $stat.html('<i class="fas fa-check-circle mr-1"></i>Completado').css('color','#16a34a');
                            } else {
                                $card.css({'background':'#fff','border-color':'#e2e8f0'});
                                $track.css('background','#cbd5e1');
                                $thumb.css('transform','translateX(0px)');
                                $num.css('background','#cbd5e1');
                                $name.css('color','#1a2e44');
                                $stat.html('<i class="fas fa-clock mr-1"></i>Pendiente').css('color','#94a3b8');
                            }
                            let l2 = body.find('.switch-aprobar:checked').length;
                            let t2 = body.find('.switch-aprobar').length;
                            let p2 = t2 > 0 ? Math.round(l2 / t2 * 100) : 0;
                            $('#aprobCounter').text(l2 + '/' + t2 + ' completados');
                            $('#aprobProgressFill').css('width', p2 + '%');
                        }

                        HoldOn.open({ theme: "sk-cube-grid", message: 'Actualizando...', textColor: "white" });
                        $.ajax({
                            url: "{{ path('app_documento_salida_aprobar_tramites_guardar') }}",
                            type: 'POST',
                            data: { id: id, valor: newVal },
                            success: function() {
                                HoldOn.close();
                                toastr.success("Trámite actualizado.");
                            },
                            statusCode: {
                                422: function(xhr) {
                                    HoldOn.close();
                                    let msg = xhr.responseJSON && xhr.responseJSON.error
                                        ? xhr.responseJSON.error
                                        : 'No se puede completar este trámite.';
                                    toastr.warning(msg, '', { timeOut: 6000 });
                                    revertirCard();
                                }
                            },
                            error: function(xhr) {
                                if (xhr.status !== 422) {
                                    HoldOn.close();
                                    toastr.error("Error al actualizar.");
                                    revertirCard();
                                }
                            }
                        });
                    });
                }
            }).fail(function() {
                loader.addClass('d-none');
                toastr.error("Error al cargar los trámites.");
            });
        });

        // Al cerrar el modal de aprobar, recargamos la página para ver los cambios de estado global
        $('#modalAprobarTramites').on('hidden.bs.modal', function () {
            HoldOn.open({ theme: "sk-cube-grid", message: 'Actualizando vista...', textColor: "white" });
            location.reload();
        });

        // Lógica Asignar Fecha Salida / Regreso
        $(document).on('click', '.btn-fecha-salida-regreso', function() {
            let url          = $(this).data('url');
            let persona      = ($(this).data('persona')        || '').trim();
            let grado        = $(this).data('grado')           || '';
            let inst         = $(this).data('institucion')     || '';
            let pais         = $(this).data('pais')            || '';
            let fechaSalida   = $(this).data('fecha-salida')   || '';
            let fechaRegreso  = $(this).data('fecha-regreso')  || '';
            let fechaEntrega  = $(this).data('fecha-entrega')  || '';
            let estancia     = $(this).data('estancia')        || '';
            let estado       = $(this).data('estado')          || '';
            let docId   = $(this).data('doc-id');
            let docData = window.docDataMap[docId] || {};

            // Iniciales del avatar
            var parts    = persona.split(/\s+/).filter(Boolean);
            var initials = (parts[0] ? parts[0][0] : '') + (parts.length > 1 ? parts[parts.length - 1][0] : '');
            $('#fechaAvatar').text(initials.toUpperCase() || '?');

            // Pre-poblar tarjeta de persona
            $('#fechaPersonaName').text(persona || '—');
            $('#fechaGrado').text(grado);
            $('#fechaInstitucion').text(inst);
            $('#fechaPais').text(pais || '—');
            $('#fechaEstancia').text(estancia || '—');
            $('#fechaEstado').text(estado || '—');
            $('#fechaEmbajada').text(docData.consultaEmbajada === true ? 'Sí' : (docData.consultaEmbajada === false ? 'No' : '—'));
            $('#fechaFechaEntrega').text(docData.fechaEntregaPasaporte || '—');
            $('#fechaFechaRecogida').text(docData.fechaRecogidaPasaporte || '—');

            // Establecer valores de fechas
            $('#asignar_fecha_salida_fechaSalidaReal').val(fechaSalida);
            $('#asignar_fecha_salida_fechaRegresoReal').val(fechaRegreso);
            $('#asignar_fecha_salida_fechaEntregaPasaporte').val(fechaEntrega);

            // Establecer acción del formulario
            $('#formFechaSalidaRegreso').attr('action', url);

            $('#modalFechaSalidaRegreso').modal('show');
        });

        // Inicializar datetimepickers al mostrar el modal
        $('#modalFechaSalidaRegreso').on('shown.bs.modal', function() {
            var $fpEl  = $('#asignar_fecha_salida_fechaSalidaReal');
            var $frEl  = $('#asignar_fecha_salida_fechaRegresoReal');
            var $fepEl = $('#asignar_fecha_salida_fechaEntregaPasaporte');

            if ($fpEl.data('DateTimePicker'))  $fpEl.data('DateTimePicker').destroy();
            if ($frEl.data('DateTimePicker'))  $frEl.data('DateTimePicker').destroy();
            if ($fepEl.data('DateTimePicker')) $fepEl.data('DateTimePicker').destroy();

            $fpEl.datetimepicker({ format: 'DD/MM/YYYY', locale: 'es' });
            $frEl.datetimepicker({ format: 'DD/MM/YYYY', locale: 'es', useCurrent: false });
            $fepEl.datetimepicker({ format: 'DD/MM/YYYY', locale: 'es', useCurrent: false });

            $fpEl.off('dp.change').on('dp.change', function(e) {
                if (e.date) $frEl.data('DateTimePicker').minDate(moment(e.date).add(1, 'days'));
            });
            $frEl.off('dp.change').on('dp.change', function(e) {
                var dep = $fpEl.data('DateTimePicker') ? $fpEl.data('DateTimePicker').date() : null;
                if (e.date && dep && e.date.isSameOrBefore(dep)) {
                    toastr.warning('La fecha de regreso debe ser posterior a la fecha de salida.');
                    $frEl.data('DateTimePicker').clear();
                }
            });
        });

        $('#formFechaSalidaRegreso').on('submit', function() {
            var $fp = $('#asignar_fecha_salida_fechaSalidaReal').val();
            var $fr = $('#asignar_fecha_salida_fechaRegresoReal').val();
            if (!$fp || !$fr) {
                toastr.warning('Debe completar ambas fechas.');
                return false;
            }
            $('#btnSubmitFecha').prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Guardando...');
            HoldOn.open({ theme: "sk-cube-grid", message: 'Guardando fechas...', textColor: "white" });
        });
    </script>
{% endblock %}
