{% extends 'baseAdmin.html.twig' %}

{% block title %}Nueva Ficha de Salida{% endblock %}

{% block body %}
<style>
    .fs-title {
        font-size: 1.15rem;
        font-weight: 700;
        color: #134679;
        border-left: 4px solid #134679;
        padding-left: 12px;
        margin-bottom: 24px;
        line-height: 1.3;
    }
    .fs-title small {
        display: block;
        font-size: .78rem;
        font-weight: 400;
        color: #6c757d;
        margin-top: 2px;
    }

    /* ── Buscador ── */
    .fs-search-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 36px 40px;
        margin-bottom: 24px;
        text-align: center;
    }
    .fs-search-card .fs-search-icon {
        width: 56px; height: 56px;
        background: #eef3fa;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 14px;
        font-size: 1.4rem;
        color: #134679;
    }
    .fs-search-card h5 {
        font-weight: 700;
        color: #1a2e44;
        margin-bottom: 4px;
        font-size: 1rem;
    }
    .fs-search-card p {
        color: #718096;
        font-size: .85rem;
        margin-bottom: 22px;
    }
    .fs-search-input-wrap {
        max-width: 560px;
        margin: 0 auto;
        display: flex;
        gap: 8px;
    }
    .fs-search-input-wrap input {
        flex: 1;
        border: 1.5px solid #cbd5e0;
        border-radius: 30px;
        padding: 11px 20px;
        font-size: .9rem;
        color: #2d3748;
        outline: none;
        transition: border-color .15s, box-shadow .15s;
        background: #f8fafc;
    }
    .fs-search-input-wrap input:focus {
        border-color: #134679;
        box-shadow: 0 0 0 3px rgba(19,70,121,.1);
        background: #fff;
    }
    .fs-search-input-wrap input::placeholder { color: #a0aec0; }
    .fs-search-input-wrap button {
        flex-shrink: 0;
        background: #134679;
        border: none;
        border-radius: 30px;
        padding: 0 22px;
        height: 44px;
        color: #fff;
        font-size: .85rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
        display: flex; align-items: center; gap: 6px;
        white-space: nowrap;
    }
    .fs-search-input-wrap button:hover { background: #0e3460; }

    /* Sin resultados */
    .fs-no-results {
        max-width: 560px;
        margin: 16px auto 0;
        background: #fffbeb;
        border: 1px solid #f6e05e;
        border-radius: 8px;
        padding: 12px 16px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        font-size: .85rem;
        color: #744210;
        text-align: left;
    }
    .fs-no-results i { color: #d69e2e; margin-top: 2px; flex-shrink: 0; }
    .btn-new-person {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 14px;
        background: transparent;
        border: 1.5px solid #38a169;
        color: #38a169;
        border-radius: 20px;
        padding: 6px 18px;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s;
        text-decoration: none;
    }
    .btn-new-person:hover { background: #38a169; color: #fff; text-decoration: none; }

    /* ── Lista de resultados ── */
    .fs-results-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
    }
    .fs-results-header h6 {
        font-weight: 700;
        color: #1a2e44;
        font-size: .9rem;
        margin: 0;
    }
    .fs-results-header .fs-badge {
        font-size: .75rem;
        background: #eef3fa;
        color: #134679;
        border-radius: 20px;
        padding: 3px 12px;
        font-weight: 600;
    }

    /* Filas de persona */
    .fs-person-row {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px 18px;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 16px;
        transition: box-shadow .15s, border-color .15s;
    }
    .fs-person-row:hover {
        border-color: #134679;
        box-shadow: 0 2px 10px rgba(19,70,121,.08);
    }
    .fs-person-avatar {
        width: 44px; height: 44px;
        border-radius: 50%;
        background: #eef3fa;
        display: flex; align-items: center; justify-content: center;
        color: #134679;
        font-size: 1rem;
        font-weight: 700;
        flex-shrink: 0;
        text-transform: uppercase;
        overflow: hidden;
        border: 2px solid #e2e8f0;
    }
    .fs-person-avatar img {
        width: 100%; height: 100%;
        object-fit: cover;
    }
    .fs-person-info { flex: 1; min-width: 0; }
    .fs-person-name {
        font-weight: 700;
        color: #1a2e44;
        font-size: .9rem;
        margin: 0 0 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .fs-person-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 4px 14px;
        font-size: .78rem;
        color: #718096;
    }
    .fs-person-meta span { display: flex; align-items: center; gap: 4px; }
    .fs-person-meta i { color: #a0aec0; font-size: .7rem; }
    .fs-person-badge {
        font-size: .72rem;
        background: #eef3fa;
        color: #134679;
        border-radius: 4px;
        padding: 2px 8px;
        font-weight: 600;
        white-space: nowrap;
        flex-shrink: 0;
        align-self: center;
    }
    .btn-fs-select {
        flex-shrink: 0;
        background: #134679;
        border: none;
        color: #fff;
        border-radius: 8px;
        padding: 7px 16px;
        font-size: .8rem;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }
    .btn-fs-select:hover { background: #0e3460; }
</style>

<div class="fs-title">
    Nueva Ficha de Salida
    <small>Busque la persona para la cual desea registrar la solicitud de viaje al exterior</small>
</div>

{# ── Buscador ── #}
<div class="fs-search-card">
    <div class="fs-search-icon"><i class="fas fa-search"></i></div>
    <h5>Búsqueda de persona</h5>
    <p>Ingrese el carnet de identidad, número de serie, nombre o apellidos</p>

    <form id="form" method="post" action="{{ path('app_ficha_salida_registrar') }}">
        <div class="fs-search-input-wrap">
            <input type="search" name="busqueda" id="busqueda"
                   autofocus
                   placeholder="Ej: García, 88010618607, Juan..."
                   value="{{ busqueda ?? '' }}">
            <button type="submit"><i class="fas fa-search"></i> Buscar</button>
        </div>

        {% if busqueda is not null and registros|length == 0 %}
            <div class="fs-no-results">
                <i class="fas fa-exclamation-circle"></i>
                <div>
                    No se encontró ninguna persona con el criterio <strong>"{{ busqueda }}"</strong>.
                    Verifique los datos ingresados o registre una nueva persona en el sistema.
                </div>
            </div>
            <div>
                <button id="btn_nuevo_registro" type="button" class="btn-new-person">
                    <i class="fas fa-user-plus"></i> Registrar nueva persona
                </button>
            </div>
        {% endif %}
    </form>
</div>

{# ── Resultados ── #}
<div id="results-container-wrapper" {% if registros|length == 0 %}style="display:none;"{% endif %}>
    <div class="fs-results-header">
        <h6><i class="fas fa-users mr-1" style="color:#134679"></i> Resultados encontrados</h6>
        <span class="fs-badge" id="results-count">{{ registros|length }} persona{{ registros|length != 1 ? 's' : '' }}</span>
    </div>

    <div id="results-container">
        {% include 'modules/tramite/ficha_salida/_results_list.html.twig' %}
    </div>

    <div id="infinite-scroll-loader" style="display: none; text-align: center; padding: 20px;">
        <div class="spinner-border text-primary" role="status">
            <span class="sr-only">Cargando...</span>
        </div>
        <p class="text-muted mt-2" style="font-size: 0.8rem;">Cargando más resultados...</p>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    let offset = {{ registros|length }};
    const limit = {{ limit ?? 10 }};
    let loading = false;
    let hasMore = offset >= limit;
    const busqueda = "{{ busqueda|escape('js') }}";

    $(document).ready(function() {
        $(window).scroll(function() {
            if ($(window).scrollTop() + $(window).height() >= $(document).height() - 100) {
                if (!loading && hasMore && busqueda) {
                    loadMoreResults();
                }
            }
        });

        // Event delegation for dynamically added "Seleccionar" buttons
        $(document).on('click', '.btn-fs-select', function(e) {
            e.preventDefault();
            const url = $(this).data('url');
            window.location = url;
        });
    });

    function loadMoreResults() {
        loading = true;
        $('#infinite-scroll-loader').show();

        $.ajax({
            url: "{{ path('app_ficha_salida_registrar') }}",
            type: 'GET',
            data: {
                busqueda: busqueda,
                offset: offset
            },
            success: function(html) {
                if (html.trim() === '') {
                    hasMore = false;
                } else {
                    const $newElements = $(html);
                    $('#results-container').append($newElements);
                    
                    const newCount = $('#results-container .fs-person-row').length;
                    $('#results-count').text(newCount + ' persona' + (newCount !== 1 ? 's' : ''));
                    
                    offset += $newElements.filter('.fs-person-row').length;
                    if ($newElements.filter('.fs-person-row').length < limit) {
                        hasMore = false;
                    }
                }
                loading = false;
                $('#infinite-scroll-loader').hide();
            },
            error: function() {
                loading = false;
                $('#infinite-scroll-loader').hide();
            }
        });
    }

    $('#form').on('submit', function() {
        // Al enviar el formulario, el offset se reinicia
        HoldOn.open({
            theme: "sk-cube-grid",
            message: 'Buscando...',
            textColor: "white"
        });
    });

    $('#btn_nuevo_registro').on('click', function (e) {
        e.preventDefault();
        window.location = '{{ path('app_persona_registrar', {'origin': 'ficha_salida'}) }}';
    });
</script>
{% endblock %}
