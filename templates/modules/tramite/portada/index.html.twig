{% extends 'baseAdmin.html.twig' %}

{% block title %}Panel de Control — Misiones{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --brand:        #0e375f;
        --brand-mid:    #134679;
        --brand-dark:   #071e3d;
        --brand-light:  #1a5898;
        --surface:      #f1f5f9;
        --white:        #ffffff;
        --text-main:    #1a2e44;
        --text-sub:     #64748b;
        --text-muted:   #94a3b8;
        --border:       #e2e8f0;
        --shadow-sm:    0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.05);
        --shadow-md:    0 4px 16px rgba(0,0,0,.10), 0 2px 6px rgba(0,0,0,.06);
        --shadow-lg:    0 10px 30px rgba(0,0,0,.12), 0 4px 10px rgba(0,0,0,.07);
        --radius:       14px;
        --transition:   .22s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ── Reset de contenedores de AdminLTE para esta página ── */
    .content-wrapper {
        background: var(--surface) !important;
        padding: 0 !important;
        min-height: auto !important;
    }
    .content-header { display: none !important; }
    .pm-btn {
        display: inline-flex; align-items: center; gap: 7px;
        padding: 9px 18px; border-radius: 9px; font-size: 13px; font-weight: 600;
        border: none; cursor: pointer; transition: var(--transition); text-decoration: none;
    }
    .pm-btn-outline {
        background: #f1f5f9;
        color: var(--brand-mid);
        border: 1.5px solid var(--border);
    }
    .pm-btn-outline:hover { background: #e2e8f0; }
    .pm-btn-white {
        background: var(--brand-mid);
        color: #fff;
    }
    .pm-btn-white:hover { background: var(--brand-dark); color: #fff; }

    /* ── Contenido ── */
    .pm-main {
        padding: 20px 15px 40px;
    }

    /* ── Separador sección ── */
    .pm-section {
        display: flex; align-items: center; gap: 14px;
        margin-bottom: 16px;
    }
    .pm-section + .pm-section,
    .pm-section-gap { margin-top: 32px; }
    .pm-section-label {
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 1px;
        color: var(--text-muted); white-space: nowrap;
    }
    .pm-section-line { flex: 1; height: 1px; background: var(--border); }

    /* ── KPI cards ── */
    .pm-kpi-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }
    .pm-kpi-card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
        padding: 22px 20px 18px;
        position: relative;
        overflow: hidden;
        transition: var(--transition);
    }
    .pm-kpi-card::before {
        content: '';
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 3px;
        background: var(--kpi-color, var(--brand-mid));
        border-radius: var(--radius) var(--radius) 0 0;
    }
    .pm-kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-lg);
        border-color: transparent;
    }
    .pm-kpi-bg {
        position: absolute;
        width: 110px; height: 110px;
        border-radius: 50%;
        bottom: -35px; right: -25px;
        background: radial-gradient(circle, var(--kpi-color, var(--brand-mid)) 0%, transparent 70%);
        opacity: .06;
        pointer-events: none;
    }
    .pm-kpi-head {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 14px;
    }
    .pm-kpi-icon {
        width: 42px; height: 42px; border-radius: 11px;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px;
        color: var(--kpi-color, var(--brand-mid));
        background: color-mix(in srgb, var(--kpi-color, var(--brand-mid)) 12%, transparent);
    }
    .pm-kpi-badge {
        font-size: 10px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .8px;
        color: var(--kpi-color, var(--brand-mid));
        background: color-mix(in srgb, var(--kpi-color, var(--brand-mid)) 10%, transparent);
        padding: 3px 8px; border-radius: 20px;
    }
    .pm-kpi-value {
        font-size: 30px; font-weight: 700;
        color: var(--text-main); line-height: 1; margin-bottom: 5px;
    }
    .pm-kpi-label {
        font-size: 12px; font-weight: 600;
        text-transform: uppercase; letter-spacing: .7px;
        color: var(--text-muted);
    }

    /* ── Chart cards ── */
    .pm-chart-card {
        background: var(--white);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
        padding: 22px 22px 18px;
        height: 100%;
    }
    .pm-chart-title {
        font-size: 14px; font-weight: 700;
        color: var(--text-main); margin-bottom: 18px;
        display: flex; align-items: center; gap: 8px;
    }
    .pm-chart-title i { color: var(--brand-mid); font-size: 15px; }

    /* ── Lista resumen ── */
    .pm-list { list-style: none; margin: 0; padding: 0; }
    .pm-list li {
        display: flex; align-items: center; justify-content: space-between;
        padding: 11px 0;
        border-bottom: 1px solid var(--border);
        font-size: 13px;
    }
    .pm-list li:last-child { border-bottom: none; }
    .pm-list-left { display: flex; align-items: center; gap: 10px; color: var(--text-sub); }
    .pm-list-left i { font-size: 14px; width: 18px; text-align: center; }
    .pm-list-badge {
        font-size: 12px; font-weight: 700;
        padding: 3px 10px; border-radius: 20px;
    }

    /* ── CTA card ── */
    .pm-cta-card {
        background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand-mid) 60%, var(--brand-light) 100%);
        border-radius: var(--radius);
        padding: 28px 24px;
        display: flex; flex-direction: column;
        align-items: flex-start; justify-content: center;
        gap: 12px;
        position: relative; overflow: hidden;
        height: 100%;
    }
    .pm-cta-card::before {
        content: '';
        position: absolute;
        width: 200px; height: 200px;
        border-radius: 50%;
        top: -70px; right: -50px;
        background: radial-gradient(circle, rgba(255,255,255,.08) 0%, transparent 70%);
        pointer-events: none;
    }
    .pm-cta-card h5 { font-size: 17px; font-weight: 700; color: #fff; margin: 0; }
    .pm-cta-card p  { font-size: 13px; color: rgba(255,255,255,.65); margin: 0; line-height: 1.5; }

    /* ── Legend dots ── */
    .pm-legend-dot {
        width: 9px; height: 9px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 7px;
        flex-shrink: 0;
    }

    /* ── @supports fallback color-mix ── */
    @supports not (background: color-mix(in srgb, red 10%, transparent)) {
        .pm-kpi-icon { background: rgba(14,55,95,.10); }
        .pm-kpi-badge { background: rgba(14,55,95,.10); }
    }

    /* ── Responsive ── */
    @media (max-width: 1100px) {
        .pm-kpi-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
        .pm-main  { padding: 16px 10px 32px; }
        .pm-kpi-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    }
    @media (max-width: 480px) {
        .pm-kpi-grid { grid-template-columns: 1fr; }
    }
</style>
{% endblock %}

{% block body %}

<!-- ── Contenido ── -->
<div class="pm-main">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between flex-wrap mb-4" style="gap:10px;">
        <div>
            <h4 style="color:var(--text-main);font-weight:700;margin:0;font-size:20px;">Resumen de Misiones</h4>
            <p style="color:var(--text-muted);font-size:13px;margin:3px 0 0;">Fichas de salida, documentos y tramitación de pasaportes</p>
        </div>
        <div class="d-flex" style="gap:8px;">
            <a href="{{ path('app_ficha_salida_index') }}" class="pm-btn pm-btn-outline">
                <i class="fas fa-list-ul"></i> Listado general
            </a>
            <button class="pm-btn pm-btn-white" id="btnRefresh">
                <i class="fas fa-sync-alt"></i> Actualizar
            </button>
        </div>
    </div>

    <!-- KPIs -->
    <div class="pm-section">
        <span class="pm-section-label">Indicadores clave</span>
        <div class="pm-section-line"></div>
    </div>

    <div class="pm-kpi-grid">

        <div class="pm-kpi-card" style="--kpi-color:#134679">
            <div class="pm-kpi-bg"></div>
            <div class="pm-kpi-head">
                <div class="pm-kpi-icon"><i class="fas fa-file-contract"></i></div>
                <span class="pm-kpi-badge">Total</span>
            </div>
            <div class="pm-kpi-value">{{ kpis.total_fichas }}</div>
            <div class="pm-kpi-label">Fichas de Salida</div>
        </div>

        <div class="pm-kpi-card" style="--kpi-color:#f59e0b">
            <div class="pm-kpi-bg"></div>
            <div class="pm-kpi-head">
                <div class="pm-kpi-icon"><i class="fas fa-hourglass-half"></i></div>
                <span class="pm-kpi-badge">Pendientes</span>
            </div>
            <div class="pm-kpi-value">{{ kpis.revision }}</div>
            <div class="pm-kpi-label">En Revisión</div>
        </div>

        <div class="pm-kpi-card" style="--kpi-color:#10b981">
            <div class="pm-kpi-bg"></div>
            <div class="pm-kpi-head">
                <div class="pm-kpi-icon"><i class="fas fa-plane-departure"></i></div>
                <span class="pm-kpi-badge">Activos</span>
            </div>
            <div class="pm-kpi-value">{{ kpis.total_docs }}</div>
            <div class="pm-kpi-label">Documentos de Salida</div>
        </div>

        <div class="pm-kpi-card" style="--kpi-color:#8b5cf6">
            <div class="pm-kpi-bg"></div>
            <div class="pm-kpi-head">
                <div class="pm-kpi-icon"><i class="fas fa-check-double"></i></div>
                <span class="pm-kpi-badge">Histórico</span>
            </div>
            <div class="pm-kpi-value">{{ kpis.finalizados }}</div>
            <div class="pm-kpi-label">Salidas Finalizadas</div>
        </div>

    </div>

    <!-- Gráficos -->
    <div class="pm-section pm-section-gap">
        <span class="pm-section-label">Análisis</span>
        <div class="pm-section-line"></div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="pm-chart-card">
                <div class="pm-chart-title">
                    <i class="fas fa-chart-line"></i> Tendencia mensual de fichas
                </div>
                <div style="height:320px">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="pm-chart-card">
                <div class="pm-chart-title">
                    <i class="fas fa-chart-pie"></i> Estado de fichas
                </div>
                <div style="height:220px">
                    <canvas id="statusChart"></canvas>
                </div>
                <div id="chartLegend" class="mt-3"></div>
            </div>
        </div>
    </div>

    <!-- Resumen + CTA -->
    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="pm-chart-card">
                <div class="pm-chart-title">
                    <i class="fas fa-info-circle"></i> Resumen operativo
                </div>
                <ul class="pm-list">
                    <li>
                        <span class="pm-list-left">
                            <i class="fas fa-clock" style="color:#f59e0b"></i>
                            Fichas nuevas (sin atender)
                        </span>
                        <span class="pm-list-badge" style="color:#92400e;background:#fef3c7">{{ kpis.nuevas }}</span>
                    </li>
                    <li>
                        <span class="pm-list-left">
                            <i class="fas fa-tasks" style="color:#134679"></i>
                            Documentos en trámite
                        </span>
                        <span class="pm-list-badge" style="color:#1e3a5f;background:#dbeafe">{{ kpis.tramite }}</span>
                    </li>
                </ul>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="pm-cta-card">
                <h5><i class="fas fa-rocket mr-2"></i>Acceso rápido</h5>
                <p>Gestiona fichas de salida, documentos y pasaportes desde el listado general del módulo.</p>
                <a href="{{ path('app_ficha_salida_index') }}" class="pm-btn pm-btn-white" style="margin-top:4px">
                    <i class="fas fa-list-ul"></i> Ver listado general
                </a>
            </div>
        </div>
    </div>

</div>

{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function () {
    Chart.defaults.font.family = "'Inter', 'Segoe UI', 'Roboto', sans-serif";
    Chart.defaults.font.size   = 12;

    const PALETTE = ['#134679','#3b82f6','#f59e0b','#10b981','#8b5cf6','#ec4899','#64748b'];

    // ── Línea de tendencia ──
    const trendCtx    = document.getElementById('trendChart').getContext('2d');
    const trendData   = {{ trend.data|raw }};
    const trendLabels = {{ trend.labels|raw }};

    new Chart(trendCtx, {
        type: 'line',
        data: {
            labels: trendLabels,
            datasets: [{
                label: 'Fichas creadas',
                data: trendData,
                borderColor: '#134679',
                backgroundColor: function(ctx) {
                    var g = ctx.chart.ctx.createLinearGradient(0, 0, 0, 350);
                    g.addColorStop(0, 'rgba(19,70,121,.35)');
                    g.addColorStop(1, 'rgba(19,70,121,0)');
                    return g;
                },
                fill: true, tension: 0.42,
                borderWidth: 2.5,
                pointRadius: 5,
                pointBackgroundColor: '#fff',
                pointBorderColor: '#134679',
                pointBorderWidth: 2,
                pointHoverRadius: 7
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(0,0,0,.05)', drawBorder: false },
                    ticks: { precision: 0, color: '#94a3b8' }
                },
                x: {
                    grid: { display: false, drawBorder: false },
                    ticks: { color: '#94a3b8' }
                }
            }
        }
    });

    // ── Donut de estados ──
    const statusCtx = document.getElementById('statusChart').getContext('2d');
    const statusRaw = {{ status_dist|raw }};
    const sLabels   = statusRaw.map(function(d){ return d.label; });
    const sValues   = statusRaw.map(function(d){ return d.value; });

    new Chart(statusCtx, {
        type: 'doughnut',
        data: {
            labels: sLabels,
            datasets: [{
                data: sValues,
                backgroundColor: PALETTE.slice(0, sLabels.length),
                borderWidth: 0,
                hoverOffset: 16
            }]
        },
        options: {
            responsive: true, maintainAspectRatio: false,
            cutout: '74%',
            plugins: { legend: { display: false } }
        }
    });

    // leyenda manual
    var legend = document.getElementById('chartLegend');
    statusRaw.forEach(function(d, i) {
        var row = document.createElement('div');
        row.style.cssText = 'display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;font-size:12px';
        row.innerHTML =
            '<span style="display:flex;align-items:center;color:#64748b;font-weight:600">'
            + '<span class="pm-legend-dot" style="background:' + PALETTE[i % PALETTE.length] + '"></span>'
            + d.label + '</span>'
            + '<span style="font-weight:700;color:#1a2e44">' + d.value + '</span>';
        legend.appendChild(row);
    });

    // botón actualizar
    document.getElementById('btnRefresh').addEventListener('click', function() {
        var icon = this.querySelector('i');
        icon.classList.add('fa-spin');
        setTimeout(function(){ location.reload(); }, 400);
    });
});
</script>
{% endblock %}
