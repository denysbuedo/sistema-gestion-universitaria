{% extends 'baseAdmin.html.twig' %}
{% block title %}Líneas celulares{% endblock %}

{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
{% include 'pages/modalDetail.html.twig' %}
{% set instituciones = [] %}
{% for item in registros %}
    {% set institucion = item.estructura.nombre|default('Sin institución') %}
    {% if institucion not in instituciones %}{% set instituciones = instituciones|merge([institucion]) %}{% endif %}
{% endfor %}
<style>.td-list-filters{display:flex;align-items:flex-end;gap:12px;margin:0 0 16px;padding:12px 14px;border:1px solid #dce4ea;border-radius:4px;background:#f8fafb}.td-list-filter{width:min(100%,380px)}.td-list-filter label{display:block;margin:0 0 5px;color:#526675;font-size:12px;font-weight:500}.td-list-filter select{width:100%;height:38px;border:1px solid #cbd6de;border-radius:4px;background:#fff;color:#263746;font-size:13px;box-shadow:none}.card-luxury>.card-header>.ml-auto{gap:10px!important}@media(max-width:575.98px){.td-list-filters{display:block}.td-list-filter{width:100%}}</style>

<div class="card card-luxury">
    <div class="card-header d-flex align-items-center">
        <div><h3 class="card-title m-0"><i class="fas fa-sim-card label-icon"></i>Líneas celulares</h3><small class="text-muted">{{ alcance }} · {{ registros|length }} registro{{ registros|length == 1 ? '' : 's' }}</small></div>
        <div class="ml-auto d-flex align-items-center" style="gap:10px"><a class="btn-lux-sm btn-lux-primary" href="{{ path('app_linea_celular_registrar') }}"><i class="fa fa-plus"></i> Nueva línea</a></div>
    </div>
    <div class="card-body px-4">
        {% if es_admin_informatizacion %}<div class="td-list-filters"><div class="td-list-filter"><label for="linea-universidad">Universidad</label><select id="linea-universidad" class="no-select2"><option value="">Todas las universidades</option>{% for value in instituciones|sort %}<option value="{{ value }}">{{ value }}</option>{% endfor %}</select></div></div>{% endif %}
        <div class="table-responsive">
        <table class="table config-table table-bordered table-striped dataTable">
            <thead>
            <tr><th>No.</th>{% if es_admin_informatizacion %}<th>Universidad</th>{% endif %}<th>Número</th><th>Plan de voz</th><th>Plan SMS</th><th>Plan de datos</th><th class="text-center">Opciones</th></tr>
            </thead>
            <tbody>{% for item in registros %}<tr>
                <td>{{ loop.index }}</td>
                {% if es_admin_informatizacion %}<td>{{ item.estructura.nombre|default('Sin institución') }}</td>{% endif %}
                <td>{{ item.numeroTelefono|default('—') }}</td><td>{{ item.planVoz is not empty ? item.planVoz ~ ' min' : '—' }}</td><td>{{ item.planSms is not empty ? item.planSms : '—' }}</td><td>{{ item.planDatos is not empty ? item.planDatos ~ ' GB' : '—' }}</td>
                <td><div class="dropdown d-flex justify-content-center"><button class="btn btn-sm btn-light p-0 d-flex align-items-center justify-content-center actions-dropdown-btn" type="button" data-toggle="dropdown" aria-label="Ver opciones" aria-haspopup="true" aria-expanded="false">&#8942;</button><div class="dropdown-menu dropdown-menu-right actions-dropdown-menu">
                    <button class="dropdown-item modalDetailAction" data-url="{{ path('app_linea_celular_detail',{id:item.id}) }}" data-title="Detalles de la línea celular"><i class="fa fa-eye fa-fw mr-2 text-primary"></i>Ver detalles</button>
                    <a class="dropdown-item" href="{{ path('app_linea_celular_modificar',{id:item.id}) }}"><i class="fa fa-edit fa-fw mr-2"></i>Modificar</a>
                    <a class="dropdown-item" href="{{ path('app_linea_celular_recargar',{id:item.id}) }}"><i class="fa fa-dollar-sign fa-fw mr-2"></i>Registrar recarga</a>
                    <a class="dropdown-item" href="{{ path('app_linea_celular_responsable',{id:item.id}) }}"><i class="fa fa-user fa-fw mr-2"></i>Gestionar responsable</a>
                    <div class="dropdown-divider"></div><button class="dropdown-item elementRemove text-danger" data-url="{{ path('app_linea_celular_eliminar',{id:item.id}) }}"><i class="fa fa-trash fa-fw mr-2"></i>Eliminar</button>
                </div></div></td>
            </tr>{% else %}<tr><td colspan="{{ es_admin_informatizacion ? 7 : 6 }}" class="text-center text-muted py-4">No hay líneas celulares registradas para este alcance.</td></tr>{% endfor %}</tbody>
        </table></div>
    </div>
</div>
{% endblock %}
{% block javascripts %}{{ parent() }}{% include 'pages/_luxury_list_dropdown_js.html.twig' %}<script>$(function(){$('#linea-universidad').on('change',function(){if(!$.fn.dataTable.isDataTable('.dataTable'))return;var table=$('.dataTable').DataTable(),value=$.fn.dataTable.util.escapeRegex(this.value);table.column(1).search(value?'^'+value+'$':'',true,false).draw()})});</script>{% endblock %}
