{% extends 'baseAdmin.html.twig' %}
{% block title %}Registrar servicio Nauta Hogar{% endblock %}
{% block body %}
{% include 'pages/_luxury_form_styles.html.twig' %}
<div class="card card-luxury">
 <div class="card-header d-flex align-items-center"><div><h3 class="card-title m-0"><i class="fas fa-wifi label-icon"></i>Registrar servicio Nauta Hogar</h3><small class="text-muted">{{ [persona.primerNombre,persona.segundoNombre,persona.primerApellido,persona.segundoApellido]|filter(v=>v)|join(' ') }} · {{ persona.entidad.nombre|default('Sin universidad') }}</small></div><div class="ml-auto"><a class="btn btn-secondary" href="{{ path('app_nauta_hogar_registrar') }}"><i class="fas fa-arrow-left mr-1"></i> Regresar</a></div></div>
 {{ form_start(form) }}<div class="card-body"><div class="row"><div class="col-md-6 form-group">{{ form_row(form.estructura) }}</div><div class="col-md-6 form-group">{{ form_row(form.numeroTelefono) }}</div><div class="col-md-6 form-group">{{ form_row(form.servicioContratado) }}</div><div class="col-md-6 form-group">{{ form_label(form.precio) }}<div class="input-group"><div class="input-group-prepend"><span class="input-group-text">$</span></div>{{ form_widget(form.precio) }}</div>{{ form_errors(form.precio) }}</div><div class="col-12 form-group">{{ form_row(form.direccionInstalacion) }}</div></div></div><div class="card-footer d-flex justify-content-end" style="gap:8px"><a class="btn btn-secondary" href="{{ path('app_nauta_hogar_index') }}">Cancelar</a><button class="btn btn-primary"><i class="fas fa-save mr-1"></i> Guardar</button></div>{{ form_end(form) }}
</div>
{% endblock %}
