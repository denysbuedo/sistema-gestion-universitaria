{% extends 'baseAdmin.html.twig' %}
{% block title %}Registrar servicio Nauta Hogar{% endblock %}
{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
<div class="card card-luxury">
 <div class="card-header d-flex align-items-center"><div><h3 class="card-title m-0"><i class="fas fa-user-search label-icon"></i>Seleccionar responsable</h3><small class="text-muted">Busque a la persona por su número de identidad para iniciar el registro.</small></div><div class="ml-auto"><a class="btn-lux-sm btn-lux-secondary" href="{{ path('app_nauta_hogar_index') }}"><i class="fas fa-arrow-left"></i> Regresar</a></div></div>
 <div class="card-body px-4">
  <form method="post" action="{{ path('app_nauta_hogar_registrar') }}" class="mb-4"><label for="busqueda">Número de identidad</label><div class="input-group" style="max-width:620px"><input type="search" name="busqueda" id="busqueda" class="form-control" maxlength="11" inputmode="numeric" autofocus required placeholder="Escriba el número de identidad" value="{{ busqueda|default('') }}"><div class="input-group-append"><button type="submit" class="btn btn-primary"><i class="fa fa-search mr-1"></i> Buscar</button></div></div></form>
  {% if busqueda and registros is empty %}<div class="alert alert-light border mb-0"><i class="fas fa-info-circle text-primary mr-2"></i>No se encontró una persona con ese número de identidad dentro de su alcance institucional.</div>{% endif %}
  {% for item in registros %}<div class="border rounded p-3 d-flex align-items-center flex-wrap" style="gap:14px"><div class="flex-grow-1"><strong style="font-weight:600;color:#263746">{{ [item.primerNombre,item.segundoNombre,item.primerApellido,item.segundoApellido]|filter(v=>v)|join(' ') }}</strong><div class="text-muted small mt-1">{{ item.entidad.nombre|default('Sin universidad asociada') }}{% if item.responsabilidad %} · {{ item.responsabilidad.nombre }}{% endif %}</div></div><a class="btn btn-primary" href="{{ path('app_nauta_hogar_registrar_v2',{id:item.id}) }}"><i class="fas fa-arrow-right mr-1"></i> Continuar</a></div>{% endfor %}
 </div>
</div>
{% endblock %}
