<dl class="row mb-0">
 <dt class="col-sm-4 text-muted">Universidad</dt><dd class="col-sm-8">{{ item.estructura.nombre|default('—') }}</dd>
 <dt class="col-sm-4 text-muted">Responsable</dt><dd class="col-sm-8">{{ [item.responsable.primerNombre|default(''),item.responsable.segundoNombre|default(''),item.responsable.primerApellido|default(''),item.responsable.segundoApellido|default('')]|filter(v=>v)|join(' ')|default('—') }}</dd>
 <dt class="col-sm-4 text-muted">Número telefónico</dt><dd class="col-sm-8">{{ item.numeroTelefono|default('—') }}</dd>
 <dt class="col-sm-4 text-muted">Servicio contratado</dt><dd class="col-sm-8">{{ item.servicioContratado.nombre|default('—') }}</dd>
 <dt class="col-sm-4 text-muted">Precio</dt><dd class="col-sm-8">{{ item.precio|default('—') }}</dd>
 <dt class="col-sm-4 text-muted">Dirección de instalación</dt><dd class="col-sm-8">{{ item.direccionInstalacion|default('—') }}</dd>
</dl>
