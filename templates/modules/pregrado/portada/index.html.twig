{% extends 'baseAdmin.html.twig' %}

{% block title %}Pregrado{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --pg-navy: #102f4f;
            --pg-text: #263746;
            --pg-muted: #6b7b88;
            --pg-line: #dce4ea;
            --pg-soft: #f4f7f9;
            --pg-white: #fff;
            --pg-blue-soft: #eaf1f6;
            --pg-steel: #496b86;
        }

        .pg-page { margin: -10px -15px 0; background: var(--pg-soft); color: var(--pg-text); }
        .pg-header { padding: 32px 36px 29px; border-bottom: 1px solid var(--pg-line); background: var(--pg-white); }
        .pg-eyebrow { margin-bottom: 7px; color: var(--pg-steel); font-size: 12px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; }
        .pg-title { margin: 0 0 7px; color: var(--pg-navy); font-size: 30px; font-weight: 500; letter-spacing: -.015em; }
        .pg-subtitle { margin: 0; color: var(--pg-muted); font-size: 15px; font-weight: 400; }
        .pg-content { padding: 28px 36px 42px; }

        .pg-metrics { display: grid; grid-template-columns: repeat(3, minmax(190px, 1fr)); gap: 16px; margin-bottom: 30px; }
        .pg-metric { display: flex; min-height: 108px; align-items: center; gap: 16px; padding: 20px 22px; border: 1px solid var(--pg-line); background: var(--pg-white); }
        .pg-metric-icon { display: flex; width: 44px; height: 44px; flex: 0 0 44px; align-items: center; justify-content: center; border: 1px solid #cfdae3; background: var(--pg-blue-soft); color: var(--pg-navy); font-size: 17px; }
        .pg-metric-value { margin-bottom: 6px; color: var(--pg-navy); font-size: 36px; font-weight: 600; line-height: 1; font-variant-numeric: tabular-nums; }
        .pg-metric-label { color: var(--pg-muted); font-size: 14px; font-weight: 400; }

        .pg-tabs { display: flex; gap: 30px; margin-bottom: 22px; border-bottom: 1px solid var(--pg-line); }
        .pg-tabs .nav-link { margin-bottom: -1px; padding: 12px 1px 13px; border: 0; border-bottom: 3px solid transparent; border-radius: 0; background: transparent; color: var(--pg-muted); font-size: 15px; font-weight: 400; }
        .pg-tabs .nav-link:hover { color: var(--pg-navy); }
        .pg-tabs .nav-link.active { border-bottom-color: var(--pg-navy); background: transparent; color: var(--pg-navy); font-weight: 500; }

        .pg-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
        .pg-column { display: contents; }
        .pg-panel { min-width: 0; padding: 24px; border: 1px solid var(--pg-line); background: var(--pg-white); }
        .pg-panel-wide { grid-column: 1 / -1; }
        .pg-panel-header { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
        .pg-panel-icon { display: flex; width: 36px; height: 36px; flex: 0 0 36px; align-items: center; justify-content: center; background: var(--pg-blue-soft); color: var(--pg-navy); font-size: 14px; }
        .pg-panel-title { margin: 0 0 4px; color: var(--pg-text); font-size: 16px; font-weight: 500; }
        .pg-panel-note { margin: 0; color: var(--pg-muted); font-size: 13px; font-weight: 400; }
        .pg-chart { position: relative; height: 340px; overflow-x: hidden; overflow-y: auto; }
        .pg-chart-large { height: 400px; }
        .pg-chart-inner { position: relative; width: 100%; min-height: 100%; }

        .pg-bars { display: grid; gap: 18px; }
        .pg-bar-head { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 8px; color: var(--pg-text); font-size: 14px; font-weight: 400; }
        .pg-bar-value { color: var(--pg-muted); font-variant-numeric: tabular-nums; }
        .pg-bar-track { height: 7px; overflow: hidden; background: #e8edf1; }
        .pg-bar-fill { height: 100%; background: var(--pg-navy); }

        .pg-inline-stats { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--pg-line); }
        .pg-inline-stat { padding: 20px 16px; border-right: 1px solid var(--pg-line); }
        .pg-inline-stat:last-child { border-right: 0; }
        .pg-inline-value { margin-bottom: 6px; color: var(--pg-navy); font-size: 26px; font-weight: 500; }
        .pg-inline-label { color: var(--pg-muted); font-size: 13px; font-weight: 400; }

        .pg-accreditation { display: grid; grid-template-columns: repeat(4, minmax(120px, 1fr)); border: 1px solid var(--pg-line); }
        .pg-accreditation-item { padding: 18px; border-right: 1px solid var(--pg-line); }
        .pg-accreditation-item:last-child { border-right: 0; }
        .pg-accreditation-value { color: var(--pg-navy); font-size: 25px; font-weight: 500; }
        .pg-accreditation-name { margin: 5px 0; color: var(--pg-text); font-size: 13px; font-weight: 400; }
        .pg-accreditation-percent { color: var(--pg-muted); font-size: 12px; }

        @media (max-width: 1100px) {
            .pg-metrics { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 800px) {
            .pg-header, .pg-content { padding-left: 18px; padding-right: 18px; }
            .pg-grid { grid-template-columns: 1fr; }
            .pg-panel-wide { grid-column: auto; }
        }
        @media (max-width: 560px) {
            .pg-metrics { grid-template-columns: 1fr; }
            .pg-accreditation { grid-template-columns: repeat(2, 1fr); }
            .pg-accreditation-item:nth-child(2n) { border-right: 0; }
            .pg-accreditation-item:nth-child(-n+2) { border-bottom: 1px solid var(--pg-line); }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="pg-page">
        <header class="pg-header">
            <div class="pg-eyebrow">Gestión académica</div>
            <h1 class="pg-title">Pregrado</h1>
            <p class="pg-subtitle">Resumen de programas académicos, modalidades, instituciones y acreditación.</p>
        </header>

        <div class="pg-content">
            <section class="pg-metrics" aria-label="Indicadores generales">
                {% set metrics = [
                    {'value': total_solicitudes, 'label': 'Solicitudes', 'icon': 'fa-file-alt'},
                    {'value': total_aprobado, 'label': 'Aprobados', 'icon': 'fa-check-circle'},
                    {'value': programas_rechazados, 'label': 'Rechazados', 'icon': 'fa-times-circle'},
                    {'value': programas_reabiertos, 'label': 'Reabiertos', 'icon': 'fa-redo-alt'},
                    {'value': programas_desactivados, 'label': 'Desactivados', 'icon': 'fa-pause-circle'},
                    {'value': programas_extintos, 'label': 'Extintos', 'icon': 'fa-archive'}
                ] %}
                {% for metric in metrics %}
                    <div class="pg-metric">
                        <div class="pg-metric-icon"><i class="fas {{ metric.icon }}" aria-hidden="true"></i></div>
                        <div><div class="pg-metric-value">{{ metric.value }}</div><div class="pg-metric-label">{{ metric.label }}</div></div>
                    </div>
                {% endfor %}
            </section>

            <nav class="nav pg-tabs" role="tablist" aria-label="Tipo de programa">
                <a class="nav-link active" data-toggle="pill" href="#pg-carreras" role="tab" aria-selected="true">Carreras universitarias</a>
                <a class="nav-link" data-toggle="pill" href="#pg-ciclo" role="tab" aria-selected="false">Educación superior de ciclo corto</a>
            </nav>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="pg-carreras" role="tabpanel">
                    <div class="pg-grid">
                        <div class="pg-column">
                            <section class="pg-panel">
                                <header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-atom"></i></div><div><h2 class="pg-panel-title">Ramas de la ciencia</h2><p class="pg-panel-note">Distribución de carreras aprobadas</p></div></header>
                                <div class="pg-bars">
                                    {% for item in carrera_por_rama_ciencia %}
                                        {% set percentage = carreras_aprobadas > 0 ? (item.total * 100 / carreras_aprobadas)|round(0) : 0 %}
                                        <div><div class="pg-bar-head"><span>{{ item.nombre }}</span><span class="pg-bar-value">{{ item.total }}</span></div><div class="pg-bar-track"><div class="pg-bar-fill" style="width: {{ percentage }}%"></div></div></div>
                                    {% endfor %}
                                </div>
                            </section>
                            <section class="pg-panel">
                                <header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-user-graduate"></i></div><div><h2 class="pg-panel-title">Modalidades</h2><p class="pg-panel-note">Programas aprobados por modalidad</p></div></header>
                                <div class="pg-inline-stats">
                                    <div class="pg-inline-stat"><div class="pg-inline-value">{{ carrera_por_modalidad.diurno }}</div><div class="pg-inline-label">Diurno</div></div>
                                    <div class="pg-inline-stat"><div class="pg-inline-value">{{ carrera_por_modalidad.por_encuentro }}</div><div class="pg-inline-label">Por encuentros</div></div>
                                    <div class="pg-inline-stat"><div class="pg-inline-value">{{ carrera_por_modalidad.adistancia }}</div><div class="pg-inline-label">A distancia</div></div>
                                </div>
                            </section>
                        </div>
                        <div class="pg-column">
                            <section class="pg-panel pg-panel-wide"><header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-university"></i></div><div><h2 class="pg-panel-title">Centros rectores</h2><p class="pg-panel-note">Programas coordinados por institución</p></div></header><div class="pg-chart pg-chart-large"><canvas id="chartCarreraRectores"></canvas></div></section>
                            <section class="pg-panel"><header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-building"></i></div><div><h2 class="pg-panel-title">Organismos formadores</h2><p class="pg-panel-note">Distribución institucional</p></div></header><div class="pg-chart"><canvas id="chartCarreraFormador"></canvas></div></section>
                            <section class="pg-panel"><header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-briefcase"></i></div><div><h2 class="pg-panel-title">Organismos demandantes</h2><p class="pg-panel-note">Demanda de programas por organismo</p></div></header><div class="pg-chart"><canvas id="chartCarreraDemandante"></canvas></div></section>
                            <section class="pg-panel pg-panel-wide">
                                <header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-award"></i></div><div><h2 class="pg-panel-title">Acreditación</h2><p class="pg-panel-note">Calidad reconocida de los programas académicos</p></div></header>
                                <div class="pg-accreditation">
                                    {% for item in carrera_por_categoria_acreditacion %}
                                        <div class="pg-accreditation-item"><div class="pg-accreditation-value">{{ item.total }}</div><div class="pg-accreditation-name">{{ item.nombre }}</div><div class="pg-accreditation-percent">{{ carreras_aprobadas > 0 ? (item.total * 100 / carreras_aprobadas)|round(1) : 0 }}%</div></div>
                                    {% endfor %}
                                </div>
                            </section>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="pg-ciclo" role="tabpanel">
                    <div class="pg-grid">
                        <div class="pg-column">
                            <section class="pg-panel">
                                <header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-atom"></i></div><div><h2 class="pg-panel-title">Ramas de la ciencia</h2><p class="pg-panel-note">Distribución de programas de ciclo corto</p></div></header>
                                <div class="pg-bars">
                                    {% for item in ciclo_corto_por_rama_ciencia %}
                                        {% set percentage = ciclo_corto_aprobados > 0 ? (item.total * 100 / ciclo_corto_aprobados)|round(0) : 0 %}
                                        <div><div class="pg-bar-head"><span>{{ item.nombre }}</span><span class="pg-bar-value">{{ item.total }}</span></div><div class="pg-bar-track"><div class="pg-bar-fill" style="width: {{ percentage }}%"></div></div></div>
                                    {% endfor %}
                                </div>
                            </section>
                            <section class="pg-panel">
                                <header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-user-graduate"></i></div><div><h2 class="pg-panel-title">Modalidades</h2><p class="pg-panel-note">Programas aprobados por modalidad</p></div></header>
                                <div class="pg-inline-stats">
                                    <div class="pg-inline-stat"><div class="pg-inline-value">{{ ciclo_corto_por_modalidad.diurno }}</div><div class="pg-inline-label">Diurno</div></div>
                                    <div class="pg-inline-stat"><div class="pg-inline-value">{{ ciclo_corto_por_modalidad.por_encuentro }}</div><div class="pg-inline-label">Por encuentros</div></div>
                                    <div class="pg-inline-stat"><div class="pg-inline-value">{{ ciclo_corto_por_modalidad.adistancia }}</div><div class="pg-inline-label">A distancia</div></div>
                                </div>
                            </section>
                        </div>
                        <div class="pg-column">
                            <section class="pg-panel pg-panel-wide"><header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-university"></i></div><div><h2 class="pg-panel-title">Centros rectores</h2><p class="pg-panel-note">Programas coordinados por institución</p></div></header><div class="pg-chart pg-chart-large"><canvas id="chartCicloRectores"></canvas></div></section>
                            <section class="pg-panel"><header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-building"></i></div><div><h2 class="pg-panel-title">Organismos formadores</h2><p class="pg-panel-note">Distribución institucional</p></div></header><div class="pg-chart"><canvas id="chartCicloFormador"></canvas></div></section>
                            <section class="pg-panel"><header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-briefcase"></i></div><div><h2 class="pg-panel-title">Organismos demandantes</h2><p class="pg-panel-note">Demanda de programas por organismo</p></div></header><div class="pg-chart"><canvas id="chartCicloDemandante"></canvas></div></section>
                            <section class="pg-panel pg-panel-wide">
                                <header class="pg-panel-header"><div class="pg-panel-icon"><i class="fas fa-award"></i></div><div><h2 class="pg-panel-title">Acreditación</h2><p class="pg-panel-note">Calidad reconocida de los programas académicos</p></div></header>
                                <div class="pg-accreditation">
                                    {% for item in ciclo_corto_por_categoria_acreditacion %}
                                        <div class="pg-accreditation-item"><div class="pg-accreditation-value">{{ item.total }}</div><div class="pg-accreditation-name">{{ item.nombre }}</div><div class="pg-accreditation-percent">{{ ciclo_corto_aprobados > 0 ? (item.total * 100 / ciclo_corto_aprobados)|round(1) : 0 }}%</div></div>
                                    {% endfor %}
                                </div>
                            </section>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            Chart.defaults.color = '#6b7b88';
            Chart.defaults.font.family = '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif';
            Chart.defaults.font.size = 13;

            function chartData(source) {
                return { labels: source.map(function (item) { return item.name; }), values: source.map(function (item) { return item.y; }) };
            }
            function horizontalChart(id, source) {
                var parsed = chartData(source);
                var canvas = document.getElementById(id);
                var chartBox = canvas.parentElement;
                var minimumHeight = chartBox.classList.contains('pg-chart-large') ? 400 : 340;
                var chartInner = document.createElement('div');
                chartInner.className = 'pg-chart-inner';
                chartBox.insertBefore(chartInner, canvas);
                chartInner.appendChild(canvas);
                chartInner.style.height = Math.max(minimumHeight, parsed.labels.length * 38 + 70) + 'px';
                var valueLabels = {
                    id: 'valueLabels',
                    afterDatasetsDraw: function (chart) {
                        var context = chart.ctx;
                        context.save();
                        context.fillStyle = '#102f4f';
                        context.font = '500 12px -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif';
                        context.textAlign = 'left';
                        context.textBaseline = 'middle';
                        chart.getDatasetMeta(0).data.forEach(function (bar, index) {
                            context.fillText(String(parsed.values[index]), Math.min(bar.x + 8, chart.chartArea.right - 24), bar.y);
                        });
                        context.restore();
                    }
                };
                return new Chart(canvas, {
                    type: 'bar',
                    data: { labels: parsed.labels, datasets: [{ data: parsed.values, backgroundColor: '#496b86', borderWidth: 0, barThickness: 16, maxBarThickness: 18 }] },
                    plugins: [valueLabels],
                    options: {
                        indexAxis: 'y', responsive: true, maintainAspectRatio: false,
                        animation: { duration: 250 },
                        layout: { padding: { right: 42 } },
                        plugins: { legend: { display: false }, tooltip: { backgroundColor: '#102f4f', displayColors: false, padding: 11, cornerRadius: 2 } },
                        scales: {
                            x: { beginAtZero: true, grid: { color: '#e6ebef', drawBorder: false }, ticks: { precision: 0, padding: 8 } },
                            y: { grid: { display: false, drawBorder: false }, ticks: { color: '#425563', padding: 8, autoSkip: false } }
                        }
                    }
                });
            }

            horizontalChart('chartCarreraRectores', {{ carrera_por_centro_rector|raw }});
            horizontalChart('chartCarreraFormador', {{ carrera_organismo_formador|raw }});
            horizontalChart('chartCarreraDemandante', {{ carrera_organismo_demandante|raw }});
            var cycleChartsCreated = false;
            $('a[href="#pg-ciclo"]').on('shown.bs.tab', function () {
                if (!cycleChartsCreated) {
                    horizontalChart('chartCicloRectores', {{ ciclo_corto_por_centro_rector|raw }});
                    horizontalChart('chartCicloFormador', {{ ciclo_corto_organismo_formador|raw }});
                    horizontalChart('chartCicloDemandante', {{ ciclo_corto_organismo_demandante|raw }});
                    cycleChartsCreated = true;
                }
            });
        });
    </script>
{% endblock %}
