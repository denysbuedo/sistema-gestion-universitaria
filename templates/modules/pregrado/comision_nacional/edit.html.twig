{% extends 'baseAdmin.html.twig' %}

{% block title %}Modificar comisión nacional{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .card-luxury { border-radius: 12px; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-top: 4px solid #134679; margin-bottom: 2rem; }
        .card-luxury .card-header { background: #fff; border-bottom: 1px solid #f1f5f9; padding: 18px 24px; }
        .fs-title { color: #1a2e44; font-weight: 700; font-size: 1.1rem; margin: 0; }
        .label-icon { color: #134679; margin-right: 8px; opacity: 0.8; }
        .fs-section-title { font-size: 0.85rem; font-weight: 700; color: #134679; text-transform: uppercase; letter-spacing: 0.5px; display: flex; align-items: center; gap: 8px; margin-bottom: 15px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px; }
        .fs-label { font-size: 0.82rem; font-weight: 600; color: #4b5563; margin-bottom: 6px; display: block; }
        .estado-toggle { display:inline-flex; border-radius:20px; background:#f1f5f9; padding:3px; gap:2px; }
        .et-opt { padding:6px 16px; border-radius:20px; border:none; font-size:0.75rem; font-weight:700; cursor:pointer; background:transparent; color:#94a3b8; display:inline-flex; align-items:center; gap:6px; transition:all .2s; letter-spacing:.3px; }
        .et-opt i { font-size:0.45rem; vertical-align:middle; }
        .et-opt.et-on.active  { background:#dcfce7; color:#15803d; box-shadow: 0 2px 4px rgba(21,128,61,0.1); }
        .et-opt.et-off.active { background:#fee2e2; color:#b91c1c; box-shadow: 0 2px 4px rgba(185,28,28,0.1); }
        .config-table { width: 100%; border-collapse: separate; border-spacing: 0; }
        .config-table thead th { background: #f8fafc; color: #475569; font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 10px 14px; border-bottom: 2px solid #e2e8f0; }
        .config-table tbody td { padding: 10px 14px; border-bottom: 1px solid #f1f5f9; font-size: 0.82rem; color: #334155; vertical-align: middle; }
        .config-table tbody tr:hover { background: #f8fafc; }
        .btn-asociar { background: #134679; color: #fff !important; font-weight: 700; font-size: 0.82rem; padding: 8px 20px; border-radius: 8px; border: none; display: inline-flex; align-items: center; gap: 6px; transition: all .2s; }
        .btn-asociar:hover { background: #0f3560; }
        .btn-fs-submit { background: #134679; color: #fff !important; font-weight: 700; font-size: 0.85rem; padding: 10px 24px; border-radius: 8px; border: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
        .btn-fs-submit:hover { background: #0f3560; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(19,70,121,0.2); }
        .btn-fs-cancel { background: #f1f5f9; color: #475569 !important; font-weight: 700; font-size: 0.85rem; padding: 10px 24px; border-radius: 8px; border: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
        .btn-fs-cancel:hover { background: #e2e8f0; color: #1e293b !important; }
    </style>
{% endblock %}

{% block body %}
    <div class="card card-luxury">
        <div class="card-header">
            <h3 class="fs-title"><i class="fas fa-edit label-icon"></i>Modificar comisión nacional</h3>
        </div>

        {{ form_start(form) }}
        <div class="card-body px-4">

            <div class="fs-section-title"><i class="fas fa-info-circle"></i> Datos Generales</div>
            <div class="row">
                <div class="col-md-6 form-group">
                    <label class="fs-label">{{ form_label(form.nombre) }}</label>
                    {{ form_widget(form.nombre, {'attr': {'class': 'form-control shadow-sm'}}) }}
                    {{ form_errors(form.nombre) }}
                </div>
                <div class="col-md-4 form-group">
                    <label class="fs-label"><i class="fas fa-toggle-on text-primary mr-1"></i> Estado</label>
                    <input type="checkbox" id="{{ form.activo.vars.id }}" name="{{ form.activo.vars.full_name }}" class="d-none" {% if form.activo.vars.data %}checked{% endif %}>
                    <div><div class="estado-toggle" data-cb="{{ form.activo.vars.id }}">
                        <button type="button" class="et-opt et-on{% if form.activo.vars.data %} active{% endif %}"><i class="fas fa-circle"></i> Habilitado</button>
                        <button type="button" class="et-opt et-off{% if not form.activo.vars.data %} active{% endif %}"><i class="fas fa-circle"></i> Deshabilitado</button>
                    </div></div>
                </div>
            </div>
            <div class="row mt-1">
                <div class="col-12 form-group">
                    <label class="fs-label">{{ form_label(form.descripcion) }}</label>
                    {{ form_widget(form.descripcion, {'attr': {'class': 'form-control shadow-sm', 'rows': '3'}}) }}
                    {{ form_errors(form.descripcion) }}
                </div>
            </div>

            <div class="fs-section-title mt-4"><i class="fas fa-user-plus"></i> Asignar miembros</div>
            <table class="config-table">
                <thead>
                <tr>
                    <th style="width:2%">No.</th>
                    <th style="width:4%"></th>
                    <th style="width:6%">Foto</th>
                    <th>Nombre y apellidos</th>
                    <th>Rol en la comisión</th>
                </tr>
                </thead>
                <tbody>
                {% for item in personas %}
                    <tr id="tr_{{ item.id }}">
                        <td>{{ loop.index }}</td>
                        <td><input type="checkbox" name="asignados_{{ item.id }}" id="asignados_{{ item.id }}" value="{{ item.id }}"></td>
                        <td>
                            <a href="{% if item.foto != null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ item.foto }}{% else %}/assets/images/usuario.png{% endif %}" target="_blank">
                                <img src="{% if item.foto != null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ item.foto }}{% else %}/assets/images/usuario.png{% endif %}" style="width:38px;height:38px;object-fit:cover;border-radius:50%;" alt="{{ item.primerNombre }}">
                            </a>
                        </td>
                        <td>{{ item.primerNombre ~ ' ' ~ item.segundoNombre ~ ' ' ~ item.primerApellido ~ ' ' ~ item.segundoApellido }}</td>
                        <td>
                            <select id="asignados_{{ item.id }}_rol" name="asignados_{{ item.id }}_rol" class="form-control form-control-sm">
                                <option value="">Seleccione</option>
                                {% for resp in rolComision %}
                                    <option value="{{ resp.id }}">{{ resp.nombre }}</option>
                                {% endfor %}
                            </select>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            <div class="d-flex justify-content-end mt-3 mb-4">
                <button type="button" class="btn-asociar" id="btn-asociar"><i class="fas fa-user-check"></i> Asociar seleccionados</button>
            </div>

            <div class="fs-section-title mt-2"><i class="fas fa-users"></i> Miembros asociados</div>
            <table id="tbl-asociados" class="config-table">
                <thead>
                <tr>
                    <th style="width:2%">No.</th>
                    <th style="width:6%">Foto</th>
                    <th>Nombre y apellidos</th>
                    <th>Rol</th>
                    <th class="text-center" style="width:8%">Opciones</th>
                </tr>
                </thead>
                <tbody>
                {% for item in asignadas %}
                    <tr>
                        <td>{{ loop.index }}</td>
                        <td>
                            <a href="{% if item.foto != null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ item.foto }}{% else %}/assets/images/usuario.png{% endif %}" target="_blank">
                                <img src="{% if item.foto != null %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ item.foto }}{% else %}/assets/images/usuario.png{% endif %}" style="width:38px;height:38px;object-fit:cover;border-radius:50%;" alt="{{ item.primerNombre }}">
                            </a>
                        </td>
                        <td>{{ item.primerNombre ~ ' ' ~ item.segundoNombre ~ ' ' ~ item.primerApellido ~ ' ' ~ item.segundoApellido }}</td>
                        <td>{{ item.rolComision | default('') }}</td>
                        <td class="text-center">
                            <a title="Eliminar" class="elementRemove" style="color:#dc2626;font-size:0.9rem;"
                               data-url="{{ path('app_comision_nacional_eliminar_persona_asignada_modificar', {'id': item.id}) }}"
                               data-content="¿Está seguro que desea eliminar este miembro?"><i class="fa fa-trash"></i></a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="card-footer bg-light px-4 py-3 d-flex justify-content-end" style="gap:12px;">
            <a class="btn-fs-cancel btn-cancel" data-url="{{ path('app_comision_nacional_index') }}" data-content="¿Desea descartar los cambios?"><i class="fas fa-times"></i> Cancelar</a>
            <button class="btn-fs-submit" type="submit"><i class="fas fa-save"></i> Guardar Cambios</button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $(document).on('click', '.estado-toggle .et-opt', function() {
                var $t = $(this).closest('.estado-toggle'), cbId = $t.data('cb'), isOn = $(this).hasClass('et-on');
                $t.find('.et-opt').removeClass('active'); $(this).addClass('active'); $('#' + cbId).prop('checked', isOn);
            });

            $('#btn-asociar').click(function(e) {
                e.preventDefault();
                var flag = true, arrayId = [];
                $('input[id*=asignados_]').each(function(idx, element) {
                    if (element.checked) {
                        var rol = $('#' + element.id + '_rol').val();
                        if (rol !== '') {
                            arrayId.push({ id_persona: element.value, id_rol: rol, nombre_rol: $('#' + element.id + '_rol option:selected').text() });
                        } else {
                            flag = false;
                            toastr.warning('El rol es obligatorio por cada miembro de la comisión.');
                            return false;
                        }
                    }
                });
                if (arrayId.length > 0 && flag) {
                    HoldOn.open({ theme: 'sk-cube-grid', message: 'Por favor espere...', textColor: 'white' });
                    $.post('{{ path('app_comision_nacional_asociar_persona_modificar') }}', { arrayId: arrayId }, function() {
                        HoldOn.close();
                        $(window).attr('location', '{{ path('app_comision_nacional_modificar', {'id': comision.id}) }}');
                    });
                } else if (flag) {
                    toastr.warning('Debe seleccionar al menos un miembro.');
                }
            });
        });
    </script>
{% endblock %}