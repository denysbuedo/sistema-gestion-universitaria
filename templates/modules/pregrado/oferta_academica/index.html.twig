{% extends 'baseAdmin.html.twig' %}

{% block title %}Oferta académica universitaria{% endblock %}

{% block body %}
<div class="card card-luxury border-0">
    <div class="card-header bg-white border-bottom d-flex align-items-center">
        <div>
            <h3 class="card-title m-0" style="float:none!important;">
                <i class="fas fa-university label-icon"></i>
                {{ accesoGlobal ? 'Oferta académica por universidades' : 'Programas de mi universidad' }}
            </h3>
            {% if institucion %}<div class="text-muted mt-1">{{ institucion.nombre }}</div>{% endif %}
        </div>
    </div>
    <div class="card-body px-4">
        <table class="table config-table table-bordered table-striped dataTable">
            <thead>
            <tr>
                <th>No.</th>
                {% if accesoGlobal %}<th>Universidad</th>{% endif %}
                <th>Programa académico</th>
                <th>Tipo</th>
                <th>Categoría de acreditación</th>
                <th>Sedes donde se imparte</th>
                <th>Opciones</th>
            </tr>
            </thead>
            <tbody>
            {% for oferta in ofertas %}
                <tr>
                    <td>{{ loop.index }}</td>
                    {% if accesoGlobal %}
                        <td title="{{ oferta.institucion.nombre }}">{{ oferta.institucion.siglas | default(oferta.institucion.nombre) }}</td>
                    {% endif %}
                    <td>{{ oferta.solicitudProgramaAcademico.nombre }}</td>
                    <td>{{ oferta.solicitudProgramaAcademico.tipoProgramaAcademico.nombre | default('') }}</td>
                    <td>{{ oferta.categoriaAcreditacion.nombre | default('Sin categoría') }}</td>
                    <td>
                        {% set sedesOferta = sedes[oferta.id] | default([]) %}
                        {% for nombre, modalidades in sedesOferta %}
                            <span class="d-block">{{ nombre }}{% if modalidades | filter(v => v) is not empty %} — {{ modalidades | filter(v => v) | join(', ') }}{% endif %}</span>
                        {% else %}
                            <span class="text-muted">Sin configurar</span>
                        {% endfor %}
                    </td>
                    <td class="text-center">
                        <div class="dropdown d-flex justify-content-center">
                            <button class="btn btn-sm btn-light rounded-circle border-0" type="button" data-toggle="dropdown" aria-expanded="false">&#8942;</button>
                            <div class="dropdown-menu dropdown-menu-right program-actions-menu">
                                <button class="dropdown-item modalDetailAction"
                                        data-url="{{ path('app_solicitud_programa_academico_aprobado_detail', {'id': oferta.solicitudProgramaAcademico.id}) }}"
                                        data-title="Detalles del programa nacional">
                                    <i class="fa fa-eye fa-fw mr-2 text-primary"></i> Ver programa nacional
                                </button>
                                <a class="dropdown-item" href="{{ path('app_solicitud_programa_academico_aprobado_gestionar_sedes', {'id': oferta.id}) }}">
                                    <i class="fa fa-map-marker-alt fa-fw mr-2 text-primary"></i> Sedes donde se imparte
                                </a>
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% include 'pages/modalDetail.html.twig' %}
{% endblock %}
