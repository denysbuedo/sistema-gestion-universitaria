{% extends 'baseAdmin.html.twig' %}

{% block title %}Aprobar programa{% endblock %}

{% block body %}
<style>

        .card-luxury { border-radius:12px; border:none; box-shadow:0 4px 20px rgba(0,0,0,0.08); border-top:4px solid #134679; margin-bottom:1.5rem; }
        .card-luxury .card-header { background-color:#fff; border-bottom:1px solid #f1f5f9; padding:15px 24px; }
        .card-luxury .card-title { color:#1a2e44; font-weight:700; font-size:1rem; margin:0; float:none !important; }
        .label-icon { color:#134679; margin-right:6px; opacity:0.8; }
        .fs-label { font-size:0.82rem; font-weight:600; color:#4b5563; margin-bottom:6px; display:block; }
        .btn-fs-submit { background:#134679; color:#fff !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; cursor:pointer; }
        .btn-fs-submit:hover { background:#0f3560; transform:translateY(-1px); box-shadow:0 4px 12px rgba(19,70,121,0.2); }
        .btn-fs-cancel { background:#f1f5f9; color:#475569 !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; text-decoration:none; cursor:pointer; }
        .btn-fs-cancel:hover { background:#e2e8f0; color:#1e293b !important; transform:translateY(-1px); }
        .config-table th { background:#f1f5f9; color:#4a5568; font-size:0.82rem; font-weight:700; border-color:#e2e8f0; padding:8px 10px; }
        .config-table td { font-size:0.85rem; color:#1a2e44; border-color:#e2e8f0; padding:7px 10px; vertical-align:middle; }
</style>

    <div class="card card-luxury">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title text-bold text-gray">Aprobar programa</h3>
    </div>
        {{ include('modules/pregrado/solicitud_programa_academico/detail-partial.html.twig', { 'item': solicitudPrograma }) }}
        <!-- /.card-header -->
        {{ form_start(form) }}
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.cartaAprobacion) }}
                    {{ form_widget(form.cartaAprobacion) }}
                    <span style="margin-top: 1%;position: absolute;margin-left: -95%;z-index: 100;"
                          class="cargar-archivo"> </span>
                    {{ form_errors(form.cartaAprobacion) }}
                    <a id="doc_container" target="_blank"
                       href="{{ app.request.getSchemeAndHttpHost() }}/uploads/pregrado/carta_aprobacion/{{ solicitudPrograma.cartaAprobacion }}">{{ solicitudPrograma.cartaAprobacion }}</a>
                </div>


                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.fechaAprobacion) }}
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        {{ form_widget(form.fechaAprobacion) }}
                        {{ form_errors(form.fechaAprobacion) }}
                    </div>
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.centroRector) }}
                    {{ form_widget(form.centroRector) }}
                    {{ form_errors(form.centroRector) }}
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.codigoPrograma) }}
                    {{ form_widget(form.codigoPrograma) }}
                    {{ form_errors(form.codigoPrograma) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.categoriaAcreditacion) }}
                    {{ form_widget(form.categoriaAcreditacion) }}
                    {{ form_errors(form.categoriaAcreditacion) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.organismoFormador) }}
                    {{ form_widget(form.organismoFormador) }}
                    {{ form_errors(form.organismoFormador) }}
                </div>
            </div>

            <br>
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    <label for="Tipo de curso">Tipo de curso</label>
                </div>
                <label for="Duración " style="margin-left: -15%">Duración </label>
            </div>
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group" style="margin-top: 1%">
                    {{ form_label(form.modalidadDiurno) }}
                    {{ form_widget(form.modalidadDiurno) }}
                    {{ form_errors(form.modalidadDiurno) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group" style="margin-left: -15%">
                    {{ form_label(form.duracionCursoDiurno) }}
                    {{ form_widget(form.duracionCursoDiurno) }}
                    {{ form_errors(form.duracionCursoDiurno) }}
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group" style="margin-top: 1%">
                    {{ form_label(form.modalidadPorEncuentro) }}
                    {{ form_widget(form.modalidadPorEncuentro) }}
                    {{ form_errors(form.modalidadPorEncuentro) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group" style="margin-left: -15%">
                    {{ form_label(form.duracionCursoPorEncuentro) }}
                    {{ form_widget(form.duracionCursoPorEncuentro) }}
                    {{ form_errors(form.duracionCursoPorEncuentro) }}
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group" style="margin-top: 1%">
                    {{ form_label(form.modalidadADistancia) }}
                    {{ form_widget(form.modalidadADistancia) }}
                    {{ form_errors(form.modalidadADistancia) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group" style="margin-left: -15%">
                    {{ form_label(form.duracionCursoADistancia) }}
                    {{ form_widget(form.duracionCursoADistancia) }}
                    {{ form_errors(form.duracionCursoADistancia) }}
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-sm-6 col-md-12 col-lg-12 col-xl-12 form-group">
                    {{ form_label(form.descripcionAprobacion) }}
                    {{ form_widget(form.descripcionAprobacion) }}
                    {{ form_errors(form.descripcionAprobacion) }}
                </div>
            </div>
        </div>

        <div class="card-footer" style="display: flex; justify-content: flex-end; align-items: center;">
            <a class="btn-fs-cancel btn-cancel" data-url="{{ path('app_solicitud_programa_academico_index') }}" data-content="¿Está seguro que desea realizar la acción?"><i class="fas fa-times mr-2"></i>Cancelar</a>
            <button type="submit" class="btn-fs-submit"><i class="fas fa-check mr-2"></i>Aceptar</button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
{% block javascripts %}
    <script>

        var fecha = "{% if solicitudPrograma.fechaAprobacion is empty %}  {{ solicitudPrograma.fechaAprobacion | default('') }} {% else %}  {{ solicitudPrograma.fechaAprobacion|date('d/m/Y') }} {% endif %}".replace(' ', '');
        $('#aprobar_solicitud_programa_academico_fechaAprobacion').val(fecha.replace(' ', ''));


        $('#aprobar_solicitud_programa_academico_cartaAprobacion').change(function () {
            var filename = jQuery(this).val().split('\\').pop();
            $('.cargar-archivo').html(filename);
        })

        $('#aprobar_solicitud_programa_academico_fechaAprobacion').datetimepicker({
            format: 'DD/MM/YYYY'
        }); 
 
        $("#aprobar_solicitud_programa_academico_duracionCursoDiurno, #aprobar_solicitud_programa_academico_duracionCursoPorEncuentro, #aprobar_solicitud_programa_academico_duracionCursoADistancia").bind("keypress", function (event) {
            if (event.charCode != 0) {
                var regex = new RegExp("^[,0-9-]*$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key)) {
                    event.preventDefault();
                    return false;
                }
            }
        });
        $('#aprobar_solicitud_programa_academico_modalidadDiurno').click(function () {
            if (!$(this).prop('checked')) {
                $('#aprobar_solicitud_programa_academico_duracionCursoDiurno').val(null);
            }
        });

        $('#aprobar_solicitud_programa_academico_modalidadPorEncuentro').click(function () {
            if (!$(this).prop('checked')) {
                $('#aprobar_solicitud_programa_academico_duracionCursoPorEncuentro').val(null);
            }
        });
        $('#aprobar_solicitud_programa_academico_modalidadADistancia').click(function () {
            if (!$(this).prop('checked')) {
                $('#aprobar_solicitud_programa_academico_duracionCursoADistancia').val(null);
            }
        });

        $("#aprobar_solicitud_programa_academico_duracionCursoDiurno").on('keydown keypress change keyup', function (e) {
            if ($("#aprobar_solicitud_programa_academico_duracionCursoDiurno").val() != "") {
                $('#aprobar_solicitud_programa_academico_modalidadDiurno').prop('checked', true);
            } else {
                $('#aprobar_solicitud_programa_academico_modalidadDiurno').prop('checked', false);
            }
        });


        $("#aprobar_solicitud_programa_academico_duracionCursoADistancia").on('keydown keypress change keyup', function (e) {
            if ($("#aprobar_solicitud_programa_academico_duracionCursoADistancia").val() != "") {
                $('#aprobar_solicitud_programa_academico_modalidadADistancia').prop('checked', true);
            } else {
                $('#aprobar_solicitud_programa_academico_modalidadADistancia').prop('checked', false);
            }
        });

        $("#aprobar_solicitud_programa_academico_duracionCursoPorEncuentro").on('keydown keypress change keyup', function (e) {
            if ($("#aprobar_solicitud_programa_academico_duracionCursoPorEncuentro").val() != "") {
                $('#aprobar_solicitud_programa_academico_modalidadPorEncuentro').prop('checked', true);
            } else {
                $('#aprobar_solicitud_programa_academico_modalidadPorEncuentro').prop('checked', false);
            }
        });

    </script>
{% endblock %}