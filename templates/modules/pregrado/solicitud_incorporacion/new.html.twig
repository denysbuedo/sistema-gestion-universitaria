{% extends 'baseAdmin.html.twig' %}
{% block title %}Solicitar incorporación de programa{% endblock %}
{% block body %}
<div class="card border-0">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <div><h3 class="card-title m-0" style="float:none!important;">Incorporar un programa existente</h3><div class="text-muted mt-1">{{ institucion.nombre }}</div></div>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_pregrado_solicitud_incorporacion_index') }}"><i class="fas fa-arrow-left mr-1"></i> Volver</a>
    </div>
    {{ form_start(form) }}
    <div class="card-body">
        <p class="text-muted">Seleccione un programa ya aprobado en el catálogo nacional y las modalidades que la universidad solicita impartir.</p>
        {{ form_row(form.programa) }}
        {{ form_row(form.fundamentacion) }}
        <div class="form-group"><label>Modalidades solicitadas</label><div class="row"><div class="col-md-4">{{ form_row(form.modalidadDiurno) }}</div><div class="col-md-4">{{ form_row(form.modalidadPorEncuentro) }}</div><div class="col-md-4">{{ form_row(form.modalidadADistancia) }}</div></div></div>
    </div>
    <div class="card-footer bg-white text-right"><a class="btn btn-outline-secondary mr-2" href="{{ path('app_pregrado_solicitud_incorporacion_index') }}">Cancelar</a><button class="btn btn-primary" type="submit">Registrar solicitud</button></div>
    {{ form_end(form) }}
</div>
{% endblock %}
