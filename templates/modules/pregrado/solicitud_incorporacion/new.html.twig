{% extends 'baseAdmin.html.twig' %}
{% block title %}Solicitar incorporación de programa{% endblock %}
{% block body %}
<div class="card border-0">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <div><h3 class="card-title m-0" style="float:none!important;">Incorporar un programa existente</h3><div class="text-muted mt-1">{{ institucion.nombre }}</div></div>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_pregrado_solicitud_incorporacion_index') }}"><i class="fas fa-arrow-left mr-1"></i> Volver</a>
    </div>
    {{ form_start(form) }}
    <div class="card-body">
        <div class="alert alert-light border"><i class="fas fa-info-circle text-primary mr-2"></i>Complete las modalidades en que se impartirá el programa, explique la necesidad de apertura y adjunte el documento formal de solicitud.</div>
        <h4 class="h6 text-primary mb-3">1. Programa nacional seleccionado</h4>
        {{ form_row(form.programa) }}
        <h4 class="h6 text-primary mt-4 mb-3">2. Modalidades solicitadas</h4>
        <div class="form-group"><div class="row">
            {% if form.modalidadDiurno is defined %}<div class="col-md-4">{{ form_row(form.modalidadDiurno) }}</div>{% endif %}
            {% if form.modalidadPorEncuentro is defined %}<div class="col-md-4">{{ form_row(form.modalidadPorEncuentro) }}</div>{% endif %}
            {% if form.modalidadADistancia is defined %}<div class="col-md-4">{{ form_row(form.modalidadADistancia) }}</div>{% endif %}
        </div></div>
        <h4 class="h6 text-primary mt-4 mb-3">3. Fundamentación</h4>
        {{ form_row(form.fundamentacion) }}
        <h4 class="h6 text-primary mt-4 mb-3">4. Documento de solicitud</h4>
        {{ form_row(form.documentoSolicitud) }}
    </div>
    <div class="card-footer bg-white text-right"><a class="btn btn-outline-secondary mr-2" href="{{ path('app_pregrado_solicitud_incorporacion_index') }}">Cancelar</a><button class="btn btn-primary" type="submit">Registrar solicitud</button></div>
    {{ form_end(form) }}
</div>
{% endblock %}
