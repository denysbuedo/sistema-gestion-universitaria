{% extends 'baseAdmin.html.twig' %}
{% block title %}Solicitudes de incorporación{% endblock %}
{% block body %}
<div class="card border-0">
    <div class="card-header bg-white border-bottom d-flex align-items-center">
        <div><h3 class="card-title m-0" style="float:none!important;"><i class="fas fa-university text-primary mr-2"></i>Solicitudes para impartir un programa existente</h3><div class="text-muted mt-1">Una universidad solicita autorización para incorporar a su oferta un programa que ya existe en el catálogo nacional.</div></div>
        {% if not global %}<div class="ml-auto"><a class="btn-lux-sm btn-lux-primary" href="{{ path('app_pregrado_solicitud_incorporacion_nueva') }}"><i class="fas fa-plus"></i> Nueva solicitud</a></div>{% endif %}
    </div>
    <div class="card-body">
        <div class="alert alert-light border mb-4">
            <i class="fas fa-info-circle text-primary mr-2"></i>
            {% if global %}Revise las solicitudes enviadas por las universidades. Al aprobar una, el programa se incorpora a la oferta de esa institución sin duplicar el programa nacional.{% else %}Utilice esta pantalla cuando su universidad quiera comenzar a impartir una carrera ya aprobada nacionalmente. Para proponer una carrera que todavía no existe, use “Solicitar nuevo programa nacional”.{% endif %}
        </div>
        <div class="border rounded p-3 mb-4 bg-light">
            <label for="programa_nacional" class="mb-1">Programa nacional</label>
            <form method="get" action="{{ path('app_pregrado_solicitud_incorporacion_nueva') }}">
                <div class="d-flex align-items-end" style="gap:10px;">
                    <div class="flex-grow-1">
                        <select id="programa_nacional" name="programa" class="form-control" required>
                            <option value="">Seleccione el programa que su universidad desea impartir</option>
                            {% for programa in programasNacionales %}<option value="{{ programa.id }}">{{ programa.nombre }} — {{ programa.tipoProgramaAcademico.nombre | default('') }}</option>{% endfor %}
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-arrow-right mr-1"></i> Continuar</button>
                </div>
                <small class="form-text text-muted">La universidad se obtiene de su cuenta. Después podrá indicar las modalidades, fundamentar la apertura y adjuntar el documento formal.</small>
            </form>
        </div>
        <table class="table table-bordered table-striped dataTable">
            <thead><tr><th>No.</th>{% if global %}<th>Universidad</th>{% endif %}<th>Programa nacional</th><th>Modalidades solicitadas</th><th>Documento</th><th>Estado</th><th>Fecha</th>{% if global %}<th>Opciones</th>{% endif %}</tr></thead>
            <tbody>
            {% for item in registros %}
                <tr>
                    <td>{{ loop.index }}</td>
                    {% if global %}<td>{{ item.institucion.siglas | default(item.institucion.nombre) }}</td>{% endif %}
                    <td>{{ item.programa.nombre }}</td>
                    <td>{{ [item.modalidadDiurno ? 'Diurno' : null, item.modalidadPorEncuentro ? 'Por encuentro' : null, item.modalidadADistancia ? 'A distancia' : null] | filter(v => v) | join(', ') }}</td>
                    <td>{% if item.documentoSolicitud %}<a target="_blank" href="{{ app.request.getSchemeAndHttpHost() }}/uploads/pregrado/solicitud_incorporacion/documento/{{ item.documentoSolicitud }}"><i class="fas fa-file-pdf text-danger mr-1"></i>Ver solicitud</a>{% else %}<span class="text-muted">—</span>{% endif %}</td>
                    <td>{{ item.estado | capitalize }}</td>
                    <td>{{ item.creado | date('d/m/Y') }}</td>
                    {% if global %}
                        <td>
                            {% if item.estado == constant('App\\Entity\\Pregrado\\SolicitudIncorporacionPrograma::PENDIENTE') %}
                                <div class="d-flex" style="gap:6px;">
                                    <form method="post" action="{{ path('app_pregrado_solicitud_incorporacion_aprobar', {'id': item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('aprobar_incorporacion_' ~ item.id) }}"><button class="btn btn-sm btn-outline-success">Aprobar</button></form>
                                    <form method="post" action="{{ path('app_pregrado_solicitud_incorporacion_rechazar', {'id': item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('rechazar_incorporacion_' ~ item.id) }}"><button class="btn btn-sm btn-outline-danger">Rechazar</button></form>
                                </div>
                            {% endif %}
                        </td>
                    {% endif %}
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
