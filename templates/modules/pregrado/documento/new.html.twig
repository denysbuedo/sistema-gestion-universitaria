{% extends 'baseAdmin.html.twig' %}

{% block title %}Adicionar documento{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .card-luxury { border-radius: 12px; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-top: 4px solid #134679; margin-bottom: 2rem; }
        .card-luxury .card-header { background: #fff; border-bottom: 1px solid #f1f5f9; padding: 18px 24px; }
        .fs-title { color: #1a2e44; font-weight: 700; font-size: 1.1rem; margin: 0; }
        .label-icon { color: #134679; margin-right: 8px; opacity: 0.8; }
        .fs-label { font-size: 0.82rem; font-weight: 600; color: #4b5563; margin-bottom: 6px; display: block; }
        .estado-toggle { display:inline-flex; border-radius:20px; background:#f1f5f9; padding:3px; gap:2px; }
        .et-opt { padding:6px 16px; border-radius:20px; border:none; font-size:0.75rem; font-weight:700; cursor:pointer; background:transparent; color:#94a3b8; display:inline-flex; align-items:center; gap:6px; transition:all .2s; letter-spacing:.3px; }
        .et-opt i { font-size:0.45rem; vertical-align:middle; }
        .et-opt.et-on.active  { background:#dcfce7; color:#15803d; box-shadow: 0 2px 4px rgba(21,128,61,0.1); }
        .et-opt.et-off.active { background:#fee2e2; color:#b91c1c; box-shadow: 0 2px 4px rgba(185,28,28,0.1); }
        .btn-fs-submit { background: #134679; color: #fff !important; font-weight: 700; font-size: 0.85rem; padding: 10px 24px; border-radius: 8px; border: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
        .btn-fs-submit:hover { background: #0f3560; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(19,70,121,0.2); }
        .btn-fs-cancel { background: #f1f5f9; color: #475569 !important; font-weight: 700; font-size: 0.85rem; padding: 10px 24px; border-radius: 8px; border: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
        .btn-fs-cancel:hover { background: #e2e8f0; color: #1e293b !important; }
    </style>
{% endblock %}

{% block body %}
    <div class="card card-luxury">
        <div class="card-header">
            <h3 class="fs-title"><i class="fas fa-file-alt label-icon"></i>Adicionar documento</h3>
        </div>
        {{ form_start(form) }}
        <div class="card-body px-4">
            <div class="row">
                <div class="col-md-8 form-group">
                    <label class="fs-label">{{ form_label(form.nombre) }}</label>
                    {{ form_widget(form.nombre, {'attr': {'class': 'form-control shadow-sm', 'placeholder': 'Nombre del documento...'}}) }}
                    {{ form_errors(form.nombre) }}
                </div>
                <div class="col-md-4 form-group">
                    <label class="fs-label"><i class="fas fa-toggle-on text-primary mr-1"></i> Estado</label>
                    <input type="checkbox" id="{{ form.activo.vars.id }}" name="{{ form.activo.vars.full_name }}" class="d-none" {% if form.activo.vars.data %}checked{% endif %}>
                    <div class="estado-toggle" data-cb="{{ form.activo.vars.id }}">
                        <button type="button" class="et-opt et-on{% if form.activo.vars.data %} active{% endif %}"><i class="fas fa-circle"></i> Habilitado</button>
                        <button type="button" class="et-opt et-off{% if not form.activo.vars.data %} active{% endif %}"><i class="fas fa-circle"></i> Deshabilitado</button>
                    </div>
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-12 form-group">
                    <label class="fs-label">{{ form_label(form.descripcion) }}</label>
                    {{ form_widget(form.descripcion, {'attr': {'class': 'form-control shadow-sm', 'rows': '4', 'placeholder': 'Descripción del tipo de documento...'}}) }}
                    {{ form_errors(form.descripcion) }}
                </div>
            </div>
        </div>
        <div class="card-footer bg-light px-4 py-3 d-flex justify-content-end" style="gap:12px;">
            <a class="btn-fs-cancel btn-cancel" data-url="{{ path('app_documento_index') }}" data-content="¿Desea cancelar?"><i class="fas fa-times"></i> Cancelar</a>
            <button class="btn-fs-submit" type="submit"><i class="fas fa-save"></i> Guardar</button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function() {
            $(document).on('click', '.estado-toggle .et-opt', function() {
                var $t = $(this).closest('.estado-toggle'), cbId = $t.data('cb'), isOn = $(this).hasClass('et-on');
                $t.find('.et-opt').removeClass('active'); $(this).addClass('active'); $('#' + cbId).prop('checked', isOn);
            });
        });
    </script>
{% endblock %}