{% extends 'baseAdmin.html.twig' %}

{% block title %}Asignar plan de estudio{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <style>
        .card-luxury { border-radius:12px; border:none; box-shadow:0 4px 20px rgba(0,0,0,0.08); border-top:4px solid #134679; margin-bottom:1.5rem; }
        .card-luxury .card-header { background-color:#fff; border-bottom:1px solid #f1f5f9; padding:15px 24px; }
        .card-luxury .card-title { color:#1a2e44; font-weight:700; font-size:1rem; margin:0; float:none !important; }
        .label-icon { color:#134679; margin-right:6px; opacity:0.8; }
        .btn-lux-sm { padding:6px 14px; border-radius:6px; font-weight:700; font-size:0.75rem; border:none; display:inline-flex; align-items:center; gap:5px; text-transform:uppercase; transition:all 0.2s; text-decoration:none; color:#fff; cursor:pointer; }
        .btn-lux-primary { background:#134679; color:#fff; }
        .btn-lux-primary:hover { background:#0f3560; color:#fff; transform:translateY(-1px); }
        .btn-action-sm { width:28px; height:28px; padding:0; display:inline-flex; justify-content:center; align-items:center; border-radius:6px; font-size:0.75rem; border:none; transition:all 0.2s; color:#fff; margin:0 2px; text-decoration:none; cursor:pointer; }
        .btn-action-primary { background:#3b82f6; }
        .btn-action-primary:hover { background:#2563eb; transform:translateY(-1px); }
        .btn-action-danger { background:#ef4444; }
        .btn-action-danger:hover { background:#dc2626; transform:translateY(-1px); }
        .config-table th { background:#f1f5f9; color:#4a5568; font-size:0.82rem; font-weight:700; border-color:#e2e8f0; padding:8px 10px; }
        .config-table td { font-size:0.85rem; color:#1a2e44; border-color:#e2e8f0; padding:7px 10px; vertical-align:middle; }
    </style>
{% endblock %}
{% block body %}
    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center program-action-header">
            <h3 class="card-title text-bold m-0"><i class="fas fa-book-open label-icon"></i>Asignar plan de estudio</h3>
            <div class="program-header-actions"><a class="program-back-link" href="{{ path('app_solicitud_programa_academico_aprobado_index') }}"><i class="fas fa-arrow-left"></i>Volver a programas</a></div>
        </div>
        <div class="program-summary">{{ include('modules/pregrado/solicitud_programa_academico_aprobado/detail.html.twig', { 'item': solicitudProgramaAcademico, 'format':'col3' }) }}</div>
        <!-- /.card-header -->
        {{ form_start(form) }}
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.planEstudio) }}
                    {{ form_widget(form.planEstudio) }}
                    {{ form_errors(form.planEstudio) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group d-flex align-items-end" id="btn_asociar">
                    <button class="btn-lux-sm btn-lux-primary"><i class="fas fa-link mr-1"></i>Asociar</button>
                </div>
            </div>
        </div>


        {{ form_end(form) }}
        <hr>
        <div class="card-body">
            <table class="table table-bordered table-striped dataTable">
                <thead class="table-custom-header">
                <tr>
                    <th>No.</th>
                    <th>Nombre</th>
                    <th class="text-center">Opciones</th>
                </tr>
                </thead>
                <tbody>
                {% for item in registros %}
                    <tr>
                        <td width="1%">{{ loop.index }}</td>
                        <td>{{ item.planEstudio.nombre | default('') }}</td>

                        <td width="15%" class="text-center">
                            <a title="Descargar plan de estudio" target="_blank" class="btn-action-sm btn-action-primary"
                               href="{{ app.request.getSchemeAndHttpHost() }}/uploads/plan_estudio/plan_estudio/{{ item.planEstudio.planEstudio }}">
                                <i class="fa fa-download"></i>
                            </a>
                            <button title="Eliminar" class="btn-action-sm btn-action-danger elementRemove"
                                    data-url="{{ path('app_solicitud_programa_academico_aprobado_eliminar_plan_estudio', {'id': item.id}) }}">
                                <i class="fa fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>

            </table>
        </div>

    </div>
{% endblock %}
{% block javascripts %}
    <script>
        {% if registros|length > 0 %}
        $('#btn_asociar').hide();
        {% else %}
        $('#btn_asociar').show();
        {% endif %}

    </script>
{% endblock %}
