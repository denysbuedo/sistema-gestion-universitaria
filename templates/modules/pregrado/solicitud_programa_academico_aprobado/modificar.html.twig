{% extends 'baseAdmin.html.twig' %}

{% block title %}Modificar información{% endblock %}

{% block body %}
<style>

        .card-luxury { border-radius:12px; border:none; box-shadow:0 4px 20px rgba(0,0,0,0.08); border-top:4px solid #134679; margin-bottom:1.5rem; }
        .card-luxury .card-header { background-color:#fff; border-bottom:1px solid #f1f5f9; padding:15px 24px; }
        .card-luxury .card-title { color:#1a2e44; font-weight:700; font-size:1rem; margin:0; float:none !important; }
        .label-icon { color:#134679; margin-right:6px; opacity:0.8; }
        .fs-label { font-size:0.82rem; font-weight:600; color:#4b5563; margin-bottom:6px; display:block; }
        .btn-fs-submit { background:#134679; color:#fff !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; cursor:pointer; }
        .btn-fs-submit:hover { background:#0f3560; transform:translateY(-1px); box-shadow:0 4px 12px rgba(19,70,121,0.2); }
        .btn-fs-cancel { background:#f1f5f9; color:#475569 !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; text-decoration:none; cursor:pointer; }
        .btn-fs-cancel:hover { background:#e2e8f0; color:#1e293b !important; transform:translateY(-1px); }
        .config-table th { background:#f1f5f9; color:#4a5568; font-size:0.82rem; font-weight:700; border-color:#e2e8f0; padding:8px 10px; }
        .config-table td { font-size:0.85rem; color:#1a2e44; border-color:#e2e8f0; padding:7px 10px; vertical-align:middle; }
        .modality-help { margin:-6px 0 16px; color:#667786; font-size:0.82rem; }
        .duration-input .input-group-text { min-width:58px; justify-content:center; border-color:#ced4da; background:#eef2f5; color:#526575; font-size:0.84rem; }
        .duration-input input:disabled { background:#f3f5f7; color:#8a98a5; }
</style>

    <div class="card card-luxury">
    <div class="card-header d-flex align-items-center program-action-header">
        <h3 class="card-title text-bold text-gray">Modificar información </h3>
        <div class="program-header-actions"><a class="program-back-link" href="{{ path('app_solicitud_programa_academico_aprobado_index') }}"><i class="fas fa-arrow-left"></i>Volver a programas</a></div>
    </div>
        <div class="program-summary">
            {{ include('modules/pregrado/solicitud_programa_academico_aprobado/detail.html.twig', { 'item': solicitudPrograma, 'format':'col3' }) }}
        </div>
        <!-- /.card-header -->
        {{ form_start(form) }}
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.centroRector) }}
                    {{ form_widget(form.centroRector) }}
                    {{ form_errors(form.centroRector) }}
                </div>
{#                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">#}
{#                    {{ form_label(form.categoriaAcreditacion) }}#}
{#                    {{ form_widget(form.categoriaAcreditacion) }}#}
{#                    {{ form_errors(form.categoriaAcreditacion) }}#}
{#                </div>#}
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.organismoDemandante) }}
                    {{ form_widget(form.organismoDemandante) }}
                    {{ form_errors(form.organismoDemandante) }}
                </div>

                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.organismoFormador) }}
                    {{ form_widget(form.organismoFormador) }}
                    {{ form_errors(form.organismoFormador) }}
                </div>
            </div>

            <div class="program-form-section">
                <h4>Modalidades y duración</h4>
                <p class="modality-help">Seleccione las modalidades disponibles e indique para cada una la duración total del programa en años.</p>
                <div class="row align-items-end">
                <div class="col-12 col-md-6 form-group">
                    {{ form_label(form.modalidadDiurno) }}
                    {{ form_widget(form.modalidadDiurno) }}
                    {{ form_errors(form.modalidadDiurno) }}
                </div>
                <div class="col-12 col-md-6 form-group">
                    {{ form_label(form.duracionCursoDiurno) }}
                    <div class="input-group duration-input">{{ form_widget(form.duracionCursoDiurno) }}<div class="input-group-append"><span class="input-group-text">años</span></div></div>
                    {{ form_errors(form.duracionCursoDiurno) }}
                </div>
                </div>
                <div class="row align-items-end">
                <div class="col-12 col-md-6 form-group">
                    {{ form_label(form.modalidadPorEncuentro) }}
                    {{ form_widget(form.modalidadPorEncuentro) }}
                    {{ form_errors(form.modalidadPorEncuentro) }}
                </div>
                <div class="col-12 col-md-6 form-group">
                    {{ form_label(form.duracionCursoPorEncuentro) }}
                    <div class="input-group duration-input">{{ form_widget(form.duracionCursoPorEncuentro) }}<div class="input-group-append"><span class="input-group-text">años</span></div></div>
                    {{ form_errors(form.duracionCursoPorEncuentro) }}
                </div>
                </div>
                <div class="row align-items-end">
                <div class="col-12 col-md-6 form-group">
                    {{ form_label(form.modalidadADistancia) }}
                    {{ form_widget(form.modalidadADistancia) }}
                    {{ form_errors(form.modalidadADistancia) }}
                </div>
                <div class="col-12 col-md-6 form-group">
                    {{ form_label(form.duracionCursoADistancia) }}
                    <div class="input-group duration-input">{{ form_widget(form.duracionCursoADistancia) }}<div class="input-group-append"><span class="input-group-text">años</span></div></div>
                    {{ form_errors(form.duracionCursoADistancia) }}
                </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12 col-sm-6 col-md-12 col-lg-12 col-xl-12 form-group">
                    {{ form_label(form.descripcionAprobacion) }}
                    {{ form_widget(form.descripcionAprobacion) }}
                    {{ form_errors(form.descripcionAprobacion) }}
                </div>
            </div>
        </div>

        <div class="card-footer" style="display: flex; justify-content: flex-end; align-items: center;">
            <a class="btn-fs-cancel btn-cancel" data-url="{{ path('app_solicitud_programa_academico_aprobado_index') }}" data-content="¿Está seguro que desea realizar la acción?"><i class="fas fa-times mr-2"></i>Cancelar</a>
            <button type="submit" class="btn-fs-submit"><i class="fas fa-check mr-2"></i>Aceptar</button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
{% block javascripts %}
    <script>

        const modalityDurationPairs = [
            ['#aprobar_modificar_solicitud_programa_academico_modalidadDiurno', '#aprobar_modificar_solicitud_programa_academico_duracionCursoDiurno'],
            ['#aprobar_modificar_solicitud_programa_academico_modalidadPorEncuentro', '#aprobar_modificar_solicitud_programa_academico_duracionCursoPorEncuentro'],
            ['#aprobar_modificar_solicitud_programa_academico_modalidadADistancia', '#aprobar_modificar_solicitud_programa_academico_duracionCursoADistancia']
        ];

        modalityDurationPairs.forEach(function (pair) {
            const $modality = $(pair[0]);
            const $duration = $(pair[1]);
            const syncDuration = function (clearValue) {
                const enabled = $modality.prop('checked');
                $duration.prop('disabled', !enabled);
                if (!enabled && clearValue) {
                    $duration.val('');
                }
            };
            $modality.on('change', function () { syncDuration(true); });
            syncDuration(false);
        });

    </script>
{% endblock %}
