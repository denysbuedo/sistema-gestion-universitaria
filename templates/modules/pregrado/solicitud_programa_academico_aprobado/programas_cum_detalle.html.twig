{% extends 'baseAdmin.html.twig' %}

{% block title %}Programas del CUM{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .cum-detail-header { gap: 16px; flex-wrap: wrap; }
        .cum-detail-heading { min-width: 0; flex: 1 1 420px; }
        .cum-detail-heading .card-title {
            float: none !important;
            display: block;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }
        .cum-detail-institution {
            display: block;
            clear: both;
            margin-top: 5px;
            line-height: 1.35;
            overflow-wrap: anywhere;
        }
    </style>
{% endblock %}

{% block body %}
<div class="card border-0">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center cum-detail-header">
        <div class="cum-detail-heading">
            <h3 class="card-title m-0">{{ centro.nombreFacultad }}</h3>
            <div class="text-muted cum-detail-institution">{{ centro.institucion.nombre | default('') }}</div>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_pregrado_programas_por_cum') }}"><i class="fas fa-arrow-left mr-1"></i> Volver</a>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped dataTable">
            <thead><tr><th>No.</th><th>Programa académico</th><th>Tipo</th><th>Modalidad</th></tr></thead>
            <tbody>
            {% for programa in programas %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ programa.nombre }}</td>
                    <td>{{ programa.tipo | default('') }}</td>
                    <td>{{ programa.modalidades | join(', ') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
