{% extends 'baseAdmin.html.twig' %}

{% block title %}Programas del CUM{% endblock %}

{% block body %}
<div class="card border-0">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center">
        <div>
            <h3 class="card-title m-0">{{ centro.nombreFacultad }}</h3>
            <div class="text-muted mt-1">{{ centro.institucion.nombre | default('') }}</div>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_pregrado_programas_por_cum') }}"><i class="fas fa-arrow-left mr-1"></i> Volver</a>
    </div>
    <div class="card-body">
        <table class="table table-bordered table-striped dataTable">
            <thead><tr><th>No.</th><th>Programa académico</th><th>Tipo</th><th>Modalidad</th></tr></thead>
            <tbody>
            {% for asignacion in asignaciones %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ asignacion.solicitudProgramaAcademicoInstitucion.solicitudProgramaAcademico.nombre }}</td>
                    <td>{{ asignacion.solicitudProgramaAcademicoInstitucion.solicitudProgramaAcademico.tipoProgramaAcademico.nombre | default('') }}</td>
                    <td>{{ asignacion.modalidad }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
