{% extends 'baseAdmin.html.twig' %}

{% block title %}Sedes donde se imparte{% endblock %}

{% block body %}
<div class="card border-0">
    <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between">
        <div>
            <h3 class="card-title m-0">Sedes donde se imparte</h3>
            <div class="text-muted mt-1">{{ programa.nombre }}</div>
        </div>
        <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_solicitud_programa_academico_aprobado_index') }}">
            <i class="fas fa-arrow-left mr-1"></i> Volver
        </a>
    </div>
    <div class="card-body">
        <p class="text-muted">Seleccione la universidad cuya distribución territorial desea consultar o modificar.</p>
        <div class="list-group list-group-flush border">
            {% for relacion in relaciones %}
                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
                   href="{{ path('app_solicitud_programa_academico_aprobado_gestionar_sedes', {'id': relacion.id}) }}">
                    <span>
                        <i class="fas fa-university text-primary mr-2"></i>
                        <strong>{{ relacion.institucion.siglas | default(relacion.institucion.nombre) }}</strong>
                        <span class="text-muted ml-2">{{ relacion.institucion.nombre }}</span>
                    </span>
                    <i class="fas fa-chevron-right text-muted"></i>
                </a>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
