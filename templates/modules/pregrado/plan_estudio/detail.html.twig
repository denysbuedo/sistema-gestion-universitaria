<style>
    .pd-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-bottom: 25px; }
    .pd-item { display: flex; flex-direction: column; }
    .pd-label { font-size: 0.72rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
    .pd-value { font-size: 0.9rem; font-weight: 600; color: #1e293b; }
    .pd-badge { padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .pd-section-title { font-size: 0.85rem; font-weight: 700; color: #134679; text-transform: uppercase; margin-bottom: 15px; display: flex; align-items: center; gap: 8px; border-bottom: 1px solid #f1f5f9; padding-bottom: 8px; }
    .file-link { color: #134679; text-decoration: none; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }
    .file-link:hover { color: #0f3560; text-decoration: underline; }
</style>

<div class="pd-section-title"><i class="fas fa-info-circle"></i> Información General</div>
<div class="pd-grid">
    <div class="pd-item">
        <span class="pd-label">Curso académico</span>
        <span class="pd-value">{{ item.cursoAcademico.nombre | default('-') }}</span>
    </div>
    <div class="pd-item">
        <span class="pd-label">Programa académico de pregrado</span>
        <span class="pd-value text-primary">{{ item.carrera.nombre | default('-') }}</span>
    </div>
    <div class="pd-item">
        <span class="pd-label">Año de aprobación</span>
        <span class="pd-value">{{ item.annoAprobacion | default('-') }}</span>
    </div>
    <div class="pd-item">
        <span class="pd-label">Fecha de aprobación</span>
        <span class="pd-value">{{ item.fechaAprobacion ? item.fechaAprobacion | date('d/m/Y') : '-' }}</span>
    </div>
    <div class="pd-item">
        <span class="pd-label">Organismo demandante</span>
        <span class="pd-value">{{ item.carrera.organismoDemandante.nombre | default('-') }}</span>
    </div>
    <div class="pd-item">
        <span class="pd-label">Organismo formador</span>
        <span class="pd-value">{{ item.organismoFormador.nombre | default('-') }}</span>
    </div>
</div>

<div class="pd-section-title"><i class="fas fa-clock"></i> Duración de la Carrera</div>
<div class="pd-grid">
    <div class="pd-item">
        <span class="pd-label">Curso Diurno</span>
        <span class="pd-value">{% if item.carrera.duracionCursoDiurno is not null %}{{ item.carrera.duracionCursoDiurno }} años{% else %}-{% endif %}</span>
    </div>
    <div class="pd-item">
        <span class="pd-label">Curso por Encuentro</span>
        <span class="pd-value">{% if item.carrera.duracionCursoPorEncuentro is not null %}{{ item.carrera.duracionCursoPorEncuentro }} años{% else %}-{% endif %}</span>
    </div>
</div>

<div class="pd-section-title"><i class="fas fa-file-pdf"></i> Archivos del Plan</div>
<div class="pd-grid">
    <div class="pd-item">
        <span class="pd-label">Plan de estudio</span>
        <a class="file-link" target="_blank" href="{{ app.request.getSchemeAndHttpHost() }}/uploads/pregrado/plan_estudio/{{ item.planEstudio }}">
            <i class="fas fa-download"></i> {{ item.planEstudio }}
        </a>
    </div>
    <div class="pd-item">
        <span class="pd-label">Documento ejecutivo</span>
        <a class="file-link" target="_blank" href="{{ app.request.getSchemeAndHttpHost() }}/uploads/pregrado/plan_estudio/documento_ejecutivo/{{ item.documentoEjecutivo }}">
            <i class="fas fa-download"></i> {{ item.documentoEjecutivo }}
        </a>
    </div>
</div>

<div class="mt-4">
    <div class="pd-section-title"><i class="fas fa-folder-open"></i> Documentos del expediente</div>
    <table class="table config-table table-bordered table-striped dataTable mb-0 shadow-sm">
        <thead>
        <tr>
            <th width="1%">No.</th>
            <th>Documento</th>
            <th>Tipo de Documento</th>
            <th class="text-center" width="5%">Descargar</th>
        </tr>
        </thead>
        <tbody>
        {% for item in registros %}
            <tr>
                <td>{{ loop.index }}</td>
                <td class="font-weight-bold">{{ item.nombre | default('') }}</td>
                <td><span class="pd-badge">{{ item.documento.nombre | default('') }}</span></td>
                <td class="text-center">
                    <a title="Descargar documento" target="_blank" class="btn btn-xs btn-outline-primary shadow-sm border-0"
                       style="background: #eff6ff; color: #2563eb;"
                       href="{{ app.request.getSchemeAndHttpHost() }}/{{ item.documentoFisico }}">
                        <i class="fa fa-file-download"></i>
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
