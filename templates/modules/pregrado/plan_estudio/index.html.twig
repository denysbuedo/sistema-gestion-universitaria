{% extends 'baseAdmin.html.twig' %}

{% block title %}Planes de estudio{% endblock %}

{% block body %}
<style>
    .card-luxury {
        border-radius: 12px; border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border-top: 4px solid #134679; margin-bottom: 1.5rem;
    }
    .card-luxury .card-header {
        background-color: #fff; border-bottom: 1px solid #f1f5f9; padding: 15px 24px;
    }
    .card-luxury .card-title { color: #1a2e44; font-weight: 700; font-size: 1rem; margin: 0; float: none !important; }
    .label-icon { color: #134679; margin-right: 6px; opacity: 0.8; }
    .config-table th {
        background: #f1f5f9; color: #4a5568; font-size: 0.82rem; font-weight: 700;
        border-color: #e2e8f0; padding: 8px 10px;
    }
    .config-table td { font-size: 0.85rem; color: #1a2e44; border-color: #e2e8f0; padding: 7px 10px; vertical-align: middle; }
    .config-table tbody tr:hover { background: #f8fafc; }
    .btn-lux-sm {
        padding: 6px 14px; border-radius: 6px; font-weight: 700; font-size: 0.75rem;
        border: none; display: inline-flex; align-items: center; gap: 5px;
        text-transform: uppercase; text-decoration: none; cursor: pointer; transition: all 0.2s;
    }
    .btn-lux-primary { background: #134679; color: #fff !important; }
    .btn-lux-primary:hover { background: #0f3560; }
    .btn-lux-secondary { background: #64748b; color: #fff !important; }
    .btn-lux-secondary:hover { background: #475569; }
</style>

{% include 'pages/modalDetail.html.twig' %}

<div class="card card-luxury">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title text-bold m-0"><i class="fas fa-book-open label-icon"></i>Planes de estudio</h3>
        <div class="ml-auto d-flex gap-2" style="gap:8px;">
            <a title="Exportar a PDF" class="btn-lux-sm btn-lux-secondary" target="_blank"
               href="{{ path('app_plan_estudio_exportar_pdf') }}">
                <i class="fa fa-file-pdf"></i> PDF
            </a>
            <a title="Nuevo" class="btn-lux-sm btn-lux-primary" href="{{ path('app_plan_estudio_registrar') }}">
                <i class="fa fa-plus"></i> Nuevo
            </a>
        </div>
    </div>
    <div class="card-body px-4">
        <table class="table config-table table-bordered table-striped dataTable">
            <thead>
            <tr>
                <th>No.</th>
                <th>Programa académico</th>
                <th>Curso académico</th>
                <th>Año de aprobación</th>
                <th>Estado</th>
                <th style="text-align:center;">Opciones</th>
            </tr>
            </thead>
            <tbody>
            {% for item in registros %}
                <tr>
                    <td width="1%">{{ loop.index }}</td>
                    <td>{{ item.nombre_carrera | default('') }}</td>
                    <td>{{ item.nombre_curso_academico | default('') }}</td>
                    <td>{{ item.annoAprobacion | default('') }}</td>
                    <td width="10%">
                        {% if '1' == item.activo %}
                                <span class="pregrado-status is-active"><i class="fas fa-circle"></i>Habilitado</span>
                        {% else %}
                                <span class="pregrado-status is-inactive"><i class="fas fa-circle"></i>Deshabilitado</span>
                        {% endif %}
                    </td>
                    <td width="5%">
                        <div class="dropdown d-flex justify-content-center">
                            <button class="btn btn-sm btn-light rounded-circle shadow-sm border-0 p-0 d-flex align-items-center justify-content-center"
                                    style="width:32px;height:32px;background:#f1f5f9;color:#64748b;font-size:1rem;line-height:1;"
                                    type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                &#8942;
                            </button>
                            <div class="dropdown-menu dropdown-menu-right shadow-sm" style="border-radius:10px;border:none;min-width:200px;padding:6px 0;font-size:0.85rem;">
                                <button class="dropdown-item modalDetailAction" style="padding:8px 16px;"
                                        data-url="{{ path('app_plan_estudio_detail', {'id': item.id}) }}"
                                        data-title="Detalles del plan de estudio">
                                    <i class="fa fa-eye fa-fw mr-2 text-primary"></i> Ver detalles
                                </button>
                                <a class="dropdown-item" style="padding:8px 16px;" href="{{ path('app_plan_estudio_modificar', {'id': item.id}) }}">
                                    <i class="fa fa-edit fa-fw mr-2 text-warning"></i> Modificar
                                </a>
                                <a class="dropdown-item" style="padding:8px 16px;" href="{{ path('app_plan_estudio_modificaciones', {'id': item.id}) }}">
                                    <i class="fa fa-cogs fa-fw mr-2 text-info"></i> Modificaciones
                                </a>
                                <div class="dropdown-divider my-1"></div>
                                <button class="dropdown-item elementRemove text-danger" style="padding:8px 16px;"
                                        data-url="{{ path('app_plan_estudio_eliminar', {'id': item.id}) }}">
                                    <i class="fa fa-trash fa-fw mr-2"></i> Eliminar
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function () {
            $(document).on('show.bs.dropdown', 'table .dropdown', function () {
                var $btn  = $(this).find('button[data-toggle="dropdown"]');
                var $menu = $(this).find('.dropdown-menu');
                var offset = $btn.offset();
                $menu.appendTo('body').css({
                    position: 'fixed',
                    top:   offset.top + $btn.outerHeight() + 2,
                    left:  'auto',
                    right: $(window).width() - offset.left - $btn.outerWidth(),
                    display: 'block',
                    zIndex: 9999
                });
            });
            $(document).on('hide.bs.dropdown', 'table .dropdown', function () {
                var $menu = $(this).find('.dropdown-menu');
                if ($menu.parent().is('body')) {
                    $menu.appendTo($(this)).css({ position: '', top: '', left: '', right: '', zIndex: '' });
                }
            });
        });
    </script>
{% endblock %}
