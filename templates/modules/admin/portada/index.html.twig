{% extends 'baseAdmin.html.twig' %}

{% block title %}Panel de Control - Administración{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --primary-dark: #134679;
            --primary-light: #2a6db0;
            --accent-color: #00bcd4;
            --bg-glass: rgba(255, 255, 255, 0.9);
        }

        .dashboard-container {
            padding: 2rem;
            background-color: #f4f7f6;
            min-height: 100vh;
        }

        .kpi-card {
            border-radius: 16px;
            border: none;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
            position: relative;
        }

        .kpi-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.12) !important;
        }

        .kpi-icon-bg {
            position: absolute;
            right: -15px;
            bottom: -15px;
            font-size: 5rem;
            opacity: 0.1;
            transform: rotate(-15deg);
        }

        .chart-container {
            background: var(--bg-glass);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 1.5rem;
            height: 100%;
            border: 1px solid rgba(255,255,255,0.3);
        }

        .status-badge {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
        }

        .pm-hero {
            background: linear-gradient(135deg, #071e3d 0%, #134679 55%, #1a5898 100%);
            padding: 30px 40px; position: relative; overflow: hidden;
            margin: -10px -15px 24px -15px;
        }
        .pm-hero::before {
            content: ''; position: absolute; width: 400px; height: 400px; border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,.07) 0%, transparent 70%);
            top: -150px; right: -80px; pointer-events: none;
        }
        .pm-hero-dot {
            position: absolute; inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1px);
            background-size: 24px 24px; pointer-events: none;
        }
        .pm-hero-inner { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
        .pm-hero-tag { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255,255,255,.55); margin-bottom: 6px; }
        .pm-hero-title { font-size: 22px; font-weight: 700; color: #fff; margin-bottom: 4px; line-height: 1.2; }
        .pm-hero-sub { font-size: 13px; color: rgba(255,255,255,.6); }
        .pm-btn-white {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 8px 16px; border-radius: 9px; font-size: 13px; font-weight: 600;
            background: #fff; color: #134679; border: none; cursor: pointer;
            transition: background .2s;
        }
        .pm-btn-white:hover { background: #f0f7ff; }
        @media (max-width: 768px) { .pm-hero { padding: 22px 16px; } }

        .glass-header { display: none; }

        .btn-modern {
            border-radius: 12px;
            font-weight: 600;
            padding: 0.6rem 1.2rem;
            transition: all 0.2s;
        }

        .card-title-modern {
            color: var(--primary-dark);
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: -0.5px;
        }
        
        .table-activity th {
            border-top: none;
            text-transform: uppercase;
            font-size: 0.75rem;
            color: #64748b;
            letter-spacing: 0.5px;
        }
        .table-activity td {
            font-size: 0.85rem;
            vertical-align: middle;
            color: #1a2e44;
        }

        /* ── White KPI cards (dashboard style) ── */
        .kpi-card-new {
            background: #fff;
            border-radius: 14px;
            border: 1px solid #e2e8f0;
            border-top: 3px solid var(--kc, #134679);
            padding: 20px 22px 18px;
            position: relative;
            overflow: hidden;
            transition: transform .22s cubic-bezier(0.4,0,0.2,1), box-shadow .22s;
            box-shadow: 0 1px 3px rgba(0,0,0,.07);
            margin-bottom: 0;
        }
        .kpi-card-new:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(0,0,0,.10);
        }
        .kpi-card-new::after {
            content: '';
            position: absolute;
            width: 100px; height: 100px;
            border-radius: 50%;
            bottom: -30px; right: -20px;
            background: radial-gradient(circle, var(--kc, #134679) 0%, transparent 70%);
            opacity: .06;
            pointer-events: none;
        }
        .kci {
            width: 44px; height: 44px;
            border-radius: 11px;
            background: color-mix(in srgb, var(--kc, #134679) 12%, transparent);
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            color: var(--kc, #134679);
            margin-bottom: 14px;
        }
        @supports not (background: color-mix(in srgb, red 10%, transparent)) {
            .kci { background: rgba(19,70,121,.10); }
        }
        .kc-val {
            font-size: 30px; font-weight: 800;
            color: #1a2e44; line-height: 1; margin-bottom: 5px;
        }
        .kc-lbl {
            font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .7px;
            color: #94a3b8;
        }
        /* Remove old kpi-card styles for this page */
        .kpi-card { display: none !important; }
        .kpi-icon-bg { display: none !important; }
    </style>
{% endblock %}

{% block body %}

<div class="content-header">
    <div class="container-fluid">
        <h4 style="color:#1a2e44;font-weight:700;margin:0">Resumen del Sistema</h4>
        <p style="color:#94a3b8;font-size:13px;margin:4px 0 0">Usuarios, roles, módulos y actividad</p>
    </div>
</div>

<div class="dashboard-container">

    <!-- KPI Section -->
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card-new" style="--kc: #134679">
                <div class="kci"><i class="fas fa-users"></i></div>
                <div class="kc-val">{{ kpis.usuarios }}</div>
                <div class="kc-lbl">Usuarios Registrados</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card-new" style="--kc: #f39c12">
                <div class="kci"><i class="fas fa-user-shield"></i></div>
                <div class="kc-val">{{ kpis.roles }}</div>
                <div class="kc-lbl">Roles del Sistema</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card-new" style="--kc: #27ae60">
                <div class="kci"><i class="fas fa-cubes"></i></div>
                <div class="kc-val">{{ kpis.modulos }}</div>
                <div class="kc-lbl">Módulos</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card-new" style="--kc: #9b59b6">
                <div class="kci"><i class="fas fa-history"></i></div>
                <div class="kc-val">{{ kpis.actividad_hoy }}</div>
                <div class="kc-lbl">Eventos Registrados</div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row mb-4">
        <!-- Trend Chart -->
        <div class="col-lg-8 mb-4">
            <div class="card chart-container shadow-sm border-0">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="card-title-modern mb-0"><i class="fas fa-chart-line mr-2"></i> Actividad del Sistema (7 días)</h5>
                    <div class="btn-group btn-group-sm rounded-pill shadow-sm overflow-hidden border">
                        <button class="btn btn-primary px-3">Trazas</button>
                    </div>
                </div>
                <div style="height: 350px;">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Distribution Chart -->
        <div class="col-lg-4 mb-4">
            <div class="card chart-container shadow-sm border-0">
                <h5 class="card-title-modern mb-4"><i class="fas fa-chart-pie mr-2"></i> Distribución de Roles</h5>
                <div style="height: 300px;">
                    <canvas id="statusChart"></canvas>
                </div>
                <div class="mt-4" id="chartLegend" style="max-height: 120px; overflow-y: auto;">
                    <!-- Leyenda dinámica -->
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary Data Row -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card chart-container shadow-sm border-0">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="card-title-modern mb-0"><i class="fas fa-list-ul mr-2 text-info"></i> Actividad Reciente</h5>
                    <a href="#" class="btn btn-sm btn-outline-primary rounded-pill px-3">Ver todas</a>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-hover table-activity mb-0">
                        <thead>
                            <tr>
                                <th>Fecha y Hora</th>
                                <th>Usuario</th>
                                <th>Acción</th>
                                <th>Objeto / Detalles</th>
                                <th>IP</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for traza in actividad_reciente %}
                            <tr>
                                <td>
                                    <span class="badge badge-light border p-2 text-muted">
                                        <i class="far fa-clock mr-1"></i> {{ traza.creado|date('d/m/Y H:i') }}
                                    </span>
                                </td>
                                <td>
                                    <span class="font-weight-bold"><i class="fas fa-user-circle text-primary mr-1"></i> {{ traza.persona ? traza.persona.primerNombre ~ ' ' ~ traza.persona.primerApellido : 'Sistema' }}</span>
                                </td>
                                <td>
                                    <span class="badge" style="background: #e8edf5; color: #134679;">{{ traza.accion ? traza.accion.nombre : '-' }}</span>
                                </td>
                                <td>{{ traza.objeto ? traza.objeto.nombre : '-' }}</td>
                                <td class="text-muted"><i class="fas fa-network-wired mr-1"></i> {{ traza.ip|default('-') }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="text-center p-4 text-muted">No hay actividad reciente registrada.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Configuración Global de Charts
            Chart.defaults.font.family = "'Segoe UI', 'Roboto', 'Arial', sans-serif";
            
            // 1. Gráfico de Tendencia (Line Chart)
            const trendCtx = document.getElementById('trendChart').getContext('2d');
            const trendDataRaw = {{ trend.data|raw }};
            const trendLabelsRaw = {{ trend.labels|raw }};

            new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: trendLabelsRaw,
                    datasets: [{
                        label: 'Eventos (Trazas)',
                        data: trendDataRaw,
                        borderColor: '#2a6db0',
                        backgroundColor: (ctx) => {
                            const gradient = ctx.chart.ctx.createLinearGradient(0, 0, 0, 400);
                            gradient.addColorStop(0, 'rgba(42, 109, 176, 0.4)');
                            gradient.addColorStop(1, 'rgba(42, 109, 176, 0)');
                            return gradient;
                        },
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 6,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#2a6db0',
                        pointBorderWidth: 2,
                        pointHoverRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.05)', drawBorder: false },
                            ticks: { precision: 0 }
                        },
                        x: {
                            grid: { display: false, drawBorder: false }
                        }
                    }
                }
            });

            // 2. Gráfico de Distribución (Doughnut Chart)
            const statusCtx = document.getElementById('statusChart').getContext('2d');
            const statusDataRaw = {{ roles_dist|raw }};
            
            const statusLabels = statusDataRaw.map(d => d.label);
            const statusValues = statusDataRaw.map(d => d.value);
            
            const vibrantColors = [
                '#134679', '#3498db', '#f39c12', '#27ae60', '#9b59b6', '#e74c3c', '#95a5a6'
            ];

            new Chart(statusCtx, {
                type: 'doughnut',
                data: {
                    labels: statusLabels,
                    datasets: [{
                        data: statusValues,
                        backgroundColor: vibrantColors.slice(0, statusLabels.length),
                        borderWidth: 0,
                        hoverOffset: 20
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Generar leyenda personalizada para el Donut
            const legendContainer = document.getElementById('chartLegend');
            statusDataRaw.forEach((d, i) => {
                const item = document.createElement('div');
                item.className = 'd-flex justify-content-between align-items-center mb-2 small';
                item.innerHTML = `
                    <div class="d-flex align-items-center">
                        <span class="status-badge" style="background-color: ${vibrantColors[i % vibrantColors.length]}"></span>
                        <span class="text-muted font-weight-bold">${d.label}</span>
                    </div>
                    <span class="font-weight-bold text-dark">${d.value}</span>
                `;
                legendContainer.appendChild(item);
            });

            $('#btnRefresh').click(function() {
                $(this).find('i').addClass('fa-spin');
                setTimeout(() => location.reload(), 500);
            });
        });
    </script>
{% endblock %}
