{% import 'pages/_detail_macros.html.twig' as dm %}
{% include 'pages/_detail_styles.html.twig' %}

<div class="detail-section">
    <div class="detail-section-header">
        <i class="fas fa-info-circle"></i>
        <h3>Datos generales</h3>
    </div>
    <div class="detail-section-body">
        <div class="row">
            <div class="col-md-6">
                {{ dm.field('Nombre', item.nombre) }}
            </div>
            <div class="col-md-3">
                {{ dm.field('Color', '<span style="display:inline-block;width:18px;height:18px;border-radius:50%;vertical-align:middle;border:1px solid #e2e8f0;background-color:' ~ item.color ~ ';"></span> ' ~ item.color)|raw }}
            </div>
            <div class="col-md-3">
                <div class="detail-field">
                    <span class="detail-label">Estado</span>
                    {{ dm.badge_estado(item.activo) }}
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                {{ dm.field('Descripción', item.descripcion) }}
            </div>
        </div>
    </div>
</div>
