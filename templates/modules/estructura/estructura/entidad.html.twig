{% extends 'baseAdmin.html.twig' %}

{% block title %}Gestión de entidades{% endblock %}

{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}

    {% include 'pages/modalDetail.html.twig' %}

    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center">
            <div>
                <h3 class="card-title text-bold m-0"><i class="fas fa-city label-icon"></i>Gestión de entidades</h3>
                <small class="text-muted">Registro nacional de universidades, unidades presupuestadas, empresas e interfaces</small>
            </div>
            <div class="ml-auto d-flex" style="gap:8px;">
                <a title="Adicionar" class="btn-lux-sm btn-lux-primary" href="{{ path('app_entidad_registrar') }}">
                    <i class="fa fa-plus"></i> Nuevo
                </a>
                <a id="exportExcel" title="Exportar a Excel" class="btn-lux-sm btn-lux-success">
                    <i class="fa fa-file-excel"></i> Excel
                </a>
            </div>
        </div>
        <!-- /.card-header -->
        <div class="card-body px-4">
            <table class="table config-table table-bordered table-striped dataTable">
                <thead>
                <tr>
                    <th>No.</th>
                    <th>Estructura superior</th>
                    <th>Nombre</th>
                    <th>Tipo de entidad</th>
                    <th>Estado</th>
                    <th class="text-center">Opciones</th>
                </tr>
                <tr>
                    <th></th>
                    <th><select class="responsive-input no-select2"><option value="">Todas</option>{% set opciones = [] %}{% for item in registros %}{% set valor = item.estructura.nombre|default('') %}{% if valor and valor not in opciones %}{% set opciones = opciones|merge([valor]) %}<option value="{{ valor }}">{{ valor }}</option>{% endif %}{% endfor %}</select></th>
                    <th><select class="responsive-input no-select2"><option value="">Todas</option>{% for item in registros %}<option value="{{ item.nombre|default('') }}">{{ item.nombre|default('') }}</option>{% endfor %}</select></th>
                    <th><select class="responsive-input no-select2"><option value="">Todos los tipos</option><option value="Unidad Presupuestada (UP)" {{ tipoSeleccionado == 'UP' ? 'selected' : '' }}>Unidad Presupuestada (UP)</option><option value="Unidad Presupuestada con Tratamiento Especial (UPTE)" {{ tipoSeleccionado == 'UPTE' ? 'selected' : '' }}>Unidad Presupuestada con Tratamiento Especial (UPTE)</option><option value="Empresa" {{ tipoSeleccionado == 'EMPRESA' ? 'selected' : '' }}>Empresa</option><option value="Interfaces y MiPYMES" {{ tipoSeleccionado == 'INTERFAZ' ? 'selected' : '' }}>Interfaces y MiPYMES</option>{% set opciones = [] %}{% for item in registros %}{% if not item.clasificacionPresupuestaria and item.categoriaEstructura.id|default(0) not in [7, 20] %}{% set valor = item.categoriaEstructura.nombre|default('Otra entidad') %}{% if valor not in opciones %}{% set opciones = opciones|merge([valor]) %}<option value="{{ valor }}">{{ valor }}</option>{% endif %}{% endif %}{% endfor %}</select></th>
                    <th><select class="responsive-input no-select2"><option value="">Todos</option><option value="Habilitado">Habilitado</option><option value="Deshabilitado">Deshabilitado</option></select></th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for item in registros %}
                    <tr>
                        <td width="1%">{{ loop.index }}</td>
                        <td>{{ item.estructura.nombre | default('') }}</td>
                        <td>{{ item.nombre | default('') }}</td>
                        <td>{% if item.clasificacionPresupuestaria == 'UP' %}Unidad Presupuestada (UP){% elseif item.clasificacionPresupuestaria == 'UPTE' %}Unidad Presupuestada con Tratamiento Especial (UPTE){% elseif item.categoriaEstructura.id|default(0) == 7 %}Empresa{% elseif item.categoriaEstructura.id|default(0) == 20 %}Interfaces y MiPYMES{% else %}{{ item.categoriaEstructura.nombre|default('Otra entidad') }}{% endif %}</td>
                        <td width="10%">
                            {% if '1' == item.activo %}
                                <span class="status-pill -on"><i class="fas fa-circle"></i>Habilitado</span>
                            {% else %}
                                <span class="status-pill -off"><i class="fas fa-circle"></i>Deshabilitado</span>
                            {% endif %}
                        </td>
                        <td width="5%">
                            <div class="dropdown d-flex justify-content-center">
                                <button class="btn btn-sm btn-light rounded-circle shadow-sm border-0 p-0 d-flex align-items-center justify-content-center actions-dropdown-btn"
                                        type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                                        title="Opciones">
                                    &#8942;
                                </button>
                                <div class="dropdown-menu dropdown-menu-right shadow-sm actions-dropdown-menu">
                                    <button class="dropdown-item modalDetailAction"
                                            data-url="{{ path('app_estructura_detail', {'id' : item.id}) }}"
                                            data-title="Detalles de la estructura">
                                        <i class="fa fa-eye fa-fw mr-2 text-primary"></i> Ver detalles
                                    </button>
                                    <a class="dropdown-item" href="{{ path('app_entidad_modificar_clasificacion', {'id': item.id}) }}">
                                        <i class="fa fa-tags fa-fw mr-2 text-primary"></i> Editar clasificación
                                    </a>
                                    <a class="dropdown-item" href="{{ path('app_estructura_plaza', {'id': item.id}) }}">
                                        <i class="fa fa-user-tag fa-fw mr-2 text-primary"></i> Gestionar responsabilidades
                                    </a>
                                    <div class="dropdown-divider my-1"></div>
                                    <button class="dropdown-item elementRemove text-danger"
                                            data-url="{{ path('app_estructura_eliminar', {'id': item.id}) }}">
                                        <i class="fa fa-trash fa-fw mr-2"></i> Eliminar
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>

            </table>
        </div>
        <!-- /.card-body -->
    </div>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'pages/_luxury_list_dropdown_js.html.twig' %}
{% endblock %}
