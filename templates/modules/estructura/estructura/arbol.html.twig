{% extends 'baseAdmin.html.twig' %}

{% block title %}Estructuras{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% include 'pages/_luxury_list_styles.html.twig' %}
    <style>
        .card-luxury { border: 1px solid #dce4ea; border-top: 3px solid #102f4f; border-radius: 0; box-shadow: none; }
        .modal-estructura .modal-dialog {
            max-width: 80%;  /* Ocupa el 90% del ancho de la pantalla */
            min-width: 800px;  /* Mínimo 800px de ancho */
            min-height: 60vh;  /* 80% del alto de la pantalla */
        }

        .modal-estructura .modal-content {
            height: 80vh;  /* Ajusta según necesidad */
        }
        .modal-estructura .modal-body {
            max-height: 70vh; /* 70% del alto de la ventana */
            overflow-y: auto; /* Scroll vertical si es necesario */
        }
        .tree-container {
            padding: 18px;
            background: #fff;
            border: 1px solid #dce4ea;
            border-radius: 0;
            min-height: 500px;
        }

        .tree-toolbar {
            margin-bottom: 15px;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .tree-search {
            flex-grow: 1;
            max-width: 300px;
        }

        .tree-ul {
            list-style-type: none;
            padding-left: 20px;
        }

        .tree-li {
            margin: 5px 0;
            position: relative;
        }

        .tree-item {
            display: flex;
            align-items: center;
            padding: 5px 10px;
            border-radius: 0;
            cursor: pointer;
            user-select: none;
            transition: background-color 0.15s;
        }

        .tree-item:hover {
            background-color: #f5f5f5;
        }

        .tree-item.has-children::before {
            content: "▶";
            margin-right: 8px;
            font-size: 10px;
            color: #666;
            transition: transform 0.2s;
        }

        .tree-item.has-children.open::before {
            content: "▼";
        }

        /* Modal styles */
        .modal-estructura .modal-content {
            border-radius: 4px;
        }

        .context-menu {
            position: absolute;
            display: none;
            background: white;
            border: 1px solid #ddd;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            z-index: 1000;
            min-width: 150px;
        }

        .context-menu-item {
            padding: 8px 15px;
            cursor: pointer;
        }

        .context-menu-item:hover {
            background-color: #f0f0f0;
        }

        .no-results {
            color: #666;
            font-style: italic;
            padding: 20px;
            text-align: center;
        }
        .tree-help { margin-bottom: 14px; padding: 10px 13px; border-left: 3px solid #102f4f; background: #eef3f6; color: #49616f; font-size: 13px; }
        .tree-item span::after { content: 'Detalles'; margin-left: 12px; padding: 1px 6px; border: 1px solid #cbd6de; color: #60798c; font-size: 11px; opacity: 0; }
        .tree-item:hover span::after { opacity: 1; }
        .tree-toolbar .btn, .tree-toolbar .form-control { border-radius: 0; }
        .tree-drag-handle { margin-right: 8px; color: #7892a6; cursor: grab; }
        .tree-item.is-dragging { opacity: .45; }
        .tree-item.drop-target, .tree-root-drop.drop-target { outline: 2px solid #496b86; background: #eaf1f6; }
        .tree-root-drop { margin-bottom: 12px; padding: 10px 13px; border: 1px dashed #9fb0bd; background: #f8fafb; color: #60798c; font-size: 13px; }
    </style>
{% endblock %}

{% block body %}
    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center">
                <h3 class="card-title m-0"><i class="fas fa-sitemap label-icon"></i>Árbol de estructuras organizativas</h3>
                <div class="ml-auto d-flex flex-wrap justify-content-end" style="gap:8px;">
                    <a title="Adicionar estructura" class="btn-lux-sm btn-lux-primary" href="{{ path('app_estructura_registrar') }}"><i class="fa fa-plus"></i> Nuevo</a>
                    <a title="Vista de listado" href="{{ path('app_estructura_index') }}" class="btn-lux-sm btn-lux-primary"><i class="fa fa-table"></i> Ver como listado</a>
                    <a title="Exportar a PDF" class="btn-lux-sm btn-lux-success" target="_blank" href="{{ path('app_estructura_exportar_pdf') }}"><i class="fa fa-file-pdf"></i> PDF</a>
                </div>
        </div>
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-6 text-gray">
                    <h5>
                        <b>
                            <i class="fa fa-university  "></i>
                        </b> ({{ entidad.siglas | default('') }}) {{ entidad.nombre | default('') }}
                    </h5>
                </div>
            </div>
            <hr>
            <div class="tree-help"><i class="fas fa-mouse-pointer mr-2"></i><strong>Detalles:</strong> haga doble clic sobre el nombre. <strong>Reorganizar:</strong> arrastre una estructura y suéltela sobre su nueva superior; el sistema pedirá confirmación.</div>
            <div class="tree-toolbar">
                <div class="input-group tree-search">
                    <input type="text" id="tree-search" class="form-control" placeholder="Buscar estructura...">
                    <div class="input-group-append">
                        <button class="btn btn-outline-secondary" type="button" id="tree-clear-search">
                            <i class="fa fa-times"></i>
                        </button>
                    </div>
                </div>
                <button class="btn btn-outline-primary" id="expand-all">
                    <i class="fa fa-plus-circle"></i> Expandir todo
                </button>
                <button class="btn btn-outline-primary" id="collapse-all">
                    <i class="fa fa-minus-circle"></i> Contraer todo
                </button>
            </div>

            <div class="tree-container">
                <div id="tree-root-drop" class="tree-root-drop"><i class="fas fa-level-up-alt mr-2"></i>Soltar aquí para mover al nivel principal de la universidad</div>
                <div id="tree-view"></div>
                <div id="no-results" class="no-results" style="display: none;">
                    No se encontraron resultados
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para detalles -->
    <div class="modal fade modal-estructura" id="estructuraModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Detalles de la Estructura</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" id="estructuraModalBody" style="overflow-y: auto; max-height: 70vh;">
                    <!-- Contenido cargado via AJAX -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Menú contextual -->
    <div id="contextMenu" class="context-menu">
        <div class="context-menu-item" id="viewDetails">
            <i class="fa fa-info-circle mr-2 text-primary"></i>Ver detalles
        </div>
        <div class="context-menu-item" id="editEstructura">
            <i class="fa fa-edit mr-2 text-primary"></i>Ver y modificar
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        $(document).ready(function () {
            const treeData = {{ registros|json_encode|raw }};
            let selectedNodeId = null;
            let allNodes = [];

            // Construir el árbol
            function buildTree(parentId = '#') {
                const children = treeData.filter(item => item.parent == parentId);
                if (children.length === 0) return '';

                let html = '<ul class="tree-ul">';
                children.forEach(child => {
                    const hasChildren = treeData.some(item => item.parent == child.id);
                    const nodeColor = child.color || '#333';

                    html += `
                <li class="tree-li" data-id="${child.id}">
                    <div class="tree-item ${hasChildren ? 'has-children' : ''}"
                         data-id="${child.id}"
                         data-name="${child.text.replace(/&/g, '&amp;').replace(/"/g, '&quot;')}"
                         draggable="${child.movable ? 'true' : 'false'}"
                         title="${child.movable ? 'Doble clic: detalles. Arrastre para cambiar subordinación.' : 'Raíz institucional'}"
                         style="color: ${nodeColor}">
                        ${child.movable ? '<i class="fas fa-grip-vertical tree-drag-handle" aria-hidden="true"></i>' : ''}<span>${child.text}</span>
                    </div>
                    ${buildTree(child.id)}
                </li>
            `;
                });
                html += '</ul>';
                return html;
            }

            // Inicializar el árbol
            $('#tree-view').html(buildTree());
            allNodes = $('.tree-li').toArray();

            let draggedNodeId = null;
            let draggedNodeName = '';

            $(document).on('dragstart', '.tree-item[draggable="true"]', function (e) {
                draggedNodeId = Number($(this).data('id'));
                draggedNodeName = String($(this).data('name'));
                $(this).addClass('is-dragging');
                e.originalEvent.dataTransfer.effectAllowed = 'move';
                e.originalEvent.dataTransfer.setData('text/plain', String(draggedNodeId));
            });
            $(document).on('dragend', '.tree-item', function () {
                $('.tree-item, .tree-root-drop').removeClass('is-dragging drop-target');
            });
            $(document).on('dragover', '.tree-item, #tree-root-drop', function (e) {
                if (!draggedNodeId) return;
                e.preventDefault();
                e.originalEvent.dataTransfer.dropEffect = 'move';
                $(this).addClass('drop-target');
            });
            $(document).on('dragleave', '.tree-item, #tree-root-drop', function () { $(this).removeClass('drop-target'); });
            $(document).on('drop', '.tree-item, #tree-root-drop', function (e) {
                e.preventDefault();
                e.stopPropagation();
                $('.tree-item, .tree-root-drop').removeClass('drop-target');
                const nuevoPadreId = this.id === 'tree-root-drop' ? 0 : Number($(this).data('id'));
                const nuevoPadreNombre = this.id === 'tree-root-drop' ? 'el nivel principal de la universidad' : String($(this).data('name'));
                if (!draggedNodeId || draggedNodeId === nuevoPadreId) return;
                if (!window.confirm(`¿Confirma que “${draggedNodeName}” pase a depender de “${nuevoPadreNombre}”?`)) return;
                $.ajax({
                    url: '{{ path('app_estructura_mover') }}',
                    method: 'POST',
                    data: { estructura: draggedNodeId, padre: nuevoPadreId, _token: '{{ csrf_token('mover_estructura') }}' },
                    success: function (response) {
                        toastr.success(response.message || 'Estructura reorganizada correctamente.');
                        window.location.reload();
                    },
                    error: function (xhr) {
                        const message = xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'No fue posible reorganizar la estructura.';
                        toastr.error(message);
                        window.location.reload();
                    }
                });
            });

            // Manejar clic en elementos con hijos
            $(document).on('click', '.tree-item.has-children', function (e) {
                e.stopPropagation();
                const $li = $(this).closest('li');
                const $children = $li.children('ul');

                if ($children.is(':visible')) {
                    $children.hide();
                    $(this).removeClass('open');
                } else {
                    $children.show();
                    $(this).addClass('open');
                }
            });

            // Manejar clic derecho para mostrar el menú contextual
            $(document).on('contextmenu', '.tree-item', function (e) {
                e.preventDefault();
                selectedNodeId = $(this).data('id');

                $('#contextMenu')
                    .css({
                        'left': e.pageX,
                        'top': e.pageY
                    })
                    .show();

                // Cerrar el menú al hacer clic en cualquier otro lugar
                $(document).one('click', function () {
                    $('#contextMenu').hide();
                });

                return false;
            });

            // Manejar clic en "Ver detalles" del menú contextual
            $('#viewDetails').click(function () {
                $('#contextMenu').hide();
                if (selectedNodeId) {
                    loadEstructuraDetails(selectedNodeId);
                }
            });
            $('#editEstructura').click(function () {
                $('#contextMenu').hide();
                if (selectedNodeId) {
                    openEditModal(selectedNodeId);
                }
            });
            function openEditModal(id) {
                const editUrl = '{{ path('app_estructura_modificar', {'id': 0}) }}'.replace('0', id);

                $('#estructuraModalBody').html('<div class="text-center py-4"><i class="fa fa-spinner fa-spin fa-2x text-primary"></i><p>Cargando formulario...</p></div>');
                $('.modal-title').text('Ver y modificar estructura');
                $('#estructuraModal').modal('show');

                // 1. Cargar el formulario vía AJAX (GET)
                $.get(editUrl, function(html) {
                    $('#estructuraModalBody').html(html);

                    // 2. Interceptar el envío del formulario cargado
                    $('#estructuraModalBody').find('form').on('submit', function(e) {
                        e.preventDefault();

                        HoldOn.open({
                            theme: "sk-cube-grid",
                            message: 'Guardando cambios, por favor espere...',
                            textColor: "white"
                        });


                        const $form = $(this);
                        const formData = $form.serialize();

                        $.ajax({
                            url: editUrl,
                            method: 'POST',
                            data: formData,
                            success: function(response) {
                                // Si el controlador devuelve éxito
                                $('#estructuraModal').modal('hide');

                                // Opcional: Actualizar solo el texto del nodo en el árbol sin recargar
                                const newName = $form.find('input[name*="nombre"]').val(); // Ajusta según el nombre de tu campo
                                $(`.tree-item[data-id="${id}"] span`).text(newName);
                                HoldOn.close();
                                toastr.success('Estructura actualizada correctamente');
                            },
                            error: function() {
                                HoldOn.close();
                                toastr.error('Error al guardar los cambios');
                            }
                        });
                    });
                });
            }
            {#$('#editEstructura').click(function () {#}
            {#    $('#contextMenu').hide();#}
            {#    if (selectedNodeId) {#}
            {#        // Generamos la URL de edición.#}
            {#        // Nota: El '0' se reemplaza dinámicamente por el ID seleccionado.#}
            {#        const editUrl = '{{ path('app_estructura_modificar', {'id': 0}) }}'.replace('0', selectedNodeId);#}
            {#        window.location.href = editUrl;#}
            {#    }#}
            {#});#}

            $(document).on('dblclick', '.tree-item', function (e) {
                e.stopPropagation();
                const id = $(this).data('id');
                const editUrl = '{{ path('app_estructura_modificar', {'id': 0}) }}'.replace('0', id);
                window.location.href = editUrl;
            });

            // Expandir todo
            $('#expand-all').click(function () {
                $('.tree-item.has-children').addClass('open');
                $('.tree-ul').show();
            });

            // Contraer todo
            $('#collapse-all').click(function () {
                $('.tree-item.has-children').removeClass('open');
                $('.tree-ul').hide();
                // Mostrar solo el primer nivel
                $('#tree-view > .tree-ul').show();
            });

            // Búsqueda en el árbol
            $('#tree-search').on('input', function () {
                const searchTerm = $(this).val().toLowerCase();

                if (searchTerm.length < 2) {
                    $('#no-results').hide();
                    $('.tree-li').show();
                    $('.tree-ul').show();
                    $('.tree-item.has-children').addClass('open');
                    return;
                }

                let hasResults = false;

                allNodes.forEach(node => {
                    const $node = $(node);
                    const text = $node.find('.tree-item span').text().toLowerCase();
                    const matches = text.includes(searchTerm);

                    if (matches) {
                        hasResults = true;
                        $node.show();
                        // Mostrar ancestros
                        $node.parents('.tree-li').show();
                        // Mostrar hijos
                        $node.find('.tree-ul').show();
                        $node.find('.tree-item.has-children').addClass('open');
                    } else {
                        $node.hide();
                    }
                });

                if (hasResults) {
                    $('#no-results').hide();
                } else {
                    $('#no-results').show();
                }
            });

            // Limpiar búsqueda
            $('#tree-clear-search').click(function () {
                $('#tree-search').val('').trigger('input');
            });

            // Contraer todo al inicio (excepto primer nivel)
            $('.tree-ul:not(#tree-view > .tree-ul)').hide();
        });

        // Función para cargar detalles de la estructura via POST
        function loadEstructuraDetails(id) {
            $('#estructuraModalBody').html(`
                <div class="text-center py-4">
                    <i class="fa fa-spinner fa-spin fa-2x"></i>
                    <p>Cargando información...</p>
                </div>
            `);

            $('#estructuraModal').modal('show');

            const csrfToken = $('meta[name="csrf-token"]').attr('content');
            const baseUrl = '{{ path('app_estructura_detail', {'id': 0}) }}'.replace('0', id);
            $.ajax({
                url: baseUrl, // Ruta sin ID
                method: 'POST',
                data: {
                    '_token': csrfToken,
                    'id': id  // Enviamos el ID como parte del cuerpo de la petición
                },
                headers: {
                    'X-CSRF-TOKEN': csrfToken
                },
                success: function (data) {
                    $('#estructuraModalBody').html(data);
                },
                error: function (xhr) {
                    let errorMsg = 'Error al cargar los detalles';
                    if (xhr.responseJSON && xhr.responseJSON.error) {
                        errorMsg = xhr.responseJSON.error;
                    }
                    $('#estructuraModalBody').html(`
                <div class="alert alert-danger">
                    ${errorMsg}
                </div>
            `);
                }
            });
        }
    </script>
{% endblock %}
