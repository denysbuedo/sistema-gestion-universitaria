{# ── Recursos humanos ── #}
<div class="detail-section-title"><i class="fas fa-users"></i> Recursos humanos</div>
<table class="table detail-table table-bordered table-striped dataTable" id="tbl-carrera">
    <thead><tr><th>No.</th><th>Recurso humano</th><th>Cantidad</th></tr></thead>
    <tbody>
    {% for rh in recursosHumanos %}
        <tr>
            <td width="1%">{{ loop.index }}</td>
            <td>{{ rh.nombre }}</td>
            <td width="20%">
                <input style="width:100%;border-radius:6px;border:1px solid #e2e8f0;padding:4px 8px;font-size:0.85rem;"
                       type="text" id="rh_{{ rh.id }}" name="rh_{{ rh.id }}"
                       maxlength="4" minlength="1"
                       value="{{ recursosHumanosAsignados[rh.id] | default(0) }}">
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
