{% extends 'baseAdmin.html.twig' %}

{% block title %}IES{% endblock %}

{% block body %}

{% include 'pages/modalDetail.html.twig' %}

<style>
    .card-luxury { border-radius:12px; border:none; box-shadow:0 4px 20px rgba(0,0,0,0.08); border-top:4px solid #134679; margin-bottom:1.5rem; }
    .card-luxury .card-header { background-color:#fff; border-bottom:1px solid #f1f5f9; padding:15px 24px; }
    .label-icon { color:#134679; margin-right:6px; opacity:0.8; }
    .btn-lux-sm { padding:6px 14px; border-radius:6px; font-weight:700; font-size:0.75rem; border:none; display:inline-flex; align-items:center; gap:5px; text-transform:uppercase; transition:all 0.2s; color:#fff; cursor:pointer; }
    .btn-lux-primary { background:#134679; } .btn-lux-primary:hover { background:#0f3560; color:#fff; transform:translateY(-1px); }
    .btn-lux-secondary { background:#64748b; } .btn-lux-secondary:hover { background:#475569; color:#fff; transform:translateY(-1px); }
    .config-table th { background:#f1f5f9; color:#4a5568; font-size:0.82rem; font-weight:700; border-color:#e2e8f0; padding:8px 10px; }
    .config-table td { font-size:0.85rem; color:#1a2e44; border-color:#e2e8f0; padding:7px 10px; vertical-align:middle; }
    .config-table tbody tr:hover { background:#f8fafc; }
    .dropdown-toggle-no-caret::after { display:none !important; }
    .inst-logo { width:40px; height:40px; object-fit:contain; border-radius:6px; border:1px solid #e2e8f0; background:#f8fafc; padding:2px; }
    .inst-logo-fallback-sm { width:40px; height:40px; border-radius:6px; border:1px solid #dbeafe; background:linear-gradient(135deg,#134679,#1e6fb5); display:inline-flex; align-items:center; justify-content:center; color:#fff; font-size:1rem; flex-shrink:0; }
</style>

<div class="card card-luxury">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title m-0"><i class="fas fa-university label-icon"></i>Instituciones de Educación Superior</h3>
        <div class="ml-auto" style="display:flex;gap:8px;">
            <a href="{{ path('app_institucion_registrar') }}" class="btn-lux-sm btn-lux-primary">
                <i class="fas fa-plus"></i> Nueva
            </a>
            <a href="{{ path('app_institucion_exportar_pdf') }}" target="_blank" class="btn-lux-sm btn-lux-secondary">
                <i class="fas fa-file-pdf"></i> PDF
            </a>
        </div>
    </div>
    <div class="card-body px-4">
        <table class="table config-table table-bordered table-striped dataTable">
            <thead>
            <tr>
                <th>No.</th>
                <th>Logo</th>
                <th>Nombre</th>
                <th>Siglas</th>
                <th>Rector</th>
                <th>Categoría acreditación</th>
                <th class="text-center" style="width:60px;">Opciones</th>
            </tr>
            </thead>
            <tbody>
            {% for item in registros %}
                <tr>
                    <td width="1%">{{ loop.index }}</td>
                    <td width="1%">
                        {% if item.logo != null %}
                            <a href="{{ app.request.getSchemeAndHttpHost() }}/uploads/institucion/logo/{{ item.logo }}" target="_blank">
                                <img src="{{ app.request.getSchemeAndHttpHost() }}/uploads/institucion/logo/{{ item.logo }}"
                                     class="inst-logo"
                                     onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
                                <span class="inst-logo-fallback-sm" style="display:none;"><i class="fas fa-university"></i></span>
                            </a>
                        {% else %}
                            <span class="inst-logo-fallback-sm"><i class="fas fa-university"></i></span>
                        {% endif %}
                    </td>
                    <td>{{ item.nombre_siglas }}</td>
                    <td><span style="font-family:monospace;font-size:0.8rem;background:#f1f5f9;padding:2px 6px;border-radius:4px;">{{ item.siglas }}</span></td>
                    <td>{{ item.rector }}</td>
                    <td>
                        {% if item.catAcreditacion %}
                            {% set cat_colors = {
                                'A': 'background:#dcfce7;color:#15803d;border:1px solid #bbf7d0;',
                                'B': 'background:#dbeafe;color:#1d4ed8;border:1px solid #bfdbfe;',
                                'C': 'background:#fef3c7;color:#b45309;border:1px solid #fde68a;',
                                'D': 'background:#fce7f3;color:#be185d;border:1px solid #fbcfe8;',
                                'E': 'background:#ede9fe;color:#6d28d9;border:1px solid #ddd6fe;'
                            } %}
                            {% set cat_key = item.catAcreditacion | slice(0,1) | upper %}
                            {% set cat_style = cat_colors[cat_key] | default('background:#f1f5f9;color:#475569;border:1px solid #e2e8f0;') %}
                            <span style="{{ cat_style }}font-size:0.72rem;font-weight:700;padding:2px 9px;border-radius:20px;display:inline-block;">
                                <i class="fas fa-award mr-1" style="font-size:0.6rem;"></i>{{ item.catAcreditacion }}
                            </span>
                        {% else %}
                            <span style="color:#94a3b8;font-size:0.8rem;">—</span>
                        {% endif %}
                    </td>
                    <td class="text-center">
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle-no-caret"
                                    data-toggle="dropdown"
                                    style="border-radius:50%;width:34px;height:34px;padding:0;line-height:34px;font-size:1rem;border-color:#dee2e6;">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right shadow-sm" style="min-width:240px;border-radius:0.5rem;padding:6px 0;">
                                <h6 class="dropdown-header" style="font-size:0.65rem;font-weight:700;color:#adb5bd;text-transform:uppercase;letter-spacing:0.5px;">Acciones</h6>
                                <button class="dropdown-item modalDetailAction"
                                        data-url="{{ path('app_institucion_detail', {'id': item.id}) }}"
                                        data-title="Detalles de la institución">
                                    <i class="fa fa-eye fa-fw mr-2 text-primary"></i> Ver detalles
                                </button>
                                <a class="dropdown-item" href="{{ path('app_institucion_modificar', {'id': item.id}) }}">
                                    <i class="fa fa-edit fa-fw mr-2 text-primary"></i> Modificar
                                </a>
                                <div class="dropdown-divider my-1"></div>
                                <h6 class="dropdown-header" style="font-size:0.65rem;font-weight:700;color:#adb5bd;text-transform:uppercase;letter-spacing:0.5px;">Asociar</h6>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_facultades', {'id': item.id}) }}">
                                    <i class="fa fa-school fa-fw mr-2 text-success"></i> Facultades
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_cum', {'id': item.id}) }}">
                                    <i class="fa fa-address-card fa-fw mr-2 text-success"></i> Centro univ. municipal
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_fum', {'id': item.id}) }}">
                                    <i class="fa fa-address-book fa-fw mr-2 text-success"></i> Filial univ. municipal
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_centros_estudio', {'id': item.id}) }}">
                                    <i class="fa fa-university fa-fw mr-2 text-success"></i> Centros de estudio
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_sede', {'id': item.id}) }}">
                                    <i class="fa fa-universal-access fa-fw mr-2 text-success"></i> Sedes
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_redes_sociales', {'id': item.id}) }}">
                                    <i class="fa fa-network-wired fa-fw mr-2 text-success"></i> Redes sociales
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_editoriales', {'id': item.id}) }}">
                                    <i class="fa fa-book fa-fw mr-2 text-success"></i> Editoriales
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_redes', {'id': item.id}) }}">
                                    <i class="fa fa-newspaper fa-fw mr-2 text-success"></i> Redes nac. e internac.
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_revistas', {'id': item.id}) }}">
                                    <i class="fa fa-book-open fa-fw mr-2 text-success"></i> Revistas científicas
                                </a>
                                <div class="dropdown-divider my-1"></div>
                                <h6 class="dropdown-header" style="font-size:0.65rem;font-weight:700;color:#adb5bd;text-transform:uppercase;letter-spacing:0.5px;">Gestión</h6>
                                <a class="dropdown-item" href="{{ path('app_institucion_programas_formacion', {'id': item.id, 'option': 'option1'}) }}">
                                    <i class="fa fa-book-reader fa-fw mr-2 text-warning"></i> Programas de formación
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_asignar_recursos_humanos', {'id': item.id}) }}">
                                    <i class="fa fa-user-friends fa-fw mr-2 text-warning"></i> Recursos humanos
                                </a>
                                <a class="dropdown-item" href="{{ path('app_institucion_internacionalizacion', {'id': item.id, 'tab': 'mecanismo'}) }}">
                                    <i class="fa fa-map-marked fa-fw mr-2 text-warning"></i> Internacionalización
                                </a>
                                <div class="dropdown-divider my-1"></div>
                                <button class="dropdown-item text-danger elementRemove"
                                        data-url="{{ path('app_institucion_eliminar', {'id': item.id}) }}">
                                    <i class="fa fa-trash fa-fw mr-2"></i> Eliminar
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    $(document).on('show.bs.dropdown', function(e) {
        var $btn = $(e.target).find('[data-toggle="dropdown"]');
        var $menu = $(e.target).find('.dropdown-menu');
        $menu.appendTo('body');
        var offset = $btn.offset();
        $menu.css({ position:'fixed', top: offset.top + $btn.outerHeight(), left:'auto', right: $(window).width() - offset.left - $btn.outerWidth(), display:'block', zIndex:9999 });
    }).on('hide.bs.dropdown', function() {
        $('.dropdown-menu').removeAttr('style').appendTo($(this));
    });
</script>
{% endblock %}
