{% extends 'baseAdmin.html.twig' %}

{% block title %}Internacionalización{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .card-luxury { border-radius:12px; border:none; box-shadow:0 4px 20px rgba(0,0,0,0.08); border-top:4px solid #134679; }
    .card-luxury .card-header { background:#fff; border-bottom:1px solid #f1f5f9; padding:15px 24px; border-radius:12px 12px 0 0; }
    .card-luxury .card-title { color:#1a2e44; font-weight:700; font-size:1rem; margin:0; }
    .label-icon { color:#134679; margin-right:6px; opacity:0.8; }
    .config-table thead th { background:#f1f5f9; color:#4a5568; font-size:0.82rem; font-weight:700; border-bottom:2px solid #e2e8f0; text-transform:uppercase; letter-spacing:0.03em; }
    .config-table tbody td { font-size:0.85rem; vertical-align:middle; }
    .config-table tbody tr:hover { background:#f8fafc; }
    /* Tabs internacionalización */
    .intl-nav .nav-link { color:#4a5568; font-weight:500; border-radius:0; border-bottom:3px solid transparent; padding:0.6rem 1.2rem; font-size:0.875rem; background:transparent; transition:all 0.2s; }
    .intl-nav .nav-link.active { color:#134679; border-bottom:3px solid #134679; font-weight:700; background:transparent; }
    .intl-nav .nav-link:hover:not(.active) { color:#134679; background:rgba(19,70,121,0.05); }
    .intl-nav { border-bottom:1px solid #e2e8f0; }
</style>
{% endblock %}

{% block body %}
<div class="card card-luxury">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title"><i class="fas fa-globe-americas label-icon"></i>Internacionalización</h3>
    </div>

    {{ include('modules/institucion/institucion/short_details.html.twig', { 'item': institucion }) }}

    <div class="card-body px-4 pt-3">
        <ul class="nav intl-nav" id="intl-tab" role="tablist">
            <li class="nav-item" id="li_mecanismo">
                <a class="nav-link" id="custom-tabs-four-mecanismo-tab" data-toggle="pill"
                   href="#custom-tabs-four-mecanismo" role="tab" aria-selected="true">
                    <i class="fas fa-handshake mr-1"></i>Mecanismos de colaboración
                </a>
            </li>
            <li class="nav-item" id="li_programa">
                <a class="nav-link" id="custom-tabs-four-programa-tab" data-toggle="pill"
                   href="#custom-tabs-four-programa" role="tab" aria-selected="false">
                    <i class="fas fa-project-diagram mr-1"></i>Programas de colaboración
                </a>
            </li>
            <li class="nav-item" id="li_proyecto">
                <a class="nav-link" id="custom-tabs-four-proyecto-tab" data-toggle="pill"
                   href="#custom-tabs-four-proyecto" role="tab" aria-selected="false">
                    <i class="fas fa-tasks mr-1"></i>Proyectos
                </a>
            </li>
            <li class="nav-item" id="li_membresia">
                <a class="nav-link" id="custom-tabs-four-membresia-tab" data-toggle="pill"
                   href="#custom-tabs-four-membresia" role="tab" aria-selected="false">
                    <i class="fas fa-id-card mr-1"></i>Membresías
                </a>
            </li>
        </ul>

        <div class="tab-content pt-3" id="custom-tabs-four-tabContent">

            <div class="tab-pane fade active show" id="custom-tabs-four-mecanismo" role="tabpanel">
                <table id="tb1" class="table config-table dataTable">
                    <thead>
                    <tr>
                        <th style="width:3%">No.</th>
                        <th>Mecanismo de colaboración</th>
                        <th>Tipo de mecanismo</th>
                        <th>Estado</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% if mecanismosColaboracion | length > 0 %}
                        {% for item in mecanismosColaboracion %}
                            <tr id="tr_{{ item.id_mecanismo_colaboracion }}">
                                <td>{{ loop.index }}</td>
                                <td>{{ item.nombre_mecanismo_colaboracion | default('') }}</td>
                                <td>{{ item.nombre_tipo_mecanismo_colaboracion | default('') }}</td>
                                <td>{{ item.nombre_estado_mecanismo_colaboracion | default('') }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-3"><i class="fas fa-inbox mr-1"></i>Sin registros.</td></tr>
                    {% endif %}
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="custom-tabs-four-programa" role="tabpanel">
                <table id="tb2" class="table config-table dataTable">
                    <thead>
                    <tr>
                        <th style="width:3%">No.</th>
                        <th>Programa de colaboración</th>
                        <th>Patrocinador</th>
                        <th>Estado</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% if programasColaboracion | length > 0 %}
                        {% for item in programasColaboracion %}
                            <tr id="tr_{{ item.id_programa_colaboracion }}">
                                <td>{{ loop.index }}</td>
                                <td>{{ item.nombre_programa_colaboracion | default('') }}</td>
                                <td>{{ item.nombre_patrocinador | default('') }}</td>
                                <td>{{ item.nombre_estado_programa | default('') }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-3"><i class="fas fa-inbox mr-1"></i>Sin registros.</td></tr>
                    {% endif %}
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="custom-tabs-four-proyecto" role="tabpanel">
                <table id="tb3" class="table config-table dataTable">
                    <thead>
                    <tr>
                        <th style="width:3%">No.</th>
                        <th>Proyecto</th>
                        <th>Estado</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% if proyectos | length > 0 %}
                        {% for item in proyectos %}
                            <tr id="tr_{{ item.id_proyecto }}">
                                <td>{{ loop.index }}</td>
                                <td>{{ item.nombre_proyecto | default('') }}</td>
                                <td>{{ item.nombre_estado_proyecto | default('') }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr><td colspan="3" class="text-center text-muted py-3"><i class="fas fa-inbox mr-1"></i>Sin registros.</td></tr>
                    {% endif %}
                    </tbody>
                </table>
            </div>

            <div class="tab-pane fade" id="custom-tabs-four-membresia" role="tabpanel">
                <table id="tb4" class="table config-table dataTable">
                    <thead>
                    <tr>
                        <th style="width:3%">No.</th>
                        <th>Membresía</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% if membresias | length > 0 %}
                        {% for item in membresias %}
                            <tr id="tr_{{ item.id_membresia }}">
                                <td>{{ loop.index }}</td>
                                <td>{{ item.nombre_membresia | default('') }}</td>
                                <td>{{ item.nombre_tipo_membresia | default('') }}</td>
                                <td>{{ item.nombre_estado_membresia | default('') }}</td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr><td colspan="4" class="text-center text-muted py-3"><i class="fas fa-inbox mr-1"></i>Sin registros.</td></tr>
                    {% endif %}
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
    $(document).ready(function () {
        $('li[id*=li_]').click(function (e) {
            tabSelected = e.target.id.split('-')[3];
            var nuevoPath = "/institucion/institucion/{{ id }}/" + tabSelected + "/internacionalizacion";
            $(window).attr('location', nuevoPath);
        });

        var tagUrl = window.location.pathname.split('/')[4];
        $('a[id*=custom-tabs-four]').removeClass('active');
        $('a[id*=' + tagUrl + ']').addClass('active');
        $('div[class*=tab-pane]').removeClass('active show');
        $('div[id*=' + tagUrl + ']').addClass('active show');
        localStorage.setItem('tabSelected', tagUrl);
    });
</script>
{% endblock %}
