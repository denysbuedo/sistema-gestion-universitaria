{% extends 'baseAdmin.html.twig' %}

{% block title %}Panel de Control - Auditoría y Trazas{% endblock %}

{% block stylesheets %}
    <style>
        :root {
            --primary-dark: #1e293b;
            --primary-light: #334155;
            --accent-color: #6366f1;
            --bg-glass: rgba(255, 255, 255, 0.9);
        }

        .dashboard-container {
            padding: 2rem;
            background-color: #f1f5f9;
            min-height: 100vh;
        }

        .kpi-card {
            border-radius: 16px;
            border: none;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
            position: relative;
        }

        .kpi-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 24px rgba(0, 0, 0, 0.1) !important;
        }

        .kpi-icon-bg {
            position: absolute;
            right: -15px;
            bottom: -15px;
            font-size: 5rem;
            opacity: 0.12;
            transform: rotate(-15deg);
        }

        .chart-container {
            background: var(--bg-glass);
            backdrop-filter: blur(10px);
            border-radius: 20px;
            padding: 1.5rem;
            height: 100%;
            border: 1px solid rgba(255,255,255,0.4);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        }

        .status-badge {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
        }

        .pm-hero {
            background: linear-gradient(135deg, #071e3d 0%, #134679 55%, #1a5898 100%);
            padding: 30px 40px; position: relative; overflow: hidden;
            margin: -10px -15px 24px -15px;
        }
        .pm-hero::before {
            content: ''; position: absolute; width: 400px; height: 400px; border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,.07) 0%, transparent 70%);
            top: -150px; right: -80px; pointer-events: none;
        }
        .pm-hero-dot {
            position: absolute; inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1px);
            background-size: 24px 24px; pointer-events: none;
        }
        .pm-hero-inner { position: relative; z-index: 1; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
        .pm-hero-tag { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: rgba(255,255,255,.55); margin-bottom: 6px; }
        .pm-hero-title { font-size: 22px; font-weight: 700; color: #fff; margin-bottom: 4px; line-height: 1.2; }
        .pm-hero-sub { font-size: 13px; color: rgba(255,255,255,.6); }
        .pm-btn-white {
            display: inline-flex; align-items: center; gap: 7px;
            padding: 8px 16px; border-radius: 9px; font-size: 13px; font-weight: 600;
            background: #fff; color: #134679; border: none; cursor: pointer;
            transition: background .2s;
        }
        .pm-btn-white:hover { background: #f0f7ff; }
        @media (max-width: 768px) { .pm-hero { padding: 22px 16px; } }

        .glass-header { display: none; }

        .btn-modern {
            border-radius: 12px;
            font-weight: 600;
            padding: 0.6rem 1.25rem;
            transition: all 0.2s;
        }

        .card-title-modern {
            color: var(--primary-dark);
            font-weight: 700;
            font-size: 1.15rem;
            letter-spacing: -0.5px;
        }
        
        .table-activity th {
            border-top: none;
            text-transform: uppercase;
            font-size: 0.75rem;
            color: #64748b;
            letter-spacing: 0.5px;
            font-weight: 700;
        }

        .table-activity td {
            font-size: 0.85rem;
            vertical-align: middle;
            color: #334155;
            padding: 1rem 0.75rem;
        }

        .badge-ip {
            background: #f1f5f9;
            color: #475569;
            font-family: 'Courier New', Courier, monospace;
            font-weight: 600;
            font-size: 0.8rem;
        }

        /* ── White KPI cards (dashboard style) ── */
        .kpi-card-new {
            background: #fff;
            border-radius: 14px;
            border: 1px solid #e2e8f0;
            border-top: 3px solid var(--kc, #1e293b);
            padding: 20px 22px 18px;
            position: relative;
            overflow: hidden;
            transition: transform .22s cubic-bezier(0.4,0,0.2,1), box-shadow .22s;
            box-shadow: 0 1px 3px rgba(0,0,0,.07);
            margin-bottom: 0;
        }
        .kpi-card-new:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(0,0,0,.10);
        }
        .kpi-card-new::after {
            content: '';
            position: absolute;
            width: 100px; height: 100px;
            border-radius: 50%;
            bottom: -30px; right: -20px;
            background: radial-gradient(circle, var(--kc, #1e293b) 0%, transparent 70%);
            opacity: .06;
            pointer-events: none;
        }
        .kci {
            width: 44px; height: 44px;
            border-radius: 11px;
            background: color-mix(in srgb, var(--kc, #1e293b) 12%, transparent);
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            color: var(--kc, #1e293b);
            margin-bottom: 14px;
        }
        @supports not (background: color-mix(in srgb, red 10%, transparent)) {
            .kci { background: rgba(30,41,59,.10); }
        }
        .kc-val {
            font-size: 30px; font-weight: 800;
            color: #1a2e44; line-height: 1; margin-bottom: 5px;
        }
        .kc-lbl {
            font-size: 11px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .7px;
            color: #94a3b8;
        }
        /* Remove old kpi-card styles for this page */
        .kpi-card { display: none !important; }
        .kpi-icon-bg { display: none !important; }
    </style>
{% endblock %}

{% block body %}

<div class="content-header">
    <div class="container-fluid">
        <h4 style="color:#1a2e44;font-weight:700;margin:0">Panel de Trazas</h4>
        <p style="color:#94a3b8;font-size:13px;margin:4px 0 0">Auditoría y registro de actividad del sistema</p>
    </div>
</div>

<div class="dashboard-container">

    <!-- KPI Section -->
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card-new" style="--kc: #1e293b">
                <div class="kci"><i class="fas fa-database"></i></div>
                <div class="kc-val">{{ kpis.total }}</div>
                <div class="kc-lbl">Logs Totales</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card-new" style="--kc: #6366f1">
                <div class="kci"><i class="fas fa-bolt"></i></div>
                <div class="kc-val">{{ kpis.hoy }}</div>
                <div class="kc-lbl">Eventos de Hoy</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card-new" style="--kc: #0ea5e9">
                <div class="kci"><i class="fas fa-tags"></i></div>
                <div class="kc-val">{{ kpis.tipos }}</div>
                <div class="kc-lbl">Tipos de Evento</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="kpi-card-new" style="--kc: #f43f5e">
                <div class="kci"><i class="fas fa-running"></i></div>
                <div class="kc-val">{{ kpis.acciones }}</div>
                <div class="kc-lbl">Operaciones</div>
            </div>
        </div>
    </div>

    <!-- Charts Section -->
    <div class="row mb-4">
        <!-- Activity Chart (Last 7 Days) -->
        <div class="col-lg-8 mb-4">
            <div class="card chart-container shadow-sm border-0">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="card-title-modern mb-0"><i class="fas fa-chart-line mr-2 text-indigo"></i> Tráfico de Auditoría (7 días)</h5>
                </div>
                <div style="height: 350px;">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Distribution Chart (Types) -->
        <div class="col-lg-4 mb-4">
            <div class="card chart-container shadow-sm border-0">
                <h5 class="card-title-modern mb-4"><i class="fas fa-chart-pie mr-2 text-indigo"></i> Composición de Trazas</h5>
                <div style="height: 280px;">
                    <canvas id="typeChart"></canvas>
                </div>
                <div class="mt-4" id="chartLegend" style="max-height: 120px; overflow-y: auto;">
                    <!-- Leyenda dinámica -->
                </div>
            </div>
        </div>
    </div>

    <!-- Table Section -->
    <div class="row">
        <div class="col-12 mb-4">
            <div class="card chart-container shadow-sm border-0">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="card-title-modern mb-0"><i class="fas fa-stream mr-2 text-indigo"></i> Últimos Eventos de Auditoría</h5>
                    <a href="{{ path('app_traza_index') }}" class="btn btn-sm btn-outline-indigo rounded-pill px-3 font-weight-bold">Ver Todo el Log</a>
                </div>
                
                <div class="table-responsive">
                    <table class="table table-hover table-activity mb-0">
                        <thead>
                            <tr>
                                <th>Marca Temporal</th>
                                <th>Usuario Responsable</th>
                                <th>Acción Realizada</th>
                                <th>Objeto Afectado</th>
                                <th>Origen (IP)</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for log in actividad_reciente %}
                            <tr>
                                <td>
                                    <span class="text-muted"><i class="far fa-clock mr-2 text-indigo"></i> {{ log.creado|date('d/m/Y H:i:s') }}</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-indigo text-white d-flex align-items-center justify-content-center mr-2 font-weight-bold" style="width: 32px; height: 32px; font-size: 0.75rem;">
                                            {{ log.persona ? log.persona.primerNombre|first|upper : 'S' }}
                                        </div>
                                        <span class="font-weight-bold">{{ log.persona ? log.persona.primerNombre ~ ' ' ~ log.persona.primerApellido : 'Sistema' }}</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge px-3 py-2" style="background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe;">
                                        {{ log.accion ? log.accion.nombre : '-' }}
                                    </span>
                                </td>
                                <td>
                                    <span class="text-dark">{{ log.objeto ? log.objeto.nombre : '-' }}</span>
                                </td>
                                <td>
                                    <span class="badge badge-ip px-2 py-1 rounded">
                                        <i class="fas fa-network-wired mr-1 opacity-50"></i> {{ log.ip|default('Local') }}
                                    </span>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="text-center p-5 text-muted">No se han registrado trazas recientemente.</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            Chart.defaults.font.family = "'Segoe UI', 'Roboto', 'Arial', sans-serif";
            
            // 1. Line Chart (Trend)
            const trendCtx = document.getElementById('trendChart').getContext('2d');
            const trendDataRaw = {{ trend.data|raw }};
            const trendLabelsRaw = {{ trend.labels|raw }};

            new Chart(trendCtx, {
                type: 'line',
                data: {
                    labels: trendLabelsRaw,
                    datasets: [{
                        label: 'Número de Eventos',
                        data: trendDataRaw,
                        borderColor: '#6366f1',
                        backgroundColor: (ctx) => {
                            const gradient = ctx.chart.ctx.createLinearGradient(0, 0, 0, 400);
                            gradient.addColorStop(0, 'rgba(99, 102, 241, 0.3)');
                            gradient.addColorStop(1, 'rgba(99, 102, 241, 0)');
                            return gradient;
                        },
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 5,
                        pointBackgroundColor: '#fff',
                        pointBorderColor: '#6366f1',
                        pointBorderWidth: 2,
                        pointHoverRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: 'rgba(0,0,0,0.03)', drawBorder: false },
                            ticks: { precision: 0 }
                        },
                        x: {
                            grid: { display: false, drawBorder: false }
                        }
                    }
                }
            });

            // 2. Donut Chart (Types)
            const typeCtx = document.getElementById('typeChart').getContext('2d');
            const typeDataRaw = {{ tipo_dist|raw }};
            
            const vibrantColors = [
                '#6366f1', '#0ea5e9', '#10b981', '#f43f5e', '#f59e0b', '#8b5cf6', '#64748b'
            ];

            new Chart(typeCtx, {
                type: 'doughnut',
                data: {
                    labels: typeDataRaw.map(d => d.label),
                    datasets: [{
                        data: typeDataRaw.map(d => d.value),
                        backgroundColor: vibrantColors.slice(0, typeDataRaw.length),
                        borderWidth: 0,
                        hoverOffset: 15
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Leyenda dinámica
            const legendContainer = document.getElementById('chartLegend');
            typeDataRaw.forEach((d, i) => {
                const item = document.createElement('div');
                item.className = 'd-flex justify-content-between align-items-center mb-2 small';
                item.innerHTML = `
                    <div class="d-flex align-items-center">
                        <span class="status-badge" style="background-color: ${vibrantColors[i % vibrantColors.length]}"></span>
                        <span class="text-muted font-weight-bold">${d.label}</span>
                    </div>
                    <span class="font-weight-bold text-dark">${d.value}</span>
                `;
                legendContainer.appendChild(item);
            });

            $('#btnRefresh').click(function() {
                $(this).find('i').addClass('fa-spin');
                setTimeout(() => location.reload(), 500);
            });
        });
    </script>
{% endblock %}
