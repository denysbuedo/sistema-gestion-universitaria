{% extends 'baseAdmin.html.twig' %}

{% block title %}Asociar dictamen{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <style>

        .card-luxury { border-radius:12px; border:none; box-shadow:0 4px 20px rgba(0,0,0,0.08); border-top:4px solid #134679; margin-bottom:1.5rem; }
        .card-luxury .card-header { background-color:#fff; border-bottom:1px solid #f1f5f9; padding:15px 24px; }
        .card-luxury .card-title { color:#1a2e44; font-weight:700; font-size:1rem; margin:0; float:none !important; }
        .label-icon { color:#134679; margin-right:6px; opacity:0.8; }
        .fs-label { font-size:0.82rem; font-weight:600; color:#4b5563; margin-bottom:6px; display:block; }
        .btn-fs-submit { background:#134679; color:#fff !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; cursor:pointer; }
        .btn-fs-submit:hover { background:#0f3560; transform:translateY(-1px); box-shadow:0 4px 12px rgba(19,70,121,0.2); }
        .btn-fs-cancel { background:#f1f5f9; color:#475569 !important; font-weight:700; font-size:0.85rem; padding:10px 24px; border-radius:8px; border:none; transition:all 0.2s; display:inline-flex; align-items:center; gap:8px; text-decoration:none; cursor:pointer; }
        .btn-fs-cancel:hover { background:#e2e8f0; color:#1e293b !important; transform:translateY(-1px); }
        .config-table th { background:#f1f5f9; color:#4a5568; font-size:0.82rem; font-weight:700; border-color:#e2e8f0; padding:8px 10px; }
        .config-table td { font-size:0.85rem; color:#1a2e44; border-color:#e2e8f0; padding:7px 10px; vertical-align:middle; }
        #map {
            height: 350px;
        }
    </style>

{% endblock %}
{% block body %}
    <div class="card card-luxury">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title text-bold">Asociar dictamen</h3>
    </div>
        {{ include('modules/postgrado/solicitud_programa/info_comun.html.twig', { 'solicitudPrograma': solicitudPrograma, 'presencialidades':presencialidades }) }}
        <!-- /.card-header -->
        {{ form_start(form) }}
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.dictamen) }}
                    {{ form_widget(form.dictamen) }}
                    <span style="margin-top: 1%;position: absolute;margin-left: -95%;z-index: 100;"
                          class="cargar-archivo"> </span>
                    {{ form_errors(form.dictamen) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.comision) }}
                    {{ form_widget(form.comision) }}
                    {{ form_errors(form.comision) }}
                </div>
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.rolComision) }}
                    {{ form_widget(form.rolComision) }}
                    {{ form_errors(form.rolComision) }}
                </div>
                <div style="margin-left: 95%" class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    <button style="margin-top: 4%" class="btn btn-primary">Asociar</button>
                </div>
            </div>
        </div>


        {{ form_end(form) }}
        <hr>
        <div class="card-body">
            <table class="table config-table table-bordered table-striped dataTable">
                <thead class="table-custom-header">
                <tr>
                    <th>No.</th>
                    <th>Dictamen</th>
                    <th>Comisión</th>
                    <th>Nombre y apellidos</th>
                    <th>Rol en comisión</th>
                    <th class="text-center">Opciones</th>
                </tr>
                </thead>
                <tbody>
                {% for item in registros %}
                    <tr>
                        <td width="1%">{{ loop.index }}</td>


                        <td><a style="cursor: pointer" title="Descargar" target="_blank"
                               href="{{ app.request.getSchemeAndHttpHost() }}/uploads/postgrado/solicitud_programa/dictamen/{{ item.dictamen }}">{{ item.dictamen }}</a>
                        </td>
                        <td>{{ item.comision.nombre | default('') }}</td>
                        <td>{{ item.propietarioDictamen.primerNombre | default('') ~' '~ item.propietarioDictamen.segundoNombre | default('') ~ ' '~ item.propietarioDictamen.primerApellido | default('') ~ ' '~ item.propietarioDictamen.segundoApellido | default('') }}</td>
                        <td>{{ item.rolComision.nombre | default('') }}</td>


                        <td width="15%" class="text-center">
                            {% if item.propietarioDictamen.id | default('-1') == personaAutenticada.id %}
                                <button title="Eliminar" class="btn-action-sm btn-action-danger elementRemove"
                                        data-url="{{ path('app_solicitud_programa_eliminar_dictamen', {'id': item.id}) }}">
                                    <i class="fa fa-trash"></i>
                                </button>
                            {% endif %}
                        </td>

                    </tr>
                {% endfor %}
                </tbody>

            </table>
        </div>

    </div>
{% endblock %}
{% block javascripts %}
    <script>
        $('#solicitud_programa_dictamen_dictamen').change(function () {
            var filename = jQuery(this).val().split('\\').pop();
            $('.cargar-archivo').html(filename);
        })

    </script>
{% endblock %}