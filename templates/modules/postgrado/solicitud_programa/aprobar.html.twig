{% extends 'baseAdmin.html.twig' %}

{% block title %}Aprobar programa{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .card-luxury { border-radius: 12px; border: none; box-shadow: 0 4px 20px rgba(0,0,0,0.08); border-top: 4px solid #134679; margin-bottom: 1.5rem; }
        .card-luxury .card-header { background-color: #fff; border-bottom: 1px solid #f1f5f9; padding: 15px 24px; }
        .card-luxury .card-title { color: #1a2e44; font-weight: 700; font-size: 1.05rem; margin: 0; }
        .label-icon { color: #134679; margin-right: 6px; opacity: 0.8; }

        .fs-section { background: #fff; border-radius: 8px; margin-bottom: 1.5rem; }
        .fs-label { font-size: 0.82rem; font-weight: 600; color: #4b5563; margin-bottom: 6px; display: block; }
        .required:after { content: ' *'; color: #ef4444; }

        .config-table th { background: #f1f5f9; color: #4a5568; font-size: 0.82rem; font-weight: 700; border-color: #e2e8f0; padding: 8px 10px; text-transform: uppercase; }
        .config-table td { font-size: 0.85rem; color: #1a2e44; border-color: #e2e8f0; padding: 7px 10px; vertical-align: middle; }

        .btn-lux-sm { padding: 6px 14px; border-radius: 6px; font-weight: 700; font-size: 0.75rem; border: none; display: inline-flex; align-items: center; gap: 5px; text-transform: uppercase; transition: all 0.2s; text-decoration: none; color: #fff; cursor: pointer; }
        .btn-lux-primary { background: #134679; color: #fff; }
        .btn-lux-primary:hover { background: #0f3560; color: #fff; transform: translateY(-1px); }

        .btn-fs-submit { background: #134679; color: #fff !important; font-weight: 700; font-size: 0.85rem; padding: 10px 24px; border-radius: 8px; border: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; }
        .btn-fs-submit:hover { background: #0f3560; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(19, 70, 121, 0.2); }

        .btn-fs-cancel { background: #f1f5f9; color: #475569 !important; font-weight: 700; font-size: 0.85rem; padding: 10px 24px; border-radius: 8px; border: none; transition: all 0.2s; display: inline-flex; align-items: center; gap: 8px; text-decoration: none; cursor:pointer;}
        .btn-fs-cancel:hover { background: #e2e8f0; color: #1e293b !important; transform: translateY(-1px); }

        .btn-action-sm { width: 28px; height: 28px; padding: 0; display: inline-flex; justify-content: center; align-items: center; border-radius: 6px; font-size: 0.75rem; border: none; transition: all 0.2s; color: #fff; margin: 0 2px; text-decoration: none; }
        .btn-action-primary { background: #3b82f6; }
        .btn-action-primary:hover { background: #2563eb; transform: translateY(-1px); }
        .btn-action-warning { background: #eab308; color: #1e293b !important; }
        .btn-action-warning:hover { background: #ca8a04; transform: translateY(-1px); }
        .btn-action-danger { background: #ef4444; }
        .btn-action-danger:hover { background: #dc2626; transform: translateY(-1px); }
    </style>
{% endblock %}

{% block body %}


    <div class="card card-luxury">
    <div class="card-header d-flex align-items-center">
        <h3 class="card-title text-bold">Aprobar programa</h3>
    </div>

        {{ include('modules/postgrado/solicitud_programa/info_comun.html.twig', { 'solicitudPrograma': solicitudPrograma, 'presencialidades':presencialidades }) }}

        <!-- /.card-header -->
        {{ form_start(form) }}
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.codigoPrograma) }}
                    {{ form_widget(form.codigoPrograma) }}
                    {{ form_errors(form.codigoPrograma) }}
                </div>
{#                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">#}
{#                    {{ form_label(form.categoriaAcreditacion) }}#}
{#                    {{ form_widget(form.categoriaAcreditacion) }}#}
{#                    {{ form_errors(form.categoriaAcreditacion) }}#}
{#                </div>#}
                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.resolucionPrograma) }}
                    {{ form_widget(form.resolucionPrograma) }}
                    <span style="margin-top: 1%;position: absolute;margin-left: -95%;z-index: 100;"
                          class="cargar-archivo"> </span>
                    {{ form_errors(form.resolucionPrograma) }}
                    <a id="doc_container" target="_blank"
                       href="{{ app.request.getSchemeAndHttpHost() }}/uploads/postgrado/resolucion_programa/{{ solicitudPrograma.resolucionPrograma }}">{{ solicitudPrograma.resolucionPrograma }}</a>
                </div>
                {#                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group"> #}
                {#                    {{ form_label(form.annoAcreditacion) }} #}
                {#                    {{ form_widget(form.annoAcreditacion) }} #}
                {#                    {{ form_errors(form.annoAcreditacion) }} #}
                {#                </div> #}

{#                                <div class="col-4 form-group"> #}
{#                                    {{ form_label(form.fechaProximaAcreditacion) }} #}
{#                                    <div class="input-group"> #}
{#                                        <div class="input-group-prepend"> #}
{#                                            <span class="input-group-text"><i class="far fa-calendar-alt"></i></span> #}
{#                                        </div> #}
{#                                        {{ form_widget(form.fechaProximaAcreditacion) }} #}
{#                                        {{ form_errors(form.fechaProximaAcreditacion) }} #}
{#                                    </div> #}
{#                                </div> #}

                <div class="col-12 col-sm-6 col-md-4 col-lg-4 col-xl-4 form-group">
                    {{ form_label(form.dictamenFinal) }}
                    {{ form_widget(form.dictamenFinal) }}
                    <span style="margin-top: 1%;position: absolute;margin-left: -95%;z-index: 100;"
                          class="cargar-archivo1"> </span>
                    {{ form_errors(form.dictamenFinal) }}
                    <a id="doc_container" target="_blank"
                       href="{{ app.request.getSchemeAndHttpHost() }}/uploads/postgrado/dictamen_final/{{ solicitudPrograma.dictamenFinal }}">{{ solicitudPrograma.dictamenFinal }}</a>
                </div>
                <div class="col-4 form-group">
                    {{ form_label(form.fechaAprobacion) }}
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        {{ form_widget(form.fechaAprobacion ) }}
                        {{ form_errors(form.fechaAprobacion) }}
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12 form-group">
                    {{ form_label(form.descripcion) }}
                    {{ form_widget(form.descripcion) }}
                    {{ form_errors(form.descripcion) }}
                </div>
            </div>
        </div>

        <div class="card-footer" style="display: flex; justify-content: flex-end; align-items: center;">
            <a class="btn-fs-cancel btn-cancel" data-url="{{ path('app_solicitud_programa_index') }}" data-content="¿Está seguro que desea realizar la acción?"><i class="fas fa-times mr-2"></i>Cancelar</a>
            <button type="submit" class="btn-fs-submit"><i class="fas fa-check mr-2"></i>Aceptar</button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
{% block javascripts %}
    <script>

        $('#aprobar_programa_annoAcreditacion').datetimepicker({
            format: 'YYYY'
        }).on('dp.change', function (e) {

        });

        var fecha = "{% if solicitudPrograma.fechaProximaAcreditacion is empty %}  {{ solicitudPrograma.fechaProximaAcreditacion | default('') }} {% else %}  {{ solicitudPrograma.fechaProximaAcreditacion|date('d/m/Y') }} {% endif %}".replace(' ', '');
        $('#aprobar_programa_fechaProximaAcreditacion').val(fecha.replace(' ', ''));

        var fechaAprobacion = "{% if solicitudPrograma.fechaAprobacion is empty %}  {{ solicitudPrograma.fechaAprobacion | default('') }} {% else %}  {{ solicitudPrograma.fechaProximaAcreditacion|date('d/m/Y') }} {% endif %}".replace(' ', '');
        $('#aprobar_programa_fechaAprobacion').val(fechaAprobacion.replace(' ', ''));


        $('#aprobar_programa_resolucionPrograma').change(function () {
            var filename = jQuery(this).val().split('\\').pop();
            $('.cargar-archivo').html(filename);
        })

        $('#aprobar_programa_dictamenFinal').change(function () {
            var filename = jQuery(this).val().split('\\').pop();
            $('.cargar-archivo1').html(filename);
        })
        $('#aprobar_programa_fechaProximaAcreditacion').datetimepicker({
            format: 'DD/MM/YYYY'
        });
        $('#aprobar_programa_fechaAprobacion').datetimepicker({
            format: 'DD/MM/YYYY'
        });
        $('[id=aprobar_programa_annoAcreditacion]').bind("keypress", function (event) {
            if (event.charCode != 0) {
                var regex = new RegExp("^[0-9-]*$");
                var key = String.fromCharCode(!event.charCode ? event.which : event.charCode);
                if (!regex.test(key)) {
                    event.preventDefault();
                    return false;
                }
            }
        });

    </script>
{% endblock %}