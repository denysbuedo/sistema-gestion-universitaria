        window.addEventListener("load", function () {
            // icono para mostrar contraseña
            showPassword = document.querySelector('.show-password');
            showPassword.addEventListener('click', () => {

                // elementos input de tipo clave
                password1 = $('#persona_contrasena');
                password2 = $('#persona_contrasena2');

                if (password1.attr('type') === "text") {
                    password1.attr('type', "password")
                    password2.attr('type', "password")
                    showPassword.classList.remove('fa-eye-slash');
                } else {
                    password1.attr('type', "text")
                    password2.attr('type', "text")
                    showPassword.classList.toggle("fa-eye-slash");
                }
            })
        });

        // ── Navegación de tabs (Siguiente / Anterior) ──────────────────────
        var tabOrder = [
            '#v-pills-personal-tab',
            '#v-pills-laboral-tab',
            '#v-pills-acceso-tab',
            '#v-pills-contacto-tab',
            '#v-pills-superacion-tab',
            '#v-pills-afiliaciones-tab'
        ];

        function getActiveTabIndex() {
            for (var i = 0; i < tabOrder.length; i++) {
                if ($(tabOrder[i]).hasClass('active')) {
                    return i;
                }
            }
            return 0;
        }

        $(document).on('click', '.btn-next-tab', function () {
            var current = getActiveTabIndex();
            var next = current + 1;
            while (next < tabOrder.length && $(tabOrder[next]).length === 0) {
                next++;
            }
            if (next < tabOrder.length) {
                $(tabOrder[next]).tab('show');
            }
        });

        $(document).on('click', '.btn-prev-tab', function () {
            var current = getActiveTabIndex();
            var prev = current - 1;
            while (prev >= 0 && $(tabOrder[prev]).length === 0) {
                prev--;
            }
            if (prev >= 0) {
                $(tabOrder[prev]).tab('show');
            }
        });
    </script>
