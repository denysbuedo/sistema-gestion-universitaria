{% extends 'baseAdmin.html.twig' %}

{% block title %}Grupos{% endblock %}

{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
<style>
    .count-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        background: #eef2ff;
        color: #4338ca;
    }
</style>

    {% include 'pages/modalDetail.html.twig' %}

    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center">
            <h3 class="card-title text-bold m-0"><i class="fas fa-layer-group label-icon"></i>Listado de Grupos</h3>
            <a title="Adicionar" class="btn-lux-sm btn-lux-primary ml-auto" href="{{ path('app_grupo_registrar') }}">
                <i class="fa fa-plus"></i> Nuevo
            </a>
        </div>
        <div class="card-body px-4">
            <table class="table config-table table-bordered table-striped dataTable">
                <thead>
                <tr>
                    <th>No.</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Estructuras asignadas</th>
                    <th>Estado</th>
                    <th class="text-center">Opciones</th>
                </tr>
                </thead>
                <tbody>
                {% for item in registros %}
                    <tr>
                        <td width="1%">{{ loop.index }}</td>
                        <td>{{ item.nombre }}</td>
                        <td>{{ item.descripcion|default('Sin descripción') }}</td>
                        <td class="text-center"><span class="count-pill"><i class="fas fa-sitemap"></i> {{ item.estructuras|length }}</span></td>
                        <td width="10%">
                            {% if item.activo %}
                                <span class="status-pill -on"><i class="fas fa-circle"></i>Habilitado</span>
                            {% else %}
                                <span class="status-pill -off"><i class="fas fa-circle"></i>Deshabilitado</span>
                            {% endif %}
                        </td>
                        <td width="5%">
                            <div class="dropdown d-flex justify-content-center">
                                <button class="btn btn-sm btn-light rounded-circle shadow-sm border-0 p-0 d-flex align-items-center justify-content-center actions-dropdown-btn"
                                        type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    &#8942;
                                </button>
                                <div class="dropdown-menu dropdown-menu-right shadow-sm actions-dropdown-menu" style="min-width:200px;">
                                    <button class="dropdown-item modalDetailAction"
                                            data-url="{{ path('app_grupo_detail', {'id' : item.id}) }}"
                                            data-title="Detalles del grupo">
                                        <i class="fa fa-eye fa-fw mr-2 text-primary"></i> Ver detalles
                                    </button>
                                    <a class="dropdown-item" href="{{ path('app_grupo_modificar', {'id': item.id}) }}">
                                        <i class="fa fa-edit fa-fw mr-2 text-warning"></i> Modificar
                                    </a>
                                    <div class="dropdown-divider my-1"></div>
                                    {% if item.estructuras|length > 0 %}
                                        <button class="dropdown-item text-muted" disabled title="No se puede eliminar - tiene estructuras asignadas">
                                            <i class="fa fa-trash fa-fw mr-2"></i> Eliminar
                                        </button>
                                    {% else %}
                                        <button class="dropdown-item elementRemove text-danger"
                                                data-url="{{ path('app_grupo_eliminar', {'id': item.id}) }}">
                                            <i class="fa fa-trash fa-fw mr-2"></i> Eliminar
                                        </button>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'pages/_luxury_list_dropdown_js.html.twig' %}
{% endblock %}
