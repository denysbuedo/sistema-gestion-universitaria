{% extends 'baseAdmin.html.twig' %}

{% block title %}Adicionar grupo{% endblock %}

{% block body %}
{% include 'pages/_luxury_form_styles.html.twig' %}

<div class="card card-luxury">
    <div class="card-header">
        <h3 class="card-title"><i class="fas fa-plus-circle label-icon"></i>Nueva agrupación del claustro</h3>
    </div>

    {{ form_start(form, {'attr': {'id': 'luxury-form'}}) }}
    <div class="card-body px-4 pt-3">
        <div class="row">
            <div class="col-md-7 mb-3">
                <div class="form-group">
                    <label class="required"><i class="fas fa-id-card label-icon"></i>Nombre</label>
                    {{ form_widget(form.nombre, {'attr': {'class': 'form-control form-control-luxury ' ~ (form.nombre.vars.valid ? '' : 'is-invalid-luxury'), 'placeholder': 'Ingrese el nombre del grupo'}}) }}
                    {% if not form.nombre.vars.valid %}
                        <span class="invalid-feedback-luxury">{{ form_errors(form.nombre) }}</span>
                    {% endif %}
                </div>
            </div>

            <div class="col-md-5 mb-3">
                <div class="form-group">
                    <label><i class="fas fa-toggle-on label-icon"></i>Estado Inicial</label>
                    <input type="checkbox"
                           id="{{ form.activo.vars.id }}"
                           name="{{ form.activo.vars.full_name }}"
                           class="d-none activo-checkbox"
                           {% if form.activo.vars.data %}checked{% endif %}>
                    <div class="estado-toggle" data-cb="{{ form.activo.vars.id }}">
                        <button type="button" class="et-opt et-on{% if form.activo.vars.data %} active{% endif %}">
                            <i class="fas fa-circle"></i> Habilitado
                        </button>
                        <button type="button" class="et-opt et-off{% if not form.activo.vars.data %} active{% endif %}">
                            <i class="fas fa-circle"></i> Deshabilitado
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 mb-3">
                <div class="form-group">
                    <label><i class="fas fa-paragraph label-icon"></i>Descripción</label>
                    {{ form_widget(form.descripcion, {'attr': {'class': 'form-control form-control-luxury', 'rows': 3, 'placeholder': 'Ingrese una descripción opcional'}}) }}
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12 mb-3">
                <div class="form-group">
                    <label><i class="fas fa-sitemap label-icon"></i>Entidades de la agrupación</label>
                    {{ form_widget(form.estructuras, {'attr': {'class': 'form-control form-control-luxury tom-select'}}) }}
                    {{ form_errors(form.estructuras) }}
                </div>
            </div>
        </div>
    </div>

    <div class="card-footer bg-white px-4 py-3 border-top-0 d-flex justify-content-end" style="gap: 10px;">
        <button type="button" class="btn-lux-sm btn-lux-outline-danger btn-cancel-confirm">
            <i class="fas fa-times"></i> Cancelar
        </button>
        <button type="submit" id="submit-btn" class="btn-lux-sm btn-lux-primary">
            <i class="fas fa-check"></i> Aceptar
        </button>
    </div>
    {{ form_row(form._token) }}
    {{ form_end(form, {'render_rest': false}) }}
</div>
{% endblock %}

{% block javascripts %}
    {% include 'pages/_luxury_form_toggle_js.html.twig' with {
        cancelUrl: path('app_grupo_index')
    } %}
{% endblock %}
