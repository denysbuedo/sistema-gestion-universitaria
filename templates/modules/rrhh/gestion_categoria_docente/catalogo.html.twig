{% extends 'baseAdmin.html.twig' %}

{% block title %}Catálogo de categorías docentes{% endblock %}

{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
<div class="card card-luxury">
    <div class="card-header d-flex align-items-center flex-wrap" style="gap:12px">
        <div>
            <h3 class="card-title m-0"><i class="fas fa-book label-icon"></i>Catálogo de categorías docentes</h3>
            <small class="text-muted">Clasificación, competencia y vigencia conforme a la Resolución 117/2023</small>
        </div>
        <div class="ml-auto d-flex flex-wrap align-items-center sgu-export-actions" style="gap:8px"></div>
    </div>
    <div class="card-body px-4">
        <table class="table config-table table-bordered table-striped dataTable">
            <thead>
            <tr><th>Orden</th><th>Código</th><th>Categoría o condición</th><th>Clasificación</th><th>Nivel de aprobación</th><th>Otorgamiento</th><th>Vigencia especial</th></tr>
            <tr><th></th><th></th><th></th><th><select class="responsive-input no-select2"><option value="">Todas</option><option>Principal</option><option>Transitoria</option><option>Complementaria</option><option>Especial</option><option>Condición especial</option></select></th><th><select class="responsive-input no-select2"><option value="">Todos</option><option>Universidad</option><option>MES</option></select></th><th></th><th></th></tr>
            </thead>
            <tbody>{% for item in registros %}<tr>
                <td>{{ item.orden }}</td><td><span class="badge badge-light border">{{ item.codigo }}</span></td><td>{{ item.nombre }}</td><td>{{ item.clasificacion }}</td>
                <td>{{ item.requiereAprobacionMes ? 'MES' : 'Universidad' }}</td><td>{{ item.autoridadOtorgamiento }}</td><td>{{ item.duracionMaximaAnnos ? item.duracionMaximaAnnos ~ ' años' : 'Sin término general' }}</td>
            </tr>{% endfor %}</tbody>
        </table>
    </div>
</div>
{% endblock %}
