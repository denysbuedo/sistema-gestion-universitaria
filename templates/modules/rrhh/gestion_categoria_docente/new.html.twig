{% extends 'baseAdmin.html.twig' %}
{% block title %}Nuevo expediente de categoría docente{% endblock %}
{% block body %}
{% include 'pages/_luxury_form_styles.html.twig' %}
<div class="card card-luxury">
    <div class="card-header"><h3 class="card-title"><i class="fas fa-folder-plus label-icon"></i>Nuevo expediente de categoría docente</h3></div>
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token('nuevo_expediente_categoria') }}">
        <div class="card-body px-4">
            <div class="row">
                <div class="col-md-6 form-group"><label class="required">Profesor o aspirante</label><select name="persona" class="form-control form-control-luxury" required><option value="">Seleccione</option>{% for p in personas %}<option value="{{ p.id }}">{{ p.siglas ? '(' ~ p.siglas ~ ') ' : '' }}{{ p.nombre }}</option>{% endfor %}</select></div>
                <div class="col-md-6 form-group"><label class="required">Categoría solicitada</label><select name="categoria" class="form-control form-control-luxury" required><option value="">Seleccione</option>{% for c in categorias %}<option value="{{ c.id }}">{{ c.nombre }} — {{ c.requiere_aprobacion_mes ? 'Aprobación MES' : 'Universidad' }}</option>{% endfor %}</select></div>
                <div class="col-md-4 form-group"><label class="required">Fecha de solicitud</label><input type="date" name="fecha_solicitud" value="{{ 'now'|date('Y-m-d') }}" class="form-control form-control-luxury" required></div>
                <div class="col-md-4 form-group d-flex align-items-center"><div class="custom-control custom-checkbox mt-3"><input type="checkbox" class="custom-control-input" id="es_extranjero" name="es_extranjero" value="1"><label class="custom-control-label" for="es_extranjero">El profesor es extranjero</label></div></div>
                <div class="col-md-4 form-group d-none" id="pais-group"><label class="required">País de procedencia</label><select id="pais" name="pais" class="form-control form-control-luxury"><option value="">Seleccione</option>{% for pais in paises %}<option value="{{ pais.id }}">{{ pais.nombre }}</option>{% endfor %}</select></div>
                <div class="col-md-8 form-group"><label>Observaciones iniciales</label><textarea name="observaciones" rows="3" class="form-control form-control-luxury"></textarea></div>
            </div>
            <div class="alert alert-info mb-0"><i class="fas fa-info-circle mr-2"></i>En esta etapa solo se registran expedientes de Profesor Titular, Profesor Auxiliar, Profesor Emérito y Doctor Honoris Causa para aprobación del MES.</div>
        </div>
        <div class="card-footer bg-white border-top-0 d-flex justify-content-end" style="gap:10px"><a href="{{ path('app_rrhh_gestion_categoria_docente_index') }}" class="btn-lux-sm btn-lux-outline-danger">Cancelar</a><button class="btn-lux-sm btn-lux-primary"><i class="fas fa-save"></i> Crear expediente</button></div>
    </form>
</div>
{% endblock %}
{% block javascripts %}{{ parent() }}<script>document.addEventListener('DOMContentLoaded',function(){var extranjero=document.getElementById('es_extranjero'),grupo=document.getElementById('pais-group'),pais=document.getElementById('pais');function actualizar(){grupo.classList.toggle('d-none',!extranjero.checked);pais.required=extranjero.checked;if(!extranjero.checked){pais.value=''}}extranjero.addEventListener('change',actualizar);actualizar()});</script>{% endblock %}
