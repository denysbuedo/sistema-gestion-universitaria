{% extends 'baseAdmin.html.twig' %}
{% block title %}Expediente {{ proceso.numero_expediente }}{% endblock %}
{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
{% include 'pages/_luxury_form_styles.html.twig' %}
<div class="d-flex flex-wrap align-items-center mb-3" style="gap:10px">
    <a href="{{ path('app_rrhh_gestion_categoria_docente_index') }}" class="btn-lux-sm btn-lux-outline-primary"><i class="fas fa-arrow-left"></i> Volver</a>
    <div><h2 class="h4 mb-0">{{ proceso.numero_expediente }}</h2><span class="text-muted">{{ proceso.persona }} · {{ proceso.categoria }}</span></div>
    <span class="status-pill -on ml-auto">{{ proceso.estado|replace({'_':' '})|title }}</span>
</div>
<div class="row">
    <div class="col-lg-8">
        <div class="card card-luxury mb-3"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-file-alt label-icon"></i>Documentos y evidencias</h3></div><div class="card-body px-4">
            {% if not administrador_rrhh and proceso.estado in ['REVISION_UNIVERSIDAD','SUBSANACION'] %}
            <form method="post" enctype="multipart/form-data" action="{{ path('app_rrhh_gestion_categoria_docente_documento', {'id':proceso.id}) }}" class="mb-4">
                <input type="hidden" name="_token" value="{{ csrf_token('documento_categoria_' ~ proceso.id) }}">
                <div class="row align-items-end"><div class="col-md-4 form-group"><label>Tipo de evidencia</label><select name="tipo" class="form-control no-select2"><option value="SOLICITUD">Solicitud institucional</option><option value="CURRICULUM">Currículo</option><option value="CERTIFICACION">Certificación</option><option value="AVAL">Aval</option><option value="OTRA_EVIDENCIA">Otra evidencia</option></select></div><div class="col-md-5 form-group"><label>Documento</label><input type="file" name="documento" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.odt" required></div><div class="col-md-3 form-group"><button class="btn-lux-sm btn-lux-primary w-100"><i class="fas fa-upload"></i> Incorporar</button></div></div>
                <input type="text" name="descripcion" class="form-control" placeholder="Descripción breve (opcional)">
            </form>
            {% endif %}
            <div class="table-responsive"><table class="table config-table table-bordered"><thead><tr><th>Tipo</th><th>Documento</th><th>Descripción</th><th>Fecha</th></tr></thead><tbody>{% for doc in documentos %}<tr><td>{{ doc.tipo|replace({'_':' '})|title }}</td><td><a href="/{{ doc.archivo }}" target="_blank" rel="noopener"><i class="fas fa-paperclip mr-1"></i>{{ doc.nombre_original }}</a></td><td>{{ doc.descripcion ?: '—' }}</td><td>{{ doc.creado|date('d/m/Y H:i') }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">Todavía no se han incorporado evidencias.</td></tr>{% endfor %}</tbody></table></div>
        </div>
        <div class="card card-luxury mb-3"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-users label-icon"></i>Tribunal</h3></div><div class="card-body px-4">
            {% if tribunal %}<dl class="row mb-3"><dt class="col-sm-3">Tribunal</dt><dd class="col-sm-9"><strong>{{ tribunal.nombre }}</strong></dd><dt class="col-sm-3">Presidente</dt><dd class="col-sm-9">{{ tribunal.presidente }}</dd><dt class="col-sm-3">Secretario</dt><dd class="col-sm-9">{{ tribunal.secretario }}</dd><dt class="col-sm-3">Vocales</dt><dd class="col-sm-9">{{ tribunal.vocales }}</dd><dt class="col-sm-3">Constitución</dt><dd class="col-sm-9">{{ tribunal.fecha_constitucion|date('d/m/Y') }}</dd></dl>{% else %}<p class="text-muted">Este expediente todavía no tiene un tribunal asignado.</p>{% endif %}
            {% if not administrador_rrhh and proceso.estado not in ['PENDIENTE_MES','APROBADO_MES','OTORGADO','NO_APROBADO'] %}<form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_tribunal', {'id':proceso.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('tribunal_categoria_' ~ proceso.id) }}"><div class="row align-items-end"><div class="col-md-9 form-group"><label>Tribunal de la universidad</label><select name="tribunal" class="form-control no-select2" required><option value="">Seleccione</option>{% for disponible in tribunales_disponibles %}<option value="{{ disponible.id }}" {{ tribunal and tribunal.id == disponible.id ? 'selected' : '' }}>{{ disponible.nombre }} — {{ disponible.presidente }}</option>{% endfor %}</select></div><div class="col-md-3 form-group"><button class="btn-lux-sm btn-lux-primary w-100"><i class="fas fa-link"></i> Asignar</button></div></div>{% if tribunales_disponibles is empty %}<div class="alert alert-warning mb-0">La universidad no tiene tribunales activos. Créelo primero desde Gestión de tribunales.</div>{% endif %}</form>{% endif %}
        </div></div>
        <div class="card card-luxury mb-3"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-clipboard-check label-icon"></i>Ejercicios y actas</h3></div><div class="card-body px-4"><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Ejercicio</th><th>Fecha</th><th>Resultado</th><th>Calificación</th></tr></thead><tbody>{% for e in ejercicios %}<tr><td>{{ e.tipo }}</td><td>{{ e.fecha|date('d/m/Y') }}</td><td>{{ e.resultado }}</td><td>{{ e.calificacion ?: '—' }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted">Sin ejercicios registrados.</td></tr>{% endfor %}</tbody></table></div>
        {% if not administrador_rrhh and tribunal and proceso.estado not in ['PENDIENTE_MES','APROBADO_MES','OTORGADO','NO_APROBADO'] %}<form method="post" enctype="multipart/form-data" action="{{ path('app_rrhh_gestion_categoria_docente_ejercicio', {'id':proceso.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('ejercicio_categoria_' ~ proceso.id) }}"><div class="row align-items-end"><div class="col-md-3 form-group"><label>Ejercicio</label><input name="tipo" class="form-control" required></div><div class="col-md-2 form-group"><label>Fecha</label><input type="date" name="fecha" class="form-control" required></div><div class="col-md-2 form-group"><label>Resultado</label><select name="resultado" class="form-control no-select2"><option>APTO</option><option>NO_APTO</option></select></div><div class="col-md-2 form-group"><label>Calificación</label><input name="calificacion" class="form-control"></div><div class="col-md-3 form-group"><label>Acta</label><input type="file" name="acta" class="form-control" accept=".pdf,.doc,.docx"></div></div><textarea name="observaciones" class="form-control mb-2" placeholder="Observaciones"></textarea><button class="btn-lux-sm btn-lux-primary">Registrar ejercicio</button></form>{% endif %}</div></div>
        <div class="card card-luxury mb-3"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-file-signature label-icon"></i>Dictámenes</h3></div><div class="card-body px-4"><div class="table-responsive"><table class="table table-bordered"><thead><tr><th>Área</th><th>Fecha</th><th>Resultado</th><th>Observaciones</th></tr></thead><tbody>{% for d in dictamenes %}<tr><td>{{ d.area|replace({'_':' '})|title }}</td><td>{{ d.fecha|date('d/m/Y') }}</td><td>{{ d.resultado }}</td><td>{{ d.observaciones ?: '—' }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted">Sin dictámenes registrados.</td></tr>{% endfor %}</tbody></table></div>
        {% if not administrador_rrhh and proceso.estado not in ['PENDIENTE_MES','APROBADO_MES','OTORGADO','NO_APROBADO'] %}<form method="post" enctype="multipart/form-data" action="{{ path('app_rrhh_gestion_categoria_docente_dictamen', {'id':proceso.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('dictamen_categoria_' ~ proceso.id) }}"><div class="row align-items-end"><div class="col-md-3 form-group"><label>Área</label><select name="area" class="form-control no-select2"><option value="RELACIONES_INTERNACIONALES">Relaciones Internacionales</option><option value="ORGANO_CONTROL">Órgano de control</option><option value="COMISION">Comisión universitaria</option><option value="OTRO">Otro</option></select></div><div class="col-md-2 form-group"><label>Fecha</label><input type="date" name="fecha" class="form-control" required></div><div class="col-md-2 form-group"><label>Resultado</label><select name="resultado" class="form-control no-select2"><option>FAVORABLE</option><option>DESFAVORABLE</option><option>NO_APLICA</option></select></div><div class="col-md-3 form-group"><label>Documento</label><input type="file" name="documento" class="form-control" accept=".pdf,.doc,.docx"></div><div class="col-md-2 form-group"><button class="btn-lux-sm btn-lux-primary w-100">Registrar</button></div></div><input name="observaciones" class="form-control" placeholder="Observaciones"></form>{% endif %}</div></div>
        {% if not administrador_rrhh and proceso.estado not in ['PENDIENTE_MES','PENDIENTE_RECTOR','APROBADO_MES','OTORGADO','NO_APROBADO'] %}<div class="card card-luxury mb-3"><div class="card-body"><form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_decision', {'id':proceso.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('decision_categoria_' ~ proceso.id) }}"><input type="hidden" name="accion" value="ELEVAR"><textarea name="observaciones" class="form-control mb-2" placeholder="Resumen para la decisión"></textarea><button class="btn-lux-sm btn-lux-primary"><i class="fas fa-paper-plane"></i> {{ proceso.requiere_aprobacion_mes ? 'Elevar expediente al MES' : 'Remitir para resolución rectoral' }}</button></form></div></div>{% endif %}
        {% if not administrador_rrhh and proceso.estado in ['PENDIENTE_RECTOR','APROBADO_MES'] %}<div class="card card-luxury mb-3"><div class="card-header"><h3 class="card-title m-0">Resolución de otorgamiento</h3></div><div class="card-body"><form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_resolucion', {'id':proceso.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('resolucion_categoria_' ~ proceso.id) }}"><div class="row align-items-end"><div class="col-md-5 form-group"><label>Número de resolución</label><input name="numero_resolucion" class="form-control" required></div><div class="col-md-4 form-group"><label>Fecha</label><input type="date" name="fecha_resolucion" class="form-control" required></div><div class="col-md-3 form-group"><button class="btn-lux-sm btn-lux-success w-100">Otorgar categoría</button></div></div></form></div></div>{% endif %}
    </div>
    <div class="col-lg-4">
        <div class="card card-luxury mb-3"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-info-circle label-icon"></i>Resumen</h3></div><div class="card-body"><dl class="mb-0"><dt>Entidad</dt><dd>{{ proceso.siglas ?: proceso.entidad }}</dd><dt>Nivel actual</dt><dd>{{ proceso.nivel_actual }}</dd><dt>Fecha de solicitud</dt><dd>{{ proceso.fecha_solicitud|date('d/m/Y') }}</dd><dt>Competencia</dt><dd>{{ proceso.requiere_aprobacion_mes ? 'MES' : 'Universidad' }}</dd></dl></div></div>
        <div class="card card-luxury"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-history label-icon"></i>Trazabilidad</h3></div><div class="card-body">{% for mov in movimientos %}<div class="border-left pl-3 pb-3"><strong>{{ mov.accion }}</strong><div class="small text-muted">{{ mov.creado|date('d/m/Y H:i') }} · {{ mov.usuario }}</div>{% if mov.observaciones %}<div class="small">{{ mov.observaciones }}</div>{% endif %}</div>{% else %}<span class="text-muted">Sin movimientos registrados.</span>{% endfor %}</div></div>
        {% if administrador_rrhh and proceso.estado == 'PENDIENTE_MES' %}<div class="card card-luxury mt-3"><div class="card-header"><h3 class="card-title m-0">Decisión del MES</h3></div><div class="card-body"><form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_aprobar_mes', {'id':proceso.id}) }}" class="mb-2"><input type="hidden" name="_token" value="{{ csrf_token('aprobar_mes_categoria_' ~ proceso.id) }}"><button class="btn-lux-sm btn-lux-success w-100"><i class="fas fa-check"></i> Aprobar por el MES</button></form><form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_decision', {'id':proceso.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('decision_categoria_' ~ proceso.id) }}"><textarea name="observaciones" class="form-control mb-2" required placeholder="Fundamento de la devolución o no aprobación"></textarea><div class="d-flex" style="gap:8px"><button name="accion" value="DEVOLVER" class="btn-lux-sm btn-lux-primary">Devolver para subsanar</button><button name="accion" value="RECHAZAR" class="btn-lux-sm btn-lux-outline-danger">No aprobar</button></div></form></div></div>{% endif %}
    </div>
</div>
{% endblock %}
