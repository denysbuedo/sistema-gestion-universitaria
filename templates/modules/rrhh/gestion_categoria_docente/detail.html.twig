{% extends 'baseAdmin.html.twig' %}
{% block title %}Expediente {{ proceso.numero_expediente }}{% endblock %}
{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
{% include 'pages/_luxury_form_styles.html.twig' %}
<style>
    .categoria-docente-expediente .card,
    .categoria-docente-expediente .card-luxury,
    .categoria-docente-expediente .card::before,
    .categoria-docente-expediente .card::after {
        box-shadow: none !important;
        filter: none !important;
    }
</style>
<div class="categoria-docente-expediente">
<div class="d-flex flex-wrap align-items-center mb-3" style="gap:10px"><a href="{{ path('app_rrhh_gestion_categoria_docente_index') }}" class="btn-lux-sm btn-lux-outline-primary"><i class="fas fa-arrow-left"></i> Volver</a><div><h2 class="h4 mb-0">{{ proceso.numero_expediente }}</h2><span class="text-muted">{{ proceso.persona }} · {{ proceso.categoria }}</span></div><span class="status-pill -on ml-auto">{{ proceso.estado|replace({'_':' '})|title }}</span></div>
<div class="row"><div class="col-lg-8">
    <div class="card card-luxury mb-3"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-clipboard-check label-icon"></i>Documentación requerida</h3></div><div class="card-body px-4">
        <div class="mb-4">{% for tipo, nombre in requisitos %}{% set presentado = documentos|filter(documento => documento.tipo == tipo)|length > 0 %}<div class="d-flex align-items-center border-bottom py-2"><i class="fas {{ presentado ? 'fa-check-circle text-success' : 'fa-exclamation-circle text-warning' }} mr-2"></i><span>{{ nombre }}</span><span class="ml-auto small {{ presentado ? 'text-success' : 'text-muted' }}">{{ presentado ? 'Incorporado' : 'Pendiente' }}</span></div>{% endfor %}</div>
        {% if not administrador_rrhh and proceso.estado in ['PREPARACION_EXPEDIENTE','SUBSANACION'] %}<form method="post" enctype="multipart/form-data" action="{{ path('app_rrhh_gestion_categoria_docente_documento', {'id':proceso.id}) }}" class="mb-4"><input type="hidden" name="_token" value="{{ csrf_token('documento_categoria_' ~ proceso.id) }}"><div class="row align-items-end"><div class="col-md-4 form-group"><label>Tipo de documento</label><select name="tipo" class="form-control no-select2">{% for tipo, nombre in requisitos %}<option value="{{ tipo }}">{{ nombre }}</option>{% endfor %}<option value="OTRA_EVIDENCIA">Otro documento complementario</option></select></div><div class="col-md-5 form-group"><label>Archivo</label><input type="file" name="documento" class="form-control" accept=".pdf,.doc,.docx,.xls,.xlsx,.odt,.jpg,.jpeg,.png" required></div><div class="col-md-3 form-group"><button class="btn-lux-sm btn-lux-primary w-100"><i class="fas fa-upload"></i> Incorporar</button></div></div><input type="text" name="descripcion" class="form-control" placeholder="Descripción breve (opcional)"></form>{% endif %}
        <div class="table-responsive"><table class="table config-table table-bordered"><thead><tr><th>Tipo</th><th>Documento</th><th>Descripción</th><th>Fecha</th></tr></thead><tbody>{% for doc in documentos %}<tr><td>{{ requisitos[doc.tipo] ?? doc.tipo|replace({'_':' '})|title }}</td><td><a href="/{{ doc.archivo }}" target="_blank" rel="noopener"><i class="fas fa-paperclip mr-1"></i>{{ doc.nombre_original }}</a></td><td>{{ doc.descripcion ?: '—' }}</td><td>{{ doc.creado|date('d/m/Y H:i') }}</td></tr>{% else %}<tr><td colspan="4" class="text-center text-muted py-4">Todavía no se han incorporado documentos.</td></tr>{% endfor %}</tbody></table></div>
    </div></div>
    {% if not administrador_rrhh and proceso.estado in ['PREPARACION_EXPEDIENTE','SUBSANACION'] %}<div class="card card-luxury"><div class="card-body"><form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_decision', {'id':proceso.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('decision_categoria_' ~ proceso.id) }}"><input type="hidden" name="accion" value="ELEVAR"><textarea name="observaciones" class="form-control mb-2" placeholder="Observaciones del envío"></textarea><button class="btn-lux-sm btn-lux-primary"><i class="fas fa-paper-plane"></i> Enviar expediente al MES</button></form></div></div>{% endif %}
</div><div class="col-lg-4">
    <div class="card card-luxury mb-3"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-info-circle label-icon"></i>Resumen</h3></div><div class="card-body"><dl class="mb-0"><dt>Entidad</dt><dd>{{ proceso.siglas ?: proceso.entidad }}</dd><dt>Fecha de solicitud</dt><dd>{{ proceso.fecha_solicitud|date('d/m/Y') }}</dd><dt>Tramitación</dt><dd>Aprobación del MES</dd><dt>Profesor extranjero</dt><dd>{{ proceso.es_extranjero ? 'Sí — requiere aval de la DRI' : 'No' }}</dd>{% if proceso.es_extranjero %}<dt>País</dt><dd>{{ proceso.pais }}</dd>{% endif %}</dl></div></div>
    <div class="card card-luxury"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-history label-icon"></i>Trazabilidad</h3></div><div class="card-body">{% for mov in movimientos %}<div class="border-left pl-3 pb-3"><strong>{{ mov.accion }}</strong><div class="small text-muted">{{ mov.creado|date('d/m/Y H:i') }} · {{ mov.usuario }}</div>{% if mov.observaciones %}<div class="small">{{ mov.observaciones }}</div>{% endif %}</div>{% else %}<span class="text-muted">Sin movimientos registrados.</span>{% endfor %}</div></div>
    {% if administrador_rrhh and proceso.estado == 'PENDIENTE_MES' %}<div class="card card-luxury mt-3"><div class="card-header"><h3 class="card-title m-0">Revisión del MES</h3></div><div class="card-body"><form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_aprobar_mes', {'id':proceso.id}) }}" class="mb-2"><input type="hidden" name="_token" value="{{ csrf_token('aprobar_mes_categoria_' ~ proceso.id) }}"><button class="btn-lux-sm btn-lux-success w-100"><i class="fas fa-check"></i> Aprobar por el MES</button></form><form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_decision', {'id':proceso.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('decision_categoria_' ~ proceso.id) }}"><textarea name="observaciones" class="form-control mb-2" required placeholder="Fundamento de la devolución o no aprobación"></textarea><div class="d-flex flex-wrap" style="gap:8px"><button name="accion" value="DEVOLVER" class="btn-lux-sm btn-lux-primary">Devolver para subsanar</button><button name="accion" value="RECHAZAR" class="btn-lux-sm btn-lux-outline-danger">No aprobar</button></div></form></div></div>{% endif %}
    {% if not administrador_rrhh and proceso.estado in ['PREPARACION_EXPEDIENTE','REVISION_UNIVERSIDAD'] %}<div class="card card-luxury mt-3"><div class="card-body"><form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_eliminar', {'id':proceso.id}) }}" onsubmit="return confirm('¿Eliminar definitivamente este expediente en preparación?')"><input type="hidden" name="_token" value="{{ csrf_token('eliminar_categoria_' ~ proceso.id) }}"><button class="btn-lux-sm btn-lux-outline-danger w-100"><i class="fas fa-trash"></i> Eliminar expediente</button></form></div></div>{% endif %}
    {% if not administrador_rrhh and proceso.estado in ['PENDIENTE_MES','SUBSANACION'] %}<div class="card card-luxury mt-3"><div class="card-header"><h3 class="card-title m-0">Desistir del proceso</h3></div><div class="card-body"><form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_decision', {'id':proceso.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('decision_categoria_' ~ proceso.id) }}"><textarea name="observaciones" class="form-control mb-2" required placeholder="Motivo institucional del desistimiento"></textarea><button name="accion" value="DESISTIR" class="btn-lux-sm btn-lux-outline-danger">Desistir sin eliminar el historial</button></form></div></div>{% endif %}
</div></div>
</div>
{% endblock %}
