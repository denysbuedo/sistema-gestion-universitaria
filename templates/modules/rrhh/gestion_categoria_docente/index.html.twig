{% extends 'baseAdmin.html.twig' %}

{% block title %}Expedientes de categorías docentes{% endblock %}

{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
<div class="card card-luxury mb-4">
    <div class="card-header d-flex align-items-center flex-wrap" style="gap:12px">
        <div><h3 class="card-title m-0"><i class="fas fa-folder-open label-icon"></i>Expedientes de categorías docentes</h3><small class="text-muted">Solicitudes registradas por las universidades y tramitación según el nivel competente</small></div>
        <div class="ml-auto d-flex flex-wrap align-items-center sgu-export-actions" style="gap:8px">
            {% if not administrador_rrhh %}
            <a href="{{ path('app_rrhh_gestion_categoria_docente_nuevo') }}" class="btn-lux-sm btn-lux-primary"><i class="fas fa-plus"></i> Nuevo expediente</a>
            {% endif %}
        </div>
    </div>
    <div class="card-body px-4">
        <table class="table config-table table-bordered table-striped dataTable">
            <thead><tr><th>Expediente</th><th>Persona</th><th>Entidad</th><th>Categoría</th><th>Solicitud</th><th>Estado</th><th>Nivel actual</th><th>Acción</th></tr></thead>
            <tbody>{% for item in expedientes %}<tr>
                <td>{{ item.numero_expediente }}</td><td>{{ item.persona }}</td><td>{{ item.siglas ?: item.entidad }}</td><td>{{ item.categoria }}</td><td>{{ item.fecha_solicitud|date('d/m/Y') }}</td>
                <td>{{ item.estado|replace({'_':' '})|title }}</td><td>{{ item.nivel_actual }}</td>
                <td class="text-center">
                    <a href="{{ path('app_rrhh_gestion_categoria_docente_detalle', {'id':item.id}) }}" class="btn-lux-sm btn-lux-outline-primary" title="Abrir expediente"><i class="fas fa-folder-open"></i> Ver expediente</a>
                    {% if not administrador_rrhh and item.estado == 'REVISION_UNIVERSIDAD' %}<form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_tramitar', {'id':item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('tramitar_categoria_' ~ item.id) }}"><button class="btn-lux-sm btn-lux-primary" title="Continuar la tramitación"><i class="fas fa-paper-plane"></i> {{ item.requiere_aprobacion_mes ? 'Enviar al MES' : 'Tramitar en la universidad' }}</button></form>{% endif %}
                    {% if administrador_rrhh and item.estado == 'PENDIENTE_MES' %}<form method="post" action="{{ path('app_rrhh_gestion_categoria_docente_aprobar_mes', {'id':item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('aprobar_mes_categoria_' ~ item.id) }}"><button class="btn-lux-sm btn-lux-success" title="Registrar aprobación del Ministerio de Educación Superior"><i class="fas fa-check"></i> Aprobar por el MES</button></form>{% endif %}
                </td>
            </tr>{% else %}<tr><td colspan="8" class="text-center text-muted py-4">No existen expedientes de categorización.</td></tr>{% endfor %}</tbody>
        </table>
    </div>
</div>
{% endblock %}
