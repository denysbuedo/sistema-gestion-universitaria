{% extends 'baseAdmin.html.twig' %}

{% block title %}Gestión de categorías docentes{% endblock %}

{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
<div class="row mb-3">
    <div class="col-md-4 mb-3">
        <div class="card card-luxury h-100"><div class="card-body"><div class="text-muted small text-uppercase">Catálogo normativo</div><div class="h3 mb-0">{{ registros|length }}</div><div class="text-muted">Figuras docentes vigentes</div></div></div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card card-luxury h-100"><div class="card-body"><div class="text-muted small text-uppercase">Resuelve la universidad</div><div class="h3 mb-0">{{ resumen.UNIVERSIDAD }}</div><div class="text-muted">Otorgamiento mediante resolución rectoral</div></div></div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card card-luxury h-100"><div class="card-body"><div class="text-muted small text-uppercase">Requieren aprobación del MES</div><div class="h3 mb-0">{{ resumen.MES }}</div><div class="text-muted">Expedientes elevados por la universidad</div></div></div>
    </div>
</div>

<div class="card card-luxury">
    <div class="card-header">
        <div>
            <h3 class="card-title m-0"><i class="fas fa-chalkboard-teacher label-icon"></i>Categorías docentes</h3>
            <small class="text-muted">Clasificación y nivel de aprobación conforme a la Resolución 117/2023</small>
        </div>
    </div>
    <div class="card-body px-4">
        <table class="table config-table table-bordered table-striped dataTable">
            <thead>
            <tr><th>Orden</th><th>Código</th><th>Categoría o condición</th><th>Clasificación</th><th>Aprobación</th><th>Otorgamiento</th><th>Vigencia especial</th></tr>
            <tr>
                <th></th><th></th><th></th>
                <th><select class="responsive-input no-select2"><option value="">Todas</option><option value="Principal">Principal</option><option value="Transitoria">Transitoria</option><option value="Complementaria">Complementaria</option><option value="Especial">Especial</option><option value="Condición especial">Condición especial</option></select></th>
                <th><select class="responsive-input no-select2"><option value="">Todos</option><option value="Universidad">Universidad</option><option value="MES">MES</option></select></th>
                <th></th><th></th>
            </tr>
            </thead>
            <tbody>
            {% for item in registros %}
                <tr>
                    <td>{{ item.orden }}</td>
                    <td><span class="badge badge-light border">{{ item.codigo }}</span></td>
                    <td>{{ item.nombre }}</td>
                    <td>{{ item.clasificacion }}</td>
                    <td>{% if item.requiereAprobacionMes %}<span class="status-pill -on">MES</span>{% else %}<span class="status-pill">Universidad</span>{% endif %}</td>
                    <td>{{ item.autoridadOtorgamiento }}</td>
                    <td>{{ item.duracionMaximaAnnos ? item.duracionMaximaAnnos ~ ' años' : 'Sin término general' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
<div class="alert alert-info mt-3 mb-0"><i class="fas fa-info-circle mr-2"></i>El próximo bloque incorporará convocatorias, expedientes e historial individual. El catálogo normativo no se administra como un nomenclador libre.</div>
{% endblock %}
