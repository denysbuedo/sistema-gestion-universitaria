{% extends 'baseAdmin.html.twig' %}
{% block title %}Nuevo tribunal docente{% endblock %}
{% block body %}
{% include 'pages/_luxury_form_styles.html.twig' %}
<div class="card card-luxury"><div class="card-header"><h3 class="card-title m-0"><i class="fas fa-users label-icon"></i>Nuevo tribunal docente</h3></div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('nuevo_tribunal_categoria') }}"><div class="card-body px-4"><div class="row"><div class="col-md-8 form-group"><label>Nombre identificativo</label><input name="nombre" class="form-control" placeholder="Ej. Tribunal de Ciencias Técnicas 2026" required></div><div class="col-md-4 form-group"><label>Fecha de constitución</label><input type="date" name="fecha_constitucion" class="form-control" required></div><div class="col-md-6 form-group"><label>Presidente</label><input name="presidente" class="form-control" required></div><div class="col-md-6 form-group"><label>Secretario</label><input name="secretario" class="form-control" required></div><div class="col-12 form-group"><label>Vocales</label><textarea name="vocales" rows="4" class="form-control" placeholder="Indique cada integrante y su función" required></textarea></div></div></div><div class="card-footer bg-white d-flex justify-content-end" style="gap:8px"><a href="{{ path('app_rrhh_gestion_tribunal_index') }}" class="btn-lux-sm btn-lux-outline-danger">Cancelar</a><button class="btn-lux-sm btn-lux-primary"><i class="fas fa-save"></i> Crear tribunal</button></div></form></div>
{% endblock %}
