{% extends 'baseAdmin.html.twig' %}
{% block title %}Gestión de tribunales docentes{% endblock %}
{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
<div class="card card-luxury"><div class="card-header d-flex align-items-center flex-wrap" style="gap:10px"><div><h3 class="card-title m-0"><i class="fas fa-users label-icon"></i>Tribunales docentes</h3><small class="text-muted">Tribunales disponibles para asignar a expedientes de categorización</small></div><div class="ml-auto d-flex sgu-export-actions" style="gap:8px">{% if not administrador_rrhh %}<a href="{{ path('app_rrhh_gestion_tribunal_nuevo') }}" class="btn-lux-sm btn-lux-primary"><i class="fas fa-plus"></i> Nuevo tribunal</a>{% endif %}</div></div><div class="card-body px-4"><table class="table config-table table-bordered table-striped dataTable"><thead><tr><th>Tribunal</th><th>Universidad</th><th>Presidente</th><th>Secretario</th><th>Vocales</th><th>Estado</th><th>Expedientes</th></tr></thead><tbody>{% for item in tribunales %}<tr><td>{{ item.nombre }}</td><td>{{ item.siglas ?: item.entidad }}</td><td>{{ item.presidente }}</td><td>{{ item.secretario }}</td><td>{{ item.vocales }}</td><td>{{ item.estado }}</td><td class="text-center">{{ item.procesos }}</td></tr>{% else %}<tr><td colspan="7" class="text-center text-muted py-4">No existen tribunales registrados.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
