{% extends 'baseAdmin.html.twig' %}

{% block title %}Composición de la fuerza laboral{% endblock %}

{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}

    {% include 'pages/modalDetail.html.twig' %}

    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center">
            <div><h3 class="card-title m-0"><i class="fas fa-file-invoice label-icon"></i>Composición de la fuerza laboral</h3><small class="text-muted">Modelo 223.216 (II) — AE3 · Información trimestral</small></div>
            <div class="ml-auto d-flex" style="gap:8px;"><a title="Adicionar" class="btn-lux-sm btn-lux-primary" href="{{ path('app_rrhh_reporte_ae3_registrar') }}"><i class="fa fa-plus"></i> Nuevo</a></div>
        </div>
        <div class="card-body px-4">
            {% set annos = [] %}
            {% set instituciones = [] %}
            {% for registro in registros %}
                {% if registro.anno not in annos %}{% set annos = annos|merge([registro.anno]) %}{% endif %}
                {% if registro.entidad and registro.entidad.nombre not in instituciones %}{% set instituciones = instituciones|merge([registro.entidad.nombre]) %}{% endif %}
            {% endfor %}
            <table class="table config-table table-bordered table-striped dataTable">
                <thead>
                <tr>
                    <th>No.</th>
                    <th>Año</th>
                    <th>Mes</th>
                    <th>Institución</th>
                    <th class="text-center">Opciones</th>
                </tr>
                <tr>
                    <th></th>
                    <th><select class="responsive-input no-select2"><option value="">Todos los años</option>{% for anno in annos|sort|reverse %}<option value="{{ anno }}">{{ anno }}</option>{% endfor %}</select></th>
                    <th><select class="responsive-input no-select2"><option value="">Todos los trimestres</option><option value="Marzo">Marzo</option><option value="Junio">Junio</option><option value="Septiembre">Septiembre</option><option value="Diciembre">Diciembre</option></select></th>
                    <th><select class="responsive-input no-select2"><option value="">Todas las instituciones</option>{% for institucion in instituciones|sort %}<option value="{{ institucion }}">{{ institucion }}</option>{% endfor %}</select></th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% set meses = [
                    '', 'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
                    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'
                ] %}

                {% for item in registros %}
                    <tr>
                        <td width="1%">{{ loop.index }}</td>
                        <td>{{ item.anno | default('') }}</td>
                        <td>{{ meses[item.mes]|default('') }}</td>
                        <td>{{ item.entidad.nombre | default('') }}</td>
                        <td width="5%">
                            <div class="dropdown d-flex justify-content-center">
                                <button class="btn btn-sm btn-light rounded-circle shadow-sm border-0 p-0 d-flex align-items-center justify-content-center actions-dropdown-btn"
                                        type="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    &#8942;
                                </button>
                                <div class="dropdown-menu dropdown-menu-right shadow-sm actions-dropdown-menu">
                                    <button class="dropdown-item modalDetailAction"
                                            data-url="{{ path('app_rrhh_reporte_ae3_detail', {'id' : item.id}) }}"
                                            data-title="Detalles del AE3">
                                        <i class="fa fa-eye fa-fw mr-2 text-primary"></i> Ver detalles
                                    </button>
                                    <a class="dropdown-item" href="{{ path('app_rrhh_reporte_ae3_modificar', {'id': item.id}) }}">
                                        <i class="fa fa-edit fa-fw mr-2 text-warning"></i> Modificar
                                    </a>
                                    {% if item.documento %}
                                        <a class="dropdown-item" target="_blank"
                                           href="{{ app.request.getSchemeAndHttpHost() }}/uploads/rrhh/ae3/documento/{{ item.documento }}">
                                            <i class="fa fa-file-download fa-fw mr-2 text-info"></i> Descargar firmado
                                        </a>
                                    {% endif %}
                                    <div class="dropdown-divider my-1"></div>
                                    <button class="dropdown-item elementRemove text-danger"
                                            data-url="{{ path('app_rrhh_reporte_ae3_eliminar', {'id': item.id}) }}">
                                        <i class="fa fa-trash fa-fw mr-2"></i> Eliminar
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% include 'pages/_luxury_list_dropdown_js.html.twig' %}
{% endblock %}
