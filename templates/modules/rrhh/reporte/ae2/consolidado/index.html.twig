{% extends 'baseAdmin.html.twig' %}

{% block title %}Plantilla y contratación por universidad{% endblock %}

{% block body %}
{% include 'pages/_luxury_list_styles.html.twig' %}
<style>
    .accordion-luxury .card {
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
        margin-bottom: 0;
    }
    .accordion-luxury .card-header {
        background: #134679 !important;
        padding: 12px 20px;
    }
    .accordion-luxury .card-header a {
        color: #fff !important;
        font-weight: 700;
        font-size: 0.85rem;
        text-decoration: none;
    }
</style>

    {% include 'pages/modalDetail.html.twig' %}

    <div class="card card-luxury">
        <div class="card-header d-flex align-items-center">
            <div><h3 class="card-title m-0"><i class="fas fa-file-invoice label-icon"></i>Plantilla y contratación por universidad</h3><small class="text-muted">Modelo 223.216 (I) — AE2 · Comparativo mensual</small></div>
        </div>
        <div class="card-body px-4">
            <div id="accordion" class="accordion-luxury mb-4">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title w-100 mb-0">
                            <a class="d-block w-100 collapsed" data-toggle="collapse"
                               href="#collapseOne" aria-expanded="false">
                                <i class="fas fa-filter mr-1"></i> Búsqueda avanzada por: {{ text_fil | default('') }}
                            </a>
                        </h4>
                    </div>
                    <div id="collapseOne" class="collapse" data-parent="#accordion">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-4"><div class="form-group">
                                    <label class="required" for="mesFicha"><i class="fas fa-calendar label-icon"></i>Mes</label>
                                    <select id="mesFicha" class="form-control no-select2">{% for id, nombre in meses %}<option value="{{ id }}" {% if id == fil_mes %}selected{% endif %}>{{ nombre }}</option>{% endfor %}</select>
                                </div></div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label class="required" for="annoFicha"><i class="fas fa-calendar-alt label-icon"></i>Año</label>
                                        <select id="annoFicha" name="annoFicha"
                                                class="form-control form-control-luxury no-select2">
                                            <option value="">Seleccione un año</option>
                                            {% set annoActual = "now"|date("Y") %}
                                            {% set annoInicial = annoActual - 5 %}
                                            {% for anno in annoActual..annoInicial %}
                                                <option value="{{ anno }}" {% if anno == fil_anno  %} selected {% endif %}>
                                                    {{ anno }}
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <table class="table config-table table-bordered table-striped dataTable">
                <thead>
                <tr>
                    <th>No.</th>
                    <th>Institución</th>
                    <th class="text-center">Opciones</th>
                </tr>
                <tr>
                    <th></th>
                    <th><select class="responsive-input no-select2"><option value="">Todas las instituciones</option>{% for item in registros %}<option value="{{ item.nombre }}">{{ item.nombre }}</option>{% endfor %}</select></th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {% for item in registros %}
                    <tr>
                        <td width="1%">{{ loop.index }}</td>
                        <td>{{ item.nombre | default('') }}</td>
                        <td width="5%" class="text-center">
                            <button class="btn-lux-sm btn-lux-primary modalDetailAction"
                                    title="Detalles"
                                    data-url="{{ path('app_rrhh_reporte_ae2_consolidado_detail', {'id' : item.id}) }}"
                                    data-title="Detalles">
                                <i class="fa fa-eye"></i> Ver
                            </button>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
{% block javascripts %}
    {{ parent() }}
    <script>
        $('#mesFicha, #annoFicha').change(function (e) {
            var mes = $('#mesFicha').val();
            var anno = $('#annoFicha').val();
            HoldOn.open({
                theme: "sk-cube-grid",
                message: 'Por favor espere...',
                textColor: "white"
            });
            $.post("{{ path('app_rrhh_reporte_ae2_consolidado_index') }}",
                {
                    mes: mes,
                    anno: anno
                },
                function (data) {
                    $(window).attr('location', window.location)
                    HoldOn.close()
                });
        });
    </script>
{% endblock %}
