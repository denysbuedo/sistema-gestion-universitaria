<div class="row g-4 mb-4">
    {# Fila 1: Datos principales #}
    <div class="col-md-6">
        <label class="text-muted small text-uppercase fw-bold mb-1 d-block border-bottom pb-1">Nombre</label>
        <p class="fs-6 fw-medium text-dark">{{ item.nombre | default('N/A') }}</p>
    </div>

    <div class="col-md-3">
        <label class="text-muted small text-uppercase fw-bold mb-1 d-block border-bottom pb-1">Duración</label>
        <p class="fs-6 text-dark">{{ item.duracion | default('No definida') }}</p>
    </div>

    <div class="col-md-3">
        <label class="text-muted small text-uppercase fw-bold mb-1 d-block border-bottom pb-1">Estado</label>
        <p class="fs-6">
            {% if '1' == item.activo %}
                <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle px-3">
                    <i class="fas fa-check-circle me-1"></i> Habilitado
                </span>
            {% else %}
                <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle px-3">
                    <i class="fas fa-times-circle me-1"></i> Deshabilitado
                </span>
            {% endif %}
        </p>
    </div>

    {# Fila 2: Descripción (Ocupa todo el ancho para mejor lectura) #}
    <div class="col-12 mt-2">
        <div class="p-3 bg-light rounded-3 border-start border-primary border-4">
            <label class="text-muted small text-uppercase fw-bold mb-1 d-block">Descripción</label>
            <p class="mb-0 text-secondary" style="line-height: 1.5;">
                {{ item.descripcion | default('Sin descripción disponible.') }}
            </p>
        </div>
    </div>
</div>