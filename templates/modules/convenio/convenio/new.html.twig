{% extends 'baseAdmin.html.twig' %}

{% block title %}Adicionar Instrumento Jurídico{% endblock %}

{% block body %}
<style>
    .card-luxury {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        border-top: 4px solid #134679;
        margin-bottom: 1.5rem;
    }
    .card-luxury .card-header {
        background-color: #fff;
        border-bottom: 1px solid #f1f5f9;
        padding: 15px 24px;
    }
    .card-luxury .card-title { color: #1a2e44; font-weight: 700; font-size: 1rem; margin: 0; }
    .label-icon { color: #134679; margin-right: 6px; opacity: 0.8; }

    .form-label {
        font-size: 0.85rem;
        font-weight: 700;
        color: #4a5568;
        margin-bottom: 8px;
    }
    .form-control {
        border-radius: 8px;
        border: 1px solid #e2e8f0;
        padding: 0.6rem 0.75rem;
        font-size: 0.9rem;
    }
    .form-control:focus {
        border-color: #134679;
        box-shadow: 0 0 0 3px rgba(19, 70, 121, 0.1);
    }
    
    .input-group-text {
        background-color: #f8fafc;
        border-color: #e2e8f0;
        color: #134679;
        border-radius: 8px 0 0 8px !important;
    }
    .input-group .form-control { border-radius: 0 8px 8px 0 !important; }

    .section-divider {
        border-bottom: 2px solid #f1f5f9;
        margin: 1.5rem 0;
        padding-bottom: 0.5rem;
        color: #134679;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* ── Compact Buttons ── */
    .btn-lux-sm {
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.75rem;
        transition: all 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-transform: uppercase;
        text-decoration: none;
        cursor: pointer;
    }
    .btn-lux-primary { background: #134679; color: #fff !important; }
    .btn-lux-primary:hover { background: #0f3560; }
    .btn-lux-outline-danger { background: #fff; border: 1px solid #fecaca; color: #dc2626 !important; }
    .btn-lux-outline-danger:hover { background: #fff5f5; border-color: #feb2b2; }

    .estado-toggle { display:inline-flex; border-radius:20px; background:#f1f5f9; padding:3px; gap:2px; }
    .et-opt { padding:4px 14px; border-radius:20px; border:none; font-size:0.75rem; font-weight:700;
              cursor:pointer; background:transparent; color:#94a3b8; display:inline-flex;
              align-items:center; gap:5px; transition:all .18s; letter-spacing:.3px; }
    .et-opt i { font-size:0.42rem; vertical-align:middle; }
    .et-opt.et-on.active  { background:#dcfce7; color:#15803d; }
    .et-opt.et-off.active { background:#fee2e2; color:#b91c1c; }
    .et-opt:not(.active):hover { color:#64748b; }

    .custom-file-label { border-radius: 8px; border-color: #e2e8f0; }
    .custom-file-input:focus ~ .custom-file-label { border-color: #134679; box-shadow: 0 0 0 3px rgba(19, 70, 121, 0.1); }
</style>

    <div class="card card-luxury">
        <div class="card-header">
            <h3 class="card-title text-bold"><i class="fas fa-file-signature label-icon"></i>Adicionar Instrumento Jurídico</h3>
        </div>
        
        {{ form_start(form) }}
        <div class="card-body p-4">
            <div class="section-divider"><i class="fas fa-info-circle mr-2"></i>Información General</div>
            <div class="row">
                <div class="col-md-12 form-group">
                    {{ form_label(form.nombre, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.nombre, {'attr': {'class': 'form-control', 'placeholder': 'Nombre descriptivo del instrumento jurídico'}}) }}
                    {{ form_errors(form.nombre) }}
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-4 form-group">
                    {{ form_label(form.modalidad, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.modalidad, {'attr': {'class': 'form-control select2'}}) }}
                    {{ form_errors(form.modalidad) }}
                </div>
                <div class="col-md-4 form-group">
                    {{ form_label(form.tipo, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.tipo, {'attr': {'class': 'form-control select2'}}) }}
                    {{ form_errors(form.tipo) }}
                </div>
                <div id="ip_active" class="col-md-4 form-group">
                    <label class="form-label d-block"><i class="fas fa-toggle-on label-icon"></i>Estado</label>
                    <input type="checkbox"
                           id="{{ form.activo.vars.id }}"
                           name="{{ form.activo.vars.full_name }}"
                           class="d-none activo-checkbox"
                           {% if form.activo.vars.data %}checked{% endif %}>
                    <div class="estado-toggle" data-cb="{{ form.activo.vars.id }}">
                        <button type="button" class="et-opt et-on{% if form.activo.vars.data %} active{% endif %}">
                            <i class="fas fa-circle"></i> Habilitado
                        </button>
                        <button type="button" class="et-opt et-off{% if not form.activo.vars.data %} active{% endif %}">
                            <i class="fas fa-circle"></i> Deshabilitado
                        </button>
                    </div>
                </div>
            </div>

            <div class="section-divider mt-4"><i class="fas fa-university mr-2"></i>Instituciones y Ubicación</div>
            <div class="row">
                <div class="col-md-6 form-group">
                    {{ form_label(form.institucionCubana, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.institucionCubana, {'attr': {'class': 'form-control select2'}}) }}
                    {{ form_errors(form.institucionCubana) }}
                </div>
                <div class="col-md-6 form-group">
                    {{ form_label(form.institucionExtranjera, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.institucionExtranjera, {'attr': {'class': 'form-control select2'}}) }}
                    {{ form_errors(form.institucionExtranjera) }}
                </div>
            </div>
            <div class="row mt-2">
                <div class="col-md-6 form-group">
                    {{ form_label(form.region, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.region, {'attr': {'class': 'form-control select2'}}) }}
                    {{ form_errors(form.region) }}
                </div>
                <div class="col-md-6 form-group">
                    {{ form_label(form.pais, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.pais, {'attr': {'class': 'form-control select2'}}) }}
                    {{ form_errors(form.pais) }}
                </div>
            </div>

            <div class="section-divider mt-4"><i class="fas fa-calendar-check mr-2"></i>Vigencia y Documentación</div>
            <div class="row">
                <div class="col-md-4 form-group">
                    {{ form_label(form.fechaSuscribe, null, {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        {{ form_widget(form.fechaSuscribe, {'attr': {'class': 'form-control datetimepicker-input'}}) }}
                    </div>
                    {{ form_errors(form.fechaSuscribe) }}
                </div>
                <div class="col-md-4 form-group">
                    {{ form_label(form.fechaCaducidad, null, {'label_attr': {'class': 'form-label'}}) }}
                    <div class="input-group">
                        <div class="input-group-prepend">
                            <span class="input-group-text"><i class="far fa-calendar-alt"></i></span>
                        </div>
                        {{ form_widget(form.fechaCaducidad, {'attr': {'class': 'form-control datetimepicker-input'}}) }}
                    </div>
                    {{ form_errors(form.fechaCaducidad) }}
                </div>
                <div class="col-md-4 form-group" id="div_doc">
                    {{ form_label(form.documento, null, {'label_attr': {'class': 'form-label'}}) }}
                    <div class="custom-file">
                        {{ form_widget(form.documento, {'attr': {'class': 'custom-file-input'}}) }}
                        <label class="custom-file-label" for="convenio_documento">Seleccionar archivo...</label>
                    </div>
                    {{ form_errors(form.documento) }}
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12 form-group">
                    {{ form_label(form.descripcion, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.descripcion, {'attr': {'class': 'form-control', 'rows': '4'}}) }}
                    {{ form_errors(form.descripcion) }}
                </div>
            </div>
        </div>
        <div class="card-footer bg-white p-4 d-flex justify-content-end gap-3" style="gap: 10px;">
            <a class="btn-lux-sm btn-lux-outline-danger mr-2 btn-cancel" 
               data-url="{{ path('app_convenio_index') }}" 
               data-title="Cancelar"
               data-content="¿Está seguro que desea cancelar la operación?">
               <i class="fas fa-times"></i> Cancelar
            </a>
            <button type="submit" class="btn-lux-sm btn-lux-primary">
                <i class="fas fa-check"></i> Aceptar
            </button>
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        $(document).ready(function() {
            // Pill toggle activo/desactivo
            $(document).on('click', '.estado-toggle .et-opt', function() {
                var $toggle = $(this).closest('.estado-toggle');
                var cbId    = $toggle.data('cb');
                var isOn    = $(this).hasClass('et-on');
                $toggle.find('.et-opt').removeClass('active');
                $(this).addClass('active');
                $('#' + cbId).prop('checked', isOn);
            });


            $('#ip_active').hide();
            
            $('#convenio_documento').change(function () {
                var filename = jQuery(this).val().split('\\').pop();
                $(this).next('.custom-file-label').html(filename);
            });

            $('#convenio_fechaSuscribe').datetimepicker({ format: 'DD/MM/YYYY' });
            $('#convenio_fechaCaducidad').datetimepicker({ format: 'DD/MM/YYYY' });

            $('#convenio_pais').on('change', function () {
                if ($(this).val() != "") {
                    HoldOn.open({ theme: "sk-cube-grid", message: 'Cargando instituciones...', textColor: "white" });
                    var url = "{{ path('app_institucion_extranjera_institucion_dado_pais', {'id':'idP'}) }}";
                    url = url.replace('idP', $(this).val());
                    $.get(url, function (data) {
                        $('#convenio_institucionExtranjera option').remove();
                        $('#convenio_institucionExtranjera').append(new Option('Seleccione', ""));
                        for (var i = 0; i < data.length; i++) {
                            $('#convenio_institucionExtranjera').append(new Option(data[i].nombre, data[i].id));
                        }
                        HoldOn.close()
                    });
                }
            });

            $('#div_doc').hide();
            $('#convenio_institucionCubana').on('change', function () {
                if ($(this).val() == 3) { $('#div_doc').show(); } else { $('#div_doc').hide(); }
            });



            $('#convenio_modalidad').on('change', function () {
                if ($(this).val() == 5) {
                    $('#ip_active').show();
                    // Activar pill "Habilitado"
                    var $toggle = $('.estado-toggle[data-cb="{{ form.activo.vars.id }}"]');
                    $toggle.find('.et-opt').removeClass('active');
                    $toggle.find('.et-on').addClass('active');
                    $('#{{ form.activo.vars.id }}').prop('checked', true);
                } else {
                    $('#ip_active').hide();
                    // Activar pill "Deshabilitado"
                    var $toggle = $('.estado-toggle[data-cb="{{ form.activo.vars.id }}"]');
                    $toggle.find('.et-opt').removeClass('active');
                    $toggle.find('.et-off').addClass('active');
                    $('#{{ form.activo.vars.id }}').prop('checked', false);
                }
            });
            
            // Re-trigger events for initial state
            $('#convenio_institucionCubana').trigger('change');
            $('#convenio_modalidad').trigger('change');
        });
    </script>
{% endblock %}