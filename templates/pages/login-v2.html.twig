<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Acceso | SGU Akademos</title>

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('assets/fontawesome-free/css/all.min.css') }}">
    <style>
        :root {
            --sgu-navy: #102f4f;
            --sgu-navy-dark: #0b2036;
            --sgu-blue: #1769aa;
            --sgu-canvas: #f4f7f9;
            --sgu-border: #dce5ec;
            --sgu-text: #243746;
            --sgu-muted: #657786;
            --sgu-white: #fff;
            --sgu-danger: #a52c38;
            --sgu-focus: #f0b429;
        }

        *, *::before, *::after { box-sizing: border-box; }
        html, body { min-height: 100%; margin: 0; overflow-x: hidden; }
        body {
            min-height: 100vh;
            background: var(--sgu-canvas);
            color: var(--sgu-text);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        }

        .login-layout { display: grid; grid-template-columns: minmax(340px, 42%) 1fr; min-height: 100vh; }
        .login-brand {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: clamp(36px, 5vw, 72px);
            background: var(--sgu-navy);
            color: var(--sgu-white);
        }
        .brand-kicker { font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; opacity: .72; }
        .brand-title { max-width: 560px; margin: 24px 0 18px; font-size: clamp(34px, 4.5vw, 58px); line-height: 1.06; font-weight: 650; letter-spacing: -.035em; }
        .brand-copy { max-width: 530px; margin: 0; font-size: 16px; line-height: 1.65; color: rgba(255,255,255,.76); }
        .brand-footer { padding-top: 48px; font-size: 13px; color: rgba(255,255,255,.62); }

        .login-main { display: flex; align-items: center; justify-content: center; padding: 40px 24px; }
        .login-panel { width: 100%; max-width: 430px; }
        .mobile-brand { display: none; margin-bottom: 34px; color: var(--sgu-navy); font-size: 13px; font-weight: 750; letter-spacing: .1em; text-transform: uppercase; }
        .login-header { margin-bottom: 30px; }
        .login-header h1 { margin: 0 0 9px; color: var(--sgu-navy); font-size: 29px; line-height: 1.2; font-weight: 680; letter-spacing: -.02em; }
        .login-header p { margin: 0; color: var(--sgu-muted); font-size: 14px; line-height: 1.55; }

        .alert-error { display: flex; gap: 10px; margin-bottom: 20px; padding: 12px 14px; border: 1px solid #e7c5c8; border-radius: 5px; background: #fff7f7; color: #7c202a; font-size: 13px; line-height: 1.45; }
        .alert-error i { margin-top: 2px; color: var(--sgu-danger); }
        .form-group { margin-bottom: 18px; }
        .form-group label { display: block; margin-bottom: 7px; color: var(--sgu-text); font-size: 13px; font-weight: 650; }
        .input-wrap { position: relative; }
        .input-icon { position: absolute; top: 50%; left: 14px; transform: translateY(-50%); color: #8193a2; font-size: 14px; pointer-events: none; }
        .form-control { width: 100%; min-height: 46px; padding: 10px 14px 10px 41px; border: 1px solid var(--sgu-border); border-radius: 5px; outline: none; background: var(--sgu-white); color: var(--sgu-text); font: inherit; font-size: 14px; transition: border-color .15s, box-shadow .15s; }
        .form-control:focus { border-color: var(--sgu-blue); box-shadow: 0 0 0 3px rgba(23,105,170,.12); }
        .form-control.has-toggle { padding-right: 45px; }
        .password-toggle { position: absolute; top: 1px; right: 1px; bottom: 1px; width: 43px; border: 0; border-radius: 0 4px 4px 0; background: transparent; color: #6e8292; cursor: pointer; }
        .password-toggle:hover { color: var(--sgu-navy); }
        .password-toggle:focus-visible, .btn-primary:focus-visible, .btn-secondary:focus-visible { outline: 3px solid var(--sgu-focus); outline-offset: 2px; }
        .caps-warning { display: none; gap: 6px; align-items: center; margin-top: 7px; color: #76520c; font-size: 12px; }
        .caps-warning.visible { display: flex; }

        .btn-primary, .btn-secondary { display: flex; width: 100%; min-height: 46px; align-items: center; justify-content: center; gap: 9px; padding: 11px 18px; border-radius: 5px; font: inherit; font-size: 14px; font-weight: 680; text-decoration: none; cursor: pointer; transition: background .15s, border-color .15s; }
        .btn-primary { border: 1px solid var(--sgu-navy); background: var(--sgu-navy); color: var(--sgu-white); }
        .btn-primary:hover { border-color: var(--sgu-navy-dark); background: var(--sgu-navy-dark); color: var(--sgu-white); text-decoration: none; }
        .btn-primary:disabled { opacity: .7; cursor: wait; }
        .btn-secondary { border: 1px solid var(--sgu-navy); background: var(--sgu-white); color: var(--sgu-navy); }
        .btn-secondary:hover { background: #eef3f7; color: var(--sgu-navy); text-decoration: none; }
        .btn-spinner { display: none; }
        .loading .btn-spinner { display: inline-block; animation: spin .65s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }

        .access-divider { display: flex; align-items: center; gap: 12px; margin: 24px 0; color: #7d8d99; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
        .access-divider::before, .access-divider::after { content: ""; height: 1px; flex: 1; background: var(--sgu-border); }
        .login-meta { margin-top: 30px; padding-top: 20px; border-top: 1px solid var(--sgu-border); color: var(--sgu-muted); font-size: 12px; line-height: 1.6; }
        .login-meta a { color: var(--sgu-navy); font-weight: 650; text-decoration: none; }
        .login-meta a:hover { text-decoration: underline; }

        @media (max-width: 800px) {
            .login-layout { display: flex; min-height: 100dvh; flex-direction: column; background: var(--sgu-white); }
            .login-brand { display: block; padding: 24px 22px; }
            .brand-kicker { font-size: 11px; }
            .brand-title { margin: 8px 0 0; font-size: 23px; line-height: 1.2; letter-spacing: -.02em; }
            .brand-copy, .brand-footer { display: none; }
            .login-main { display: block; min-height: 0; padding: 28px 22px 36px; background: var(--sgu-white); }
            .login-panel { max-width: none; }
            .mobile-brand { display: none; }
            .login-header { margin-bottom: 24px; }
            .login-header h1 { font-size: 25px; }
            .login-meta { margin-top: 24px; }
        }
        @media (max-width: 480px) {
            .login-brand { padding: 20px 18px; }
            .login-main { padding: 24px 18px 30px; }
            .form-control { min-height: 48px; font-size: 16px; }
            .btn-primary, .btn-secondary { min-height: 48px; padding-left: 12px; padding-right: 12px; font-size: 13px; }
            .access-divider { margin: 20px 0; }
        }
        @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition: none !important; animation: none !important; } }
    </style>
{% endblock %}

{% block body %}
    <main class="login-layout">
        <section class="login-brand" aria-label="Sistema de Gestión Universitaria">
            <div>
                <div class="brand-kicker">SGU · Akademos</div>
                <h1 class="brand-title">Sistema de Gestión Universitaria</h1>
                <p class="brand-copy">Plataforma institucional para la gestión integrada de los procesos académicos y administrativos de la educación superior.</p>
            </div>
            <div class="brand-footer">Ministerio de Educación Superior</div>
        </section>

        <section class="login-main">
            <div class="login-panel">
                <div class="mobile-brand">SGU · Akademos</div>
                <header class="login-header">
                    <h1>Acceso al sistema</h1>
                    <p>Identifíquese para continuar a su espacio de trabajo.</p>
                </header>

                {% if error %}
                    <div class="alert-error" role="alert"><i class="fas fa-exclamation-circle" aria-hidden="true"></i><span>Credenciales inválidas. Verifique su correo y contraseña.</span></div>
                {% endif %}
                {% for message in app.flashes('error') %}
                    <div class="alert-error" role="alert"><i class="fas fa-exclamation-circle" aria-hidden="true"></i><span>{{ message }}</span></div>
                {% endfor %}

                {% if oidc_enabled %}
                    <a href="{{ path('oidc_login') }}" class="btn-primary">
                        <i class="fas fa-shield-alt" aria-hidden="true"></i>
                        <span>Continuar con identidad institucional</span>
                    </a>
                    <div class="access-divider">Acceso local</div>
                {% endif %}

                <form method="post" autocomplete="off" id="login-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <div class="form-group">
                        <label for="inputEmail">Correo electrónico</label>
                        <div class="input-wrap">
                            <i class="fas fa-envelope input-icon" aria-hidden="true"></i>
                            <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="usuario@dominio.cu">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="inputPassword">Contraseña</label>
                        <div class="input-wrap">
                            <i class="fas fa-lock input-icon" aria-hidden="true"></i>
                            <input type="password" name="password" id="inputPassword" class="form-control has-toggle" autocomplete="current-password" required placeholder="Contraseña">
                            <button type="button" class="password-toggle" id="passwordToggle" aria-label="Mostrar contraseña" aria-pressed="false">
                                <i class="far fa-eye" id="toggleIcon" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="caps-warning" id="capsWarning"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i>Bloq Mayús activado</div>
                    </div>
                    <button type="submit" class="btn-secondary" id="submitBtn">
                        <i class="fas fa-circle-notch btn-spinner" aria-hidden="true"></i>
                        <span class="btn-label">Entrar con cuenta local</span>
                    </button>
                </form>

                <footer class="login-meta">
                    Soporte: <a href="mailto:soporte@mes.gob.cu">soporte@mes.gob.cu</a><br>
                    &copy; {{ "now"|date("Y") }} Universidad de las Ciencias Informáticas
                </footer>
            </div>
        </section>
    </main>
{% endblock %}

{% block javascripts %}
<script>
    (function () {
        var passInput = document.getElementById('inputPassword');
        var toggleBtn = document.getElementById('passwordToggle');
        var toggleIcon = document.getElementById('toggleIcon');
        toggleBtn.addEventListener('click', function () {
            var show = passInput.type === 'password';
            passInput.type = show ? 'text' : 'password';
            toggleBtn.setAttribute('aria-pressed', show ? 'true' : 'false');
            toggleBtn.setAttribute('aria-label', show ? 'Ocultar contraseña' : 'Mostrar contraseña');
            toggleIcon.classList.toggle('fa-eye', !show);
            toggleIcon.classList.toggle('fa-eye-slash', show);
        });
        var capsWarn = document.getElementById('capsWarning');
        function checkCaps(event) {
            if (typeof event.getModifierState === 'function') capsWarn.classList.toggle('visible', event.getModifierState('CapsLock'));
        }
        passInput.addEventListener('keydown', checkCaps);
        passInput.addEventListener('keyup', checkCaps);
        document.getElementById('login-form').addEventListener('submit', function () {
            var btn = document.getElementById('submitBtn');
            btn.classList.add('loading');
            btn.disabled = true;
        });
    })();
</script>
{% endblock %}
