{# Estilos compartidos para vistas de detalle: detail-section, detail-field, detail-badge #}
<style>
    .detail-section {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }
    .detail-section .detail-section-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 12px 20px;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .detail-section .detail-section-header i { color: #134679; }
    .detail-section .detail-section-header h3 {
        margin: 0;
        font-size: 0.9rem;
        font-weight: 700;
        color: #1a2e44;
        text-transform: uppercase;
        letter-spacing: .3px;
    }
    .detail-section .detail-section-body { padding: 20px; }

    .detail-field { margin-bottom: 14px; }
    .detail-field:last-child { margin-bottom: 0; }
    .detail-field .detail-label {
        display: block;
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: #94a3b8;
        margin-bottom: 3px;
    }
    .detail-field .detail-value {
        font-size: 0.92rem;
        color: #1a2e44;
        font-weight: 600;
    }
    .detail-field .detail-value.text-muted-value { color: #94a3b8; font-weight: 400; font-style: italic; }

    .detail-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: .3px;
    }
    .detail-badge.-success { background: #dcfce7; color: #15803d; }
    .detail-badge.-danger  { background: #fee2e2; color: #b91c1c; }

    .detail-table th {
        background: #f1f5f9;
        color: #4a5568;
        font-size: 0.78rem;
        font-weight: 700;
        border-color: #e2e8f0;
        padding: 8px 10px;
    }
    .detail-table td {
        font-size: 0.85rem;
        color: #1a2e44;
        border-color: #e2e8f0;
        padding: 7px 10px;
        vertical-align: middle;
    }
</style>
