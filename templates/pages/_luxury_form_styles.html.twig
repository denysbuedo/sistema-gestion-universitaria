{# Estilos compartidos para formularios "luxury": card-luxury, form-control-luxury, toggle de estado, btn-lux #}
<style>
    .card-luxury {
        border-radius: 12px;
        border: none;
        box-shadow: none;
        border-top: 4px solid #134679;
        margin-bottom: 2rem;
    }
    .card-luxury .card-header {
        background-color: #fff;
        border-bottom: 1px solid #f1f5f9;
        padding: 15px 24px;
    }
    .card-luxury .card-title { color: #1a2e44; font-weight: 700; font-size: 1rem; }

    .form-group label {
        color: #4a5568;
        font-weight: 600;
        margin-bottom: 0.4rem;
        display: block;
        font-size: 0.85rem;
    }
    .label-icon { color: #134679; margin-right: 6px; opacity: 0.8; }

    label.required::after { content: '*'; color: #ef4444; margin-left: 4px; }

    .form-control-luxury {
        border-radius: 8px;
        border: 1.5px solid #e2e8f0;
        padding: 8px 12px;
        transition: all 0.2s;
        font-size: 0.85rem;
    }
    .form-control-luxury:focus {
        border-color: #134679;
        box-shadow: 0 0 0 3px rgba(19,70,121,0.08);
        outline: none;
    }
    .is-invalid-luxury { border-color: #ef4444 !important; background-color: #fffafb; }
    .invalid-feedback-luxury { color: #ef4444; font-size: 0.7rem; font-weight: 600; margin-top: 4px; display: block; }

    .estado-toggle {
        display: inline-flex;
        border-radius: 20px;
        background: #f1f5f9;
        padding: 3px;
        gap: 2px;
    }
    .et-opt {
        padding: 4px 14px;
        border-radius: 20px;
        border: none;
        font-size: 0.75rem;
        font-weight: 700;
        cursor: pointer;
        background: transparent;
        color: #94a3b8;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all .18s;
        letter-spacing: .3px;
    }
    .et-opt i { font-size: 0.42rem; vertical-align: middle; }
    .et-opt.et-on.active  { background: #dcfce7; color: #15803d; }
    .et-opt.et-off.active { background: #fee2e2; color: #b91c1c; }
    .et-opt:not(.active):hover { color: #64748b; }

    .btn-lux-sm {
        padding: 6px 14px;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.75rem;
        transition: all 0.2s;
        border: none;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        text-transform: uppercase;
    }
    .btn-lux-primary { background: #134679; color: #fff; }
    .btn-lux-outline-danger { background: #fff; border: 1px solid #fecaca; color: #dc2626; }
</style>
