<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio — AKADEMOS</title>
    <link rel="stylesheet" href="{{ asset('assets/fontawesome-free/css/all.min.css') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --brand:        #0e375f;
            --brand-mid:    #134679;
            --brand-dark:   #071e3d;
            --brand-light:  #1a5898;
            --surface:      #f1f5f9;
            --white:        #ffffff;
            --text-main:    #1a2e44;
            --text-sub:     #64748b;
            --text-muted:   #94a3b8;
            --border:       #e2e8f0;
            --shadow-sm:    0 1px 3px rgba(0,0,0,.08), 0 1px 2px rgba(0,0,0,.05);
            --shadow-md:    0 4px 16px rgba(0,0,0,.10), 0 2px 6px rgba(0,0,0,.06);
            --shadow-lg:    0 10px 30px rgba(0,0,0,.12), 0 4px 10px rgba(0,0,0,.07);
            --radius:       14px;
            --transition:   .22s cubic-bezier(0.4, 0, 0.2, 1);
        }

        html, body { height: 100%; }
        body {
            font-family: 'Inter', sans-serif;
            background: var(--surface);
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* ═══════════════════════════════════════
           NAVBAR
        ═══════════════════════════════════════ */
        .navbar {
            height: 58px;
            background: var(--white);
            border-bottom: 1px solid var(--border);
            box-shadow: var(--shadow-sm);
            display: flex;
            align-items: center;
            padding: 0 28px;
            gap: 20px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }
        .nav-brand-icon {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, var(--brand) 0%, var(--brand-light) 100%);
            border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            color: #fff;
            font-size: 15px;
            box-shadow: 0 2px 8px rgba(14,55,95,.35);
        }
        .nav-brand-name {
            font-size: 16px;
            font-weight: 700;
            color: var(--brand);
            letter-spacing: .5px;
        }

        .nav-spacer { flex: 1; }

        .nav-user {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .nav-user-avatar {
            width: 34px; height: 34px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--border);
        }
        .nav-user-info { line-height: 1.3; }
        .nav-user-name  { font-size: 13px; font-weight: 600; color: var(--text-main); }
        .nav-user-role  { font-size: 11px; color: var(--text-muted); }

        .nav-divider { width: 1px; height: 28px; background: var(--border); }

        .btn-logout {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            background: none;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--text-sub);
            text-decoration: none;
            transition: var(--transition);
            cursor: pointer;
        }
        .btn-logout:hover {
            border-color: #fca5a5;
            color: #dc2626;
            background: #fff5f5;
        }

        /* ═══════════════════════════════════════
           HERO
        ═══════════════════════════════════════ */
        .hero {
            background: linear-gradient(135deg, var(--brand-dark) 0%, var(--brand) 55%, var(--brand-light) 100%);
            padding: 36px 40px;
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
        }
        .hero::before {
            content: '';
            position: absolute;
            width: 400px; height: 400px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(255,255,255,.07) 0%, transparent 70%);
            top: -150px; right: -80px;
            pointer-events: none;
        }
        .hero::after {
            content: '';
            position: absolute;
            width: 200px; height: 200px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(43,125,233,.12) 0%, transparent 70%);
            bottom: -60px; left: 30%;
            pointer-events: none;
        }
        .hero-dot-grid {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1px);
            background-size: 24px 24px;
            pointer-events: none;
        }
        .hero-inner {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            max-width: 1280px;
            margin: 0 auto;
        }
        .hero-greeting-tag {
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: rgba(255,255,255,.55);
            margin-bottom: 6px;
        }
        .hero-name {
            font-size: 24px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 5px;
            line-height: 1.2;
        }
        .hero-subtitle {
            font-size: 13px;
            color: rgba(255,255,255,.6);
        }
        .hero-clock { text-align: right; flex-shrink: 0; }
        .hero-time {
            font-size: 32px;
            font-weight: 700;
            color: #fff;
            letter-spacing: 1px;
            line-height: 1;
        }
        .hero-date {
            font-size: 12.5px;
            color: rgba(255,255,255,.6);
            margin-top: 4px;
            text-transform: capitalize;
        }

        /* ═══════════════════════════════════════
           CONTENIDO PRINCIPAL
        ═══════════════════════════════════════ */
        .main {
            flex: 1;
            padding: 32px 40px 40px;
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            align-self: stretch;
        }

        /* ═══════════════════════════════════════
           SEPARADOR DE SECCIÓN
        ═══════════════════════════════════════ */
        .section-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 18px;
        }
        .section-header:not(:first-child) { margin-top: 36px; }

        .section-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            white-space: nowrap;
        }
        .section-line {
            flex: 1;
            height: 1px;
            background: var(--border);
        }

        /* ═══════════════════════════════════════
           GRID DE MÓDULOS PRIMARIOS
        ═══════════════════════════════════════ */
        .modules-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 18px;
        }

        /* Tarjeta base */
        .mod-card {
            background: var(--white);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            padding: 24px 22px 20px;
            text-decoration: none;
            color: var(--text-main);
            display: flex;
            flex-direction: column;
            gap: 14px;
            position: relative;
            overflow: hidden;
            transition: var(--transition);
        }
        .mod-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--mod-color, var(--brand));
            border-radius: var(--radius) var(--radius) 0 0;
        }
        .mod-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lg);
            border-color: transparent;
            text-decoration: none;
            color: var(--text-main);
        }

        /* Mancha decorativa */
        .mod-card-bg {
            position: absolute;
            width: 120px; height: 120px;
            border-radius: 50%;
            bottom: -40px; right: -30px;
            background: radial-gradient(circle, var(--mod-color, var(--brand)) 0%, transparent 70%);
            opacity: .06;
            pointer-events: none;
        }

        .mod-icon-wrap {
            width: 46px; height: 46px;
            border-radius: 12px;
            background: color-mix(in srgb, var(--mod-color, var(--brand)) 12%, transparent);
            display: flex; align-items: center; justify-content: center;
            font-size: 20px;
            color: var(--mod-color, var(--brand));
            flex-shrink: 0;
        }

        .mod-body { flex: 1; }
        .mod-name {
            font-size: 15px;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 4px;
            line-height: 1.2;
        }
        .mod-desc {
            font-size: 12px;
            color: var(--text-sub);
            line-height: 1.5;
        }

        /* Footer tarjeta simple (módulos directos) */
        .mod-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding-top: 12px;
            border-top: 1px solid var(--border);
        }
        .mod-arrow {
            width: 28px; height: 28px;
            border-radius: 8px;
            background: var(--surface);
            display: flex; align-items: center; justify-content: center;
            font-size: 12px;
            color: var(--text-muted);
            transition: var(--transition);
        }
        .mod-card:hover .mod-arrow {
            background: var(--mod-color, var(--brand));
            color: #fff;
        }



        /* ═══════════════════════════════════════
           GRID DE HERRAMIENTAS (secundario)
        ═══════════════════════════════════════ */
        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: 12px;
        }

        .tool-card {
            background: var(--white);
            border-radius: 10px;
            box-shadow: var(--shadow-sm);
            border: 1px solid var(--border);
            padding: 14px 16px;
            text-decoration: none;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 12px;
            position: relative;
            overflow: hidden;
            transition: var(--transition);
        }
        .tool-card::before {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 2px;
            background: var(--mod-color, var(--text-muted));
        }
        .tool-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            border-color: transparent;
            text-decoration: none;
            color: var(--text-main);
        }
        .tool-icon {
            width: 36px; height: 36px;
            border-radius: 9px;
            background: color-mix(in srgb, var(--mod-color, var(--text-muted)) 12%, transparent);
            display: flex; align-items: center; justify-content: center;
            font-size: 15px;
            color: var(--mod-color, var(--text-muted));
            flex-shrink: 0;
        }
        .tool-info { flex: 1; min-width: 0; }
        .tool-name {
            font-size: 13px;
            font-weight: 600;
            color: var(--text-main);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .tool-desc {
            font-size: 11px;
            color: var(--text-muted);
            margin-top: 1px;
        }
        .tool-arrow {
            font-size: 10px;
            color: var(--text-muted);
            transition: var(--transition);
            flex-shrink: 0;
        }
        .tool-card:hover .tool-arrow {
            color: var(--mod-color, var(--brand));
            transform: translateX(2px);
        }

        /* ── Estado vacío ── */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-muted);
        }
        .empty-state i { font-size: 2.5rem; margin-bottom: 14px; opacity: .4; }
        .empty-state p { font-size: 14px; }

        /* ═══════════════════════════════════════
           FOOTER
        ═══════════════════════════════════════ */
        .page-footer {
            text-align: center;
            padding: 16px;
            font-size: 11.5px;
            color: var(--text-muted);
            border-top: 1px solid var(--border);
            background: var(--white);
        }
        .page-footer a { color: var(--text-muted); text-decoration: none; }
        .page-footer a:hover { color: var(--brand); }

        /* ═══════════════════════════════════════
           FALLBACK color-mix
        ═══════════════════════════════════════ */
        @supports not (background: color-mix(in srgb, red 10%, transparent)) {
            .mod-icon-wrap  { background: rgba(14,55,95,.10); }
            .tool-icon      { background: rgba(14,55,95,.10); }
        }

        /* ═══════════════════════════════════════
           RESPONSIVE
        ═══════════════════════════════════════ */
        @media (max-width: 768px) {
            .hero           { padding: 24px 20px; }
            .hero-clock     { display: none; }
            .main           { padding: 22px 16px 32px; }
            .modules-grid   { grid-template-columns: 1fr 1fr; gap: 12px; }
            .tools-grid     { grid-template-columns: 1fr 1fr; gap: 10px; }
            .navbar         { padding: 0 16px; }
            .nav-user-info  { display: none; }
        }
        @media (max-width: 480px) {
            .modules-grid   { grid-template-columns: 1fr; }
            .tools-grid     { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

    <!-- ── Navbar ── -->
    <nav class="navbar">
        <a href="{{ path('home') }}" class="nav-brand">
            <div class="nav-brand-icon"><i class="fas fa-landmark"></i></div>
            <span class="nav-brand-name">AKADEMOS</span>
        </a>

        <div class="nav-spacer"></div>

        <div class="nav-user">
            <img class="nav-user-avatar"
                 src="{% if app.session.get('foto_usuario_autenticado') %}{{ app.request.getSchemeAndHttpHost() }}/uploads/images/personas/{{ app.session.get('foto_usuario_autenticado') }}{% else %}/assets/images/usuario.png{% endif %}"
                 alt="Avatar">
            <div class="nav-user-info">
                <div class="nav-user-name">{{ app.session.get('nombre_usuario_autenticado') ?? app.user.email }}</div>
                <div class="nav-user-role">{{ app.session.get('responsabilidad_usuario_autenticado') ?? 'Usuario' }}</div>
            </div>
        </div>

        <div class="nav-divider"></div>

        <a href="{{ path('app_logout') }}" class="btn-logout">
            <i class="fas fa-sign-out-alt"></i>
            <span>Salir</span>
        </a>
    </nav>

    <!-- ── Hero ── -->
    <div class="hero">
        <div class="hero-dot-grid"></div>
        <div class="hero-inner">
            <div>
                <div class="hero-greeting-tag">Bienvenido de nuevo</div>
                <div class="hero-name">{{ app.session.get('nombre_usuario_autenticado') ?? 'Usuario' }}</div>
                <div class="hero-subtitle">Sistema de Gestión Universitaria — MES</div>
            </div>
            <div class="hero-clock">
                <div class="hero-time" id="clock">--:--</div>
                <div class="hero-date" id="clock-date"></div>
            </div>
        </div>
    </div>

    <!-- ── Contenido ── -->
    <div class="main">

        {# ── Módulos principales ── #}
        <div class="section-header">
            <span class="section-label">Módulos</span>
            <div class="section-line"></div>
        </div>

        <div class="modules-grid">

            {% if hasRoles('ROLE_HOME_PREGR') %}
            <a href="{{ path('app_pregrado_portada') }}" class="mod-card" style="--mod-color:#3b82f6">
                <div class="mod-card-bg"></div>
                <div class="mod-icon-wrap"><i class="fas fa-graduation-cap"></i></div>
                <div class="mod-body">
                    <div class="mod-name">Pregrado</div>
                    <div class="mod-desc">Gestión académica de programas de pregrado</div>
                </div>
                <div class="mod-footer">
                    <div class="mod-arrow"><i class="fas fa-arrow-right"></i></div>
                </div>
            </a>
            {% endif %}

            {% if hasRoles('ROLE_HOME_POSTG') %}
            <a href="{{ path('app_postgrado_portada') }}" class="mod-card" style="--mod-color:#8b5cf6">
                <div class="mod-card-bg"></div>
                <div class="mod-icon-wrap"><i class="fas fa-university"></i></div>
                <div class="mod-body">
                    <div class="mod-name">Posgrado</div>
                    <div class="mod-desc">Maestrías, doctorados y programas de posgrado</div>
                </div>
                <div class="mod-footer">
                    <div class="mod-arrow"><i class="fas fa-arrow-right"></i></div>
                </div>
            </a>
            {% endif %}

            {% if hasRoles('ROLE_HOME_EVALUACION') %}
            <a href="{{ path('app_evaluacion_portada') }}" class="mod-card" style="--mod-color:#10b981">
                <div class="mod-card-bg"></div>
                <div class="mod-icon-wrap"><i class="fas fa-clipboard-check"></i></div>
                <div class="mod-body">
                    <div class="mod-name">Evaluación</div>
                    <div class="mod-desc">Evaluación del desempeño docente e institucional</div>
                </div>
                <div class="mod-footer">
                    <div class="mod-arrow"><i class="fas fa-arrow-right"></i></div>
                </div>
            </a>
            {% endif %}

            {# Tarjeta: Internacionalización #}
            {% if hasRoles('ROLE_HOME_TRAMITES') or hasRoles('ROLE_HOME_ECONOMIA') or hasRoles('ROLE_HOME_CONVENIO') %}
            <a href="{{ path('app_tramite_portada') }}" class="mod-card" style="--mod-color:#f59e0b">
                <div class="mod-card-bg"></div>
                <div class="mod-icon-wrap"><i class="fas fa-globe-americas"></i></div>
                <div class="mod-body">
                    <div class="mod-name">Internacionalización</div>
                    <div class="mod-desc">Gestión integral de la internacionalización universitaria</div>
                </div>
                <div class="mod-footer">
                    <div class="mod-arrow"><i class="fas fa-arrow-right"></i></div>
                </div>
            </a>
            {% endif %}

            {% if hasRoles('ROLE_HOME_INFORMATIZACION') %}
            <a href="{{ path('app_informatizacion_portada') }}" class="mod-card" style="--mod-color:#6366f1">
                <div class="mod-card-bg"></div>
                <div class="mod-icon-wrap"><i class="fas fa-laptop-code"></i></div>
                <div class="mod-body">
                    <div class="mod-name">Informatización</div>
                    <div class="mod-desc">Proyectos y procesos de informatización universitaria</div>
                </div>
                <div class="mod-footer">
                    <div class="mod-arrow"><i class="fas fa-arrow-right"></i></div>
                </div>
            </a>
            {% endif %}

            {% if hasRoles('ROLE_HOME_RRHH') %}
            <a href="{{ path('app_rrhh_portada') }}" class="mod-card" style="--mod-color:#ec4899">
                <div class="mod-card-bg"></div>
                <div class="mod-icon-wrap"><i class="fas fa-users"></i></div>
                <div class="mod-body">
                    <div class="mod-name">Recursos Humanos</div>
                    <div class="mod-desc">Gestión integral del capital humano institucional</div>
                </div>
                <div class="mod-footer">
                    <div class="mod-arrow"><i class="fas fa-arrow-right"></i></div>
                </div>
            </a>
            {% endif %}

        </div>

        {# ── Herramientas del sistema (módulos secundarios) ── #}
        {% if hasRoles('ROLE_HOME_PERSONAL') or hasRoles('ROLE_HOME_INSTIT') or hasRoles('ROLE_HOME_ADMIN') or hasRoles('ROLE_HOME_TRAZAS') %}
        <div class="section-header">
            <span class="section-label">Herramientas del sistema</span>
            <div class="section-line"></div>
        </div>

        <div class="tools-grid">

            {% if hasRoles('ROLE_HOME_PERSONAL') %}
            <a href="{{ path('app_personal_portada') }}" class="tool-card" style="--mod-color:#14b8a6">
                <div class="tool-icon"><i class="fas fa-user-tie"></i></div>
                <div class="tool-info">
                    <div class="tool-name">Personal</div>
                    <div class="tool-desc">Expedientes y datos del personal</div>
                </div>
                <i class="fas fa-chevron-right tool-arrow"></i>
            </a>
            {% endif %}

            {% if hasRoles('ROLE_HOME_INSTIT') %}
            <a href="{{ path('app_institucion_portada') }}" class="tool-card" style="--mod-color:#0ea5e9">
                <div class="tool-icon"><i class="fa fa-university"></i></div>
                <div class="tool-info">
                    <div class="tool-name">Instituciones</div>
                    <div class="tool-desc">Gestión de instituciones</div>
                </div>
                <i class="fas fa-chevron-right tool-arrow"></i>
            </a>
            {% endif %}

            {% if hasRoles('ROLE_HOME_ADMIN') %}
            <a href="{{ path('app_administracion_portada') }}" class="tool-card" style="--mod-color:#64748b">
                <div class="tool-icon"><i class="fas fa-cog"></i></div>
                <div class="tool-info">
                    <div class="tool-name">Administración</div>
                    <div class="tool-desc">Configuración del sistema</div>
                </div>
                <i class="fas fa-chevron-right tool-arrow"></i>
            </a>
            {% endif %}

            {% if hasRoles('ROLE_HOME_TRAZAS') %}
            <a href="{{ path('app_traza_portada') }}" class="tool-card" style="--mod-color:#94a3b8">
                <div class="tool-icon"><i class="fa fa-clone"></i></div>
                <div class="tool-info">
                    <div class="tool-name">Trazas</div>
                    <div class="tool-desc">Auditoría y registro de actividad</div>
                </div>
                <i class="fas fa-chevron-right tool-arrow"></i>
            </a>
            {% endif %}

        </div>
        {% endif %}

    </div>

    <!-- ── Footer ── -->
    <footer class="page-footer">
        &copy; <a href="https://www.uci.cu/" target="_blank" rel="noopener">UCI</a>
        {{ "now"|date("Y") }} &mdash; AKADEMOS &mdash; Ministerio de Educación Superior
    </footer>

    <script>
        (function () {
            var DAYS   = ['domingo','lunes','martes','miércoles','jueves','viernes','sábado'];
            var MONTHS = ['enero','febrero','marzo','abril','mayo','junio',
                          'julio','agosto','septiembre','octubre','noviembre','diciembre'];
            function pad(n) { return n < 10 ? '0' + n : n; }
            function tick() {
                var now = new Date();
                document.getElementById('clock').textContent =
                    pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
                document.getElementById('clock-date').textContent =
                    DAYS[now.getDay()] + ', ' + now.getDate() + ' de ' +
                    MONTHS[now.getMonth()] + ' de ' + now.getFullYear();
            }
            tick();
            setInterval(tick, 1000);
        })();
    </script>
</body>
</html>
