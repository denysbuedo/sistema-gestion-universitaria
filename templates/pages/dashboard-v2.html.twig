<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#102f4f">
    <title>Inicio | SGU</title>
    <link rel="stylesheet" href="{{ asset('assets/fontawesome-free/css/all.min.css') }}">
    <style>
        :root{--navy:#102f4f;--navy-dark:#0b2036;--blue:#1769aa;--ink:#17212b;--text:#435466;--muted:#6c7d8f;--line:#dde5ec;--soft:#edf2f6;--canvas:#f6f8fa;--white:#fff;--focus:#f2b544;--shadow:0 12px 30px rgba(14,42,70,.08)}
        *,*::before,*::after{box-sizing:border-box}html{min-height:100%;background:var(--canvas)}body{min-height:100vh;margin:0;color:var(--ink);background:linear-gradient(180deg,#eef4f8 0,var(--canvas) 280px);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit}a:focus-visible,input:focus-visible,button:focus-visible{outline:3px solid var(--focus);outline-offset:3px}
        .topbar{min-height:72px;color:#fff;background:var(--navy-dark);border-bottom:3px solid #1e75b7}.topbar__inner{width:min(1440px,calc(100% - 48px));min-height:72px;margin:auto;display:flex;align-items:center;gap:24px}.brand{display:inline-flex;align-items:center;gap:14px;text-decoration:none}.brand__mark{width:40px;height:40px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.22);border-radius:10px;background:rgba(255,255,255,.08);font-size:17px}.brand__product{display:block;font-size:17px;font-weight:750;letter-spacing:.035em}.brand__institution{display:block;margin-top:2px;color:#b9cada;font-size:10px;letter-spacing:.08em;text-transform:uppercase}.topbar__spacer{flex:1}.identity{display:flex;align-items:center;gap:11px;min-width:0}.identity__photo{width:38px;height:38px;border:2px solid rgba(255,255,255,.32);border-radius:50%;object-fit:cover;background:#fff}.identity__text{min-width:0;line-height:1.25}.identity__name,.identity__role{max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.identity__name{color:#f7fafc;font-size:13px;font-weight:650}.identity__role{margin-top:2px;color:#aebfd0;font-size:11px}.logout{min-height:38px;padding:0 14px;display:inline-flex;align-items:center;gap:8px;color:#e9f1f7;border:1px solid rgba(255,255,255,.2);border-radius:8px;text-decoration:none;font-size:12px;font-weight:650;transition:.16s}.logout:hover{background:rgba(255,255,255,.1);border-color:rgba(255,255,255,.38)}
        .page{width:min(1440px,calc(100% - 48px));margin:auto;padding:34px 0 48px}.intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,390px);align-items:end;gap:36px;margin-bottom:32px}.eyebrow{margin:0 0 8px;color:var(--blue);font-size:11px;font-weight:750;letter-spacing:.12em;text-transform:uppercase}.intro h1{margin:0;color:var(--navy-dark);font-size:clamp(27px,3vw,38px);font-weight:760;letter-spacing:-.035em;line-height:1.08}.intro__lead{max-width:700px;margin:10px 0 0;color:var(--text);font-size:14px;line-height:1.65}.search{position:relative}.search>i{position:absolute;top:50%;left:15px;color:var(--muted);font-size:14px;transform:translateY(-50%);pointer-events:none}.search input{width:100%;height:46px;padding:0 42px;color:var(--ink);background:#fff;border:1px solid #cbd5df;border-radius:10px;box-shadow:0 5px 18px rgba(14,42,70,.05);font:inherit;font-size:13px}.search input::placeholder{color:#8392a2}.search__clear{position:absolute;top:50%;right:8px;width:32px;height:32px;display:none;place-items:center;border:0;border-radius:7px;color:var(--muted);background:transparent;cursor:pointer;transform:translateY(-50%)}.search__clear:hover{color:var(--navy);background:var(--soft)}
        .section{margin-top:34px}.section:first-of-type{margin-top:0}.section__head{margin-bottom:15px;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.section__title{margin:0;color:var(--navy-dark);font-size:16px;font-weight:750}.section__description{margin:4px 0 0;color:var(--muted);font-size:12px;white-space:nowrap}.section__count{color:var(--muted);font-size:11px;font-weight:650}.process-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:15px}.process-card{min-height:186px;padding:21px;display:flex;flex-direction:column;color:var(--ink);background:#fff;border:1px solid #d5dee7;border-radius:8px;text-decoration:none;transition:border-color .16s,background .16s}.process-card:hover{border-color:#7890a5;background:#fbfcfd}.process-card__top{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}.process-card__icon{width:42px;height:42px;display:grid;place-items:center;color:var(--navy);background:#eef3f7;border:1px solid #d8e1e9;border-radius:7px;font-size:17px}.process-card__arrow{margin-top:5px;color:#aebbc7;font-size:12px;transition:.16s}.process-card:hover .process-card__arrow{color:var(--navy);transform:translateX(2px)}.process-card__name{margin:20px 0 6px;color:var(--navy-dark);font-size:16px;font-weight:750;line-height:1.2}.process-card__description{margin:0;color:var(--muted);font-size:12px;line-height:1.55}.process-card__tag{margin-top:auto;padding-top:16px;color:#567086;font-size:10px;font-weight:750;letter-spacing:.075em;text-transform:uppercase}
        .tools-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.tool-card{min-height:82px;padding:15px 17px;display:flex;align-items:center;gap:14px;color:var(--ink);background:rgba(255,255,255,.82);border:1px solid var(--line);border-radius:10px;text-decoration:none;transition:.16s}.tool-card:hover{background:#fff;border-color:#b9c9d7;box-shadow:0 8px 22px rgba(14,42,70,.07)}.tool-card__icon{width:38px;height:38px;display:grid;place-items:center;flex:0 0 auto;color:#17446f;background:#e8f2fa;border-radius:9px;font-size:15px}.tool-card__body{min-width:0;flex:1}.tool-card__name{display:block;color:var(--navy-dark);font-size:13px;font-weight:700}.tool-card__description{display:block;margin-top:3px;overflow:hidden;color:var(--muted);font-size:11px;text-overflow:ellipsis;white-space:nowrap}.tool-card__arrow{color:#cbd5df;font-size:10px}.empty{display:none;padding:42px 24px;text-align:center;color:var(--muted);background:#fff;border:1px dashed #cbd5df;border-radius:12px}.empty i{display:block;margin-bottom:11px;font-size:22px}.empty strong{display:block;margin-bottom:4px;color:var(--text);font-size:13px}.empty span{font-size:12px}.footer{width:min(1440px,calc(100% - 48px));margin:auto;padding:20px 0 28px;display:flex;justify-content:space-between;gap:20px;color:var(--muted);border-top:1px solid var(--line);font-size:11px}
        @media(max-width:1120px){.process-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:840px){.topbar__inner,.page,.footer{width:min(100% - 32px,1440px)}.identity__text{display:none}.intro{grid-template-columns:1fr;gap:20px}.section__description{white-space:normal}.process-grid,.tools-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.topbar__inner{min-height:64px;gap:12px}.brand__institution,.identity{display:none}.logout span{display:none}.logout{width:38px;padding:0;justify-content:center}.page{padding-top:25px}.intro h1{font-size:27px}.process-grid,.tools-grid{grid-template-columns:1fr}.process-card{min-height:164px}.footer{flex-direction:column;gap:6px}}@media(prefers-reduced-motion:reduce){*,*::before,*::after{transition:none!important}}
    </style>
</head>
<body>
<header class="topbar"><div class="topbar__inner">
    <a class="brand" href="{{ path('home') }}" aria-label="SGU, página de inicio"><span class="brand__mark"><i class="fas fa-landmark"></i></span><span><span class="brand__product">SGU · AKADEMOS</span><span class="brand__institution">Ministerio de Educación Superior</span></span></a>
    <span class="topbar__spacer"></span>
    <div class="identity"><img class="identity__photo" src="{% if app.session.get('foto_usuario_autenticado') %}{{ asset('uploads/images/personas/' ~ app.session.get('foto_usuario_autenticado')) }}{% else %}{{ asset('assets/images/usuario.png') }}{% endif %}" alt=""><div class="identity__text"><div class="identity__name">{{ app.session.get('nombre_usuario_autenticado') ?? app.user.email }}</div><div class="identity__role">{{ app.session.get('responsabilidad_usuario_autenticado') ?? 'Usuario del sistema' }}</div></div></div>
    <a class="logout" href="{{ path('app_logout') }}" title="Cerrar sesión"><i class="fas fa-sign-out-alt"></i><span>Cerrar sesión</span></a>
</div></header>

<main class="page">
    <section class="intro" aria-labelledby="page-title"><div><p class="eyebrow">Portal institucional</p><h1 id="page-title">Gestión universitaria</h1><p class="intro__lead">Seleccione un proceso para acceder a sus operaciones, indicadores y servicios. Solo se muestran las áreas habilitadas para su cuenta.</p></div><div class="search" role="search"><i class="fas fa-search"></i><input id="module-search" type="search" placeholder="Buscar un proceso o herramienta" autocomplete="off" aria-label="Buscar un proceso o herramienta"><button id="search-clear" class="search__clear" type="button" aria-label="Limpiar búsqueda"><i class="fas fa-times"></i></button></div></section>

    <section class="section" data-section><div class="section__head"><div><h2 class="section__title">Procesos Universitarios</h2><p class="section__description">Actividades académicas y administrativas que articulan la formación, la investigación, la extensión y la graduación.</p></div><span class="section__count" data-count></span></div><div class="process-grid">
        {% if hasRoles('ROLE_HOME_PREGR') %}{{ _self.process('app_pregrado_portada','pregrado formación académica carreras','graduation-cap','Pregrado','Programas académicos, planes de estudio y formación profesional.','Formación académica','#1769aa') }}{% endif %}
        {% if hasRoles('ROLE_HOME_POSTG') %}{{ _self.process('app_postgrado_portada','posgrado maestrías doctorados especialidades','user-graduate','Posgrado','Maestrías, especialidades, doctorados y superación profesional.','Formación avanzada','#6d4bb8') }}{% endif %}
        {% if hasRoles('ROLE_HOME_EVALUACION') %}{{ _self.process('app_evaluacion_portada','evaluación acreditación calidad','clipboard-check','Evaluación','Evaluación institucional, acreditación y seguimiento de la calidad.','Calidad','#167a69') }}{% endif %}
        {% if hasRoles('ROLE_HOME_TRAMITES') %}{{ _self.process('app_tramite_portada','trámites internacionalización misiones pasaportes','passport','Trámites internacionales','Misiones, pasaportes, documentos de salida y movilidad.','Internacionalización','#b46518') }}{% endif %}
        {% if hasRoles('ROLE_HOME_CONVENIO') %}{{ _self.process('app_convenio_portada','convenios cooperación internacional acuerdos','handshake','Convenios','Acuerdos, instrumentos jurídicos y cooperación universitaria.','Cooperación','#a24658') }}{% endif %}
        {% if hasRoles('ROLE_HOME_ECONOMIA') %}{{ _self.process('app_economia_portada','economía gestión económica','chart-line','Economía','Procesos económicos asociados a la actividad universitaria.','Gestión económica','#82721f') }}{% endif %}
        {% if hasRoles('ROLE_HOME_INFORMATIZACION') %}{{ _self.process('app_informatizacion_portada','informatización transformación digital sistemas conectividad','laptop-code','Informatización','Sistemas, servicios digitales, conectividad e infraestructura tecnológica.','Transformación digital','#3758a6') }}{% endif %}
        {% if hasRoles('ROLE_HOME_RRHH') %}{{ _self.process('app_rrhh_portada','recursos humanos rrhh plantilla personal','users','Recursos humanos','Plantillas, indicadores laborales y gestión del capital humano.','Capital humano','#8b3d70') }}{% endif %}
    </div></section>

    {% if hasRoles('ROLE_HOME_PERSONAL') or hasRoles('ROLE_HOME_INSTIT') or hasRoles('ROLE_HOME_STRUCT') or hasRoles('ROLE_HOME_REPORT') or hasRoles('ROLE_HOME_ADMIN') or hasRoles('ROLE_HOME_TRAZAS') %}
    <section class="section" data-section><div class="section__head"><div><h2 class="section__title">Gestión y control</h2><p class="section__description">Catálogos, configuración, reportes y auditoría</p></div><span class="section__count" data-count></span></div><div class="tools-grid">
        {% if hasRoles('ROLE_HOME_PERSONAL') %}{{ _self.tool('app_personal_portada','personal expedientes personas','id-card','Personal','Expedientes y datos de personas') }}{% endif %}
        {% if hasRoles('ROLE_HOME_INSTIT') %}{{ _self.tool('app_institucion_portada','instituciones universidades centros','university','Instituciones','Universidades y entidades adscritas') }}{% endif %}
        {% if hasRoles('ROLE_HOME_STRUCT') %}{{ _self.tool('app_estructura_portada','estructura organizativa entidades áreas','sitemap','Estructura','Organización y estructuras institucionales') }}{% endif %}
        {% if hasRoles('ROLE_HOME_REPORT') %}{{ _self.tool('app_reporte_portada','reportes informes exportaciones','file-alt','Reportes','Informes y salidas consolidadas') }}{% endif %}
        {% if hasRoles('ROLE_HOME_ADMIN') %}{{ _self.tool('app_administracion_portada','administración configuración usuarios roles','cog','Administración','Usuarios, roles y configuración') }}{% endif %}
        {% if hasRoles('ROLE_HOME_TRAZAS') %}{{ _self.tool('app_traza_portada','trazas auditoría actividad seguridad','history','Trazas','Auditoría y actividad del sistema') }}{% endif %}
    </div></section>
    {% endif %}
    <div id="empty-search" class="empty"><i class="fas fa-search"></i><strong>No encontramos coincidencias</strong><span>Pruebe con otro nombre o término.</span></div>
</main>
<footer class="footer"><span>SGU · Sistema de Gestión Universitaria</span><span>Ministerio de Educación Superior · {{ "now"|date("Y") }}</span></footer>
<script>
(function(){var input=document.getElementById('module-search'),clear=document.getElementById('search-clear'),empty=document.getElementById('empty-search'),cards=[].slice.call(document.querySelectorAll('[data-module]')),sections=[].slice.call(document.querySelectorAll('[data-section]'));function normal(v){return v.toLocaleLowerCase('es').normalize('NFD').replace(/[\u0300-\u036f]/g,'')}function update(){var q=normal(input.value.trim()),total=0;cards.forEach(function(card){var visible=!q||normal(card.getAttribute('data-module')+' '+card.textContent).indexOf(q)!==-1;card.hidden=!visible;if(visible)total++});sections.forEach(function(section){var count=section.querySelectorAll('[data-module]:not([hidden])').length;section.hidden=count===0;var label=section.querySelector('[data-count]');if(label)label.textContent=count+(count===1?' acceso':' accesos')});empty.style.display=total===0?'block':'none';clear.style.display=input.value?'grid':'none'}input.addEventListener('input',update);clear.addEventListener('click',function(){input.value='';input.focus();update()});update()}());
</script>
</body>
</html>

{% macro process(route, search, icon, name, description, tag, color) %}
<a class="process-card" data-module="{{ search }}" href="{{ path(route) }}"><div class="process-card__top"><span class="process-card__icon"><i class="fas fa-{{ icon }}"></i></span><i class="fas fa-arrow-right process-card__arrow"></i></div><h3 class="process-card__name">{{ name }}</h3><p class="process-card__description">{{ description }}</p><span class="process-card__tag">{{ tag }}</span></a>
{% endmacro %}

{% macro tool(route, search, icon, name, description) %}
<a class="tool-card" data-module="{{ search }}" href="{{ path(route) }}"><span class="tool-card__icon"><i class="fas fa-{{ icon }}"></i></span><span class="tool-card__body"><span class="tool-card__name">{{ name }}</span><span class="tool-card__description">{{ description }}</span></span><i class="fas fa-chevron-right tool-card__arrow"></i></a>
{% endmacro %}
